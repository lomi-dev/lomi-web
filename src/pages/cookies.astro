---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieSettingsLink from '../components/CookieSettingsLink.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const page = content.pages.cookies;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({ ...link, href: link.href.startsWith('#') ? `/${link.href}` : link.href })),
  })).filter((group) => group.links.length > 0),
};
---

<Layout title={page.seo.title} description={page.seo.description} website={content} themeColor={content.site.theme.paper} edgeColor="var(--color-lime)">
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="light" />
  <main class="cookies-page" id="main" tabindex="-1" data-scroll-surface>
    <div class="cookies-shell">
      <header><h1>{page.title}</h1><p>{page.description}</p></header>
      {page.sections.map((section, sectionIndex) => <section id={sectionIndex === 0 ? 'preferences' : undefined} aria-labelledby={`policy-title-${sectionIndex}`}>
        <h2 id={`policy-title-${sectionIndex}`}>{section.title}</h2>
        {section.paragraphs.map((paragraph, paragraphIndex) => <>
          <p>{paragraph.text.split(/(\{embedding\}|\{privacy\})/).map((part) => {
            const link = part === '{embedding}' ? page.links.embedding : part === '{privacy}' ? page.links.privacy : null;
            return link ? <a href={link.href}>{link.label}</a> : part;
          })}</p>
          {section.showStorage && paragraphIndex === 0 && <dl>{page.storage.map((row) => <div><dt>{row.label}</dt><dd>{row.code ? <code>{row.value}</code> : row.value}</dd></div>)}</dl>}
        </>)}
        {section.showStorage && section.paragraphs.length === 0 && <dl>{page.storage.map((row) => <div><dt>{row.label}</dt><dd>{row.code ? <code>{row.value}</code> : row.value}</dd></div>)}</dl>}
        {section.showSettings && <CookieSettingsLink label={page.settingsLabel} />}
        {section.showNoscript && <noscript><p>{section.noscript}</p></noscript>}
      </section>)}
    </div>
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>

<style>
  .cookies-page { --scroll-surface-color: var(--color-paper); padding: 132px 0 80px; color: var(--color-ink); background: var(--color-paper); }
  .cookies-shell { width: min(760px, calc(100% - 80px)); margin-inline: auto; }
  h1 { margin: 0; font-size: clamp(46px, 5vw, 64px); font-weight: 500; line-height: 1.06; letter-spacing: -.055em; text-wrap: balance; }
  header > p { margin-top: 20px; color: var(--color-text-secondary); font-size: 17px; line-height: 1.65; }
  section { margin-top: 40px; padding-top: 24px; border-top: 1px solid #dfe4d8; }
  h2 { font-size: 24px; font-weight: 500; line-height: 1.25; letter-spacing: -.035em; }
  section p { margin-top: 16px; color: var(--color-text-secondary); font-size: 14px; line-height: 1.8; }
  section p a { color: #263b15; text-decoration: underline; text-underline-offset: 3px; }
  section :global(.cookie-settings-link) { margin-top: 16px; padding: 0 18px; border: 1px solid #b6e43b; border-radius: 999px; background: var(--color-lime); font-size: 13px; font-weight: 500; }
  dl { margin: 20px 0; font-size: 13px; line-height: 1.65; }
  dl > div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 8px 24px; padding-block: 12px; border-bottom: 1px solid #edf0e9; }
  dt { color: var(--color-text-secondary); }
  dd { margin: 0; overflow-wrap: anywhere; }
  code { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: 12px; }
  @media (max-width: 767px) {
    .cookies-page { padding: 112px 0 48px; }
    .cookies-shell { width: calc(100% - 40px); }
    h1 { font-size: clamp(40px, 9vw, 56px); }
    header > p { font-size: 15px; }
    section { margin-top: 32px; }
    dl > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
