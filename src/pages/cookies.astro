---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieSettingsLink from '../components/CookieSettingsLink.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const page = content.pages.cookies;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({ ...link, href: link.href.startsWith('#') ? `/${link.href}` : link.href })),
  })).filter((group) => group.links.length > 0),
};
---

<Layout title={page.seo.title} description={page.seo.description} website={content} themeColor="#0e0e11" edgeColor="var(--color-chalk)">
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="dark" />
  <main class="cookies-page" id="main" tabindex="-1" data-scroll-surface>
    <div class="cookies-shell">
      <header><h1>{page.title}</h1><p>{page.description}</p></header>
      {page.sections.map((section, sectionIndex) => <section id={sectionIndex === 0 ? 'preferences' : undefined} aria-labelledby={`policy-title-${sectionIndex}`}>
        <h2 id={`policy-title-${sectionIndex}`}>{section.title}</h2>
        {section.paragraphs.map((paragraph, paragraphIndex) => <>
          <p>{paragraph.text.split(/(\{embedding\}|\{privacy\})/).map((part) => {
            const link = part === '{embedding}' ? page.links.embedding : part === '{privacy}' ? page.links.privacy : null;
            return link ? <a href={link.href}>{link.label}</a> : part;
          })}</p>
          {section.showStorage && paragraphIndex === 0 && <dl>{page.storage.map((row) => <div><dt>{row.label}</dt><dd>{row.code ? <code>{row.value}</code> : row.value}</dd></div>)}</dl>}
        </>)}
        {section.showStorage && section.paragraphs.length === 0 && <dl>{page.storage.map((row) => <div><dt>{row.label}</dt><dd>{row.code ? <code>{row.value}</code> : row.value}</dd></div>)}</dl>}
        {section.showSettings && <CookieSettingsLink label={page.settingsLabel} variant="button" />}
        {section.showNoscript && <noscript><p>{section.noscript}</p></noscript>}
      </section>)}
    </div>
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>

<style>
  .cookies-page { --scroll-surface-color: var(--color-chalk); padding: 132px 0 96px; color: var(--color-ink); background: var(--color-chalk); }
  .cookies-shell { width: min(760px, calc(100% - 80px)); margin-inline: auto; }
  h1 { font-size: clamp(40px, 6vw, 80px); }
  header > p { max-width: 70ch; margin-top: 24px; color: var(--color-text-secondary); font-size: 17px; line-height: 1.65; text-wrap: pretty; }
  header > .updated { margin-top: 20px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
  section { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(24px, 3vw, 32px); line-height: 1.15; }
  section p, section li { color: var(--color-text-secondary); font-size: 17px; line-height: 1.65; }
  section p { max-width: 70ch; margin-top: 16px; }
  section ul { display: grid; gap: 12px; max-width: 70ch; margin: 16px 0 0; padding-left: 22px; }
  section li { padding-left: 3px; }
  section li::marker { color: var(--color-night-500); }
  section p a { color: var(--color-violet-300); text-decoration: underline; text-underline-offset: 3px; }
  section p a:hover { color: var(--color-ink); }
  section strong { color: var(--color-ink); font-weight: 600; }
  section :global(.cookie-settings-link) { margin-top: 16px; }
  dl { margin: 20px 0; font-size: 15px; line-height: 1.6; }
  dl > div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 8px 24px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  dt { color: var(--color-text-secondary); }
  dd { margin: 0; overflow-wrap: anywhere; }
  code { padding: 1px 6px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--color-night-850); color: var(--color-ink); font-size: .85em; }
  @media (max-width: 767px) {
    .cookies-page { padding: 112px 0 64px; }
    .cookies-shell { width: calc(100% - 40px); }
    h1 { font-size: clamp(36px, 10vw, 48px); }
    section { margin-top: 40px; }
    section p, section li, header > p { font-size: 16px; }
    dl > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
