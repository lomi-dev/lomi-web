---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon';
import DevlogCard from '../components/DevlogCard.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';
import { loadDevlogs } from '../../content/load-devlogs';

const [content, episodes] = await Promise.all([loadLanding(import.meta.env.CMS_URL), loadDevlogs(import.meta.env.CMS_URL)]);
const page = content.pages.devlog;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({
      ...link,
      href: link.href.startsWith('#') ? `/${link.href}` : link.href,
    })),
  })).filter((group) => group.links.length > 0),
};
const [latest, ...archive] = episodes;
---

<Layout title={page.seo.title} description={page.seo.description} website={content} themeColor={content.site.theme.background} edgeColor="var(--color-chalk)">
  <div class="devlog-surface" data-scroll-surface>
    <Header content={content.navigation} site={content.site} layout={content.layout} theme="light" />
    <main id="main" class="devlog-page devlog-shell" tabindex="-1">
      <header class="devlog-intro">
        <h1>{page.title.map((line, index) => <>{index > 0 && ' '}{line.text}</>)}{page.accent && <span aria-hidden="true">{page.accent}</span>}</h1>
        <p class="devlog-description">{page.description.map((line, index) => <>{index > 0 && <br />}{line.text}</>)}</p>
        <a class="devlog-home" href={page.cta.href}><Icon name="arrow" width={17} height={17} />{page.cta.label}</a>
      </header>

      <div class="devlog-recordings">
        {latest ? <>
          <section class="devlog-latest" aria-labelledby="latest-label">
            <h2 id="latest-label" class="devlog-section-heading">{page.latestLabel}</h2>
            <DevlogCard episode={latest} featured language={content.site.language} watchLabel={page.watchLabel} placeholderLogo={content.site.brand.logo} />
          </section>
          {archive.length > 0 && <section class="devlog-archive" aria-labelledby="archive-label">
            <h2 id="archive-label" class="devlog-section-heading">{page.archiveLabel}</h2>
            <div class="devlog-grid">{archive.map((episode) => <DevlogCard episode={episode} language={content.site.language} watchLabel={page.watchLabel} placeholderLogo={content.site.brand.logo} />)}</div>
          </section>}
        </> : <section class="devlog-empty" data-devlog-empty aria-labelledby="empty-title">
          <div class="empty-preview" aria-hidden="true">
            <MediaPlaceholder logo={content.site.brand.logo} aspect="16 / 9" />
          </div>
          <div class="empty-copy">
            <h2 id="empty-title">{page.empty.title}</h2>
            <p class="empty-description">{page.empty.description}</p>
          </div>
        </section>}
      </div>
    </main>
    <Footer content={footerContent} site={content.site} layout={content.layout} />
  </div>
</Layout>

<style>
  .devlog-surface { --scroll-surface-color: var(--color-chalk); --devlog-muted: var(--color-text-secondary); --devlog-line: var(--line); min-height: 100svh; display: flex; flex-direction: column; background: var(--color-chalk); color: var(--color-ink); overflow-wrap: anywhere; }
  .devlog-shell { width: min(1440px, calc(100% - clamp(40px, 10.4vw, 192px))); margin-inline: auto; }
  .devlog-page { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 2.25fr); align-items: start; flex: 1; gap: clamp(44px, 6vw, 88px); padding-top: 156px; padding-bottom: 100px; }
  .devlog-intro { position: sticky; top: calc(var(--site-header-height) + 56px); }
  h1 { margin: 0; font-size: clamp(46px, 4.8vw, 72px); font-weight: 500; letter-spacing: -.055em; line-height: 1.06; text-wrap: balance; }
  .devlog-description { max-width: 240px; margin-top: 22px; color: var(--devlog-muted); font-size: 16px; line-height: 1.75; text-wrap: pretty; }
  .devlog-home { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 27px; color: var(--devlog-muted); font-size: 13px; }
  .devlog-home :global(svg) { transform: rotate(180deg); }
  .devlog-home:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
  .devlog-recordings { min-width: 0; padding-top: 8px; }
  .devlog-section-heading { margin: 0 0 22px; color: var(--devlog-muted); font-size: 13px; font-weight: 400; letter-spacing: normal; line-height: 1.5; }
  .devlog-archive { margin-top: 54px; padding-top: 28px; border-top: 1px solid var(--line); }
  .devlog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; }
  .empty-preview { aspect-ratio: 16 / 9; }
  .empty-copy { padding: 27px 0 0; }
  .empty-copy h2 { font-size: 24px; line-height: 1.3; letter-spacing: -.025em; }
  .empty-description { max-width: 420px; margin-top: 10px; color: var(--devlog-muted); font-size: 15px; line-height: 1.75; text-wrap: pretty; }
  @media (max-width: 1000px) { .devlog-page { grid-template-columns: minmax(0, .8fr) minmax(0, 2fr); gap: 40px; } h1 { font-size: 50px; } .devlog-description { font-size: 15px; } }
  @media (max-width: 767px) {
    .devlog-page { display: block; padding-top: 116px; padding-bottom: 64px; }
    .devlog-intro { position: static; margin-bottom: 38px; }
    h1 { font-size: 54px; }
    .devlog-description { max-width: 360px; margin-top: 16px; }
    .devlog-home { margin-top: 15px; }
    .devlog-recordings { padding-top: 0; }
    .devlog-section-heading { margin-bottom: 18px; }
    .empty-copy { padding-top: 22px; }
    .empty-copy h2 { font-size: 22px; }
    .empty-description { font-size: 14px; }
    .devlog-archive { margin-top: 36px; padding-top: 24px; }
  }
  @media (max-width: 540px) { .devlog-grid { grid-template-columns: 1fr; gap: 28px; } }
  @media (max-height: 600px) { .devlog-intro { position: static; } }
  @media (prefers-reduced-motion: no-preference) { .devlog-home :global(svg) { transition: transform 160ms ease; } .devlog-home:hover :global(svg) { transform: rotate(180deg) translateX(3px); } }
</style>
