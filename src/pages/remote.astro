---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RemotePage from '../components/RemotePage.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const page = content.pages.remote;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({
      ...link,
      href: link.href.startsWith('#') ? `/${link.href}` : link.href,
    })),
  })).filter((group) => group.links.length > 0),
};
---

<Layout title={page.seo.title} description={page.seo.description} website={content} themeColor={content.site.theme.paper} edgeColor="var(--color-lime)">
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="light" />
  <main id="main" tabindex="-1">
    <RemotePage content={page} placeholderLogo={content.site.brand.logo} />
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>
