---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureGallery from '../components/FeatureGallery.astro';
import Roadmap from '../components/Roadmap.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import Footer from '../components/Footer.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const { hero, features, roadmap, newsletter } = content;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups
    .map((group) => ({ ...group, links: activeLandingLinks(group.links, content.layout) }))
    .filter((group) => group.links.length > 0),
};
---

<Layout website={content} title={content.seo.title} description={content.seo.description} themeColor={content.site.theme.paper} edgeColor="var(--color-lime)">
  <Header content={content.navigation} site={content.site} layout={content.layout} />
  <div class="home-pull-viewport" data-scroll-surface style="--scroll-surface-color: var(--color-paper)">
    <div class="home-pull-content">
      <main id="main" tabindex="-1" data-scroll-surface style="--scroll-surface-color: var(--color-chalk)">
        {!content.layout.some((row) => row.section === 'hero' && row.enabled) && <h1 class="sr-only">{content.seo.title}</h1>}
        {content.layout.filter((row) => row.enabled).map(({ section }) => section === 'hero' ? <Hero content={hero} layout={content.layout} />
          : section === 'features' ? <FeatureGallery content={features} />
          : section === 'roadmap' ? <Roadmap content={roadmap} />
          : section === 'newsletter' ? <NewsletterSection content={newsletter} site={content.site} /> : null)}
      </main>
      <Footer content={footerContent} site={content.site} layout={content.layout} />
    </div>
  </div>
</Layout>

<script>
  import { initHeroPull } from '../components/hero-pull';
  import { alignInitialSectionAnchor } from '../components/initial-section-anchor';
  alignInitialSectionAnchor();
  initHeroPull();
</script>

<style>
  .home-pull-viewport { overflow: clip; }
</style>
