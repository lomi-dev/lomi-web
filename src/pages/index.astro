---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureGallery from '../components/FeatureGallery.astro';
import CliCompatibility from '../components/CliCompatibility.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import Footer from '../components/Footer.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const { hero, features, newsletter } = content;
const publicLayout = content.layout.filter((row) => row.section !== 'roadmap');
const startsWithHero = publicLayout.find((row) => row.enabled)?.section === 'hero';
const heroSurface = '#f6f8f4';
const footerContent = {
  ...content.footer,
  groups: content.footer.groups
    .map((group) => ({ ...group, links: activeLandingLinks(group.links, publicLayout) }))
    .filter((group) => group.links.length > 0),
};
---

<Layout website={content} title={content.seo.title} description={content.seo.description} themeColor={startsWithHero ? heroSurface : content.site.theme.paper} edgeColor={startsWithHero ? heroSurface : 'var(--color-lime)'}>
  <Header content={content.navigation} site={content.site} layout={publicLayout} theme={startsWithHero ? 'light' : undefined} />
  <main id="main" class="home-main" tabindex="-1" data-scroll-surface style="--scroll-surface-color: var(--color-chalk)">
    {!publicLayout.some((row) => row.section === 'hero' && row.enabled) && <h1 class="sr-only">{content.seo.title}</h1>}
    {publicLayout.filter((row) => row.enabled).map(({ section }) => section === 'hero' ? <Hero content={hero} layout={publicLayout} />
      : section === 'features' ? <><FeatureGallery content={features} placeholderLogo={content.site.brand.logo} /><CliCompatibility /></>
      : section === 'newsletter' ? <NewsletterSection content={newsletter} /> : null)}
  </main>
  <Footer content={footerContent} site={content.site} layout={publicLayout} />
</Layout>

<script>
  import { alignInitialSectionAnchor } from '../components/initial-section-anchor';
  alignInitialSectionAnchor();
</script>

<style>
  .home-main { overflow-x: clip; }
  :global(html:has(.hero)) { overscroll-behavior-y: none; }
</style>
