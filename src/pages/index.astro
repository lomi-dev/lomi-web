---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureGallery from '../components/FeatureGallery.astro';
import Roadmap from '../components/Roadmap.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import VideoDialog from '../components/VideoDialog.astro';
import Footer from '../components/Footer.astro';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const { hero, features, roadmap, newsletter } = content;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups
    .map((group) => ({ ...group, links: activeLandingLinks(group.links) }))
    .filter((group) => group.links.length > 0),
};
---

<Layout title={content.seo.title} description={content.seo.description} themeColor="#ffffff" edgeColor="var(--color-lime)">
  <Header content={content.navigation} />
  <main id="main" tabindex="-1" data-scroll-surface style="--scroll-surface-color: var(--color-chalk)">
    <Hero content={hero} />
    <FeatureGallery content={features} />
    <Roadmap content={roadmap} />
    <NewsletterSection content={newsletter} />
  </main>
  <Footer content={footerContent} />
  <VideoDialog />
</Layout>

<script>
  import { alignInitialSectionAnchor } from '../components/initial-section-anchor';
  alignInitialSectionAnchor();
</script>
