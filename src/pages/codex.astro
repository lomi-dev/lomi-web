---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgentGuide from '../components/AgentGuide.astro';
import { agentGuides } from '../data/agent-guides';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';

const content = await loadLanding(import.meta.env.CMS_URL);
const guide = agentGuides.codex;
const footerContent = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({
      ...link,
      href: link.href.startsWith('#') ? `/${link.href}` : link.href,
    })),
  })).filter((group) => group.links.length > 0),
};
---

<Layout
  title={guide.seoTitle}
  description={guide.seoDescription}
  website={content}
  themeColor={content.site.theme.paper}
  edgeColor="var(--color-lime)"
  article={{}}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: guide.title, href: '/codex/' }]}
>
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="light" />
  <main id="main" tabindex="-1">
    <AgentGuide guide={guide} />
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>
