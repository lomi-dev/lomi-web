---
import type { Landing } from '../../content/landing-schema';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  summary: string;
  eyebrow?: string;
  breadcrumbs: { name: string; href: string }[];
  sections: { id: string; label: string }[];
  reviewedAt?: string;
}

const { title, description, heading, summary, eyebrow, breadcrumbs, sections, reviewedAt } = Astro.props;
const content = await loadLanding(import.meta.env.CMS_URL);
const footerContent: Landing['footer'] = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({
      ...link,
      href: link.href.startsWith('#') ? `/${link.href}` : link.href,
    })),
  })).filter((group) => group.links.length > 0),
};
const reviewDate = reviewedAt ? new Date(`${reviewedAt}T12:00:00.000Z`) : undefined;
if (reviewDate && Number.isNaN(reviewDate.valueOf())) throw new TypeError('reviewedAt must be an ISO date.');
const publishedBreadcrumbs = breadcrumbs.at(-1)?.href === Astro.url.pathname
  ? breadcrumbs
  : [...breadcrumbs, { name: heading, href: Astro.url.pathname }];

---

<Layout
  title={title}
  description={description}
  website={content}
  themeColor="#0e0e11"
  edgeColor="var(--color-chalk)"
  article={reviewDate ? { modifiedTime: reviewDate.toISOString() } : undefined}
  breadcrumbs={publishedBreadcrumbs}
>
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="dark" />
  <main id="main" class="resource-page" tabindex="-1">
    <div class="resource-shell">
      <nav class="resource-breadcrumbs" aria-label="Breadcrumb">
        {publishedBreadcrumbs.map((item, index) => <Fragment>
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === publishedBreadcrumbs.length - 1
            ? <span aria-current="page">{item.name}</span>
            : <a href={item.href}>{item.name}</a>}
        </Fragment>)}
      </nav>

      <header class="resource-opening">
        {eyebrow && <p class="eyebrow resource-eyebrow">{eyebrow}</p>}
        <h1>{heading}</h1>
        <p class="resource-summary">{summary}</p>
        {reviewDate && <p class="resource-reviewed">Reviewed <time datetime={reviewDate.toISOString()}>{reviewDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time> · Lomi team</p>}
        <div class="resource-actions">
          <a class="button button-primary resource-primary" href="/download/">Download Lomi</a>
          <a class="resource-secondary" href="https://docs.lomi.dev/features/">Explore Lomi features</a>
        </div>
      </header>

      <div class="resource-body">
        <nav class="resource-toc" aria-label="On this page">
          <h2>On this page</h2>
          <ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}</ol>
        </nav>
        <article class="resource-copy"><slot /></article>
      </div>
    </div>
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>

<style>
  .resource-page { --scroll-surface-color: var(--color-chalk); min-height: 70vh; padding: 0 0 clamp(64px, 9vw, 112px); background: var(--color-chalk); color: var(--color-ink); overflow-wrap: break-word; }
  .resource-shell { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .resource-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding-top: 112px; color: var(--color-text-secondary); font-size: .8125rem; line-height: 1.6; }
  .resource-breadcrumbs a { text-decoration: underline; text-decoration-color: var(--color-night-600); text-underline-offset: 3px; }
  .resource-breadcrumbs a:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .resource-breadcrumbs [aria-current="page"] { color: var(--color-ink); }
  .resource-opening { max-width: 780px; padding-top: 48px; }
  .resource-eyebrow { margin-bottom: 16px; }
  .resource-opening h1 { max-width: 16ch; font-size: clamp(40px, 6vw, 80px); text-wrap: balance; }
  .resource-summary { max-width: 66ch; margin: 24px 0 0; color: var(--color-text-secondary); font-size: clamp(1.0625rem, 1.5vw, 1.25rem); line-height: 1.65; text-wrap: pretty; }
  .resource-reviewed { margin: 18px 0 0; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; line-height: 1.6; text-transform: uppercase; }
  .resource-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 28px; }
  .resource-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; color: var(--color-violet-300); font-size: .9375rem; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); gap: 10px; }
  .resource-secondary:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .resource-body { display: grid; grid-template-columns: minmax(180px, 220px) minmax(0, 740px); justify-content: space-between; gap: clamp(48px, 7vw, 100px); margin-top: 84px; }
  .resource-toc { position: sticky; top: calc(var(--site-header-height) + 30px); align-self: start; padding-top: 16px; border-top: 1px solid var(--line); }
  .resource-toc h2 { margin: 0; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 12px; font-weight: 500; font-stretch: 100%; letter-spacing: .04em; line-height: 1.6; text-transform: uppercase; }
  .resource-toc ol { display: grid; gap: 3px; margin: 16px 0 0; padding: 0; list-style: none; }
  .resource-toc a { display: block; padding: 8px 0; color: var(--color-text-secondary); font-size: .875rem; line-height: 1.55; text-underline-offset: 4px; }
  .resource-toc a { text-decoration: underline; text-decoration-color: transparent; }
  .resource-toc a:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .resource-copy { min-width: 0; color: var(--color-text-secondary); font-size: 1.0625rem; line-height: 1.65; }
  .resource-copy :global(section) { scroll-margin-top: calc(var(--site-header-height) + 24px); }
  .resource-copy :global(section + section) { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--line); }
  .resource-copy :global(h2) { max-width: 24ch; margin: 0; color: var(--color-ink); font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.15; }
  .resource-copy :global(h3) { margin: 32px 0 10px; color: var(--color-ink); font-size: 1.25rem; }
  .resource-copy :global(p) { max-width: 70ch; margin: 16px 0 0; text-wrap: pretty; }
  .resource-copy :global(ul), .resource-copy :global(ol) { display: grid; gap: 10px; max-width: 70ch; margin: 18px 0 0; padding-left: 1.3em; }
  .resource-copy :global(li) { padding-left: .1em; }
  .resource-copy :global(li::marker) { color: var(--color-night-500); }
  .resource-copy :global(a) { color: var(--color-violet-300); text-decoration: underline; text-underline-offset: 3px; }
  .resource-copy :global(a:hover) { color: var(--color-ink); }
  .resource-copy :global(strong) { color: var(--color-ink); font-weight: 600; }
  .resource-copy :global(code) { padding: 1px 6px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--color-night-850); color: var(--color-ink); font-size: .85em; overflow-wrap: anywhere; }
  .resource-copy :global(pre) { max-width: 100%; margin: 22px 0 0; padding: 18px; overflow-x: auto; border: 1px solid var(--line-strong); border-radius: var(--radius-md); background: var(--color-night-850); color: var(--color-ink); font-size: .8125rem; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
  .resource-copy :global(pre code) { padding: 0; border: 0; background: none; font-size: inherit; }
  .resource-copy :global(.table-scroll) { max-width: 100%; margin-top: 22px; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--color-paper); scrollbar-width: thin; }
  .resource-copy :global(table) { width: 100%; border-collapse: collapse; font-size: .9375rem; line-height: 1.55; }
  .resource-copy :global(caption) { padding: 14px 16px; color: var(--color-text-secondary); font-size: .8125rem; text-align: start; }
  .resource-copy :global(th), .resource-copy :global(td) { min-width: 140px; padding: 13px 15px; border-top: 1px solid var(--line); text-align: start; vertical-align: top; }
  .resource-copy :global(th) { color: var(--color-ink); font-weight: 600; }
  .resource-copy :global(thead th) { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .resource-copy :global(td:first-child) { color: var(--color-ink); font-weight: 600; }
  .resource-copy :global(.editorial-note) { margin-top: 26px; padding: 18px 20px; border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--color-paper); font-size: 1rem; }
  .resource-copy :global(.editorial-note p) { margin-top: 0; }
  .resource-copy :global(.editorial-note p + p) { margin-top: 12px; }
  .resource-copy :global(.source-list) { gap: 8px; font-size: .9375rem; }

  @media (max-width: 999px) {
    .resource-shell { width: min(760px, calc(100% - 56px)); }
    .resource-opening { max-width: 700px; }
    .resource-opening h1 { max-width: 18ch; }
    .resource-body { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 62px; }
    .resource-toc { position: static; padding-top: 13px; }
    .resource-toc ol { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 8px; }
    .resource-toc a { min-height: 40px; }
  }
  @media (max-width: 767px) {
    .resource-page { padding-bottom: 62px; }
    .resource-shell { width: calc(100% - 40px); }
    .resource-breadcrumbs { padding-top: 100px; }
    .resource-opening { padding-top: 30px; }
    .resource-opening h1 { max-width: 14ch; font-size: clamp(36px, 10vw, 48px); }
    .resource-summary { margin-top: 17px; font-size: 1rem; }
    .resource-actions { gap: 5px 14px; margin-top: 20px; }
    .resource-primary { min-height: 46px; padding-inline: 15px; }
    .resource-secondary { min-height: 44px; }
    .resource-body { gap: 18px; margin-top: 46px; }
    .resource-toc ol { gap: 0 13px; }
    .resource-toc a { padding-block: 6px; font-size: .8125rem; }
    .resource-copy { font-size: 1rem; }
    .resource-copy :global(section + section) { margin-top: 46px; padding-top: 24px; }
    .resource-copy :global(h2) { font-size: 1.75rem; }
    .resource-copy :global(h3) { margin-top: 27px; font-size: 1.125rem; }
    .resource-copy :global(table) { font-size: .875rem; }
    .resource-copy :global(th), .resource-copy :global(td) { min-width: 125px; padding: 11px 12px; }
  }
</style>
