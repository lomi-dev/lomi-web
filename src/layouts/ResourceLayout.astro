---
import type { Landing } from '../../content/landing-schema';
import { activeLandingLinks } from '../data/navigation';
import { loadLanding } from '../../content/load-landing';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  summary: string;
  eyebrow?: string;
  breadcrumbs: { name: string; href: string }[];
  sections: { id: string; label: string }[];
  reviewedAt?: string;
}

const { title, description, heading, summary, eyebrow, breadcrumbs, sections, reviewedAt } = Astro.props;
const content = await loadLanding(import.meta.env.CMS_URL);
const footerContent: Landing['footer'] = {
  ...content.footer,
  groups: content.footer.groups.map((group) => ({
    ...group,
    links: activeLandingLinks(group.links, content.layout).map((link) => ({
      ...link,
      href: link.href.startsWith('#') ? `/${link.href}` : link.href,
    })),
  })).filter((group) => group.links.length > 0),
};
const reviewDate = reviewedAt ? new Date(`${reviewedAt}T12:00:00.000Z`) : undefined;
if (reviewDate && Number.isNaN(reviewDate.valueOf())) throw new TypeError('reviewedAt must be an ISO date.');
const publishedBreadcrumbs = breadcrumbs.at(-1)?.href === Astro.url.pathname
  ? breadcrumbs
  : [...breadcrumbs, { name: heading, href: Astro.url.pathname }];

---

<Layout
  title={title}
  description={description}
  website={content}
  themeColor={content.site.theme.paper}
  edgeColor="var(--color-lime)"
  article={reviewDate ? { modifiedTime: reviewDate.toISOString() } : undefined}
  breadcrumbs={publishedBreadcrumbs}
>
  <Header content={content.navigation} site={content.site} layout={content.layout} theme="light" />
  <main id="main" class="resource-page" tabindex="-1">
    <div class="resource-shell">
      <nav class="resource-breadcrumbs" aria-label="Breadcrumb">
        {publishedBreadcrumbs.map((item, index) => <Fragment>
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === publishedBreadcrumbs.length - 1
            ? <span aria-current="page">{item.name}</span>
            : <a href={item.href}>{item.name}</a>}
        </Fragment>)}
      </nav>

      <header class="resource-opening">
        {eyebrow && <p class="resource-eyebrow">{eyebrow}</p>}
        <h1>{heading}</h1>
        <p class="resource-summary">{summary}</p>
        {reviewDate && <p class="resource-reviewed">Reviewed <time datetime={reviewDate.toISOString()}>{reviewDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time> · Lomi team</p>}
        <div class="resource-actions">
          <a class="resource-primary" href="/download/">Download Lomi</a>
          <a class="resource-secondary" href="https://docs.lomi.dev/features/">Explore Lomi features</a>
        </div>
      </header>

      <div class="resource-body">
        <nav class="resource-toc" aria-label="On this page">
          <h2>On this page</h2>
          <ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}</ol>
        </nav>
        <article class="resource-copy"><slot /></article>
      </div>
    </div>
  </main>
  <Footer content={footerContent} site={content.site} layout={content.layout} />
</Layout>

<style>
  .resource-page { --scroll-surface-color: var(--color-paper); min-height: 70vh; padding: 0 0 clamp(64px, 9vw, 112px); background: var(--color-paper); color: var(--color-ink); overflow-wrap: break-word; }
  .resource-shell { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .resource-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding-top: 112px; color: var(--color-text-secondary); font-size: .75rem; line-height: 1.6; }
  .resource-breadcrumbs a { text-decoration-color: #9ba891; text-underline-offset: 3px; }
  .resource-breadcrumbs a:hover { color: var(--color-ink); }
  .resource-breadcrumbs [aria-current="page"] { color: var(--color-ink); }
  .resource-opening { max-width: 780px; padding-top: 48px; }
  .resource-eyebrow { margin: 0 0 16px; color: #56624e; font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .resource-opening h1 { max-width: 16ch; margin: 0; font-size: clamp(44px, 6.6vw, 76px); font-weight: 500; letter-spacing: -.055em; line-height: 1.06; text-wrap: balance; }
  .resource-summary { max-width: 66ch; margin: 22px 0 0; color: var(--color-text-secondary); font-size: clamp(1.0625rem, 1.5vw, 1.25rem); line-height: 1.65; text-wrap: pretty; }
  .resource-reviewed { margin: 18px 0 0; color: var(--color-text-secondary); font-size: .875rem; line-height: 1.6; }
  .resource-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 28px; }
  .resource-primary, .resource-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; }
  .resource-primary { padding-inline: 19px; border: 1px solid var(--color-ink); border-radius: 999px; background: var(--color-lime); color: var(--color-ink); font-size: .875rem; font-weight: 550; text-decoration: none; }
  .resource-primary:hover { background: var(--color-lime-hover); }
  .resource-secondary { color: #304719; font-size: .875rem; text-decoration-color: #a2b091; text-underline-offset: 4px; }
  .resource-body { display: grid; grid-template-columns: minmax(180px, 220px) minmax(0, 740px); justify-content: space-between; gap: clamp(48px, 7vw, 100px); margin-top: 84px; }
  .resource-toc { position: sticky; top: calc(var(--site-header-height) + 30px); align-self: start; padding-top: 16px; border-top: 1px solid var(--line); }
  .resource-toc h2 { margin: 0; font-size: .875rem; font-weight: 550; letter-spacing: -.01em; line-height: 1.6; }
  .resource-toc ol { display: grid; gap: 3px; margin: 16px 0 0; padding: 0; list-style: none; }
  .resource-toc a { display: block; padding: 8px 0; color: var(--color-text-secondary); font-size: .8125rem; line-height: 1.55; text-decoration: none; text-underline-offset: 4px; }
  .resource-toc a:hover { color: var(--color-ink); text-decoration: underline; }
  .resource-copy { min-width: 0; color: #293126; font-size: 1rem; line-height: 1.7; }
  .resource-copy :global(section + section) { margin-top: 66px; padding-top: 30px; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--site-header-height) + 24px); }
  .resource-copy :global(section) { scroll-margin-top: calc(var(--site-header-height) + 24px); }
  .resource-copy :global(h2) { max-width: 24ch; margin: 0; color: var(--color-ink); font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; text-wrap: balance; }
  .resource-copy :global(h3) { margin: 32px 0 10px; color: var(--color-ink); font-size: 1.25rem; font-weight: 550; letter-spacing: -.02em; line-height: 1.3; }
  .resource-copy :global(p) { max-width: 70ch; margin: 16px 0 0; text-wrap: pretty; }
  .resource-copy :global(ul), .resource-copy :global(ol) { display: grid; gap: 10px; margin: 18px 0 0; padding-left: 1.3em; }
  .resource-copy :global(li) { padding-left: .1em; }
  .resource-copy :global(li::marker) { color: #61754f; }
  .resource-copy :global(a) { color: #304719; text-decoration: underline; text-decoration-color: #a2b091; text-underline-offset: 3px; }
  .resource-copy :global(a:hover) { color: var(--color-ink); }
  .resource-copy :global(strong) { color: #20251d; font-weight: 600; }
  .resource-copy :global(code) { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .9em; overflow-wrap: anywhere; }
  .resource-copy :global(pre) { max-width: 100%; margin: 22px 0 0; padding: 18px; overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: #edf0e7; font-size: .8125rem; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
  .resource-copy :global(pre code) { font-size: inherit; }
  .resource-copy :global(.table-scroll) { max-width: 100%; margin-top: 22px; overflow-x: auto; border: 1px solid color-mix(in srgb, var(--line) 85%, transparent); border-radius: 9px; background: color-mix(in srgb, white 40%, var(--color-paper)); scrollbar-width: thin; }
  .resource-copy :global(table) { width: 100%; border-collapse: collapse; font-size: .875rem; line-height: 1.55; }
  .resource-copy :global(caption) { padding: 14px 16px; color: var(--color-text-secondary); font-size: .8125rem; text-align: start; }
  .resource-copy :global(th), .resource-copy :global(td) { min-width: 140px; padding: 13px 15px; border-top: 1px solid var(--line); text-align: start; vertical-align: top; }
  .resource-copy :global(th) { color: #384332; font-size: .75rem; font-weight: 600; letter-spacing: .025em; }
  .resource-copy :global(td:first-child) { color: var(--color-ink); font-weight: 550; }
  .resource-copy :global(.editorial-note) { margin-top: 26px; padding: 18px 20px; border: 1px solid color-mix(in srgb, var(--line) 85%, transparent); border-radius: 8px; background: color-mix(in srgb, var(--color-lime) 10%, var(--color-paper)); color: #394633; font-size: .9rem; }
  .resource-copy :global(.editorial-note p) { margin-top: 0; }
  .resource-copy :global(.editorial-note p + p) { margin-top: 12px; }
  .resource-copy :global(.source-list) { gap: 8px; font-size: .875rem; }

  @media (max-width: 999px) {
    .resource-shell { width: min(760px, calc(100% - 56px)); }
    .resource-opening { max-width: 700px; }
    .resource-opening h1 { max-width: 18ch; }
    .resource-body { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 62px; }
    .resource-toc { position: static; padding-top: 13px; }
    .resource-toc ol { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 8px; }
    .resource-toc a { min-height: 40px; }
  }
  @media (max-width: 767px) {
    .resource-page { padding-bottom: 62px; }
    .resource-shell { width: calc(100% - 40px); }
    .resource-breadcrumbs { padding-top: 100px; font-size: .6875rem; }
    .resource-opening { padding-top: 30px; }
    .resource-opening h1 { max-width: 14ch; font-size: clamp(2.625rem, 10vw, 3.625rem); letter-spacing: -.05em; }
    .resource-summary { margin-top: 17px; font-size: 1rem; }
    .resource-actions { gap: 5px 14px; margin-top: 20px; }
    .resource-primary { min-height: 46px; padding-inline: 15px; }
    .resource-secondary { min-height: 44px; }
    .resource-body { gap: 18px; margin-top: 46px; }
    .resource-toc ol { gap: 0 13px; }
    .resource-toc a { padding-block: 6px; font-size: .75rem; }
    .resource-copy { font-size: .9375rem; }
    .resource-copy :global(section + section) { margin-top: 46px; padding-top: 24px; }
    .resource-copy :global(h2) { font-size: 1.75rem; }
    .resource-copy :global(h3) { margin-top: 27px; font-size: 1.125rem; }
    .resource-copy :global(table) { font-size: .8125rem; }
    .resource-copy :global(th), .resource-copy :global(td) { min-width: 125px; padding: 11px 12px; }
  }
</style>
