---
import { activeLandingLinks } from '../../data/navigation';
import type { HeroProps } from './types';
interface Props extends HeroProps { class?: string }
const { content, layout, class: className = '', ...attributes } = Astro.props;
const primary = activeLandingLinks([{ label: content.primaryLabel, href: content.primaryHref }], layout)[0];
const secondary = activeLandingLinks([{ label: content.secondaryLabel, href: content.secondaryHref }], layout)[0];
---
<div {...attributes} class:list={['hero-actions', className]}>
  {primary && <a class="button button-primary hero-primary" href={primary.href}>{primary.label}<svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 14v3h12v-3" stroke="currentColor" stroke-width="1.4" /></svg></a>}
  {secondary && <a class="button button-secondary hero-secondary" href={secondary.href}>{secondary.label}</a>}
</div>
<style>
  .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:var(--hero-actions-gap,12px); }
  .hero-primary, .hero-secondary { gap:var(--hero-action-gap,12px); min-height:var(--hero-action-height,var(--button-height)); padding-inline:var(--hero-action-padding,20px); font-size:var(--hero-action-font-size,var(--button-font-size)); }
</style>
