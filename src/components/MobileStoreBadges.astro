---
---

<div class="mobile-store-badges">
  <div class="mobile-store-row" role="group" aria-label="App download availability">
    <button class="mobile-store-badge" type="button" disabled aria-label="Get it on Google Play. Coming soon." aria-describedby="mobile-store-coming-soon">
      <svg class="play-mark" viewBox="0 0 32 36" aria-hidden="true">
        <path d="M4 2.2c-.7.5-1 1.2-1 2.3v27c0 1.1.3 1.8 1 2.3L19 18 4 2.2Z" fill="currentColor" />
        <path d="m4 2.2 18.5 11.4-4.8 4.4L4 2.2Z" fill="#9696a2" />
        <path d="m4 33.8 18.5-11.4-4.8-4.4L4 33.8Z" fill="#6e6e7a" />
        <path d="m19 18 4.4-4.4 5.2 3c1.5.9 1.5 1.9 0 2.8l-5.2 3-4.4-4.4Z" fill="#4a4a54" />
      </svg>
      <span class="badge-copy"><span class="badge-overline">GET IT ON</span><span class="badge-store-name">Google Play</span></span>
    </button>
    <button class="mobile-store-badge" type="button" disabled aria-label="Download on the App Store. Coming soon." aria-describedby="mobile-store-coming-soon">
      <svg class="apple-mark" viewBox="0 0 32 38" aria-hidden="true">
        <path fill="currentColor" d="M24.9 20.2c0-4.1 3.3-6.1 3.5-6.2-1.9-2.8-4.8-3.2-5.8-3.2-2.5-.3-4.9 1.5-6.2 1.5-1.3 0-3.3-1.5-5.4-1.4-2.8 0-5.4 1.6-6.8 4.1-2.9 5.1-.7 12.5 2 16.5 1.4 2 2.9 4.2 5.1 4.1 2.1-.1 2.9-1.3 5.4-1.3s3.2 1.3 5.4 1.3c2.2 0 3.6-2 4.9-4.1a18.6 18.6 0 0 0 2.2-4.6c-.1 0-4.3-1.7-4.3-6.7ZM20.8 8c1.1-1.3 1.9-3.1 1.7-4.9-1.6.1-3.5 1-4.6 2.3-1 1.1-1.9 3-1.7 4.7 1.8.1 3.6-.9 4.6-2.1Z" />
      </svg>
      <span class="badge-copy"><span class="badge-overline">Download on the</span><span class="badge-store-name">App Store</span></span>
    </button>
  </div>
  <span class="sr-only" id="mobile-store-coming-soon">Coming soon</span>
</div>

<style>
  .mobile-store-badges { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .mobile-store-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .mobile-store-badge { display: inline-flex; align-items: center; gap: 10px; box-sizing: border-box; min-height: 48px; padding: 0 18px 0 14px; border: 1px solid var(--line-strong); border-radius: var(--button-radius); background: rgb(247 247 249 / .04); color: var(--color-text-secondary); text-align: left; opacity: 1; cursor: default; }
  .mobile-store-badge:disabled { opacity: 1; }
  .play-mark, .apple-mark { flex: none; width: 20px; height: 22px; }
  .badge-copy { display: flex; flex-direction: column; min-width: 0; }
  .badge-overline { color: var(--color-text-secondary); font-size: 10px; font-weight: 550; line-height: 1.2; letter-spacing: .035em; }
  .badge-store-name { color: var(--color-ink); font-size: 16px; font-weight: 600; line-height: 1.15; letter-spacing: -.02em; white-space: nowrap; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 767px) { .mobile-store-row { width: 100%; flex-wrap: nowrap; gap: 10px; } .mobile-store-badge { flex: 1 1 0; min-width: 0; padding-inline: 12px; } }
  @media (forced-colors: active) {
    .mobile-store-badge { border-color: ButtonText; background: ButtonFace; color: ButtonText; }
    .badge-overline, .badge-store-name { color: ButtonText; }
  }
</style>
