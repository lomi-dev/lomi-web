---
---

<div class="mobile-store-badges" aria-label="App download availability">
  <div class="mobile-store-badge-wrap">
    <button class="mobile-store-badge" type="button" disabled aria-label="Get it on Google Play. Coming soon." aria-describedby="mobile-play-coming-soon">
      <svg class="play-mark" viewBox="0 0 32 36" aria-hidden="true">
        <path d="M4 2.2c-.7.5-1 1.2-1 2.3v27c0 1.1.3 1.8 1 2.3L19 18 4 2.2Z" fill="currentColor" />
        <path d="m4 2.2 18.5 11.4-4.8 4.4L4 2.2Z" fill="#808680" />
        <path d="m4 33.8 18.5-11.4-4.8-4.4L4 33.8Z" fill="#626a63" />
        <path d="m19 18 4.4-4.4 5.2 3c1.5.9 1.5 1.9 0 2.8l-5.2 3-4.4-4.4Z" fill="#707770" />
      </svg>
      <span class="badge-copy"><span class="badge-overline">GET IT ON</span><span class="badge-store-name">Google Play</span></span>
    </button>
    <span class="mobile-store-coming-soon" id="mobile-play-coming-soon">Coming soon</span>
  </div>
  <div class="mobile-store-badge-wrap">
    <button class="mobile-store-badge" type="button" disabled aria-label="Download on the App Store. Coming soon." aria-describedby="mobile-app-store-coming-soon">
      <svg class="apple-mark" viewBox="0 0 32 38" aria-hidden="true">
        <path fill="currentColor" d="M24.9 20.2c0-4.1 3.3-6.1 3.5-6.2-1.9-2.8-4.8-3.2-5.8-3.2-2.5-.3-4.9 1.5-6.2 1.5-1.3 0-3.3-1.5-5.4-1.4-2.8 0-5.4 1.6-6.8 4.1-2.9 5.1-.7 12.5 2 16.5 1.4 2 2.9 4.2 5.1 4.1 2.1-.1 2.9-1.3 5.4-1.3s3.2 1.3 5.4 1.3c2.2 0 3.6-2 4.9-4.1a18.6 18.6 0 0 0 2.2-4.6c-.1 0-4.3-1.7-4.3-6.7ZM20.8 8c1.1-1.3 1.9-3.1 1.7-4.9-1.6.1-3.5 1-4.6 2.3-1 1.1-1.9 3-1.7 4.7 1.8.1 3.6-.9 4.6-2.1Z" />
      </svg>
      <span class="badge-copy"><span class="badge-overline">Download on the</span><span class="badge-store-name">App Store</span></span>
    </button>
    <span class="mobile-store-coming-soon" id="mobile-app-store-coming-soon">Coming soon</span>
  </div>
</div>

<style>
  .mobile-store-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 12px 14px;
    width: 100%;
    max-width: 382px;
    margin-inline: auto;
  }
  .mobile-store-badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex: 1 1 0;
  }
  .mobile-store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    box-sizing: border-box;
    width: 100%;
    min-height: 56px;
    padding: 7px 12px;
    border: 1px solid #c9cec7;
    border-radius: var(--button-radius);
    background: #e5e8e2;
    color: #424944;
    text-align: left;
    opacity: 1;
    cursor: not-allowed;
  }
  .mobile-store-badge:disabled { opacity: 1; }
  .mobile-store-badge:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  .play-mark { flex: 0 0 26px; width: 26px; height: 30px; }
  .apple-mark { flex: 0 0 25px; width: 25px; height: 30px; }
  .badge-copy { display: flex; flex-direction: column; min-width: 0; }
  .badge-overline { color: #59615b; font-size: 9px; font-weight: 550; line-height: 1.25; letter-spacing: .035em; }
  .badge-store-name { color: #313833; font-size: 17px; font-weight: 600; line-height: 1.12; letter-spacing: -.025em; white-space: nowrap; }
  .mobile-store-coming-soon { color: #60695f; font-size: 10px; line-height: 1.4; }
  @media (max-width: 359px) {
    .mobile-store-badges { gap: 9px; }
    .mobile-store-badge { min-height: 52px; gap: 7px; padding-inline: 8px; }
    .badge-store-name { font-size: 15px; }
    .play-mark, .apple-mark { flex-basis: 22px; width: 22px; height: 27px; }
  }
  @media (forced-colors: active) {
    .mobile-store-badge { border-color: ButtonText; background: ButtonFace; color: ButtonText; }
    .badge-overline, .badge-store-name, .mobile-store-coming-soon { color: ButtonText; }
  }
</style>
