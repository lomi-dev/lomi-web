---
import Icon from './Icon';
import { editorDefaults } from '../../content/editor-defaults';
import type { Landing } from '../../content/landing-schema';
interface Props { content?: Landing['site']['cookie'] }
const { content = editorDefaults.site.cookie } = Astro.props;
---

<div data-cookie-consent data-copy={JSON.stringify(content)}>
  <section class="cookie-banner" data-cookie-banner aria-labelledby="cookie-banner-title" hidden>
    <header class="cookie-heading">
      <h2 id="cookie-banner-title">{content.title}</h2>
      <button type="button" class="cookie-close" data-cookie-close aria-label={content.closeLabel} hidden><Icon name="close" width={18} height={18} /></button>
    </header>
    <p class="cookie-introduction">{content.introduction} <a href={content.informationHref}>{content.informationLabel}</a>{content.introductionSuffix}</p>

    <div class="cookie-compact" data-cookie-compact>
      <div class="cookie-actions">
        <button type="button" class="cookie-button cookie-customize" data-cookie-customize aria-expanded="false" aria-controls="cookie-preferences">{content.customizeLabel}</button>
        <button type="button" class="cookie-button cookie-primary" data-cookie-accept>{content.acceptLabel}</button>
      </div>
      <button type="button" class="cookie-reject" data-cookie-reject>{content.rejectLabel}</button>
    </div>

    <div id="cookie-preferences" class="cookie-preferences" role="region" aria-labelledby="cookie-banner-title" tabindex="-1" hidden>
      <form data-cookie-form>
        <div class="cookie-category">
          <div class="cookie-category-heading"><h3>{content.necessaryLabel}</h3><span class="cookie-necessary-switch" role="img" aria-label={content.alwaysOnLabel}><span></span></span></div>
          <p>{content.necessaryDescription}</p>
        </div>
        <div class="cookie-category">
          <label class="cookie-media-label" for="cookie-external-media"><span>{content.mediaLabel}</span><input id="cookie-external-media" type="checkbox" role="switch" aria-describedby="cookie-media-description" /></label>
          <p id="cookie-media-description">{content.mediaDescription}</p>
        </div>
        <p class="cookie-retention">{content.retention}</p>
        <button type="submit" class="cookie-button cookie-primary cookie-save" data-cookie-save>{content.saveLabel}</button>
        <button type="button" class="cookie-reject" data-cookie-reject>{content.rejectLabel}</button>
      </form>
    </div>
  </section>

  <div class="cookie-feedback" data-cookie-feedback hidden>
    <p role="status" aria-live="polite" data-cookie-message></p>
    <button type="button" class="cookie-close" data-cookie-message-close aria-label={content.dismissLabel}><Icon name="close" width={18} height={18} /></button>
  </div>
</div>

<script>
  import { initCookieConsent } from './cookie-consent';
  document.querySelectorAll<HTMLElement>('[data-cookie-consent]').forEach(initCookieConsent);
</script>

<style>
  .cookie-banner, .cookie-feedback { color: var(--color-ink); background: var(--color-paper); font-family: var(--font-sans); }
  .cookie-banner { position: fixed; z-index: 60; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); width: min(420px, calc(100% - 40px)); max-height: calc(100dvh - 40px); overflow: auto; overscroll-behavior: contain; padding: 24px 24px 12px; border: 1px solid #e5e8e1; border-radius: 16px; box-shadow: 0 12px 48px #13210d1f; }
  .cookie-banner[hidden], .cookie-feedback[hidden], .cookie-preferences[hidden], .cookie-compact[hidden], .cookie-close[hidden] { display: none; }
  .cookie-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 28px; }
  .cookie-heading h2 { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -.035em; line-height: 1.3; }
  .cookie-heading > .cookie-close { width: 44px; height: 44px; margin: -8px -8px -8px 0; }
  .cookie-introduction { margin-top: 14px; color: #535c56; font-size: 14px; line-height: 1.65; }
  .cookie-introduction a { color: #535c56; text-decoration: underline; text-decoration-color: #9aa392; text-underline-offset: 3px; }
  .cookie-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 20px; }
  .cookie-button { display: inline-flex; align-items: center; justify-content: center; min-width: 0; min-height: 46px; padding: 11px 12px; border: 1px solid #d8ddd2; border-radius: 9px; background: #f0f1ee; color: var(--color-ink); font: 500 13px/1.5 var(--font-sans); cursor: pointer; }
  .cookie-primary { border-color: var(--color-ink); background: var(--color-ink); color: #fff; }
  .cookie-reject { display: flex; align-items: center; justify-content: center; min-height: 44px; width: 100%; margin-top: 4px; padding: 8px 12px; border: 0; border-radius: 8px; background: transparent; color: #46533e; font: 500 12px/1.5 var(--font-sans); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .cookie-preferences { padding-top: 20px; }
  .cookie-preferences:focus { outline: none; }
  .cookie-category { padding: 12px 16px 16px; border-radius: 12px; background: #f7f8f5; }
  .cookie-category + .cookie-category { margin-top: 12px; }
  .cookie-category-heading, .cookie-media-label { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; }
  .cookie-category h3, .cookie-media-label { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.5; letter-spacing: -.01em; }
  .cookie-category > p { margin-top: 2px; color: #535c56; font-size: 13px; line-height: 1.65; }
  .cookie-media-label { cursor: pointer; }
  .cookie-media-label input, .cookie-necessary-switch { position: relative; appearance: none; flex-shrink: 0; width: 38px; height: 22px; margin: 0; border: 1px solid #b1b8aa; border-radius: 999px; background: #dce1d7; }
  .cookie-media-label input { border-color: #738067; background: #858d7e; cursor: pointer; }
  .cookie-media-label input::before, .cookie-necessary-switch > span { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--color-paper); content: ''; }
  .cookie-media-label input:checked, .cookie-necessary-switch { border-color: var(--color-ink); background: var(--color-ink); }
  .cookie-media-label input:checked::before, .cookie-necessary-switch > span { left: 18px; }
  .cookie-retention { margin-top: 16px; color: #535c56; font-size: 11px; line-height: 1.65; }
  .cookie-save { width: 100%; margin-top: 16px; }
  .cookie-close { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: #535c56; cursor: pointer; }
  .cookie-feedback { position: fixed; z-index: 62; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 12px; width: min(420px, calc(100% - 40px)); padding: 12px 12px 12px 20px; border: 1px solid #dfe4d8; border-radius: 12px; box-shadow: 0 12px 48px #13210d1f; }
  .cookie-feedback p { font-size: 12px; line-height: 1.6; }
  [data-cookie-consent] :focus-visible:not(.cookie-preferences) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (hover: hover) {
    .cookie-customize:hover, .cookie-close:hover { background: #e5e8e1; }
    .cookie-primary:hover { background: #26321d; border-color: #26321d; }
    .cookie-reject:hover { background: #f1f4eb; color: var(--color-ink); }
    .cookie-introduction a:hover { color: var(--color-ink); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cookie-button, .cookie-close, .cookie-reject { transition: background-color 150ms ease, border-color 150ms ease; }
    .cookie-media-label input::before { transition: left 150ms ease; }
  }
  @media (max-width: 479px) {
    .cookie-banner { right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom)); width: calc(100% - 24px); max-height: calc(100dvh - 24px); padding: 20px 20px 8px; }
    .cookie-feedback { right: 12px; bottom: 12px; width: calc(100% - 24px); }
    .cookie-button { padding-inline: 8px; }
  }
  @media (forced-colors: active) {
    .cookie-media-label input { appearance: auto; }
    .cookie-media-label input::before { display: none; }
    .cookie-necessary-switch { border-color: CanvasText; }
    .cookie-necessary-switch > span { background: CanvasText; }
    .cookie-button { border-color: ButtonText; }
  }
</style>
