---
import Icon from './Icon';
import { editorDefaults } from '../../content/editor-defaults';
import type { Landing } from '../../content/landing-schema';
interface Props { content?: Landing['site']['cookie'] }
const { content = editorDefaults.site.cookie } = Astro.props;
---

<div data-cookie-consent data-copy={JSON.stringify(content)}>
  <section class="cookie-banner" data-cookie-banner aria-labelledby="cookie-banner-title" hidden>
    <header class="cookie-heading">
      <h2 id="cookie-banner-title">{content.title}</h2>
      <button type="button" class="cookie-close" data-cookie-close aria-label={content.closeLabel} hidden><Icon name="close" width={18} height={18} /></button>
    </header>
    <p class="cookie-introduction">{content.introduction} <a href={content.informationHref}>{content.informationLabel}</a>{content.introductionSuffix}</p>

    <div class="cookie-compact" data-cookie-compact>
      <div class="cookie-actions">
        <button type="button" class="button button-secondary button-compact cookie-button cookie-customize" data-cookie-customize aria-expanded="false" aria-controls="cookie-preferences">{content.customizeLabel}</button>
        <button type="button" class="button button-primary button-compact cookie-button cookie-primary" data-cookie-accept>{content.acceptLabel}</button>
      </div>
      <button type="button" class="cookie-reject" data-cookie-reject>{content.rejectLabel}</button>
    </div>

    <div id="cookie-preferences" class="cookie-preferences" role="region" aria-labelledby="cookie-banner-title" tabindex="-1" hidden>
      <form data-cookie-form>
        <div class="cookie-category">
          <div class="cookie-category-heading"><h3>{content.necessaryLabel}</h3><span class="cookie-necessary-switch" role="img" aria-label={content.alwaysOnLabel}><span></span></span></div>
          <p>{content.necessaryDescription}</p>
        </div>
        <div class="cookie-category">
          <label class="cookie-media-label" for="cookie-external-media"><span>{content.mediaLabel}</span><input id="cookie-external-media" type="checkbox" role="switch" aria-describedby="cookie-media-description" /></label>
          <p id="cookie-media-description">{content.mediaDescription}</p>
        </div>
        <p class="cookie-retention">{content.retention}</p>
        <button type="submit" class="button button-primary button-compact cookie-button cookie-primary cookie-save" data-cookie-save>{content.saveLabel}</button>
        <button type="button" class="cookie-reject" data-cookie-reject>{content.rejectLabel}</button>
      </form>
    </div>
  </section>

  <div class="cookie-feedback" data-cookie-feedback hidden>
    <p role="status" aria-live="polite" data-cookie-message></p>
    <button type="button" class="cookie-close" data-cookie-message-close aria-label={content.dismissLabel}><Icon name="close" width={18} height={18} /></button>
  </div>
</div>

<script>
  import { initCookieConsent } from './cookie-consent';
  document.querySelectorAll<HTMLElement>('[data-cookie-consent]').forEach(initCookieConsent);
</script>

<style>
  .cookie-banner, .cookie-feedback { color: var(--color-ink); background: var(--color-paper); font-family: var(--font-sans); }
  .cookie-banner { position: fixed; z-index: 60; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); width: min(420px, calc(100% - 40px)); max-height: calc(100dvh - 40px); overflow: auto; overscroll-behavior: contain; padding: 24px 24px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-lg); box-shadow: 0 12px 48px rgb(0 0 0 / .5); }
  .cookie-banner[hidden], .cookie-feedback[hidden], .cookie-preferences[hidden], .cookie-compact[hidden], .cookie-close[hidden] { display: none; }
  .cookie-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 28px; }
  .cookie-heading h2 { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -.035em; line-height: 1.3; }
  .cookie-heading > .cookie-close { width: 44px; height: 44px; margin: -8px -8px -8px 0; }
  .cookie-introduction { margin-top: 14px; color: #bdbdc6; font-size: 14px; line-height: 1.65; }
  .cookie-introduction a { color: var(--color-violet-300); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 20px; }
  .cookie-button { min-height: 46px; padding-inline: 12px; }
  .cookie-reject { display: flex; align-items: center; justify-content: center; min-height: 44px; width: 100%; margin-top: 4px; padding: 8px 12px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-secondary); font: 500 12px/1.5 var(--font-mono); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .cookie-preferences { padding-top: 20px; }
  .cookie-preferences:focus { outline: none; }
  .cookie-category { padding: 12px 16px 16px; border-radius: var(--radius-md); background: var(--color-night-850); }
  .cookie-category + .cookie-category { margin-top: 12px; }
  .cookie-category-heading, .cookie-media-label { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; }
  .cookie-category h3, .cookie-media-label { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.5; letter-spacing: -.01em; }
  .cookie-category > p { margin-top: 2px; color: var(--color-text-secondary); font-size: 13px; line-height: 1.65; }
  .cookie-media-label { cursor: pointer; }
  .cookie-media-label input, .cookie-necessary-switch { position: relative; appearance: none; flex-shrink: 0; width: 38px; height: 22px; margin: 0; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--color-night-700); }
  .cookie-media-label input { cursor: pointer; }
  .cookie-media-label input::before, .cookie-necessary-switch > span { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--color-ink); content: ''; }
  .cookie-media-label input:checked, .cookie-necessary-switch { border-color: var(--color-lime); background: var(--color-lime); }
  .cookie-media-label input:checked::before, .cookie-necessary-switch > span { left: 18px; background: var(--on-accent); }
  .cookie-retention { margin-top: 16px; color: var(--color-text-secondary); font: 400 11px/1.65 var(--font-mono); }
  .cookie-save { width: 100%; margin-top: 16px; }
  .cookie-close { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-secondary); cursor: pointer; }
  .cookie-feedback { position: fixed; z-index: 62; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 12px; width: min(420px, calc(100% - 40px)); padding: 12px 12px 12px 20px; border: 1px solid var(--line-strong); border-radius: var(--radius-md); box-shadow: 0 12px 48px rgb(0 0 0 / .5); }
  .cookie-feedback p { font-size: 12px; line-height: 1.6; }
  [data-cookie-consent] :focus-visible:not(.cookie-preferences) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (hover: hover) {
    .cookie-close:hover { background: var(--color-night-800); color: var(--color-ink); }
    .cookie-reject:hover { background: var(--color-night-850); color: var(--color-ink); }
    .cookie-introduction a:hover { color: var(--color-ink); }
  }
  .cookie-close:active, .cookie-reject:active { background: var(--color-night-800); }
  @media (prefers-reduced-motion: no-preference) {
    .cookie-banner:not([hidden]), .cookie-feedback:not([hidden]) { animation: cookie-enter var(--dur-slow) var(--ease-out); }
    .cookie-close, .cookie-reject { transition: background-color var(--dur-fast) ease-out, color var(--dur-fast) ease-out, transform var(--dur) var(--ease-out); }
    .cookie-close:active, .cookie-reject:active { transform: scale(.97); transition-duration: 60ms; transition-timing-function: var(--ease-press); }
    .cookie-media-label input, .cookie-media-label input::before { transition: left var(--dur) var(--ease-out), background-color var(--dur-fast) ease-out, border-color var(--dur-fast) ease-out; }
  }
  @keyframes cookie-enter { from { opacity: 0; transform: translateY(12px); } }
  .cookie-banner[data-leaving] { opacity: 0; transform: translateY(8px); transition: opacity 200ms var(--ease-press), transform 200ms var(--ease-press); pointer-events: none; }
  @media (max-width: 479px) {
    .cookie-banner { right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom)); width: calc(100% - 24px); max-height: calc(100dvh - 24px); padding: 16px 16px 4px; }
    .cookie-heading h2 { font-size: 18px; }
    .cookie-introduction { margin-top: 8px; font-size: 13px; line-height: 1.55; }
    .cookie-actions { margin-top: 14px; }
    .cookie-button { min-height: 44px; }
    .cookie-feedback { right: 12px; bottom: 12px; width: calc(100% - 24px); }
    .cookie-button { padding-inline: 8px; }
  }
  @media (forced-colors: active) {
    .cookie-media-label input { appearance: auto; }
    .cookie-media-label input::before { display: none; }
    .cookie-necessary-switch { border-color: CanvasText; }
    .cookie-necessary-switch > span { background: CanvasText; }
    .cookie-button { border-color: ButtonText; }
  }
</style>
