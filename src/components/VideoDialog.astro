---
import MediaPlaceholder from './MediaPlaceholder.astro';
---

<dialog class="video-dialog" id="video-dialog" aria-label="Watch Lomi" aria-describedby="video-instructions" tabindex="0" autofocus>
  <p class="video-instructions" id="video-instructions">Press Escape to close, or click outside the video.</p>
  <div class="video-player" data-video-player data-video-status="loading" aria-busy="true">
    <div class="video-poster" data-video-poster aria-hidden="true">
      <MediaPlaceholder loading="eager" />
      <span class="video-loading" data-video-loading><span class="video-loading-ring"></span></span>
    </div>
    <div class="video-mount" data-video-mount inert></div>
    <section class="video-consent" data-video-consent aria-labelledby="video-consent-title" aria-describedby="video-consent-description" hidden>
      <span class="video-consent-eyebrow">External media</span>
      <h2 id="video-consent-title">Allow YouTube to play this video?</h2>
      <p id="video-consent-description">YouTube videos require your permission. Playing this video connects your browser to YouTube, which may store cookies and process your data.</p>
      <p class="video-consent-note">We remember your choice. You can change it anytime in Cookie settings.</p>
      <div class="video-consent-actions">
        <button type="button" class="video-consent-allow" data-video-allow>Allow YouTube &amp; play</button>
        <a data-video-external href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" rel="noopener noreferrer">Open on YouTube</a>
        <button type="button" data-video-decline>Not now</button>
      </div>
    </section>
  </div>
  <p class="video-consent-storage" data-video-consent-storage role="status" hidden>Your choice applies to this visit. Your browser couldn’t save it for next time.</p>
</dialog>

<script>
  import { hasMediaConsent, onConsentChange, saveConsent } from '../lib/consent';
  type YouTubePlayer = { mute: () => void; playVideo: () => void; destroy: () => void };
  type YouTubeEvent = { target: YouTubePlayer; data?: number };
  type YouTubeAPI = { Player: new (iframe: HTMLIFrameElement, options: {
    events: {
      onReady: (event: YouTubeEvent) => void;
      onStateChange: (event: YouTubeEvent) => void;
      onAutoplayBlocked: () => void;
      onError: () => void;
    };
  }) => YouTubePlayer };
  const youtubeWindow = window as Window & { YT?: YouTubeAPI; onYouTubeIframeAPIReady?: () => void };
  const dialog = document.querySelector<HTMLDialogElement>('#video-dialog');
  const player = dialog?.querySelector<HTMLElement>('[data-video-player]');
  const mount = dialog?.querySelector<HTMLElement>('[data-video-mount]');
  const consentGate = dialog?.querySelector<HTMLElement>('[data-video-consent]');
  const allowButton = dialog?.querySelector<HTMLButtonElement>('[data-video-allow]');
  const storageNotice = dialog?.querySelector<HTMLElement>('[data-video-consent-storage]');
  const externalLink = dialog?.querySelector<HTMLAnchorElement>('[data-video-external]');
  let apiScript: HTMLScriptElement | null = null;
  let cancelAPIRequest: (() => void) | null = null;
  let apiPromise: Promise<YouTubeAPI> | null = null;
  let youtubePlayer: YouTubePlayer | null = null;
  let playbackVersion = 0;
  let playbackTimeout = 0;
  let revealFrame = 0;
  let returnFocus: HTMLElement | null = null;
  let scrollPosition = { x: 0, y: 0 };
  let previousRootOverflow = '';
  let previousBodyOverflow = '';
  let backdropPointer = false;
  let motion: Animation | null = null;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // Load the official API only after an explicit external media choice. A failed
  // request can be retried on the next open without leaving a stale callback.
  function loadYouTubeAPI(version: number): Promise<YouTubeAPI> {
    if (!currentPlayback(version)) return Promise.reject(new Error('Media consent is required'));
    if (youtubeWindow.YT?.Player) return Promise.resolve(youtubeWindow.YT);
    if (apiPromise) return apiPromise;
    apiPromise = new Promise((resolve, reject) => {
      const previousReady = youtubeWindow.onYouTubeIframeAPIReady;
      const script = document.createElement('script');
      apiScript = script;
      let timeout = 0;
      const cleanup = () => {
        clearTimeout(timeout);
        cancelAPIRequest = null;
        script.onerror = null;
        if (youtubeWindow.onYouTubeIframeAPIReady === ready) youtubeWindow.onYouTubeIframeAPIReady = previousReady;
      };
      const fail = () => {
        cleanup();
        script.remove();
        apiPromise = null;
        reject(new Error('YouTube player API did not load'));
      };
      cancelAPIRequest = fail;
      const ready = () => {
        if (!currentPlayback(version)) { fail(); return; }
        cleanup();
        if (youtubeWindow.YT?.Player) resolve(youtubeWindow.YT);
        else fail();
        previousReady?.();
      };
      youtubeWindow.onYouTubeIframeAPIReady = ready;
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      script.onerror = fail;
      timeout = window.setTimeout(fail, 12000);
      document.head.append(script);
    });
    return apiPromise;
  }

  const currentPlayback = (version: number) => version === playbackVersion && hasMediaConsent() && dialog?.open && dialog.dataset.state !== 'closing';

  function revealPlayer(version: number, status: 'playing' | 'fallback') {
    if (!currentPlayback(version) || !player || !mount) return;
    clearTimeout(playbackTimeout);
    mount.inert = false;
    player.dataset.videoStatus = status;
    player.setAttribute('aria-busy', 'false');
  }

  function clearPlayback() {
    if (storageNotice) storageNotice.hidden = true;
    playbackVersion++;
    cancelAPIRequest?.();
    clearTimeout(playbackTimeout);
    cancelAnimationFrame(revealFrame);
    revealFrame = 0;
    const active = youtubePlayer;
    youtubePlayer = null;
    try { active?.destroy(); } catch { /* Removing the iframe below also stops playback. */ }
    mount?.replaceChildren();
    if (mount) mount.inert = true;
    if (player) {
      player.dataset.videoStatus = 'loading';
      player.setAttribute('aria-busy', 'true');
    }
  }

  function showConsentGate() {
    clearPlayback();
    if (player) {
      player.dataset.videoStatus = 'consent';
      player.setAttribute('aria-busy', 'false');
    }
    if (consentGate) consentGate.hidden = false;
    dialog?.setAttribute('aria-labelledby', 'video-consent-title');
    dialog?.setAttribute('aria-describedby', 'video-consent-description video-instructions');
  }

  function startPlayback() {
    if (!mount || !dialog?.open || dialog.dataset.state === 'closing') return;
    if (!hasMediaConsent()) { showConsentGate(); return; }
    if (consentGate) consentGate.hidden = true;
    dialog.removeAttribute('aria-labelledby');
    dialog.setAttribute('aria-describedby', 'video-instructions');
    clearPlayback();
    const version = playbackVersion;
    const iframe = document.createElement('iframe');
    iframe.id = 'lomi-youtube-player';
    iframe.title = 'Lomi video';
    const source = new URL('https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ');
    // Start through onReady, after mute(), to prevent an audible first frame.
    source.search = new URLSearchParams({ autoplay: '0', controls: '1', playsinline: '1', enablejsapi: '1', origin: location.origin }).toString();
    iframe.src = source.href;
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    mount.replaceChildren(iframe);
    // If playback is blocked or unavailable, make YouTube's native play/error
    // controls reachable rather than leaving the visitor behind a poster.
    playbackTimeout = window.setTimeout(() => revealPlayer(version, 'fallback'), 15000);
    void loadYouTubeAPI(version).then((api) => {
      if (!currentPlayback(version)) return;
      youtubePlayer = new api.Player(iframe, { events: {
        onReady: ({ target }) => {
          if (!currentPlayback(version)) return;
          target.mute();
          target.playVideo();
        },
        onStateChange: ({ data }) => {
          if (data !== 1 || !currentPlayback(version) || player?.dataset.videoStatus === 'playing') return;
          cancelAnimationFrame(revealFrame);
          // PLAYING is the documented playback signal. Give the embedded
          // document a paint opportunity before swapping the poster out.
          revealFrame = requestAnimationFrame(() => {
            if (!currentPlayback(version)) return;
            revealFrame = requestAnimationFrame(() => revealPlayer(version, 'playing'));
          });
        },
        onAutoplayBlocked: () => revealPlayer(version, 'fallback'),
        onError: () => revealPlayer(version, 'fallback'),
      } });
    }).catch(() => revealPlayer(version, 'fallback'));
  }

  // Sample the reference's unit-mass spring (stiffness 300, damping 30).
  // Normalize its response to land exactly at the requested duration's endpoint.
  const spring = (time: number) => 1 - Math.exp(-15 * time) * (
    Math.cos(Math.sqrt(75) * time) + 15 / Math.sqrt(75) * Math.sin(Math.sqrt(75) * time)
  );

  function animateDialog(closing: boolean) {
    if (!dialog) return;
    const reduced = reducedMotion.matches;
    const duration = reduced ? 100 : closing ? 220 : 300;
    // Read the in-flight presentation before canceling it, so a rapid Escape
    // reverses from the visible scale and opacity without jumping.
    const current = getComputedStyle(dialog);
    const fromScale = closing && current.transform !== 'none' ? new DOMMatrixReadOnly(current.transform).a : closing ? 1 : 0.5;
    const fromOpacity = closing ? Number(current.opacity) : 0;
    motion?.cancel();
    const toScale = closing ? 0.5 : 1;
    const toOpacity = closing ? 0 : 1;
    dialog.dataset.state = closing ? 'closing' : 'opening';
    if (typeof dialog.animate !== 'function') {
      if (closing) dialog.close();
      else dialog.dataset.state = 'open';
      return;
    }
    const frames: Keyframe[] = Array.from({ length: 31 }, (_, index) => {
      const offset = index / 30;
      const progress = reduced ? offset : spring(offset * duration / 1000) / spring(duration / 1000);
      return {
        offset,
        transform: reduced ? 'none' : `scale(${fromScale + (toScale - fromScale) * progress})`,
        opacity: fromOpacity + (toOpacity - fromOpacity) * progress,
      };
    });
    const active = dialog.animate(frames, { duration, easing: 'linear', fill: 'both' });
    motion = active;
    void active.finished.then(() => {
      if (motion !== active) return;
      if (closing) dialog.close();
      else {
        motion = null;
        active.cancel();
        dialog.dataset.state = 'open';
      }
    }).catch(() => { /* A close or reversal canceled this finite animation. */ });
  }

  function requestClose() {
    if (!dialog?.open || dialog.dataset.state === 'closing') return;
    // Stop playback as soon as closing is requested, while the native dialog
    // remains modal until its exit animation has finished.
    clearPlayback();
    animateDialog(true);
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-video-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!dialog || !player || !mount || typeof dialog.showModal !== 'function') return;
      if (dialog.open) {
        event.preventDefault();
        return;
      }
      returnFocus = trigger;
      if (externalLink) externalLink.href = trigger.href;
      scrollPosition = { x: scrollX, y: scrollY };
      // Stop an in-flight anchor or keyboard focus scroll before locking.
      window.scrollTo({ left: scrollPosition.x, top: scrollPosition.y, behavior: 'instant' });
      previousRootOverflow = document.documentElement.style.overflow;
      previousBodyOverflow = document.body.style.overflow;
      dialog.showModal();
      event.preventDefault();
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      animateDialog(false);
      startPlayback();
      if (!hasMediaConsent()) allowButton?.focus({ preventScroll: true });
    });
  });

  allowButton?.addEventListener('click', () => {
    if (!dialog?.open || dialog.dataset.state === 'closing') return;
    // Notifications are synchronous: the subscription never starts playback,
    // so this explicit action creates exactly one player.
    const { persisted } = saveConsent(true);
    startPlayback();
    if (storageNotice) storageNotice.hidden = persisted;
    dialog.focus({ preventScroll: true });
  });
  dialog?.querySelector('[data-video-decline]')?.addEventListener('click', requestClose);
  onConsentChange((choice) => {
    if (choice?.externalMedia) return;
    const hadPlayerFocus = !!mount?.contains(document.activeElement);
    clearPlayback();
    apiScript?.remove();
    apiScript = null;
    if (dialog?.open && dialog.dataset.state !== 'closing') {
      showConsentGate();
      if (hadPlayerFocus) allowButton?.focus({ preventScroll: true });
    }
  });

  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    requestClose();
  });
  const outsideDialog = (event: MouseEvent) => {
    if (!dialog || event.target !== dialog) return false;
    const bounds = dialog.getBoundingClientRect();
    return event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
  };
  dialog?.addEventListener('pointerdown', (event) => { backdropPointer = outsideDialog(event); });
  dialog?.addEventListener('click', (event) => {
    if (backdropPointer && outsideDialog(event)) requestClose();
    backdropPointer = false;
  });
  dialog?.addEventListener('close', () => {
    motion?.cancel();
    motion = null;
    delete dialog.dataset.state;
    clearPlayback();
    document.documentElement.style.overflow = previousRootOverflow;
    document.body.style.overflow = previousBodyOverflow;
    window.scrollTo({ left: scrollPosition.x, top: scrollPosition.y, behavior: 'instant' });
    returnFocus?.focus({ preventScroll: true });
    if (returnFocus?.isConnected) {
      const bounds = returnFocus.getBoundingClientRect();
      if (bounds.bottom <= 0 || bounds.top >= innerHeight || bounds.right <= 0 || bounds.left >= innerWidth) {
        returnFocus.scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'nearest' });
      }
    }
    returnFocus = null;
    backdropPointer = false;
  });
</script>

<style>
  .video-dialog { width: min(1080px, calc(100vw - 32px), calc((100dvh - 32px) * 16 / 9)); max-width: none; max-height: calc(100dvh - 32px); margin: auto; padding: 0; overflow: auto; overscroll-behavior: contain; border: 0; border-radius: 12px; background: #050705; color: #f0f4e9; box-shadow: 0 30px 100px #0008; }
  .video-dialog:focus { outline: none; }
  .video-dialog:focus-visible { outline: 2px solid #d5f8a8; outline-offset: 3px; }
  .video-dialog::backdrop { background: rgb(0 0 0 / 50%); backdrop-filter: blur(12px); opacity: 1; transition: opacity 300ms ease; }
  .video-dialog[data-state='closing']::backdrop { opacity: 0; transition-duration: 220ms; }
  @starting-style {
    .video-dialog[open]::backdrop { opacity: 0; }
  }
  .video-instructions { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .video-player { position: relative; width: 100%; min-width: 200px; min-height: 200px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: #050705; }
  .video-poster, .video-mount { position: absolute; inset: 0; transition: opacity 200ms ease; }
  .video-poster { pointer-events: none; }
  .video-poster :global(picture), .video-poster :global(img) { display: block; width: 100%; height: 100%; }
  .video-poster :global(img) { object-fit: cover; object-position: center; }
  .video-loading { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(5 7 5 / 16%); opacity: 0; transition: opacity 150ms ease; }
  .video-loading-ring { display: grid; width: 64px; height: 64px; place-items: center; border: 1px solid #ffffff26; border-radius: 50%; background: rgb(5 7 5 / 76%); box-shadow: 0 8px 24px #0003; }
  .video-loading-ring::after { content: ''; width: 25px; height: 25px; border: 2px solid #ffffff26; border-top-color: var(--color-lime); border-radius: 50%; animation: video-loading-spin 900ms linear infinite; animation-play-state: paused; }
  .video-dialog[open]:not([data-state='closing']) .video-player[data-video-status='loading'] .video-loading { opacity: 1; }
  .video-dialog[open]:not([data-state='closing']) .video-player[data-video-status='loading'] .video-loading-ring::after { animation-play-state: running; }
  @keyframes video-loading-spin { to { transform: rotate(360deg); } }
  .video-player[data-video-status='consent'] { aspect-ratio: auto; min-height: 0; }
  .video-player[data-video-status='consent'] .video-poster { opacity: 0.12; }
  .video-consent { position: relative; padding: clamp(24px, 5vw, 64px); }
  .video-consent[hidden], .video-consent-storage[hidden] { display: none; }
  .video-consent-storage { margin: 0; padding: 12px 20px; color: #b8c0b2; font-size: 14px; line-height: 1.5; }
  .video-consent-eyebrow { color: var(--color-lime); font-size: 13px; font-weight: 600; }
  .video-consent h2 { max-width: 560px; margin: 12px 0 16px; font-size: clamp(24px, 4vw, 36px); font-weight: 500; line-height: 1.15; letter-spacing: -0.04em; text-wrap: balance; }
  .video-consent p { max-width: 600px; margin: 0 0 16px; color: #f0f4e9; font-size: 16px; line-height: 1.6; }
  .video-consent .video-consent-note { color: #b8c0b2; font-size: 14px; }
  .video-consent-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
  .video-consent-actions :is(button, a) { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; padding: 10px 16px; border: 1px solid #f0f4e933; border-radius: 8px; background: #050705; color: #f0f4e9; font: inherit; font-size: 14px; font-weight: 500; line-height: 1.4; text-align: center; text-decoration: none; cursor: pointer; }
  .video-consent-actions .video-consent-allow { border-color: var(--color-lime); background: var(--color-lime); color: #152414; }
  .video-consent-actions :is(button, a):hover { border-color: #f0f4e9; }
  .video-consent-actions :is(button, a):focus-visible { outline: 2px solid var(--color-lime); outline-offset: 4px; }
  .video-mount { opacity: 0; pointer-events: none; }
  .video-player[data-video-status='playing'] .video-mount, .video-player[data-video-status='fallback'] .video-mount { opacity: 1; pointer-events: auto; }
  .video-player[data-video-status='playing'] .video-poster, .video-player[data-video-status='fallback'] .video-poster { opacity: 0; }
  .video-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  @media (max-height: 350px) {
    .video-dialog { width: min(640px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-dialog::backdrop, .video-dialog[data-state='closing']::backdrop { transition-duration: 100ms; }
    .video-loading-ring::after { animation: none; }
  }
</style>
