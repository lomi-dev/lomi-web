---
import { Picture } from 'astro:assets';
import ribbon from '../assets/hero/glass-ribbon.png';
---

<lomi-hero-backdrop class="hero-backdrop" aria-hidden="true">
  <div class="hero-backdrop-parallax">
    <div class="hero-backdrop-drift">
      <Picture src={ribbon} alt="" class="hero-backdrop-image" widths={[640, 960, 1280, 1536]}
        sizes="(min-width: 1200px) 130vw, 100vw" formats={['webp']} quality={82}
        loading="eager" fetchpriority="low" decoding="async" />
      <div class="hero-backdrop-reflection"></div>
    </div>
  </div>
</lomi-hero-backdrop>

<script>
  import { HeroBackdrop } from './hero-backdrop';
  if (!customElements.get('lomi-hero-backdrop')) customElements.define('lomi-hero-backdrop', HeroBackdrop);
</script>

<style>
  .hero-backdrop { display: block; position: absolute; z-index: 0; inset: 0; overflow: clip; pointer-events: none; user-select: none; }
  .hero-backdrop-parallax, .hero-backdrop-drift { width: 100%; height: 100%; }
  .hero-backdrop-drift { position: relative; transform-origin: 80% 45%; }
  .hero-backdrop-drift > :global(picture) { display: block; width: 100%; height: 100%; }
  .hero-backdrop :global(.hero-backdrop-image) {
    width: 100%; height: 100%; object-fit: cover; object-position: right center;
    transform: scale(1.3); transform-origin: right center;
  }
  .hero-backdrop-reflection {
    position: absolute; inset: 0; opacity: 0;
    background: linear-gradient(112deg, transparent 44%, rgb(255 255 255 / .8) 53%, transparent 62%);
    mix-blend-mode: soft-light;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-backdrop[data-motion] .hero-backdrop-drift {
      animation: glass-drift 24s ease-in-out infinite;
      animation-play-state: paused;
    }
    .hero-backdrop[data-motion] .hero-backdrop-reflection {
      animation: glass-reflection 18s ease-in-out infinite alternate;
      animation-play-state: paused;
    }
    .hero-backdrop[data-motion="running"] .hero-backdrop-drift,
    .hero-backdrop[data-motion="running"] .hero-backdrop-reflection { animation-play-state: running; }
  }
  @keyframes glass-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    40% { transform: translate3d(-6px, -10px, 0) rotate(-.3deg); }
    72% { transform: translate3d(4px, -4px, 0) rotate(.15deg); }
  }
  @keyframes glass-reflection {
    from { transform: translate3d(-8%, 0, 0); opacity: .15; }
    to { transform: translate3d(8%, 0, 0); opacity: .7; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop-parallax { transform: none !important; }
  }
  @media (min-width: 1200px) and (max-width: 1399px) {
    .hero-backdrop :global(.hero-backdrop-image) { transform: none; }
  }
  @media (max-width: 1199px) {
    .hero-backdrop {
      top: 55%;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 24%);
      mask-image: linear-gradient(to bottom, transparent, #000 24%);
    }
    .hero-backdrop :global(.hero-backdrop-image) { transform: none; object-position: 65% center; }
  }
</style>
