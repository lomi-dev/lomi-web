---
import { Picture } from 'astro:assets';
import darkHome from '../assets/product/mobile-app/workspace-home-dark.png';

interface Props { alt: string }
const { alt } = Astro.props;
---

{/* A real Lomi Mobile screen (786x1704), never a drawing of it. The hero crops its empty lower half. */}
<div class="stage" data-mobile-phone-preview>
  <div class="phone"><Picture src={darkHome} alt={alt} widths={[400, 600, 786]} sizes="(max-width: 767px) 78vw, 400px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" data-mobile-primary-preview /></div>
</div>

<style>
  /* The phone stands in the right column and runs past the bottom of the hero. */
  .stage { align-self: start; display: flex; justify-content: center; min-width: 0; height: 100%; padding-top: clamp(40px, 8svh, 96px); }
  .phone { flex: none; box-sizing: border-box; width: clamp(300px, min(30vw, 48svh), 420px); height: fit-content; padding: 11px; border-radius: 58px; background: #1f1f24; box-shadow: inset 0 0 0 1px rgb(247 247 249 / .1), 0 0 0 1px rgb(247 247 249 / .16), 0 0 0 10px rgb(247 247 249 / .03), 0 60px 140px -30px rgb(0 0 0 / .9), 0 0 140px -20px rgb(114 59 250 / .55); }
  .phone :global(img) { display: block; width: 100%; height: auto; border-radius: 47px; }

  @media (prefers-reduced-motion: no-preference) {
    .phone { animation: phone-in 1300ms var(--ease-out) 250ms both; }
  }
  @keyframes phone-in { from { opacity: 0; transform: translateY(90px); } }

  @media (max-width: 1023px) {
    .stage { height: clamp(420px, 110vw, 620px); padding-top: 0; overflow: hidden; -webkit-mask-image: linear-gradient(#000 65%, transparent); mask-image: linear-gradient(#000 65%, transparent); }
    .phone { width: min(340px, 78vw); box-shadow: inset 0 0 0 1px rgb(247 247 249 / .1), 0 0 0 1px rgb(247 247 249 / .16); }
  }
  @media (max-width: 767px) {
    .phone { padding: 8px; border-radius: 44px; }
    .phone :global(img) { border-radius: 36px; }
  }
  @media (forced-colors: active) { .phone { border: 1px solid CanvasText; } }
</style>
