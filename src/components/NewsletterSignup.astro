---
import { editorDefaults } from '../../content/editor-defaults';
import type { Landing } from '../../content/landing-schema';
interface Props { content?: Landing['newsletter']['form']; showNote?: boolean; class?: string }
const { content = editorDefaults.newsletter.form, showNote = true, class: className, ...attributes } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
if (endpoint) {
  const url = new URL(endpoint);
  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash ||
      url.pathname !== '/v1/newsletter/subscribe' || url.toString() !== endpoint) {
    throw new Error('Invalid PUBLIC_NEWSLETTER_ENDPOINT');
  }
}
const isConfigured = Boolean(endpoint);
---

<lomi-newsletter-signup {...attributes} class={className}>
<section class="newsletter" data-state={isConfigured ? 'idle' : 'unavailable'} aria-label={content.ariaLabel}>
  <form id="newsletter-form" data-endpoint={endpoint} data-copy={JSON.stringify(content)} aria-busy="false">
    <label for="newsletter-email">{content.emailLabel}</label>
    <div class="newsletter-controls">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder={content.placeholder}
        maxlength="254"
        required
        disabled
        aria-describedby={showNote ? 'newsletter-status newsletter-note' : 'newsletter-status'}
      />
      <button class="button button-primary" type="submit" disabled>
        <span data-submit-label>{content.submitLabel}</span>
        <span class="newsletter-submit-icon" aria-hidden="true">
          <svg class="newsletter-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-6-7 7 7-7 7" /></svg>
          <svg class="newsletter-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>
        </span>
      </button>
    </div>
    <p id="newsletter-status" class="newsletter-status" role="status" aria-live="polite" aria-atomic="true">
      {!isConfigured && content.unavailableMessage}
    </p>
  </form>
  {showNote && <p class="newsletter-note" id="newsletter-note">{content.note}</p>}
  <noscript><p class="newsletter-noscript">{content.noscript}</p></noscript>
</section>
</lomi-newsletter-signup>

<script>
  import { NewsletterSignupElement } from './newsletter-signup';
  if (!customElements.get('lomi-newsletter-signup')) customElements.define('lomi-newsletter-signup', NewsletterSignupElement);
</script>

<style>
  lomi-newsletter-signup { display:block; min-width:0; width:100%; }
  .newsletter {
    width: 100%;
    min-width: 0;
    margin: 0;
    color: var(--color-ink);
    text-align: left;
  }
  .newsletter form { margin: 0; }
  .newsletter label {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--nl-label-ink, var(--color-text-secondary));
  }
  .newsletter-controls { display: grid; grid-template-columns:var(--nl-controls-columns,minmax(0,1fr)); gap:var(--nl-control-gap,8px); }
  .newsletter input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid var(--nl-field-border,var(--line-strong));
    border-radius: var(--radius-md);
    background: var(--nl-field-bg,var(--color-night-850));
    color: var(--nl-field-ink,var(--color-ink));
    font: inherit;
    font-size: var(--nl-field-size,16px);
    line-height: 1.5;
  }
  .newsletter input::placeholder { color: var(--color-text-secondary); opacity: 1; }
  .newsletter button {
    width: 100%;
    min-width: 148px;
  }
  .newsletter-submit-icon { display: grid; flex: 0 0 20px; }
  .newsletter-submit-icon > svg { grid-area: 1 / 1; transition: opacity var(--dur) ease-out, transform var(--dur) var(--ease-out); }
  .newsletter-check { opacity: 0; transform: translateY(4px); }
  .newsletter[data-state="success"] .newsletter-arrow { opacity: 0; transform: translateY(-4px); }
  .newsletter[data-state="success"] .newsletter-check { opacity: 1; transform: none; }
  /* Label and status text are swapped by script; a changing animation name replays the fade on each state. */
  .newsletter[data-state="pending"] [data-submit-label] { animation: nl-fade-a var(--dur) ease-out; }
  .newsletter[data-state="success"] [data-submit-label] { animation: nl-fade-b var(--dur) ease-out; }
  .newsletter[data-state="error"] [data-submit-label] { animation: nl-fade-c var(--dur) ease-out; }
  .newsletter-status[data-state="pending"] { animation: nl-rise-a var(--dur-slow) var(--ease-out); }
  .newsletter-status[data-state="success"] { animation: nl-rise-b var(--dur-slow) var(--ease-out); }
  .newsletter-status[data-state="error"] { animation: nl-rise-c var(--dur-slow) var(--ease-out); }
  @keyframes nl-fade-a { from { opacity: 0; } }
  @keyframes nl-fade-b { from { opacity: 0; } }
  @keyframes nl-fade-c { from { opacity: 0; } }
  @keyframes nl-rise-a { from { opacity: 0; transform: translateY(4px); } }
  @keyframes nl-rise-b { from { opacity: 0; transform: translateY(4px); } }
  @keyframes nl-rise-c { from { opacity: 0; transform: translateY(4px); } }
  @media (hover: hover) { .newsletter input:not(:disabled):not(:focus-visible):hover { border-color: var(--color-night-600); } }
  @media (prefers-reduced-motion: reduce) {
    .newsletter [data-submit-label], .newsletter-status { animation: none !important; }
    .newsletter-submit-icon > svg { transform: none !important; transition: none; }
  }
  .newsletter input:disabled { color: var(--color-text-secondary); cursor: default; opacity: 1; }
  .newsletter input:focus-visible { outline: 2px solid var(--color-violet-300); outline-offset: 2px; border-color: var(--color-violet-300); }
  .newsletter-status {
    min-height: 3em;
    margin: 8px 0 0;
    color: var(--color-text-secondary);
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .newsletter-status[data-state="success"] { color: var(--color-success); }
  .newsletter-status[data-state="error"] { color: var(--color-danger); }
  .newsletter-note {
    margin: 4px 0 0;
    color: var(--color-text-secondary);
    font-size: var(--nl-note-size,11px);
    line-height: 1.6;
    text-align: var(--nl-note-align,center);
    text-wrap: balance;
  }
  .newsletter-noscript { margin: 12px 0 0; font-size: 12px; line-height: 1.5; }

</style>
