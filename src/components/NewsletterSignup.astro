---
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
if (endpoint) {
  const url = new URL(endpoint);
  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash ||
      url.pathname !== '/v1/newsletter/confirmation' || url.toString() !== endpoint) {
    throw new Error('Invalid PUBLIC_NEWSLETTER_ENDPOINT');
  }
}
const isConfigured = Boolean(endpoint);
---

<section class="newsletter" aria-label="Newsletter signup">
  <form id="newsletter-form" data-endpoint={endpoint}>
    <label for="newsletter-email">Email address</label>
    <div class="newsletter-controls">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        maxlength="254"
        required
        disabled
      />
      <button type="submit" disabled>Subscribe</button>
    </div>
    <p id="newsletter-status" class="newsletter-status" role="status" aria-live="polite">
      {!isConfigured && 'Newsletter signup is temporarily unavailable.'}
    </p>
  </form>
  <p class="newsletter-note">Confirm by email to receive occasional updates. Unsubscribe anytime.</p>
</section>

<noscript><p class="newsletter-noscript">Enable JavaScript to subscribe to the newsletter.</p></noscript>

<script>
  const form = document.querySelector<HTMLFormElement>('#newsletter-form');
  const emailInput = document.querySelector<HTMLInputElement>('#newsletter-email');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const status = document.querySelector<HTMLElement>('#newsletter-status');
  const endpoint = form?.dataset.endpoint;

  emailInput?.addEventListener('input', () => {
    if (status?.dataset.state) {
      status.textContent = '';
      status.removeAttribute('data-state');
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailInput || !submitButton || !status || submitButton.disabled || !form.reportValidity() || !endpoint) return;

    const email = emailInput.value.trim();
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';
    status.removeAttribute('data-state');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        credentials: 'omit',
        redirect: 'error',
        signal: AbortSignal.timeout(10000),
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (response.status !== 202 || (await response.json()).accepted !== true) {
        throw new Error('Confirmation request unavailable');
      }

      form.reset();
      status.textContent = 'Check your inbox to confirm your subscription.';
      status.dataset.state = 'success';
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.dataset.state = 'error';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Subscribe';
    }
  });

  if (endpoint && emailInput && submitButton) {
    emailInput.disabled = false;
    submitButton.disabled = false;
  }
</script>

<style>
  .newsletter {
    width: min(100%, 510px);
    margin: 26px auto 0;
    text-align: center;
  }
  .newsletter form { margin: 0; }
  .newsletter label { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 500; text-align: left; }
  .newsletter-controls { display: flex; gap: 8px; }
  .newsletter input {
    min-width: 0;
    flex: 1;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid #a9b0a8;
    border-radius: 9px;
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 14px;
  }
  .newsletter input::placeholder { color: #68716a; }
  .newsletter button {
    min-height: 48px;
    padding: 0 19px;
    border: 1px solid var(--color-ink);
    border-radius: 9px;
    background: var(--color-lime);
    color: var(--color-ink);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .newsletter button:active { background: var(--color-lime-pressed); }
  .newsletter button:disabled { cursor: wait; opacity: .65; }
  .newsletter input:disabled { background: #f2f3ef; }
  .newsletter input:focus-visible, .newsletter button:focus-visible { outline-offset: 3px; }
  .newsletter-status { min-height: 16px; margin-top: 5px; font-size: 12px; line-height: 1.5; }
  .newsletter-status:empty { display: none; }
  .newsletter-status[data-state="success"] { color: #245a3b; }
  .newsletter-status[data-state="error"] { color: #a02424; }
  .newsletter-note { margin-top: 10px; color: var(--color-text-secondary); font-size: 12px; line-height: 1.6; }
  .newsletter-noscript { text-align: center; font-size: 12px; }

  @media (hover: hover) and (pointer: fine) {
    .newsletter button:not(:disabled):hover { background: var(--color-lime-hover); }
  }
  @media (max-width: 460px) {
    .newsletter { margin-top: 24px; }
    .newsletter-controls { flex-direction: column; }
    .newsletter input { flex: auto; width: 100%; }
  }
  @media (max-height: 600px) and (min-width: 601px) {
    .newsletter { margin-top: 18px; }
  }
</style>
