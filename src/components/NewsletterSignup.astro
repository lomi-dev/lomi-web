---
import { editorDefaults } from '../../content/editor-defaults';
import type { Landing } from '../../content/landing-schema';
interface Props { content?: Landing['newsletter']['form']; showNote?: boolean; class?: string }
const { content = editorDefaults.newsletter.form, showNote = true, class: className, ...attributes } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
if (endpoint) {
  const url = new URL(endpoint);
  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash ||
      url.pathname !== '/v1/newsletter/subscribe' || url.toString() !== endpoint) {
    throw new Error('Invalid PUBLIC_NEWSLETTER_ENDPOINT');
  }
}
const isConfigured = Boolean(endpoint);
---

<lomi-newsletter-signup {...attributes} class={className}>
<section class="newsletter" data-state={isConfigured ? 'idle' : 'unavailable'} aria-label={content.ariaLabel}>
  <form id="newsletter-form" data-endpoint={endpoint} data-copy={JSON.stringify(content)} aria-busy="false">
    <label for="newsletter-email">{content.emailLabel}</label>
    <div class="newsletter-controls">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder={content.placeholder}
        maxlength="254"
        required
        disabled
        aria-describedby={showNote ? 'newsletter-status newsletter-note' : 'newsletter-status'}
      />
      <button type="submit" disabled>
        <span data-submit-label>{content.submitLabel}</span>
        <span class="newsletter-submit-icon" aria-hidden="true">
          <svg class="newsletter-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-6-7 7 7-7 7" /></svg>
          <svg class="newsletter-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>
        </span>
      </button>
    </div>
    <p id="newsletter-status" class="newsletter-status" role="status" aria-live="polite" aria-atomic="true">
      {!isConfigured && content.unavailableMessage}
    </p>
  </form>
  {showNote && <p class="newsletter-note" id="newsletter-note">{content.note}</p>}
  <noscript><p class="newsletter-noscript">{content.noscript}</p></noscript>
</section>
</lomi-newsletter-signup>

<script>
  import { NewsletterSignupElement } from './newsletter-signup';
  if (!customElements.get('lomi-newsletter-signup')) customElements.define('lomi-newsletter-signup', NewsletterSignupElement);
</script>

<style>
  lomi-newsletter-signup { display:block; min-width:0; width:100%; }
  .newsletter {
    width: 100%;
    min-width: 0;
    margin: 0;
    color: var(--color-ink);
    text-align: left;
  }
  .newsletter form { margin: 0; }
  .newsletter label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--nl-label-ink, inherit);
  }
  .newsletter-controls { display: grid; grid-template-columns:var(--nl-controls-columns,minmax(0,1fr)); gap:var(--nl-control-gap,8px); }
  .newsletter input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 56px;
    padding: 14px 16px;
    border: 1px solid var(--nl-field-border,#adb79f);
    border-radius: var(--nl-field-radius,10px);
    background: var(--nl-field-bg,#f5f6ef);
    color: var(--nl-field-ink,var(--color-ink));
    font: inherit;
    font-size: var(--nl-field-size,16px);
    line-height: 1.5;
  }
  .newsletter input::placeholder { color: #62695b; opacity: 1; }
  .newsletter button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-sizing: border-box;
    width: 100%;
    min-height: 52px;
    padding: 13px 20px;
    border: 1px solid var(--nl-button-bg,var(--color-ink));
    border-radius: var(--nl-button-radius,999px);
    background: var(--nl-button-bg,var(--color-ink));
    color: var(--nl-button-ink,var(--color-lime));
    font: inherit;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 500;
    cursor: pointer;
  }
  .newsletter-submit-icon { display: flex; flex: 0 0 20px; }
  .newsletter-check { display: none; }
  .newsletter[data-state="success"] .newsletter-arrow { display: none; }
  .newsletter[data-state="success"] .newsletter-check { display: block; }
  .newsletter button:not(:disabled):active { background:var(--nl-button-active,var(--nl-button-bg,#30362c)); }
  .newsletter button:disabled { cursor: not-allowed; background:var(--nl-disabled-bg,#30362c); border-color:var(--nl-disabled-bg,#30362c); color:var(--nl-disabled-ink,var(--nl-button-ink,var(--color-lime))); }
  .newsletter input:disabled { color: #62695b; cursor: not-allowed; opacity: 1; }
  .newsletter input:focus-visible,
  .newsletter button:focus-visible { outline: 2px solid #476c16; outline-offset: 4px; }
  .newsletter-status {
    min-height: 3em;
    margin: 8px 0 0;
    color: #525b4a;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .newsletter-status[data-state="success"] { color: #245a3b; }
  .newsletter-status[data-state="error"] { color: #a02424; }
  .newsletter-note {
    margin: 4px 0 0;
    color: #62695b;
    font-size: var(--nl-note-size,11px);
    line-height: 1.6;
    text-align: var(--nl-note-align,center);
    text-wrap: balance;
  }
  .newsletter-noscript { margin: 12px 0 0; font-size: 12px; line-height: 1.5; }

  @media (hover: hover) and (pointer: fine) {
    .newsletter button:not(:disabled):hover { background:var(--nl-button-hover,var(--nl-button-bg,#272e22)); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .newsletter button { transition: background-color 160ms ease, transform 160ms ease; }
    .newsletter button:not(:disabled):active { transform: translateY(1px); }
  }
</style>
