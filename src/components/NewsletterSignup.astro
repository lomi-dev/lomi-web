---
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
if (endpoint) {
  const url = new URL(endpoint);
  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash ||
      url.pathname !== '/v1/newsletter/subscribe' || url.toString() !== endpoint) {
    throw new Error('Invalid PUBLIC_NEWSLETTER_ENDPOINT');
  }
}
const isConfigured = Boolean(endpoint);
---

<section class="newsletter" data-state={isConfigured ? 'idle' : 'unavailable'} aria-label="Newsletter signup">
  <form id="newsletter-form" data-endpoint={endpoint} aria-busy="false">
    <label for="newsletter-email">Email address</label>
    <div class="newsletter-controls">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        maxlength="254"
        required
        disabled
        aria-describedby="newsletter-status newsletter-note"
      />
      <button type="submit" disabled>
        <span data-submit-label>Keep me posted</span>
        <span class="newsletter-submit-icon" aria-hidden="true">
          <svg class="newsletter-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15m-6-7 7 7-7 7" /></svg>
          <svg class="newsletter-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>
        </span>
      </button>
    </div>
    <p id="newsletter-status" class="newsletter-status" role="status" aria-live="polite" aria-atomic="true">
      {!isConfigured && 'Newsletter signup is temporarily unavailable.'}
    </p>
  </form>
  <p class="newsletter-note" id="newsletter-note">Occasional updates. Unsubscribe anytime.</p>
  <noscript><p class="newsletter-noscript">Enable JavaScript to subscribe to the newsletter.</p></noscript>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#newsletter-form');
  const newsletter = form?.closest<HTMLElement>('.newsletter');
  const emailInput = document.querySelector<HTMLInputElement>('#newsletter-email');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.querySelector<HTMLElement>('[data-submit-label]');
  const status = document.querySelector<HTMLElement>('#newsletter-status');
  const endpoint = form?.dataset.endpoint;

  function setState(state: 'idle' | 'pending' | 'success' | 'error', message = '') {
    if (!form || !newsletter || !emailInput || !submitButton || !submitLabel || !status) return;
    newsletter.dataset.state = state;
    status.dataset.state = state;
    status.textContent = message;
    form.setAttribute('aria-busy', String(state === 'pending'));
    emailInput.disabled = state === 'pending';
    submitButton.disabled = state === 'pending';
    submitLabel.textContent = state === 'pending' ? 'Subscribing…' : state === 'success' ? 'Subscribed' : 'Keep me posted';
  }

  emailInput?.addEventListener('input', () => {
    if (endpoint && newsletter?.dataset.state !== 'pending') setState('idle');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailInput || !submitButton || !status || submitButton.disabled || !form.reportValidity() || !endpoint) return;

    const email = emailInput.value.trim();
    setState('pending', 'Sending your signup…');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        credentials: 'omit',
        redirect: 'error',
        signal: AbortSignal.timeout(10000),
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (response.status === 429) {
        setState('error', 'Too many attempts. Please wait a moment and try again.');
        return;
      }
      if (response.status !== 202 || (await response.json()).accepted !== true) {
        throw new Error('Signup request unavailable');
      }

      form.reset();
      setState('success', 'You’re on the list. Thanks for joining!');
    } catch {
      setState('error', 'We couldn’t complete your signup. Please try again.');
    }
  });

  if (endpoint) setState('idle');
</script>

<style>
  .newsletter {
    width: 100%;
    min-width: 0;
    margin: 0;
    color: #0b0d0c;
    text-align: left;
  }
  .newsletter form { margin: 0; }
  .newsletter label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
  }
  .newsletter-controls { display: grid; gap: 8px; }
  .newsletter input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 56px;
    padding: 14px 16px;
    border: 1px solid #adb79f;
    border-radius: 10px;
    background: #f5f6ef;
    color: #0b0d0c;
    font: inherit;
    font-size: 16px;
    line-height: 1.5;
  }
  .newsletter input::placeholder { color: #62695b; opacity: 1; }
  .newsletter button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-sizing: border-box;
    width: 100%;
    min-height: 52px;
    padding: 13px 20px;
    border: 1px solid #0b0d0c;
    border-radius: 999px;
    background: #0b0d0c;
    color: #c8ff3d;
    font: inherit;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 500;
    cursor: pointer;
  }
  .newsletter-submit-icon { display: flex; flex: 0 0 20px; }
  .newsletter-check { display: none; }
  .newsletter[data-state="success"] .newsletter-arrow { display: none; }
  .newsletter[data-state="success"] .newsletter-check { display: block; }
  .newsletter button:not(:disabled):active { background: #30362c; }
  .newsletter button:disabled { cursor: not-allowed; background: #30362c; border-color: #30362c; }
  .newsletter input:disabled { color: #62695b; cursor: not-allowed; opacity: 1; }
  .newsletter input:focus-visible,
  .newsletter button:focus-visible { outline: 2px solid #476c16; outline-offset: 4px; }
  .newsletter-status {
    min-height: 3em;
    margin: 8px 0 0;
    color: #525b4a;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .newsletter-status[data-state="success"] { color: #245a3b; }
  .newsletter-status[data-state="error"] { color: #a02424; }
  .newsletter-note {
    margin: 4px 0 0;
    color: #62695b;
    font-size: 11px;
    line-height: 1.6;
    text-align: center;
    text-wrap: balance;
  }
  .newsletter-noscript { margin: 12px 0 0; font-size: 12px; line-height: 1.5; }

  @media (hover: hover) and (pointer: fine) {
    .newsletter button:not(:disabled):hover { background: #272e22; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .newsletter button { transition: background-color 160ms ease, transform 160ms ease; }
    .newsletter button:not(:disabled):active { transform: translateY(1px); }
  }
</style>
