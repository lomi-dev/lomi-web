---
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import { editorDefaults } from '../../content/editor-defaults';
import { resolveMedia } from '../../content/editor-schema';
import { activeLandingLinks } from '../data/navigation';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['navigation']; site?: Landing['site']; layout?: Landing['layout']; theme?: 'light' | 'dark' }
const { content, theme, site = editorDefaults.site, layout = editorDefaults.layout } = Astro.props;
const navigationLinks = activeLandingLinks(content.links, layout);
const brandLogo = resolveMedia(site.brand.logo, import.meta.env.CMS_URL);
const isHome = Astro.url.pathname === '/';
const homeHref = (href: string) => href.startsWith('#') && !isHome ? `/${href}` : href;
const isPageLink = (href: string) => {
  const target = new URL(homeHref(href), Astro.url);
  return !target.hash || target.origin !== Astro.url.origin || target.pathname !== Astro.url.pathname;
};
const productGroups = content.productGroups.map((group) => ({ ...group, links: activeLandingLinks(group.links, layout) })).filter((group) => group.links.length);
const productHref = productGroups[0]?.links[0]?.href ?? '/';
const action = activeLandingLinks([{ label: content.actionLabel, href: content.actionHref }], layout)[0];
---

<header class="site-header" data-theme={theme ?? (isHome ? 'light' : 'dark')}>
  <div class="navigation-backdrop" aria-hidden="true"></div>
  <div class="header-inner shell">
    <a class="wordmark" href={isHome ? '#top' : '/'} aria-label={site.brand.logoAlt}>{brandLogo ? <img src={brandLogo.url} alt={site.brand.logoAlt} /> : <Fragment set:html={logo} />}</a>
    <nav class="desktop-navigation" aria-label={content.primaryAriaLabel}>
      {productGroups.length > 0 && <><a class="product-fallback" href={homeHref(productHref)}>{content.productLabel}{isPageLink(productHref) && <Icon name="diagonal" width={13} height={13} />}</a>
      <details class="product-menu" id="product-menu">
        <summary>{content.productLabel}<svg class="menu-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
        <div class="product-panel">
          <div class="product-panel-inner">
            {productGroups.map((group) => <div class="product-group"><p class="product-group-label">{group.label}</p>{group.links.map((link) => <a class="product-link" href={homeHref(link.href)} aria-current={link.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined}><span class="product-link-title">{link.label}</span>{isPageLink(link.href) && <Icon name="diagonal" width={14} height={14} />}</a>)}</div>)}
          </div>
        </div>
      </details></>}
      {navigationLinks.map((link) => <a class="navigation-link" href={homeHref(link.href)} aria-current={link.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined}>{link.label}{isPageLink(link.href) && <Icon name="diagonal" width={13} height={13} />}</a>)}
    </nav>
    <div class="header-actions">
      <a class="header-source" href={site.githubUrl} aria-label={content.sourceAriaLabel}><Icon name="github" width={17} height={17} /><span>{content.sourceLabel}</span><Icon name="diagonal" width={13} height={13} /></a>
      {action && <a class="header-action" href={homeHref(action.href)}>{action.label}<Icon name="diagonal" width={16} height={16} /></a>}
    </div>
    <details class="mobile-navigation" id="mobile-navigation">
      <summary><span>{content.menuLabel}</span><span class="menu-symbol" aria-hidden="true"></span></summary>
      <nav class="mobile-panel" aria-label={content.mobileAriaLabel}>
        {productGroups.length > 0 && <details class="mobile-product" id="mobile-product">
          <summary><span class="mobile-product-enter">{content.productLabel}<Icon name="arrow" width={17} height={17} /></span><span class="mobile-product-back"><Icon name="arrow" width={16} height={16} />{content.backLabel}</span></summary>
          <div class="mobile-product-panel">
            {productGroups.map((group) => <div class="product-group"><p class="product-group-label">{group.label}</p>{group.links.map((link) => <a class="product-link" href={homeHref(link.href)} aria-current={link.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined}><span class="product-link-title">{link.label}</span>{isPageLink(link.href) && <Icon name="diagonal" width={14} height={14} />}</a>)}</div>)}
          </div>
        </details>}
        {navigationLinks.map((link) => <a class="mobile-root-link" href={homeHref(link.href)} aria-current={link.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined}>{link.label}<Icon name={isPageLink(link.href) ? 'diagonal' : 'arrow'} width={16} height={16} /></a>)}
        <div class="mobile-utilities"><a href={site.githubUrl}>{content.sourceLabel}<Icon name="diagonal" width={15} height={15} /></a>{action && <a class="mobile-download" href={homeHref(action.href)}>{action.label}<Icon name="diagonal" width={15} height={15} /></a>}</div>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const product = document.querySelector<HTMLDetailsElement>('#product-menu');
  const mobile = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  const mobileProduct = document.querySelector<HTMLDetailsElement>('#mobile-product');
  const productSummary = product?.querySelector<HTMLElement>(':scope > summary');
  const mobileSummary = mobile?.querySelector<HTMLElement>(':scope > summary');
  const mobileProductSummary = mobileProduct?.querySelector<HTMLElement>(':scope > summary');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const desktop = matchMedia('(min-width: 768px)');
  let openTimer: ReturnType<typeof setTimeout> | undefined;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  let lastHeaderFocus: HTMLElement | null = null;
  const clearTimers = () => { clearTimeout(openTimer); clearTimeout(closeTimer); };
  const closeProduct = () => { clearTimers(); if (product) product.open = false; };
  const closeMobile = () => { if (mobile) mobile.open = false; if (mobileProduct) mobileProduct.open = false; };
  const closeAll = () => { closeProduct(); closeMobile(); };

  // A browser may blur a control as CSS hides it, before the media-query
  // callback runs. Keep its identity so the equivalent menu retains focus.
  document.addEventListener('focusin', (event) => {
    if (!(event.target instanceof HTMLElement)) return;
    if (event.target === document.body || event.target === document.documentElement) return;
    lastHeaderFocus = header?.contains(event.target) ? event.target : null;
  });

  productSummary?.addEventListener('pointerenter', () => {
    if (!finePointer.matches || !desktop.matches) return;
    clearTimers();
    openTimer = setTimeout(() => { if (product) product.open = true; }, 100);
  });
  product?.addEventListener('pointerenter', () => { clearTimeout(closeTimer); });
  product?.addEventListener('pointerleave', () => {
    clearTimeout(openTimer);
    if (!finePointer.matches || product.contains(document.activeElement)) return;
    closeTimer = setTimeout(closeProduct, 180);
  });
  productSummary?.addEventListener('pointerdown', () => { clearTimers(); });
  product?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !product.contains(event.relatedTarget)) closeProduct();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    clearTimers();
    if (product?.open) { event.preventDefault(); closeProduct(); productSummary?.focus(); }
    else if (mobileProduct?.open) { event.preventDefault(); mobileProduct.open = false; mobileProductSummary?.focus(); }
    else if (mobile?.open) { event.preventDefault(); closeMobile(); mobileSummary?.focus(); }
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!header?.contains(event.target)) lastHeaderFocus = null;
    const clickedControl = event.target instanceof Element && event.target.closest('a[href], button, input, select, textarea, summary, [contenteditable="true"], [tabindex]:not([tabindex="-1"])');
    if (product?.open && !product.contains(event.target)) {
      const focusWasInside = product.contains(document.activeElement);
      closeProduct();
      if (focusWasInside) {
        if (!clickedControl) event.preventDefault();
        productSummary?.focus();
      }
    }
    if (mobile?.open && !mobile.contains(event.target)) {
      const focusWasInside = mobile.contains(document.activeElement);
      closeMobile();
      if (focusWasInside) {
        if (!clickedControl) event.preventDefault();
        mobileSummary?.focus();
      }
    }
  });
  mobile?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !mobile.contains(event.relatedTarget)) closeMobile();
  });
  mobile?.addEventListener('toggle', () => { if (!mobile.open && mobileProduct) mobileProduct.open = false; });
  header?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    const wasInDisclosure = product?.contains(link) || mobile?.contains(link);
    closeAll();
    // Put keyboard and screen-reader users at the chosen section after closing.
    if ((wasInDisclosure || link.hash === '#newsletter') && link.getAttribute('href')?.startsWith('#')) {
      const target = document.getElementById(link.hash.slice(1));
      if (target) {
        const hadTabindex = target.hasAttribute('tabindex');
        if (!hadTabindex) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        if (!hadTabindex) target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
      }
    }
  }));
  type SurfaceColor = [number, number, number];
  const surfaceColor = (surface: Element): SurfaceColor => {
    // Product captures have a dark interface inside their white image frames.
    if (surface.closest('.deck-frame, .deck-detail')) return [19, 23, 20];
    for (let element: Element | null = surface; element; element = element.parentElement) {
      const background = getComputedStyle(element).backgroundColor;
      const channels = background.match(/[\d.]+/g)?.map(Number);
      // color-mix(in srgb, ...) is serialized with 0–1 channels, unlike rgb().
      if (channels && background.startsWith('color(srgb ')) {
        for (let index = 0; index < 3; index++) channels[index] *= 255;
      }
      if (channels && channels.length >= 3 && (channels[3] ?? 1) >= .95) {
        return channels.slice(0, 3) as SurfaceColor;
      }
      if (element.matches('.hero')) return [255, 255, 255];
    }
    return [247, 248, 243];
  };
  const contrastTargets = header?.querySelectorAll<HTMLElement>('.wordmark, .product-fallback, .navigation-link, .product-menu > summary, .header-source, .mobile-navigation > summary') ?? [];
  const frostedBackdrop = CSS.supports('backdrop-filter', 'blur(1px)') || CSS.supports('-webkit-backdrop-filter', 'blur(1px)');
  const syncHeaderSurface = () => {
    if (!header) return;
    header.toggleAttribute('data-scrolled', window.scrollY > 24);
    if (!frostedBackdrop || document.querySelector('dialog[open]')) return;
    if (product?.open || mobile?.open) {
      const contrast = header.dataset.theme === 'dark' ? 'light' : 'dark';
      contrastTargets.forEach((target) => { if (target.dataset.contrast !== contrast) target.dataset.contrast = contrast; });
      return;
    }
    // When menus are closed, colors come from the native backdrop blur. Only
    // each individual control's foreground needs a local contrast adjustment.
    contrastTargets.forEach((target) => {
      const bounds = target.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      const rgb: SurfaceColor = [0, 0, 0];
      // Include neighboring surfaces to account for the blur at image edges.
      const weights = [1, 3, 3, 1];
      for (let row = 0; row < 4; row++) for (let column = 0; column < 4; column++) {
        const x = Math.max(0, Math.min(innerWidth - 1, bounds.left + bounds.width / 2 + (column * 2 - 3) * 14));
        const y = Math.max(0, bounds.top + bounds.height / 2 + (row * 2 - 3) * 14);
        const underlying = document.elementsFromPoint(x, y).find((element) => !header.contains(element));
        const color = underlying ? surfaceColor(underlying) : [247, 248, 243];
        const weight = weights[row] * weights[column] / 64;
        color.forEach((channel, index) => { rgb[index] += channel * weight; });
      }
      const linear = rgb.map((channel) => {
        const value = (channel * .94 + 255 * .06) / 255;
        return value <= .04045 ? value / 12.92 : ((value + .055) / 1.055) ** 2.4;
      });
      const luminance = .2126 * linear[0] + .7152 * linear[1] + .0722 * linear[2];
      const contrast = luminance > .179 ? 'dark' : 'light';
      if (target.dataset.contrast !== contrast) target.dataset.contrast = contrast;
    });
  };
  let surfaceFrame = 0;
  const scheduleHeaderSurface = () => {
    if (surfaceFrame) return;
    surfaceFrame = requestAnimationFrame(() => { surfaceFrame = 0; syncHeaderSurface(); });
  };
  syncHeaderSurface();
  window.addEventListener('scroll', scheduleHeaderSurface, { passive: true });
  window.addEventListener('resize', scheduleHeaderSurface, { passive: true });
  window.addEventListener('pageshow', scheduleHeaderSurface);
  product?.addEventListener('toggle', scheduleHeaderSurface);
  mobile?.addEventListener('toggle', scheduleHeaderSurface);
  document.addEventListener('close', scheduleHeaderSurface, true);
  document.addEventListener('lomi:media-surface-change', scheduleHeaderSurface);
  if (header) header.dataset.navigationReady = '';
  desktop.addEventListener('change', () => {
    const active = document.activeElement;
    const focused = active === document.body || active === document.documentElement ? lastHeaderFocus : active;
    const focusWasInHiddenNavigation = desktop.matches ? mobile?.contains(focused) : header?.querySelector('.desktop-navigation')?.contains(focused) || header?.querySelector('.header-actions')?.contains(focused);
    // A resize callback can arrive after the newly visible menu was opened.
    // Close only the navigation that this breakpoint hides.
    clearTimers();
    if (desktop.matches) closeMobile();
    else closeProduct();
    if (focusWasInHiddenNavigation) (desktop.matches ? productSummary : mobileSummary)?.focus();
  });
</script>

<style>
  .wordmark img { width: 70px; height: auto; max-height: 44px; object-fit: contain; }
  .site-header {
    --header-surface: rgb(15 20 14 / 72%);
    --header-panel: #10150f;
    --header-line: #303b2a;
    --header-text: #f3f6ed;
    --header-muted: #bcc9b1;
    --header-subtle: #a7b69a;
    --header-hover: #222d1b;
    --header-icon: #c8ff3d;
    --header-focus: var(--color-lime);
    position: fixed; top: 0; inset-inline: 0; z-index: 20;
    color: var(--header-text);
  }
  .site-header::before { content: ''; position: absolute; z-index: 0; inset: 0; pointer-events: none; background: rgb(255 255 255 / 6%); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); opacity: 0; transition: opacity 180ms ease; }
  .site-header[data-scrolled]::before, .site-header:not([data-navigation-ready])::before, .site-header:has(.product-menu[open], .mobile-navigation[open])::before { opacity: 1; }
  .site-header:has(.product-menu[open], .mobile-navigation[open])::before { background: var(--header-panel); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .site-header:not([data-navigation-ready])::before { background: var(--header-surface); }
  .site-header[data-theme='light'] { --header-surface: rgb(255 255 255 / 72%); --header-panel: var(--color-paper); --header-line: #dfe5d8; --header-text: #202c18; --header-muted: #3f4b36; --header-subtle: #5c6b4e; --header-hover: #eef3e8; --header-icon: #4b6c16; --header-focus: var(--color-focus); }
  .site-header [data-contrast] { transition: background-color 150ms ease; }
  .site-header [data-contrast='light'] { --header-text: #fff; --header-muted: #fff; --header-line: rgb(255 255 255 / 30%); --header-hover: rgb(255 255 255 / 12%); --header-focus: var(--color-lime); color: var(--header-text); }
  .site-header [data-contrast='dark'] { --header-text: #000; --header-muted: #000; --header-line: rgb(11 14 11 / 25%); --header-hover: rgb(11 14 11 / 7%); --header-focus: var(--color-focus); color: var(--header-text); }
  .site-header:has(.product-menu[open], .mobile-navigation[open]) [data-contrast] { --header-text: inherit; --header-muted: inherit; --header-line: inherit; --header-hover: inherit; --header-focus: inherit; }
  .navigation-backdrop { position: fixed; inset: 0; z-index: -1; visibility: hidden; opacity: 0; background: rgb(5 10 5 / 26%); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: opacity 180ms ease, visibility 180ms; }
  .site-header[data-theme='light'] .navigation-backdrop { background: rgb(30 43 21 / 10%); }
  .site-header[data-navigation-ready]:has(.product-menu[open], .mobile-navigation[open]) .navigation-backdrop { visibility: visible; opacity: 1; }
  .header-inner { position: relative; z-index: 1; display: flex; align-items: center; width: min(1440px, calc(100% - clamp(40px, 10.4vw, 160px))); min-height: var(--site-header-height); padding: 0; gap: 24px; }
  .wordmark { display: inline-flex; align-items: center; flex-shrink: 0; min-height: 44px; }
  .wordmark :global(svg) { display: block; width: 70px; height: auto; }
  .desktop-navigation { display: flex; align-items: stretch; gap: 4px; align-self: stretch; margin-left: 24px; margin-right: auto; }
  .product-menu { display: none; align-items: center; align-self: stretch; }
  .site-header[data-navigation-ready] .product-menu { display: flex; }
  .navigation-link, .product-fallback, .product-menu > summary { display: inline-flex; align-items: center; justify-content: center; gap: 7px; align-self: center; min-height: 44px; padding-inline: 14px; border-radius: 6px; font-size: 13px; font-weight: 500; color: var(--header-muted); transition: color 150ms ease, background-color 150ms ease; }
  .site-header[data-navigation-ready] .product-fallback { display: none; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .navigation-link[aria-current], .product-menu[open] > summary { color: var(--header-text); background: var(--header-hover); }
  .menu-chevron { transition: transform 180ms var(--ease-out); }
  .product-menu[open] .menu-chevron { transform: rotate(180deg); }
  .product-panel { position: fixed; top: var(--site-header-height); inset-inline: 0; padding-block: 22px 32px; max-height: calc(100dvh - var(--site-header-height)); overflow: auto; overscroll-behavior: contain; background: var(--header-panel); box-shadow: 0 12px 24px -20px rgb(0 0 0 / 18%); }
  .product-panel-inner { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; width: min(1440px, calc(100% - clamp(40px, 10.4vw, 160px))); margin-inline: auto; }
  .product-group-label { margin: 0 0 6px; font-size: 13px; font-weight: 400; line-height: 1.5; color: var(--header-subtle); }
  .product-link { display: flex; align-items: center; gap: 8px; width: fit-content; min-width: 44px; max-width: 100%; min-height: 44px; padding-block: 8px; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .product-link-title { font-size: 16px; font-weight: 400; line-height: 1.5; color: var(--header-text); }
  .product-link:focus-visible { text-decoration-line: underline; }
  .product-link[aria-current='page'] .product-link-title { text-decoration: underline; text-underline-offset: 4px; }
  .header-actions { display: flex; align-items: center; flex-shrink: 0; gap: 12px; padding-left: 20px; }
  .header-source { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; padding-inline: 10px; border-radius: 6px; color: var(--header-muted); font-size: 12px; font-weight: 500; transition: color 150ms ease, background-color 150ms ease; }
  .header-action { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 0 17px; border: 1px solid #b6e43b; border-radius: 8px; color: #0b0e0b; background: var(--color-lime); font-size: 12px; font-weight: 550; transition: background-color 150ms ease, transform 150ms ease-out; }
  .header-action:active { background: var(--color-lime-pressed); transform: scale(.96); }
  .site-header :focus-visible { outline: 2px solid var(--header-focus); outline-offset: 3px; }
  .mobile-navigation { display: none; }
  .product-menu[open] .product-panel, .mobile-navigation[open] > .mobile-panel { animation: panel-enter 180ms var(--ease-out); }
  @keyframes panel-enter { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @media (hover: hover) {
    .navigation-link:hover, .product-fallback:hover, .product-menu > summary:hover, .header-source:hover { color: var(--header-text); background: var(--header-hover); }
    .product-link:hover { text-decoration-line: underline; }
    .header-action:hover { background: #dcff83; }
  }
  @media (max-width: 1100px) { .header-source > span { display: none; } }
  @media (max-width: 1000px) { .header-inner { gap: 16px; } .desktop-navigation { gap: 2px; margin-left: 8px; } .navigation-link, .product-fallback, .product-menu > summary { padding-inline: 10px; font-size: 12px; } .header-actions { gap: 8px; padding-left: 12px; } .header-action { padding-inline: 13px; font-size: 11px; } }
  @media (min-width: 768px) and (max-width: 860px) {
    .header-inner { width: calc(100% - 40px); gap: 12px; }
    .desktop-navigation { margin-left: 0; gap: 0; }
    .navigation-link, .product-fallback, .product-menu > summary { padding-inline: 8px; }
    .header-actions { padding-left: 8px; }
    .header-source { padding-inline: 6px; }
  }
  @media (max-width: 767px) {
    .header-inner { width: calc(100% - 40px); justify-content: space-between; }
    .wordmark :global(svg), .wordmark img { width: 64px; }
    .desktop-navigation, .header-actions { display: none; }
    .site-header[data-navigation-ready] .mobile-navigation { display: flex; align-items: center; align-self: stretch; }
    .site-header:not([data-navigation-ready]) .header-inner { gap: 8px; }
    .site-header:not([data-navigation-ready]) .desktop-navigation { display: flex; flex-wrap: wrap; justify-content: flex-end; align-content: center; gap: 0; margin: 0 0 0 auto; }
    .site-header:not([data-navigation-ready]) .navigation-link, .site-header:not([data-navigation-ready]) .product-fallback { min-width: 44px; padding-inline: 6px; font-size: 11px; }
    .mobile-navigation > summary { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding-inline: 12px; border: 1px solid var(--header-line); border-radius: 7px; font-size: 12px; font-weight: 500; color: var(--header-text); }
    .mobile-navigation[open] > summary { background: var(--header-hover); }
    .menu-symbol { position: relative; width: 16px; height: 8px; border-block: 1px solid currentColor; }
    .mobile-navigation[open] .menu-symbol { height: 16px; border-block-color: transparent; }
    .mobile-navigation[open] .menu-symbol::before, .mobile-navigation[open] .menu-symbol::after { content: ''; position: absolute; inset-inline: 0; top: 7px; height: 1px; background: currentColor; transform: rotate(45deg); }
    .mobile-navigation[open] .menu-symbol::after { transform: rotate(-45deg); }
    .mobile-panel { position: absolute; top: 100%; left: -20px; right: -20px; max-height: calc(100dvh - var(--site-header-height)); overflow: auto; overscroll-behavior: contain; padding: 8px 20px 20px; border-bottom: 1px solid var(--header-line); color: var(--header-text); background: var(--header-panel); box-shadow: 0 16px 32px rgb(0 0 0 / 10%); }
    .mobile-root-link, .mobile-product > summary { display: flex; align-items: center; justify-content: space-between; min-height: 56px; border-bottom: 1px solid var(--header-line); font-size: 16px; }
    .mobile-root-link[aria-current] { color: var(--header-icon); }
    .mobile-product > summary > span { width: 100%; align-items: center; justify-content: space-between; gap: 10px; }
    .mobile-product-enter { display: flex; }
    .mobile-product-back { display: none; }
    .mobile-product-back :global(svg) { transform: rotate(180deg); }
    .mobile-product[open] > summary { border-bottom: 0; font-size: 12px; color: var(--header-icon); min-height: 48px; }
    .mobile-product[open] .mobile-product-back { display: flex; justify-content: flex-start; }
    .mobile-product[open] .mobile-product-enter { display: none; }
    .mobile-panel:has(.mobile-product[open]) > .mobile-root-link, .mobile-panel:has(.mobile-product[open]) > .mobile-utilities { display: none; }
