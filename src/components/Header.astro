---
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import type { Landing } from '../../content/landing-schema';
import { site } from '../data/site';
interface Props { content: Landing['navigation'] }
const { content } = Astro.props;
---

<header class="site-header shell">
  <div class="header-brand"><a class="wordmark" href="#top" aria-label="lomi home"><Fragment set:html={logo} /></a><span class="header-descriptor" aria-hidden="true">/ desktop workspace</span></div>
  <nav class="desktop-navigation" aria-label="Primary navigation">
    {content.links.map((link, index) => <a href={link.href}><span class="nav-index" aria-hidden="true">0{index + 1}</span>{link.label}</a>)}
  </nav>
  <div class="header-actions"><a class="header-github" href={site.github} aria-label="lomi source on GitHub"><Icon name="github" width={18} height={18} /></a><a class="header-action" href="#download">{content.actionLabel}<Icon name="diagonal" width={16} height={16} /></a></div>
  <details class="mobile-navigation" id="mobile-navigation">
    <summary>Menu <Icon name="plus" width={18} height={18} /></summary>
    <nav aria-label="Mobile navigation">
      {content.links.map((link) => <a href={link.href}>{link.label}<Icon name="arrow" width={16} height={16} /></a>)}
      <a href="#download">{content.actionLabel}<Icon name="download" width={16} height={16} /></a>
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
