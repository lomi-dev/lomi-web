---
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['navigation'] }
const { content } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="#top" aria-label="lomi home"><Fragment set:html={logo} /></a>
  <nav class="desktop-navigation" aria-label="Primary navigation">
    {content.links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <a class="header-action" href="#download">{content.actionLabel}<Icon name="download" width={16} height={16} /></a>
  <details class="mobile-navigation" id="mobile-navigation">
    <summary>Menu <Icon name="plus" width={18} height={18} /></summary>
    <nav aria-label="Mobile navigation">
      {content.links.map((link) => <a href={link.href}>{link.label}<Icon name="arrow" width={16} height={16} /></a>)}
      <a href="#download">{content.actionLabel}<Icon name="download" width={16} height={16} /></a>
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header { position: absolute; z-index: 10; top: 24px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; justify-content: space-between; gap: 30px; width: min(1240px, calc(100% - 64px)); min-height: 78px; padding: 12px 20px 12px 24px; border: 1px solid #e2e6dc; border-radius: 13px; background: var(--color-chalk); color: var(--color-ink); box-shadow: 0 10px 45px rgb(0 0 0 / 12%); }
  .wordmark { display: block; padding-block: 6px; }
  .wordmark :global(svg) { display: block; width: 96px; height: auto; }
  .desktop-navigation { display: flex; align-items: center; gap: 30px; }
  .desktop-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; font-weight: 450; text-underline-offset: 5px; }
  .desktop-navigation a:hover { text-decoration: underline; }
  .header-action { display: inline-flex; align-items: center; gap: 17px; min-height: 46px; padding-inline: 17px; border-radius: 6px; background: var(--color-ink); color: var(--color-chalk); font-size: 12px; font-weight: 500; }
  .header-action:hover { background: #304326; }
  .mobile-navigation { display: none; }
  @media (max-width: 1000px) { .site-header { gap: 20px; } .desktop-navigation { gap: 22px; } }
  @media (max-width: 767px) {
    .site-header { top: 16px; width: calc(100% - 32px); min-height: 66px; padding: 8px 12px 8px 17px; border-radius: 11px; gap: 18px; }
    .desktop-navigation, .header-action { display: none; }
    .mobile-navigation { display: block; }
    .mobile-navigation > summary { display: flex; align-items: center; gap: 14px; min-height: 44px; padding-inline: 10px; list-style: none; cursor: pointer; font-size: 12px; }
    .mobile-navigation[open] > summary :global(svg) { transform: rotate(45deg); }
    summary::-webkit-details-marker { display: none; }
    .mobile-navigation nav { position: absolute; top: calc(100% + 9px); right: -1px; left: -1px; padding: 10px 20px; border: 1px solid #d9dfd2; border-radius: 11px; background: var(--color-chalk); box-shadow: 0 14px 35px rgb(0 0 0 / 16%); }
    .mobile-navigation nav a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 48px; font-size: 14px; }
  }
</style>
