---
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import { site } from '../data/site';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['navigation'] }
const { content } = Astro.props;
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="#top" aria-label="lomi home"><Fragment set:html={logo} /></a>
    <nav class="desktop-navigation" aria-label="Primary navigation">
      {content.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="header-source" href={site.github} aria-label="lomi source on GitHub"><Icon name="github" width={18} height={18} /></a>
      <a class="header-action" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog">{content.actionLabel}<Icon name="diagonal" width={14} height={14} /></a>
    </div>
    <details class="mobile-navigation" id="mobile-navigation">
      <summary><span>Menu</span><span class="menu-symbol" aria-hidden="true"></span></summary>
      <nav aria-label="Mobile navigation">
        {content.links.map((link) => <a href={link.href}>{link.label}<Icon name="arrow" width={16} height={16} /></a>)}
        <a href={site.github}>GitHub<Icon name="diagonal" width={16} height={16} /></a>
        <a class="mobile-download" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog">{content.actionLabel}<Icon name="download" width={16} height={16} /></a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>

<style>
  .site-header { position: absolute; top: 24px; inset-inline: 0; z-index: 20; color: #f3f6ed; }
  .header-inner { display: flex; align-items: center; width: min(1120px, calc(100% - 64px)); min-height: 72px; padding: 11px 14px 11px 25px; gap: 24px; border: 1px solid #b8cca82b; border-radius: 999px; background: rgb(15 20 14 / 86%); box-shadow: inset 0 1px 0 #e9ffdc0a, 0 12px 35px #0002; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .wordmark { display: inline-flex; align-items: center; min-height: 44px; }
  .wordmark :global(svg) { display: block; width: 82px; height: auto; }
  .desktop-navigation { display: flex; align-items: center; justify-content: center; gap: 4px; margin-inline: auto; }
  .desktop-navigation a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding-inline: 16px; border-radius: 999px; font-size: 13px; color: #c0ccb4; transition: color 150ms ease, background-color 150ms ease; }
  .desktop-navigation a:hover { color: #fff; background: #e1f9cd0c; }
  .header-actions { display: flex; align-items: center; gap: 10px; }
  .header-source { display: inline-flex; align-items: center; justify-content: center; width: 44px; min-height: 44px; border: 1px solid #bbcca32b; border-radius: 50%; color: #d2dfc4; transition: border-color 150ms ease, background-color 150ms ease; }
  .header-source:hover { border-color: #b4ce9570; background: #b4ce950f; }
  .header-action { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; padding: 0 19px; border: 1px solid #daff78; border-radius: 999px; color: #0b0e0b; background: var(--color-lime); font-size: 12px; font-weight: 550; transition: background-color 150ms ease; }
  .header-action:hover { background: #dcff83; }
  .site-header :focus-visible { outline-color: var(--color-lime); }
  .mobile-navigation { display: none; }
  @media (max-width: 1000px) { .header-inner { gap: 15px; padding-left: 22px; } .desktop-navigation { gap: 0; } .desktop-navigation a { padding-inline: 12px; font-size: 12px; } .header-actions { gap: 8px; } .header-action { gap: 12px; padding-inline: 15px; font-size: 11px; } }
  @media (max-width: 767px) {
    .site-header { top: 16px; }
    .header-inner { width: calc(100% - 32px); min-height: 64px; justify-content: space-between; padding: 8px 12px 8px 21px; }
    .wordmark :global(svg) { width: 79px; }
    .desktop-navigation, .header-actions { display: none; }
    .mobile-navigation { display: block; }
    .mobile-navigation > summary { display: inline-flex; align-items: center; gap: 13px; min-height: 44px; padding-inline: 13px; border-radius: 999px; background: #d9f4bc0b; list-style: none; cursor: pointer; font-size: 12px; color: #e0ead5; }
    .menu-symbol { position: relative; width: 16px; height: 8px; border-block: 1px solid currentColor; }
    .mobile-navigation[open] .menu-symbol { height: 16px; border-block-color: transparent; }
    .mobile-navigation[open] .menu-symbol::before, .mobile-navigation[open] .menu-symbol::after { content: ''; position: absolute; inset-inline: 0; top: 7px; height: 1px; background: currentColor; transform: rotate(45deg); }
    .mobile-navigation[open] .menu-symbol::after { transform: rotate(-45deg); }
    summary::-webkit-details-marker { display: none; }
    .mobile-navigation nav { position: absolute; top: calc(100% + 10px); left: 16px; right: 16px; max-height: calc(100svh - 112px); overflow: auto; padding: 12px 22px 16px; border: 1px solid #536343; border-radius: 23px; color: #e0ead5; background: #11180f; box-shadow: 0 20px 50px #0008; }
    .mobile-navigation nav a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 49px; border-bottom: 1px solid #3e4a3459; font-size: 14px; }
    .mobile-navigation nav a:last-child { border: 0; color: var(--color-lime); }
  }
</style>
