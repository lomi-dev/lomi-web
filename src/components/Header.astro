---
import { Image } from 'astro:assets';
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import workbench from '../assets/product/workbench.png';
import browser from '../assets/product/browser.png';
import phone from '../assets/product/mobile-app/workspace-home-dark.png';
import { editorDefaults } from '../../content/editor-defaults';
import { resolveMedia } from '../../content/editor-schema';
import { activeLandingLinks, activeProductGroups } from '../data/navigation';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['navigation']; site?: Landing['site']; layout?: Landing['layout']; theme?: 'light' | 'dark' }
const { content, site = editorDefaults.site, layout = editorDefaults.layout } = Astro.props;
const navigationLinks = activeLandingLinks(content.links, layout);
const brandLogo = resolveMedia(site.brand.logo, import.meta.env.CMS_URL);
const isHome = Astro.url.pathname === '/';
const homeHref = (href: string) => href.startsWith('#') && !isHome ? `/${href}` : href;
const isPageLink = (href: string) => {
  const target = new URL(homeHref(href), Astro.url);
  return !target.hash || target.origin !== Astro.url.origin || target.pathname !== Astro.url.pathname;
};
const current = (href: string) => href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined;
const productGroups = activeProductGroups(content.productGroups, layout);
const [cardGroup, ...listGroups] = productGroups;
const action = activeLandingLinks([{ label: content.actionLabel, href: content.actionHref }], layout)[0];

// Real captures of each product, and one line on what it is. Unknown CMS links show text only.
const key = (href: string) => href.replace(/^\//, '').replace(/\/$/, '');
const thumbs: Record<string, { src: ImageMetadata; position: string }> = {
  '#features': { src: workbench, position: '0 0' },
  remote: { src: browser, position: '0 0' },
  'mobile-app': { src: phone, position: '50% 0' },
};
const notes: Record<string, string> = {
  '#features': 'Terminals, editor, previews and Git in one native window.',
  remote: 'Your workspaces and terminals, ready for another screen.',
  'mobile-app': 'Follow and guide a running session from your phone.',
  'https://docs.lomi.dev': 'Guides and reference.',
  'https://github.com/lomi-dev/lomi': 'Apache 2.0, open on GitHub.',
  download: 'macOS, Windows and Linux.',
  'https://github.com/lomi-dev/lomi/releases': 'What changed in each release.',
};
---

<header class="site-header" data-intro>
  {/* Liquid glass: the capsule's rim bends what is behind it (Chromium only; elsewhere plain frost). */}
  <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false"><filter id="nav-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB"><feGaussianBlur in="SourceGraphic" stdDeviation="9" result="frost" /><feImage result="map" x="0" y="0" preserveAspectRatio="none" /><feDisplacementMap in="frost" in2="map" scale="70" xChannelSelector="R" yChannelSelector="G" /></filter></svg>
  <div class="navigation-backdrop" aria-hidden="true"></div>
  <div class="header-inner">
    <a class="wordmark" href={isHome ? '#top' : '/'} aria-label={site.brand.logoAlt}>{brandLogo ? <img src={brandLogo.url} alt={site.brand.logoAlt} /> : <Fragment set:html={logo} />}</a>
    <nav class="desktop-navigation" aria-label={content.primaryAriaLabel}>
      <span class="nav-indicator" aria-hidden="true"></span>
      {cardGroup && <><details class="product-menu" id="product-menu">
        <summary>{content.productLabel}<svg class="menu-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
        <div class="product-panel">
          <div class="product-cards">
            <p class="panel-label">{cardGroup.label}</p>
            <div class="product-card-grid">
              {cardGroup.links.map((link) => { const thumb = thumbs[key(link.href)]; return <a class="product-card" href={homeHref(link.href)} aria-current={current(link.href)}>
                {thumb && <span class="product-thumb"><Image src={thumb.src} alt="" width={520} format="webp" quality={80} style={`object-position:${thumb.position}`} /></span>}
                <span class="product-card-title">{link.label}</span>
                {notes[key(link.href)] && <span class="product-card-note">{notes[key(link.href)]}</span>}
              </a>; })}
            </div>
          </div>
          {listGroups.length > 0 && <div class="product-lists">
            {listGroups.map((group) => <div class="product-group"><p class="panel-label">{group.label}</p>{group.links.map((link) => <a class="product-link" href={homeHref(link.href)} aria-current={current(link.href)}><span><span class="product-link-title">{link.label}</span>{notes[key(link.href)] && <span class="product-link-note">{notes[key(link.href)]}</span>}</span>{isPageLink(link.href) && <Icon name="diagonal" width={14} height={14} />}</a>)}</div>)}
          </div>}
        </div>
      </details></>}
      {navigationLinks.map((link) => <a class="navigation-link" href={homeHref(link.href)} aria-current={current(link.href)}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="header-source" href={site.githubUrl} aria-label={content.sourceAriaLabel}><Icon name="github" width={18} height={18} /></a>
      {action && <a class="button button-compact header-action" href={homeHref(action.href)}><Icon name="download" width={16} height={16} />{action.label}</a>}
    </div>
    <details class="mobile-navigation" id="mobile-navigation">
      <summary aria-label={content.menuLabel}><span class="menu-symbol" aria-hidden="true"></span></summary>
      <nav class="mobile-panel" aria-label={content.mobileAriaLabel}>
        {cardGroup && <div class="mobile-cards">{cardGroup.links.map((link) => { const thumb = thumbs[key(link.href)]; return <a class="mobile-card" href={homeHref(link.href)} aria-current={current(link.href)}>
          {thumb && <span class="product-thumb"><Image src={thumb.src} alt="" width={320} format="webp" quality={75} style={`object-position:${thumb.position}`} /></span>}
          <span class="product-card-title">{link.label}</span>
        </a>; })}</div>}
        <div class="mobile-links">
          {navigationLinks.map((link) => <a class="mobile-root-link" href={homeHref(link.href)} aria-current={current(link.href)}>{link.label}<Icon name={isPageLink(link.href) ? 'diagonal' : 'arrow'} width={18} height={18} /></a>)}
          {listGroups.flatMap((group) => group.links).filter((link) => !/download/i.test(link.href) && !navigationLinks.some((nav) => nav.href.replace(/\/$/, '') === link.href.replace(/\/$/, ''))).map((link) => <a class="mobile-root-link mobile-secondary" href={homeHref(link.href)}>{link.label}<Icon name="diagonal" width={16} height={16} /></a>)}
        </div>
        <div class="mobile-utilities">
          <a class="button button-secondary mobile-source" href={site.githubUrl}><Icon name="github" width={17} height={17} />{content.sourceLabel}</a>
          {action && <a class="button button-primary mobile-download" href={homeHref(action.href)}><Icon name="download" width={16} height={16} />{action.label}</a>}
        </div>
      </nav>
    </details>
  </div>
</header>
<script is:inline>
  // Arriving from another Lomi page: the capsule is already on screen, so skip its intro.
  try { if (document.referrer && new URL(document.referrer).origin === location.origin) document.querySelector('.site-header')?.removeAttribute('data-intro'); } catch {}
</script>

<script>

  const header = document.querySelector<HTMLElement>('.site-header');
  const product = document.querySelector<HTMLDetailsElement>('#product-menu');
  const mobile = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  const mobileProduct = document.querySelector<HTMLDetailsElement>('#mobile-product');
  const productSummary = product?.querySelector<HTMLElement>(':scope > summary');
  const mobileSummary = mobile?.querySelector<HTMLElement>(':scope > summary');
  const mobileProductSummary = mobileProduct?.querySelector<HTMLElement>(':scope > summary');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const desktop = matchMedia('(min-width: 768px)');
  let openTimer: ReturnType<typeof setTimeout> | undefined;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  let lastHeaderFocus: HTMLElement | null = null;
  const clearTimers = () => { clearTimeout(openTimer); clearTimeout(closeTimer); };
  // Menus leave the way they came: a short fade before the disclosure really closes.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const shut = (menu?: HTMLDetailsElement | null) => {
    if (!menu?.open || menu.dataset.closing !== undefined) return;
    if (still.matches) { menu.open = false; return; }
    menu.dataset.closing = '';
    setTimeout(() => { if (menu.dataset.closing === undefined) return; menu.open = false; delete menu.dataset.closing; }, 150);
  };
  const reopen = (menu?: HTMLDetailsElement | null) => { if (!menu) return; delete menu.dataset.closing; menu.open = true; };
  const closeProduct = () => { clearTimers(); shut(product); };
  const closeMobile = () => { shut(mobile); if (mobileProduct) mobileProduct.open = false; };
  [[product, productSummary], [mobile, mobileSummary]].forEach(([menu, summary]) => summary?.addEventListener('click', (event) => {
    const details = menu as HTMLDetailsElement | null;
    if (!details?.open) return;
    event.preventDefault();
    // With a mouse, hover has already opened Product: a click keeps it open rather than
    // toggling it shut. Keyboard activation (detail 0) still toggles.
    if (details === product && event.detail > 0 && finePointer.matches && desktop.matches) { reopen(details); return; }
    if (details.dataset.closing !== undefined) reopen(details);
    else if (details === product) closeProduct(); else closeMobile();
  }));
  const closeAll = () => { closeProduct(); closeMobile(); };

  // A browser may blur a control as CSS hides it, before the media-query
  // callback runs. Keep its identity so the equivalent menu retains focus.
  document.addEventListener('focusin', (event) => {
    if (!(event.target instanceof HTMLElement)) return;
    if (event.target === document.body || event.target === document.documentElement) return;
    lastHeaderFocus = header?.contains(event.target) ? event.target : null;
  });

  productSummary?.addEventListener('pointerenter', () => {
    if (!finePointer.matches || !desktop.matches) return;
    clearTimers();
    openTimer = setTimeout(() => reopen(product), 100);
  });
  product?.addEventListener('pointerenter', () => { clearTimeout(closeTimer); });
  product?.addEventListener('pointerleave', () => {
    clearTimeout(openTimer);
    // keyboard users keep the menu while they tab through it; a mouse click's focus does not hold it open
    const keyboardFocus = document.activeElement instanceof HTMLElement && product.contains(document.activeElement) && document.activeElement.matches(':focus-visible');
    if (!finePointer.matches || keyboardFocus) return;
    closeTimer = setTimeout(closeProduct, 180);
  });
  productSummary?.addEventListener('pointerdown', () => { clearTimers(); });
  product?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !product.contains(event.relatedTarget)) closeProduct();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    clearTimers();
    if (product?.open) { event.preventDefault(); closeProduct(); productSummary?.focus(); }
    else if (mobileProduct?.open) { event.preventDefault(); mobileProduct.open = false; mobileProductSummary?.focus(); }
    else if (mobile?.open) { event.preventDefault(); closeMobile(); mobileSummary?.focus(); }
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!header?.contains(event.target)) lastHeaderFocus = null;
    const clickedControl = event.target instanceof Element && event.target.closest('a[href], button, input, select, textarea, summary, [contenteditable="true"], [tabindex]:not([tabindex="-1"])');
    if (product?.open && !product.contains(event.target)) {
      const focusWasInside = product.contains(document.activeElement);
      closeProduct();
      if (focusWasInside) {
        if (!clickedControl) event.preventDefault();
        productSummary?.focus();
      }
    }
    if (mobile?.open && !mobile.contains(event.target)) {
      const focusWasInside = mobile.contains(document.activeElement);
      closeMobile();
      if (focusWasInside) {
        if (!clickedControl) event.preventDefault();
        mobileSummary?.focus();
      }
    }
  });
  mobile?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !mobile.contains(event.relatedTarget)) closeMobile();
  });
  mobile?.addEventListener('toggle', () => { if (!mobile.open && mobileProduct) mobileProduct.open = false; });
  header?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    const wasInDisclosure = product?.contains(link) || mobile?.contains(link);
    closeAll();
    // Put keyboard and screen-reader users at the chosen section after closing.
    if ((wasInDisclosure || link.hash === '#newsletter') && link.getAttribute('href')?.startsWith('#')) {
      const target = document.getElementById(link.hash.slice(1));
      if (target) {
        const hadTabindex = target.hasAttribute('tabindex');
        if (!hadTabindex) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        if (!hadTabindex) target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
      }
    }
  }));
  const markScrolled = () => header?.toggleAttribute('data-scrolled', scrollY > 24);
  markScrolled();
  addEventListener('scroll', markScrolled, { passive: true });
  if (header) header.dataset.navigationReady = '';
  desktop.addEventListener('change', () => {
    const active = document.activeElement;
    const focused = active === document.body || active === document.documentElement ? lastHeaderFocus : active;
    const focusWasInHiddenNavigation = desktop.matches ? mobile?.contains(focused) : header?.querySelector('.desktop-navigation')?.contains(focused) || header?.querySelector('.header-actions')?.contains(focused);
    // A resize callback can arrive after the newly visible menu was opened.
    // Close only the navigation that this breakpoint hides.
    clearTimers();
    if (desktop.matches) closeMobile();
    else closeProduct();
    if (focusWasInHiddenNavigation) (desktop.matches ? productSummary : mobileSummary)?.focus();
  });

  // --- The capsule: lens map, light on the rim, sliding indicator, intro sweep.
  const capsule = header?.querySelector<HTMLElement>('.header-inner');
  const lensImage = header?.querySelector<SVGFEImageElement>('#nav-lens feImage');
  // Chromium alone renders SVG filters in backdrop-filter; userAgentData exists only there.
  if (capsule && lensImage && 'userAgentData' in navigator) {
    const paintLens = () => {
      const w = Math.round(capsule.offsetWidth), h = Math.round(capsule.offsetHeight);
      if (!w || !h) return;
      const r = parseFloat(getComputedStyle(capsule).borderTopLeftRadius) || 16, zone = Math.min(26, h / 2);
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const context = canvas.getContext('2d');
      if (!context) return;
      const image = context.createImageData(w, h);
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        const px = x + .5 - w / 2, py = y + .5 - h / 2;
        const ix = w / 2 - Math.abs(px), iy = h / 2 - Math.abs(py);
        const cx = Math.max(r - ix, 0), cy = Math.max(r - iy, 0);
        let d, nx = 0, ny = 0;
        if (cx > 0 && cy > 0) { const l = Math.hypot(cx, cy) || 1; d = r - l; nx = cx / l * Math.sign(px); ny = cy / l * Math.sign(py); }
        else if (ix < iy) { d = ix; nx = Math.sign(px); } else { d = iy; ny = Math.sign(py); }
        // the rim magnifies inward like the edge of a lens; the middle stays clear
        const t = Math.max(0, 1 - d / zone), k = t * t;
        const i = (y * w + x) * 4;
        image.data[i] = 128 - nx * k * 127; image.data[i + 1] = 128 - ny * k * 127; image.data[i + 2] = 128; image.data[i + 3] = 255;
      }
      context.putImageData(image, 0, 0);
      lensImage.setAttribute('href', canvas.toDataURL());
      lensImage.setAttribute('width', String(w)); lensImage.setAttribute('height', String(h));
      header?.setAttribute('data-lens', '');
    };
    paintLens();
    capsule.addEventListener('transitionend', (event) => { if (event.propertyName === 'width') paintLens(); });
    addEventListener('resize', () => requestAnimationFrame(paintLens));
  }
  capsule?.addEventListener('pointermove', (event) => {
    const box = capsule.getBoundingClientRect();
    capsule.style.setProperty('--mx', `${event.clientX - box.left}px`);
    capsule.style.setProperty('--my', `${event.clientY - box.top}px`);
    capsule.style.setProperty('--lit', '1');
  });
  capsule?.addEventListener('pointerleave', () => capsule.style.setProperty('--lit', '0'));
  setTimeout(() => header?.removeAttribute('data-intro'), 1900);

  // A capsule about as wide as the panel takes it flush, as one shape.
  const syncFlush = () => header?.toggleAttribute('data-flush', !!capsule && capsule.offsetWidth <= 1120);
  syncFlush();
  addEventListener('resize', syncFlush);
  capsule?.addEventListener('transitionend', (event) => { if (event.propertyName === 'width') syncFlush(); });
  // the scrolled width is known ahead of its transition, so the panel never shows the wrong shape
  addEventListener('scroll', () => requestAnimationFrame(syncFlush), { passive: true });

  const nav = header?.querySelector<HTMLElement>('.desktop-navigation');
  const indicator = nav?.querySelector<HTMLElement>('.nav-indicator');
  const items = nav ? [...nav.querySelectorAll<HTMLElement>('.navigation-link, .product-menu > summary')] : [];
  const resting = () => nav?.querySelector<HTMLElement>('.navigation-link[aria-current]') ?? null;
  let shown: HTMLElement | null = null;
  const moveTo = (item: HTMLElement | null) => {
    if (!nav || !indicator) return;
    shown = item;
    if (!item) { indicator.style.opacity = '0'; return; }
    // layout offsets, not screen rects: they ignore the capsule's own entrance transform
    indicator.style.width = `${item.offsetWidth}px`;
    indicator.style.transform = `translateX(${item.offsetLeft}px)`;
    indicator.style.opacity = '1';
  };
  items.forEach((item) => { item.addEventListener('pointerenter', () => moveTo(item)); item.addEventListener('focus', () => moveTo(item)); });
  nav?.addEventListener('pointerleave', () => moveTo(product?.open ? productSummary ?? null : resting()));
  product?.addEventListener('toggle', () => { if (!product.open && !nav?.matches(':hover')) moveTo(resting()); });
  requestAnimationFrame(() => { indicator?.classList.add('no-slide'); moveTo(resting()); requestAnimationFrame(() => indicator?.classList.remove('no-slide')); });
  document.fonts?.ready.then(() => moveTo(shown ?? resting()));

  // Links to sections of this page (e.g. Newsletter on the home page) become current while their
  // section holds the middle of the screen, and at once when clicked.
  const sectionLinks = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('.navigation-link')].filter((link) =>
    link.hash && link.pathname === location.pathname && document.getElementById(link.hash.slice(1))) : [];
  const settleIndicator = () => { if (!nav?.matches(':hover') && !product?.open) moveTo(resting()); };
  const markCurrent = (link: HTMLAnchorElement | null) => {
    sectionLinks.forEach((other) => {
      if (other === link) other.setAttribute('aria-current', 'location');
      else if (other.getAttribute('aria-current') === 'location') other.removeAttribute('aria-current');
    });
    settleIndicator();
  };
  if (sectionLinks.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) visible.add(entry.target); else visible.delete(entry.target); });
      markCurrent(sectionLinks.find((link) => visible.has(document.getElementById(link.hash.slice(1))!)) ?? null);
    }, { rootMargin: '-45% 0px -45% 0px' });
    sectionLinks.forEach((link) => {
      spy.observe(document.getElementById(link.hash.slice(1))!);
      link.addEventListener('click', () => markCurrent(link));
    });
  }
  // The links move whenever the capsule changes width (the scrolled "island", a restored scroll
  // position after navigation, a resize): follow them at once, without the slide.
  if (capsule && indicator && 'ResizeObserver' in window) {
    new ResizeObserver(() => {
      if (!shown) return;
      indicator.classList.add('no-slide');
      moveTo(shown);
      requestAnimationFrame(() => indicator.classList.remove('no-slide'));
    }).observe(capsule);
  }
</script>

<style>
  /* A floating capsule of frosted glass; the Product menu opens as a glass panel below it. */
  .site-header { --cap-gap: 12px; --glass: rgb(16 16 20 / 46%); --glass-strong: rgb(18 18 22 / 98.5%); --glass-scrolled: rgb(16 16 20 / 58%); --edge: rgb(247 247 249 / 10%); position: fixed; top: 0; inset-inline: 0; z-index: 20; height: var(--site-header-height); padding-top: var(--cap-gap); color: var(--color-ink); pointer-events: none; }
  .lens-defs { position: absolute; width: 0; height: 0; }
  @property --mx { syntax: '<length-percentage>'; inherits: true; initial-value: 50%; }
  @property --lit { syntax: '<number>'; inherits: true; initial-value: 0; }
  .header-inner { --lit: 0; --my: 0px; position: relative; z-index: 1; isolation: isolate; contain: layout; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(1320px, calc(100% - 32px)); height: calc(var(--site-header-height) - var(--cap-gap)); margin-inline: auto; padding: 0 8px 0 20px; border: 1px solid var(--edge); border-radius: 20px; background: var(--glass); -webkit-backdrop-filter: blur(22px) saturate(170%); backdrop-filter: blur(22px) saturate(170%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%), inset 0 -1px 0 rgb(255 255 255 / 3%), 0 18px 50px -24px rgb(0 0 0 / 80%); pointer-events: auto; transition: width 520ms var(--ease-out), background-color 240ms ease-out, border-color 240ms ease-out; }
  .site-header[data-lens] .header-inner { -webkit-backdrop-filter: url(#nav-lens) saturate(170%) brightness(1.08); backdrop-filter: url(#nav-lens) saturate(170%) brightness(1.08); }
  /* light that runs along the rim, under the pointer (and once around on arrival) */
  .header-inner::before { position: absolute; inset: -1px; z-index: 2; padding: 1.5px; border-radius: inherit; background: radial-gradient(260px 140px at var(--mx) var(--my), rgb(198 255 40), rgb(185 245 0 / 90%) 18%, rgb(174 141 255 / 80%) 42%, transparent 75%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: var(--lit); transition: opacity 320ms ease-out; pointer-events: none; content: ''; }
  .header-inner::after { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(260px 120px at var(--mx) var(--my), rgb(114 59 250 / 20%), transparent 70%), linear-gradient(rgb(255 255 255 / 4%), transparent 50%); opacity: calc(.35 + var(--lit) * .65); transition: opacity 320ms ease-out; pointer-events: none; content: ''; }
  /* the intro ends on its own (no script needed); `backwards` hands --lit back to the pointer afterwards */
  .site-header[data-intro] .header-inner { animation: cap-in 900ms var(--ease-out) both, rim-sweep 1700ms ease-in-out 200ms backwards; }
  @keyframes cap-in { from { opacity: 0; transform: translateY(-14px) scale(.98); filter: blur(6px); } }
  @keyframes rim-sweep { 0% { --mx: -15%; --lit: 1; } 85% { --lit: 1; } 100% { --mx: 115%; --lit: 0; } }
  .site-header[data-scrolled] .header-inner { width: min(980px, calc(100% - 32px)); }
  .site-header[data-scrolled] .header-inner { background: var(--glass-scrolled); border-color: rgb(247 247 249 / 13%); }
  .site-header:has(details[open]) .header-inner { background: var(--glass-strong); border-color: rgb(247 247 249 / 13%); }
  .wordmark { display: inline-flex; align-items: center; justify-self: start; min-height: 44px; }
  .wordmark :global(svg), .wordmark img { display: block; width: 68px; height: auto; color: var(--color-ink); }
  .navigation-backdrop { position: fixed; inset: 0; z-index: -1; visibility: hidden; opacity: 0; background: rgb(8 8 10 / 55%); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); transition: opacity 180ms ease-out, visibility 180ms; pointer-events: auto; }
  .site-header[data-navigation-ready]:has(details[open]) .navigation-backdrop { visibility: visible; opacity: 1; }

  /* The indicator is placed against this row, so it moves with the links as the capsule resizes. */
  .desktop-navigation { position: relative; display: flex; align-items: center; gap: 2px; }
  .nav-indicator { position: absolute; top: 50%; left: 0; z-index: 0; width: 0; height: 38px; margin-top: -19px; border-radius: 11px; background: rgb(247 247 249 / 9%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 7%); opacity: 0; transition: transform 260ms var(--ease-out), width 260ms var(--ease-out), opacity 180ms ease-out; pointer-events: none; }
  .nav-indicator.no-slide { transition: none; }
  .navigation-link, .product-menu > summary { position: relative; z-index: 1; }
  .navigation-link, .product-menu > summary { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding-inline: 14px; border-radius: 10px; color: #c8c8d0; font-size: 14px; font-weight: 500; transition: color 120ms ease-out, background-color 120ms ease-out; }
