---
import Icon from './Icon';
import logo from '../assets/lomi-wordmark.svg?raw';
import { site } from '../data/site';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['navigation'] }
const { content } = Astro.props;
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="#top" aria-label="lomi home"><Fragment set:html={logo} /></a>
    <span class="header-category" aria-hidden="true">terminal ade</span>
    <nav class="desktop-navigation" aria-label="Primary navigation">
      {content.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="header-source" href={site.github}><Icon name="github" width={16} height={16} /><span>GitHub</span></a>
      <a class="header-action" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog">{content.actionLabel}<Icon name="diagonal" width={14} height={14} /></a>
    </div>
    <details class="mobile-navigation" id="mobile-navigation">
      <summary><span>Menu</span><span class="menu-symbol" aria-hidden="true"></span></summary>
      <nav aria-label="Mobile navigation">
        {content.links.map((link) => <a href={link.href}>{link.label}<Icon name="arrow" width={16} height={16} /></a>)}
        <a href={site.github}>GitHub<Icon name="diagonal" width={16} height={16} /></a>
        <a class="mobile-download" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog">{content.actionLabel}<Icon name="download" width={16} height={16} /></a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>

<style>
  .site-header { position: absolute; top: 0; inset-inline: 0; z-index: 20; color: #eef1e8; background: #0b0e0b; }
  .header-inner { display: flex; align-items: center; min-height: 88px; gap: 25px; border-bottom: 1px solid #b6c0a815; }
  .wordmark { display: inline-flex; align-items: center; min-height: 44px; }
  .wordmark :global(svg) { display: block; width: 86px; height: auto; }
  .header-category { padding-left: 20px; border-left: 1px solid #68735e50; color: #849277; font-family: var(--font-mono); font-size: 9px; line-height: 1.5; }
  .desktop-navigation { display: flex; align-items: center; justify-content: center; gap: 28px; margin-left: auto; }
  .desktop-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; color: #a9b39e; transition: color 150ms ease; }
  .desktop-navigation a:hover { color: #f4f6ee; }
  .header-actions { display: flex; align-items: center; gap: 24px; margin-left: 26px; }
  .header-source { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #c6d0ba; font-size: 12px; }
  .header-source:hover { color: #fff; }
  .header-action { display: inline-flex; align-items: center; gap: 18px; min-height: 40px; padding: 0 17px; border: 1px solid #536343; border-radius: 7px; color: #d7e4c9; font-size: 11px; transition: border-color 150ms ease, background-color 150ms ease; }
  .header-action:hover { background: #c8ff3d0c; border-color: #a5c583; }
  .site-header :focus-visible { outline-color: var(--color-lime); }
  .mobile-navigation { display: none; }
  @media (max-width: 1100px) { .header-category { display: none; } .desktop-navigation { gap: 22px; } .header-actions { gap: 18px; margin-left: 10px; } }
  @media (max-width: 767px) {
    .header-inner { min-height: 78px; justify-content: space-between; }
    .wordmark :global(svg) { width: 79px; }
    .desktop-navigation, .header-actions { display: none; }
    .mobile-navigation { display: block; }
    .mobile-navigation > summary { display: inline-flex; align-items: center; gap: 15px; min-height: 44px; padding-inline: 4px; list-style: none; cursor: pointer; font-size: 11px; color: #c8d2bc; }
    .menu-symbol { position: relative; width: 16px; height: 8px; border-block: 1px solid currentColor; }
    .mobile-navigation[open] .menu-symbol { height: 16px; border-block-color: transparent; }
    .mobile-navigation[open] .menu-symbol::before, .mobile-navigation[open] .menu-symbol::after { content: ''; position: absolute; inset-inline: 0; top: 7px; height: 1px; background: currentColor; transform: rotate(45deg); }
    .mobile-navigation[open] .menu-symbol::after { transform: rotate(-45deg); }
    summary::-webkit-details-marker { display: none; }
    .mobile-navigation nav { position: absolute; top: 70px; left: 20px; right: 20px; max-height: calc(100svh - 90px); overflow: auto; padding: 10px 20px 14px; border: 1px solid #3e4a34; border-radius: 10px; color: #dce6d1; background: #151b12; box-shadow: 0 20px 50px #0008; }
    .mobile-navigation nav a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 49px; border-bottom: 1px solid #3e4a3459; font-size: 14px; }
    .mobile-navigation nav a:last-child { border: 0; color: var(--color-lime); }
  }
</style>
