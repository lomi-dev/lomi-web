---
import { Picture } from 'astro:assets';
import terminalRender from '../assets/product/remote/cli-light.webp';
---

<figure class="cli-preview" data-remote-cli-preview aria-label="Lomi Remote CLI preview">
  <Picture
    src={terminalRender}
    alt="Lomi Remote’s light terminal interface with sample local workspaces on the blue Tahoe desktop background."
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="(min-width: 1080px) 1000px, (min-width: 1000px) calc(100vw - 80px), (min-width: 768px) calc(100vw - 48px), (min-width: 360px) calc(100vw - 40px), calc(100vw - 32px)"
    quality={94}
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .cli-preview { width: 100%; min-width: 0; margin: 0; }
  .cli-preview :global(picture) { display: block; overflow: hidden; aspect-ratio: 8 / 5; border-radius: 16px; }
  .cli-preview :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 767px) {
    .cli-preview :global(picture) { border-radius: 12px; }
  }
</style>
