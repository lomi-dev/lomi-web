---
import Icon from './Icon';
import { site } from '../data/site';

const navigation = [
  {
    title: 'Find your flow',
    links: [
      { label: 'The workspace', href: '#workflow' },
      { label: 'Download lomi', href: '#download' },
      { label: 'Questions & answers', href: '#faq' },
    ],
  },
  {
    title: 'Out in the open',
    links: [
      { label: 'Documentation', href: site.docs },
      { label: 'Release notes', href: site.releases },
      { label: 'Share an idea', href: `${site.github}/issues` },
    ],
  },
];
---

<footer id="footer" class="site-footer" aria-label="lomi footer">
  <div class="footer-content shell">
    <div class="footer-top">
      <div class="footer-invitation">
        <h2>The rest is<br />yours to build.</h2>
        <a class="footer-github" href={site.github}>
          <Icon name="github" width={18} height={18} />
          <span>Let’s build it together</span>
          <Icon name="diagonal" width={16} height={16} />
        </a>
      </div>

      <nav class="footer-navigation" aria-label="Footer navigation">
        {navigation.map((group) => (
          <div class="footer-link-group">
            <h3>{group.title}</h3>
            <ul>
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}<Icon name="diagonal" width={14} height={14} /></a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer-signature">
      <p class="footer-signoff">A little more room to build.</p>
      <div class="footer-brand-row">
        <span class="footer-brand">lomi</span>
        <a class="footer-takeoff" href="#top" aria-label="Back to top — back to the clouds">
          <span class="footer-takeoff-label" aria-hidden="true">Back to the clouds <span>↑</span></span>
          <span class="footer-takeoff-disc">
            <svg class="footer-flight-path" viewBox="0 0 290 200" fill="none" aria-hidden="true">
              <path d="M5 176c62 9 140-5 139-52-1-35-56-30-52 3 5 38 91 21 147-67" />
            </svg>
            <svg class="footer-plane" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path class="footer-plane-wing" d="m9 29 46-17-16 44-10-18-20-9Z" />
              <path d="m29 38 26-26M29 38l1 14 9-7" />
            </svg>
          </span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>Made with care. Built in the open.</p>
      <a class="footer-license" href={`${site.github}/blob/main/LICENSE`}><span class="footer-open-dot" aria-hidden="true"></span>Free & open source <span class="footer-license-name">/ Apache 2.0</span></a>
      <span class="footer-colophon">A little more possibility.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-bg: #193c3e;
    --footer-ink: #e6eee1;
    --footer-muted: #afc6bc;
    --footer-accent: #c0d3b7;
    background: var(--footer-bg);
    color: var(--footer-ink);
    padding-block: 72px 0;
  }

  .footer-content { container-type: inline-size; }
  .footer-top { display: flex; justify-content: space-between; gap: 64px; }
  .footer-invitation h2 {
    font-family: var(--font-serif);
    font-size: clamp(44px, 4.4vw, 62px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.025em;
  }
  .footer-github {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 19px;
    color: var(--footer-muted);
    font-size: 13px;
    transition: color 180ms;
  }
  .footer-github span { text-decoration: underline; text-decoration-color: #688c80; text-underline-offset: 5px; }
  .footer-github:hover { color: var(--footer-ink); }
  .footer-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 76px; padding-top: 10px; }
  .footer-link-group h3 { color: var(--footer-muted); font-size: 12px; font-weight: 400; margin-bottom: 17px; }
  .footer-link-group ul { list-style: none; padding: 0; margin: 0; }
  .footer-link-group a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    width: fit-content;
    font-size: 14px;
    text-underline-offset: 5px;
  }
  .footer-link-group a svg { opacity: 0; transform: translate(-3px, 3px); transition: opacity 180ms, transform 180ms; }
  .footer-link-group a:hover { text-decoration: underline; text-decoration-color: var(--footer-muted); }
  .footer-link-group a:is(:hover, :focus-visible) svg { opacity: 1; transform: none; }
  .footer-signature { margin-top: 64px; }
  .footer-signoff { color: var(--footer-muted); font-size: 12px; }
  .footer-brand-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 4%; padding-top: 28px; padding-bottom: 35px; }
  .footer-brand {
    display: block;
    margin-left: -.07em;
    font-size: 49cqw;
    font-weight: 570;
    line-height: .73;
    letter-spacing: -.09em;
    user-select: none;
  }
  .footer-takeoff {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 12.4%;
    aspect-ratio: 1;
    margin: 0 0 .3%;
    border-radius: 50%;
    -webkit-tap-highlight-color: #c0d3b740;
  }
  .footer-takeoff-label {
    position: absolute;
    bottom: calc(100% + 28px);
    right: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    color: var(--footer-muted);
    font-size: 12px;
    transition: color 180ms;
  }
  .footer-takeoff-label > span { font-size: 18px; }
  .footer-takeoff-disc {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--footer-accent);
    color: var(--footer-bg);
    transition: background-color 220ms, transform 260ms cubic-bezier(.2, .7, .2, 1);
  }
  .footer-plane { position: relative; width: 48%; overflow: visible; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 320ms cubic-bezier(.2, .7, .2, 1); }
  .footer-plane-wing { fill: #e6eee166; }
  .footer-flight-path { position: absolute; width: 220%; height: auto; right: 25%; bottom: 13%; pointer-events: none; color: #7f9f8c; }
  .footer-flight-path path { stroke: currentColor; stroke-width: 1; stroke-dasharray: 3 7; stroke-linecap: round; }
  .footer-takeoff:hover .footer-takeoff-label { color: var(--footer-ink); }
  .footer-takeoff:is(:hover, :focus-visible) .footer-takeoff-disc { background: #dae7d3; transform: translateY(-4px); }
  .footer-takeoff:is(:hover, :focus-visible) .footer-plane { transform: translate(4px, -5px) rotate(-8deg); }
  .footer-takeoff:active .footer-takeoff-disc { transform: translateY(-1px) scale(.97); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    min-height: 82px;
    padding-block: 18px;
    border-top: 1px solid #42615b;
    color: var(--footer-muted);
    font-size: 11px;
  }
  .footer-license { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 7px; min-height: 44px; text-underline-offset: 4px; }
  .footer-license:hover { color: var(--footer-ink); text-decoration: underline; }
  .footer-open-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--footer-accent); margin-right: 3px; }
  .site-footer :focus-visible { outline-color: var(--footer-accent); }
  .footer-takeoff:focus-visible { border-radius: 50%; outline-offset: 8px; }

  @media (min-width: 1600px) {
    .footer-content { width: min(1440px, calc(100% - 160px)); }
  }
  @media (max-width: 1050px) {
    .footer-top { gap: 40px; }
    .footer-navigation { gap: 30px; }
    .footer-colophon { display: none; }
  }
  @media (max-width: 767px) {
    .site-footer { padding-top: 48px; }
    .footer-top { flex-direction: column; gap: 38px; }
    .footer-invitation h2 { font-size: 48px; }
    .footer-github { margin-top: 15px; }
    .footer-navigation { gap: 24px; padding-top: 0; }
    .footer-link-group h3 { margin-bottom: 10px; }
    .footer-link-group a { font-size: 13px; gap: 5px; }
    .footer-link-group a svg { display: none; }
    .footer-signature { margin-top: 45px; }
    .footer-signoff { font-size: 11px; }
    .footer-brand-row { padding-top: 50px; padding-bottom: 28px; }
    .footer-takeoff { width: 15%; min-width: 44px; margin-right: 0; }
    .footer-takeoff-label { bottom: calc(35.8cqw + 18px); gap: 7px; font-size: 11px; }
    .footer-takeoff-label > span { font-size: 15px; }
    .footer-flight-path { width: 180%; right: 25%; bottom: 12%; }
    .footer-plane { width: 54%; }
    .footer-bottom { padding-block: 20px 22px; gap: 5px; flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-takeoff:is(:hover, :focus-visible) .footer-takeoff-disc,
    .footer-takeoff:is(:hover, :focus-visible) .footer-plane { transform: none; }
  }
</style>
