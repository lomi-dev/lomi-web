---
import Icon from './Icon';
import CookieSettingsLink from './CookieSettingsLink.astro';
import { editorDefaults } from '../../content/editor-defaults';
import { resolveMedia } from '../../content/editor-schema';
import { activeLandingLinks, agentWorkflowLinks, workspaceResourceLinks } from '../data/navigation';
import logo from '../assets/lomi-wordmark.svg?raw';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['footer']; site?: Landing['site']; layout?: Landing['layout'] }
const { content, site = editorDefaults.site, layout = editorDefaults.layout } = Astro.props;
const brandLogo = resolveMedia(site.brand.logo, import.meta.env.CMS_URL);
const guideLinks = [
  ...agentWorkflowLinks,
  ...workspaceResourceLinks.map(({ href, footerLabel }) => ({ href, label: footerLabel })),
];
const groups = [
  ...content.groups.map((group, index) => ({
    ...group,
    links: activeLandingLinks([...group.links, ...(index === 0 ? guideLinks.filter((guide) => !group.links.some((link) => link.href === guide.href)) : [])], layout).map((link) => ({
      ...link,
      label: link.label.trim().toLowerCase() === 'lomi remote' ? 'Remote' : link.label,
    })),
  })).filter((group) => group.links.length),
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Security', href: '/security/' },
    ],
  },
];
const socials = content.socials.filter(({ href }) => {
  try {
    const url = new URL(href);
    return url.protocol === 'https:' && url.pathname.replace(/\/+$/, '').length > 0;
  } catch { return false; }
});
---

<footer class="site-footer" aria-label={content.ariaLabel} data-scroll-surface>
  <div class="footer-frame" tabindex="0" role="region" aria-label={content.contentAriaLabel}>
    <div class="footer-body">
      <div class="footer-invitation">
        <h2>{content.signoff}</h2>
        <div class="footer-actions">
          <a class="footer-github" href={site.githubUrl}>
            <Icon name="github" width={19} height={19} />
            <span>{content.githubLabel}</span>
            <span class="footer-github-arrow" aria-hidden="true"><Icon name="diagonal" width={19} height={19} /></span>
          </a>
          {socials.length > 0 && <div class="footer-socials" role="group" aria-label={content.socialsAriaLabel}>
            {socials.map((social) => <a class="footer-social" href={social.href} aria-label={social.label} title={social.label}><Icon name={social.icon as 'youtube' | 'x' | 'linkedin' | 'tiktok'} width={20} height={20} /></a>)}
          </div>}
        </div>
      </div>
      <nav class="footer-navigation" aria-label={content.navigationAriaLabel}>
        {groups.map((group) => <div class="footer-link-group">
          <h3>{group.title}</h3>
          <ul>{group.links.map((link) => <li><a href={link.href}><span>{link.label}</span><Icon name="diagonal" width={15} height={15} /></a></li>)}</ul>
        </div>)}
      </nav>
    </div>

    <div class="footer-wordmark" data-footer-wordmark={!brandLogo || undefined} aria-hidden="true">
      <div class="footer-wordmark-source" data-footer-wordmark-source>{brandLogo ? <img src={brandLogo.url} alt="" /> : <Fragment set:html={logo} />}</div>
      <canvas class="footer-wordmark-canvas" data-footer-wordmark-canvas></canvas>
    </div>

    <div class="footer-bottom">
      <div class="footer-credits">
        <div class="footer-legal"><a href={content.licenseHref}>{content.licenseLabel}</a><span>{content.copyrightLabel.replace('{year}', String(new Date().getUTCFullYear()))}</span><CookieSettingsLink label={content.cookieSettingsLabel} /></div>
      </div>
      <a class="footer-takeoff" href="#top">{content.backToTopLabel}<span class="footer-takeoff-arrow" aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<script>
  import { initFooterWordmark } from './footer-wordmark';

  document.querySelectorAll<HTMLElement>('[data-footer-wordmark]').forEach((wordmark) => {
    initFooterWordmark(wordmark);
  });
</script>

<style>
  .site-footer {
    --scroll-surface-color: var(--footer-lime);
    --footer-ink: var(--color-ink);
    --footer-lime: var(--color-lime);
    --footer-muted: #384526;
    --footer-rule: rgb(11 13 12 / 25%);
    --footer-gutter: clamp(20px, 4vw, 64px);
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
    padding: calc(var(--site-header-height) + clamp(24px, 4vh, 44px)) var(--footer-gutter) clamp(20px, 3vh, 36px);
    color: var(--footer-ink);
    background: var(--footer-lime);
    border-top: 1px solid var(--footer-lime);
    overflow-wrap: anywhere;
    isolation: isolate;
  }

  .site-footer * { box-sizing: border-box; }
  .site-footer ::selection { background: var(--footer-ink); color: var(--footer-lime); }
  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer :focus-visible { outline: 2px solid var(--footer-ink); outline-offset: 4px; }

  .footer-frame {
    display: grid;
    grid-template-rows: min-content minmax(136px, 1fr) auto;
    gap: clamp(20px, 3vh, 36px);
    height: calc(100% + 12px);
    min-width: 0;
    min-height: 0;
    overflow: auto;
    padding: 6px;
    margin: -6px;
    scroll-padding-block: 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--footer-ink) var(--footer-lime);
  }

  .footer-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 7vw, 112px);
    min-width: 0;
    align-items: start;
  }

  .footer-invitation, .footer-navigation, .footer-link-group { min-width: 0; }
  .footer-invitation h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(48px, 4.7vw, 72px);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -.06em;
    text-wrap: balance;
  }
  .footer-actions { --footer-action-gap: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: var(--footer-action-gap); margin-top: 25px; }
  .footer-github {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    max-width: 100%;
    min-height: 48px;
    padding: 5px 5px 5px 18px;
    border: 1px solid var(--footer-ink);
    border-radius: 999px;
    background: var(--footer-ink);
    color: var(--footer-lime) !important;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.4;
    transition: background-color 150ms ease-out;
  }
  .footer-github > span:not(.footer-github-arrow) { padding-block: 6px; }
  .footer-github-arrow {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    margin-left: 10px;
    border: 1px solid rgb(200 255 61 / 35%);
    border-radius: 50%;
  }

  .footer-navigation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 24px;
    padding-top: 5px;
  }
  .footer-link-group {
    padding-left: clamp(16px, 2.3vw, 36px);
    border-left: 1px solid var(--footer-rule);
  }
  .footer-link-group h3 {
    margin: 0 0 18px;
    color: var(--footer-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .footer-link-group ul { list-style: none; margin: 0; padding: 0; }
  .footer-link-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    min-height: 44px;
    padding-block: 7px;
    font-size: 14px;
    line-height: 1.45;
    transition: color 150ms ease-out;
  }
  .footer-link-group a > span { min-width: 0; }
  .footer-link-group a :global(svg) { color: var(--footer-ink); opacity: 0; transition: opacity 150ms ease-out; }
  .footer-link-group a:focus-visible :global(svg) { opacity: 1; }

  .footer-wordmark {
    position: relative;
    min-width: 0;
    min-height: 136px;
    color: var(--footer-ink);
  }
  .footer-wordmark-source, .footer-wordmark-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .footer-wordmark-source { pointer-events: none; }
  .footer-wordmark-source img { width: 100%; height: 100%; object-fit: contain; }
  .footer-wordmark-source :global(svg) { display: block; width: 100%; height: 100%; }
  .footer-wordmark-canvas { display: block; opacity: 0; }
  .footer-wordmark[data-wordmark-ready="true"] .footer-wordmark-source { visibility: hidden; }
  .footer-wordmark[data-wordmark-ready="true"] .footer-wordmark-canvas { opacity: 1; }

  .footer-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    min-width: 0;
    padding-top: 16px;
    border-top: 1px solid var(--footer-rule);
  }
  .footer-credits { min-width: 0; color: var(--footer-muted); font-size: 11px; line-height: 1.6; }
  .footer-legal { display: flex; align-items: center; flex-wrap: wrap; gap: 0 20px; }
  .footer-legal a { display: inline-flex; align-items: center; min-height: 44px; }
  .footer-socials { display: flex; align-items: center; gap: var(--footer-action-gap); }
  .footer-social {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: 1px solid rgb(11 13 12 / 30%);
    border-radius: 50%;
  }
  a.footer-social { transition: color 150ms ease-out, background-color 150ms ease-out; }
  .footer-takeoff { display: inline-flex; align-items: center; gap: 15px; min-height: 44px; justify-self: end; font-size: 12px; }
  .footer-takeoff-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(11 13 12 / 35%);
    border-radius: 50%;
    color: var(--footer-ink);
    font-size: 21px;
    line-height: 1;
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }

  @media (hover: hover) {
    .footer-github:hover { background: #243019; }
    .footer-link-group a:hover, .footer-legal a:hover { color: var(--footer-ink); }
    .footer-link-group a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .footer-link-group a:hover :global(svg) { opacity: 1; }
    .footer-legal a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .footer-takeoff:hover .footer-takeoff-arrow { color: var(--footer-lime); background: var(--footer-ink); }
    a.footer-social:hover { color: var(--footer-lime); background: var(--footer-ink); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-github { transition: background-color 150ms ease-out, scale 150ms ease-out; }
    .footer-github:active { scale: .96; }
    .footer-github-arrow :global(svg) { transition: transform 200ms cubic-bezier(.2, 0, 0, 1); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .footer-github:hover .footer-github-arrow :global(svg) { transform: rotate(45deg); }
  }

  @media (max-width: 760px) {
    .footer-frame { gap: 20px; }
    .footer-body { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .footer-invitation h2 { font-size: clamp(42px, 10vw, 62px); max-width: 14ch; }
    .footer-actions { margin-top: 20px; }
    .footer-navigation { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-top: 0; column-gap: 20px; }
    .footer-link-group { padding-left: 15px; }
    .footer-link-group h3 { margin-bottom: 10px; font-size: 9px; }
    .footer-link-group a { font-size: 13px; }
    .footer-wordmark { min-height: 112px; }
    .footer-frame { grid-template-rows: min-content minmax(112px, 1fr) auto; }
    .footer-bottom { gap: 12px; padding-top: 12px; }
    .footer-credits { font-size: 10px; }
    .footer-takeoff { gap: 8px; font-size: 11px; }
    .footer-takeoff-arrow { width: 34px; height: 34px; font-size: 19px; }
  }

  @media (max-width: 420px) {
    .footer-bottom { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .footer-takeoff { justify-self: start; }
  }

  @media (max-height: 700px) {
    .site-footer { --footer-gutter: clamp(16px, 3vw, 32px); padding-top: calc(var(--site-header-height) + 20px); padding-bottom: 16px; }
    .footer-frame { gap: 20px; }
    .footer-invitation h2 { font-size: clamp(40px, 4.6vw, 60px); }
    .footer-actions { margin-top: 18px; }
  }

  @media (max-height: 390px) {
    .site-footer { padding: calc(var(--site-header-height) + 12px) 20px 12px; }
    .footer-body { gap: 24px; }
  }

  @media (max-height: 200px) {
    .site-footer { padding: calc(var(--site-header-height) + 8px) 16px 8px; }
  }

  @media (forced-colors: active) {
    .site-footer { border-color: CanvasText; }
    .footer-wordmark-source { color: CanvasText; visibility: visible !important; }
    .footer-wordmark-canvas { display: none; }
    .footer-github { color: ButtonText !important; border-color: ButtonText; }
    .footer-link-group a :global(svg) { opacity: 1; }
  }
</style>
