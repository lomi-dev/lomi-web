---
import Icon from './Icon';
import { site } from '../data/site';
import logo from '../assets/lomi-wordmark.svg?raw';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['footer'] }
const { content } = Astro.props;
---

<footer class="site-footer" aria-label="lomi footer">
  <div class="footer-frame" tabindex="0" role="region" aria-label="Footer content">
    <div class="footer-header">
      <a class="footer-brand" href="#top" aria-label="lomi — back to top"><span aria-hidden="true"><Fragment set:html={logo} /></span></a>
    </div>
    <div class="footer-body">
      <div class="footer-invitation">
        <h2>{content.signoff}</h2>
        <p>{content.tagline}</p>
        <a class="footer-github" href={site.github}><Icon name="github" width={20} height={20} />{content.githubLabel}<Icon name="diagonal" width={18} height={18} /></a>
      </div>
      <nav class="footer-navigation" aria-label="Footer navigation">
        {content.groups.map((group) => <div class="footer-link-group">
          <h3>{group.title}</h3>
          <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </div>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="footer-credits"><p>{content.colophon}</p><div class="footer-legal"><a href={`${site.github}/blob/main/LICENSE`}>{content.licenseLabel}</a><span>© {new Date().getUTCFullYear()} lomi</span></div></div>
      <a class="footer-takeoff" href="#top">{content.backToTopLabel}<span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    box-sizing: border-box;
    overflow: hidden;
    background: #c8ff3d;
    color: #0b0d0c;
    overflow-wrap: anywhere;
    padding: clamp(20px, 4vw, 64px);
  }

  .site-footer * { box-sizing: border-box; }

  .footer-frame {
    display: grid;
    grid-template-rows: auto minmax(min-content, 1fr) auto;
    gap: clamp(20px, 4vh, 48px);
    height: calc(100% + 12px);
    min-width: 0;
    min-height: 0;
    overflow: auto;
    padding: 6px;
    margin: -6px;
    scrollbar-color: #0b0d0c #c8ff3d;
  }

  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .site-footer :focus-visible { outline: 2px solid #0b0d0c; outline-offset: 4px; }
  .footer-header { min-width: 0; }
  .footer-brand { display: inline-flex; align-items: center; min-height: 44px; width: 105px; }
  .footer-brand span { display: block; width: 100%; }
  .footer-brand :global(svg) { display: block; width: 100%; height: auto; }

  .footer-body {
    min-height: min-content;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-content: start;
    gap: clamp(32px, 7vw, 112px);
  }

  /* Intrinsic row sizes keep CMS content intact; the frame scrolls whenever
     the combined header, body and credits exceed the available height. */
  .footer-body { align-content: safe center; }
  .footer-invitation, .footer-navigation, .footer-link-group { min-width: 0; }
  .footer-invitation h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(48px, 6.8vw, 100px);
    line-height: .98;
    font-weight: 550;
    letter-spacing: -.065em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .footer-invitation p { max-width: 35ch; margin: 28px 0 20px; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.5; }
  .footer-github { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 48px; max-width: 100%; box-sizing: border-box; padding: 12px 18px; border: 1px solid currentColor; border-radius: 999px; font-size: 15px; font-weight: 550; }
  .footer-github :global(svg) { flex-shrink: 0; }
  .footer-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: 32px 24px; }
  .footer-link-group h3 { margin: 0 0 14px; font-size: 12px; line-height: 1.5; font-weight: 550; letter-spacing: .1em; text-transform: uppercase; overflow-wrap: anywhere; }
  .footer-link-group ul { list-style: none; margin: 0; padding: 0; }
  .footer-link-group a { display: flex; align-items: center; min-height: 44px; font-size: 16px; line-height: 1.35; padding: 6px 0; box-sizing: border-box; overflow-wrap: anywhere; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: end; gap: 24px; border-top: 1px solid rgb(11 13 12 / 35%); padding-top: 18px; min-width: 0; }
  .footer-credits { min-width: 0; font-size: 12px; line-height: 1.5; }
  .footer-credits p { margin: 0; overflow-wrap: anywhere; }
  .footer-legal { display: flex; align-items: center; flex-wrap: wrap; column-gap: 20px; }
  .footer-legal a { display: inline-flex; align-items: center; min-height: 44px; }
  .footer-takeoff { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; flex-shrink: 0; font-size: 13px; }
  .footer-takeoff span { font-size: 24px; line-height: 1; }

  @media (max-width: 760px) {
    .footer-frame { gap: 24px; }
    .footer-body { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .footer-invitation h2 { font-size: clamp(44px, 9vw, 68px); }
    .footer-invitation p { margin: 20px 0 16px; }
    .footer-bottom { align-items: start; gap: 12px; }
    .footer-takeoff { gap: 8px; }
  }

  @media (max-width: 420px) {
    .footer-bottom { flex-direction: column; gap: 4px; }
    .footer-navigation { column-gap: 16px; }
  }

  @media (max-height: 700px) {
    .site-footer { padding: clamp(16px, 3vw, 32px); }
    .footer-frame { gap: 20px; }
    .footer-invitation h2 { font-size: clamp(44px, 5.5vw, 72px); }
    .footer-invitation p { margin: 16px 0; }
    .footer-bottom { padding-top: 10px; }
  }

  /* Compact spacing for short windows; the same frame remains the only
     scroll container. The outer footer stays exactly 100dvh at every size. */
  @media (max-height: 390px) {
    .site-footer { padding: 12px 20px; }
    .footer-frame { display: block; padding: 4px; margin: -4px; height: calc(100% + 8px); }
    .footer-brand { width: 85px; }
    .footer-body { margin: 20px 0; padding: 4px; align-content: start; }
    .footer-invitation h2 { font-size: 44px; }
    .footer-bottom { margin-top: 24px; }
  }

  @media (max-height: 320px) {
    .footer-body { gap: 24px; }
    .footer-invitation h2 { font-size: 40px; }
  }

  @media (max-height: 200px) {
    .site-footer { padding: 8px 16px; }
    .footer-body { margin-top: 12px; }
  }
</style>
