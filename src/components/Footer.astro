---
import Icon from './Icon';
import { site } from '../data/site';
import logo from '../assets/lomi-wordmark.svg?raw';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['footer'] }
const { content } = Astro.props;
---

<footer class="site-footer" aria-label="lomi footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-invitation">
        <h2>{content.tagline}</h2>
        <a class="text-link" href={site.github}><Icon name="github" width={18} height={18} />{content.githubLabel}<Icon name="diagonal" width={15} height={15} /></a>
      </div>
      <nav class="footer-navigation" aria-label="Footer navigation">
        {content.groups.map((group) => <div class="footer-link-group">
          <h3>{group.title}</h3>
          <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </div>)}
      </nav>
    </div>
    <div class="footer-signature">
      <p>{content.signoff}</p>
      <a class="footer-takeoff" href="#top">{content.backToTopLabel}<span aria-hidden="true">↑</span></a>
    </div>
    <div class="footer-wordmark" aria-hidden="true"><Fragment set:html={logo} /></div>
    <div class="footer-bottom">
      <p>{content.colophon}</p>
      <a href={`${site.github}/blob/main/LICENSE`}><span class="status-dot" aria-hidden="true"></span>{content.licenseLabel}</a>
      <span>© {new Date().getUTCFullYear()} lomi</span>
    </div>
  </div>
</footer>
