---
import { agentWorkflowLinks, workspaceResourceLinks } from '../data/navigation';
---

<section id="agent-workflows" class="agent-workflows" aria-labelledby="agent-workflows-title">
  <div class="shell">
    <div class="workflow-heading">
      <h2 id="agent-workflows-title">Your agent.<br />Your way of working.</h2>
      <p>Keep the CLI you know. Give it a workspace with your files, a local app preview and Git.</p>
    </div>
    <div class="workflow-links">
      {agentWorkflowLinks.map((guide, index) => <a class="workflow-link" href={guide.href}>
        <span class="workflow-number" aria-hidden="true">0{index + 1}</span>
        <span class="workflow-copy"><h3>{guide.label}</h3><span>{index === 0 ? 'From your first terminal session to reviewing the diff.' : 'Run Codex CLI beside the code and app you are building.'}</span></span>
        <span class="workflow-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <nav class="workflow-resources" aria-label="Choose and use a coding workspace">
      {workspaceResourceLinks.map((resource) => <a href={resource.href}>
        <span class="resource-label">{resource.label}<span aria-hidden="true">↗</span></span>
        <span class="resource-description">{resource.description}</span>
      </a>)}
    </nav>
  </div>
</section>

<style>
  .agent-workflows { padding-block: clamp(64px, 8vw, 112px); background: var(--color-chalk); }
  .workflow-heading { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: end; margin-bottom: 44px; }
  .workflow-heading h2 { font-size: clamp(36px, 4.2vw, 58px); }
  .workflow-heading p { max-width: 390px; color: var(--color-text-secondary); font-size: 16px; line-height: 1.7; }
  .workflow-links { border-top: 1px solid var(--line); }
  .workflow-link { display: flex; align-items: baseline; gap: 28px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .workflow-number { color: var(--color-text-secondary); font-size: 12px; font-variant-numeric: tabular-nums; }
  .workflow-copy { display: grid; gap: 10px; flex: 1; }
  .workflow-copy h3 { font-size: clamp(23px, 2.4vw, 32px); }
  .workflow-copy > span { color: var(--color-text-secondary); font-size: 15px; line-height: 1.6; }
  .workflow-arrow { font-size: 24px; }
  .workflow-link:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  .workflow-resources { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; margin-top: 32px; }
  .workflow-resources a { display: grid; align-content: start; gap: 8px; min-height: 44px; padding-block: 8px; }
  .resource-label { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; line-height: 1.6; }
  .resource-description { max-width: 48ch; color: var(--color-text-secondary); font-size: 13px; line-height: 1.7; }
  .workflow-resources a:hover .resource-label { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 767px) { .workflow-heading { grid-template-columns: 1fr; gap: 24px; } .workflow-link { gap: 16px; } .workflow-resources { grid-template-columns: 1fr; gap: 16px; margin-top: 24px; } }
</style>
