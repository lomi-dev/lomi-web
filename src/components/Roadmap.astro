---
import Icon from './Icon';
import type { Landing } from '../../content/landing-schema';
import { summarizeRoadmapStage } from '../../content/roadmap-progress';

interface Props { content: Landing['roadmap'] }
const { content } = Astro.props;
const taskStatusLabels = { completed: content.ui.legendCompleted, 'in-progress': content.ui.legendProgress, 'not-started': content.ui.legendPlanned };
const progressText = (completed: number, total: number) => content.ui.progressTemplate.replaceAll('{completed}', String(completed)).replaceAll('{total}', String(total));
const stages = content.items.map((item) => ({ ...item, ...summarizeRoadmapStage(item) }));
---

<section id="roadmap" class="roadmap-story" aria-labelledby="roadmap-title" data-scroll-surface data-roadmap-mode="static">
  <div class="roadmap-viewport" data-roadmap-viewport>
    <div class="roadmap-stage" data-roadmap-stage>
      <div class="roadmap-scene-track" data-roadmap-track>
        <div class="roadmap-intro">
          <h2 id="roadmap-title">{content.title}</h2>
          <p class="roadmap-intro-description">{content.description}</p>
          <ul class="roadmap-legend" aria-label={content.ui.legendLabel}>
            {Object.entries(taskStatusLabels).map(([status, label]) => <li data-task-status={status}>
              <span class="roadmap-task-marker" aria-hidden="true">{status === 'completed' && <Icon name="check" width={12} height={12} />}{status === 'in-progress' && <span></span>}</span>
              <span>{label}</span>
            </li>)}
          </ul>
          <span class="roadmap-scroll-hint" aria-hidden="true">{content.ui.scrollHint} <span>→</span></span>
        </div>
        <div class="roadmap-spine" aria-hidden="true"><span></span></div>
        <ol class="roadmap-milestones">
          {stages.map((item, index) => <li class="roadmap-milestone" data-roadmap-milestone data-status={item.status} id={`roadmap-stage-${index + 1}`}>
            <div class="milestone-stem" aria-hidden="true"><span></span></div>
            <span class="milestone-coordinate" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="milestone-copy" data-roadmap-copy>
              <p class="milestone-phase">{item.phase}</p>
              <h3>{item.title}</h3>
              <p class="milestone-description">{item.description}</p>
              <div class="roadmap-task-progress">
                <div class="roadmap-progress-caption"><span>{progressText(item.completed, item.total)}</span><span class="roadmap-progress-percent">{item.percent}%</span></div>
                <progress value={item.completed} max={item.total} aria-label={content.ui.progressLabel.replaceAll('{phase}', item.phase)} aria-valuetext={`${progressText(item.completed, item.total)} (${item.percent}%)`}>{item.percent}%</progress>
              </div>
              <ul class="roadmap-tasks">{item.tasks.map((task) => <li class="roadmap-task" data-task-status={task.status}>
                <span class="roadmap-task-marker" aria-hidden="true">{task.status === 'completed' && <Icon name="check" width={12} height={12} />}{task.status === 'in-progress' && <span></span>}</span>
                <span><span class="roadmap-task-label" data-roadmap-task-label>{task.label}</span><span class="roadmap-sr-only">: {taskStatusLabels[task.status]}</span></span>
              </li>)}</ul>
            </div>
          </li>)}
        </ol>
      </div>
    </div>

    <div class="roadmap-bottom roadmap-shell">
      <nav class="roadmap-controls" aria-label={content.ui.stagesLabel}>
        {content.items.map((item, index) => <button type="button" data-roadmap-jump={index} aria-controls={`roadmap-stage-${index + 1}`} aria-label={content.ui.exploreLabel.replaceAll('{phase}', item.phase)}><span class="roadmap-control-index">{String(index + 1).padStart(2, '0')}</span><span class="roadmap-control-label">{item.phase}</span></button>)}
      </nav>
      <a class="roadmap-discuss" href={content.href}>{content.linkLabel}<Icon name="diagonal" width={16} height={16} /></a>
    </div>
  </div>
</section>

<script>
  import { initRoadmap } from './roadmap-timeline';
  document.querySelectorAll<HTMLElement>('.roadmap-story').forEach(initRoadmap);
</script>

<style>
  .roadmap-story {
    --scroll-surface-color: var(--color-dark);
    --roadmap-background: var(--color-dark);
    --roadmap-foreground: var(--color-dark-text);
    --roadmap-muted: #adb7a5;
    --roadmap-accent: var(--color-lime);
    --roadmap-gutter: clamp(24px, 5.2vw, 112px);
    --roadmap-intro-width: min(600px, 48vw);
    --roadmap-column-width: clamp(340px, 29vw, 430px);
    --roadmap-gap: clamp(56px, 6vw, 104px);
    position: relative;
    padding-block: 56px 72px;
    background: var(--roadmap-background);
    color: var(--roadmap-foreground);
    overflow-wrap: anywhere;
  }
  .roadmap-shell { width: calc(100% - var(--roadmap-gutter) * 2); max-width: 1640px; margin-inline: auto; }
  .roadmap-stage { margin-top: 0; }
  .roadmap-scene-track { width: calc(100% - var(--roadmap-gutter) * 2); max-width: 1280px; margin-inline: auto; }
  .roadmap-intro { max-width: 760px; padding-bottom: 64px; }
  h2 { max-width: 660px; font-size: clamp(44px, 5.2vw, 76px); line-height: 1.04; letter-spacing: -.06em; text-wrap: balance; }
  .roadmap-intro-description { max-width: 420px; margin-top: 26px; color: var(--roadmap-muted); font-size: 14px; line-height: 1.8; }
  .roadmap-scroll-hint { display: none; }
  .roadmap-spine { display: none; }
  .roadmap-milestones { list-style: none; padding: 0; margin: 0; }
  .roadmap-milestone { position: relative; padding: 0 0 52px 40px; border-left: 1px solid #596849; }
  .roadmap-milestone:last-child { padding-bottom: 0; border-color: transparent; }
  .milestone-stem { position: absolute; top: 0; left: -5px; width: 9px; height: 9px; border: 1px solid var(--roadmap-accent); border-radius: 50%; background: var(--roadmap-background); }
  [data-status='available'] .milestone-stem { background: var(--roadmap-accent); }
  .milestone-coordinate { display: none; }
  .milestone-copy { max-width: 640px; }
  .milestone-phase { margin-bottom: 12px; font-size: 13px; line-height: 1.5; font-weight: 500; color: var(--roadmap-muted); }
  h3 { font-size: 26px; font-weight: 500; line-height: 1.2; letter-spacing: -.035em; }
  .milestone-description { margin-top: 9px; color: var(--roadmap-muted); font-size: 13px; line-height: 1.7; }
  .roadmap-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin: 24px 0 0; padding: 0; list-style: none; color: var(--roadmap-muted); font-size: 11px; line-height: 1.5; }
  .roadmap-legend li { display: flex; align-items: center; gap: 7px; }
  .roadmap-task-progress { margin-top: 18px; }
  .roadmap-progress-caption { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 7px; color: var(--roadmap-muted); font-size: 11px; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .roadmap-progress-percent { color: var(--roadmap-foreground); }
  .roadmap-task-progress progress { display: block; appearance: none; width: 100%; height: 2px; border: 0; border-radius: 99px; overflow: hidden; background: #34402c; color: var(--roadmap-accent); }
  .roadmap-task-progress progress::-webkit-progress-bar { background: #34402c; border-radius: inherit; }
  .roadmap-task-progress progress::-webkit-progress-value { background: var(--roadmap-accent); border-radius: inherit; }
  .roadmap-task-progress progress::-moz-progress-bar { background: var(--roadmap-accent); border-radius: inherit; }
  .roadmap-tasks { list-style: none; display: grid; margin: 14px 0 0; padding: 0; }
  .roadmap-task { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; color: #c7d0be; font-size: 13px; line-height: 1.55; }
  .roadmap-task + .roadmap-task { border-top: 1px solid #2c3826; }
  .roadmap-task > span:last-child { min-width: 0; }
  .roadmap-task-marker { position: relative; display: grid; flex: 0 0 14px; place-items: center; width: 14px; height: 14px; margin-top: 2px; color: var(--roadmap-accent); }
  [data-task-status='not-started'] > .roadmap-task-marker::before { content: ''; width: 6px; height: 6px; border: 1px solid #819370; border-radius: 50%; }
  [data-task-status='in-progress'] > .roadmap-task-marker::before { content: ''; position: absolute; inset: 2px; border: 1px solid var(--roadmap-accent); border-radius: 50%; }
  [data-task-status='in-progress'] > .roadmap-task-marker > span { width: 3px; height: 3px; border-radius: 50%; background: var(--roadmap-accent); }
  .roadmap-task-marker :global(svg) { stroke-width: 2; }
  .roadmap-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .roadmap-bottom { display: flex; justify-content: flex-end; align-items: center; gap: 24px; margin-top: 48px; border-top: 1px solid #35402e; padding-top: 18px; }
  .roadmap-controls { display: none; }
  .roadmap-discuss { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 44px; font-size: 12px; }
  .roadmap-discuss svg { color: var(--roadmap-accent); transition: transform 180ms var(--ease-out); }
  .roadmap-story :focus-visible { outline: 2px solid var(--roadmap-accent); outline-offset: 5px; }

  .roadmap-story[data-roadmap-mode='horizontal'] { height: calc(100svh - var(--site-header-height) + var(--roadmap-distance)); padding: 0; }
  [data-roadmap-mode='horizontal'] .roadmap-viewport { position: sticky; top: var(--site-header-height); height: calc(100svh - var(--site-header-height)); display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; padding-block: 28px 20px; }
  [data-roadmap-mode='horizontal'] .roadmap-stage { position: relative; min-width: 0; width: 100%; min-height: 0; overflow: clip; }
  [data-roadmap-mode='horizontal'] .roadmap-scene-track { position: relative; display: flex; align-items: stretch; gap: var(--roadmap-gap); width: max-content; max-width: none; height: 100%; padding-inline: var(--roadmap-gutter) max(var(--roadmap-gutter), calc(50vw - var(--roadmap-column-width) / 2)); margin: 0; will-change: transform; }
  [data-roadmap-mode='horizontal'] .roadmap-intro { display: flex; flex: 0 0 var(--roadmap-intro-width); flex-direction: column; justify-content: center; align-items: flex-start; padding: 0 24px 26px 0; }
  [data-roadmap-mode='horizontal'] h2 { font-size: clamp(52px, 5.2vw, 80px); }
  [data-roadmap-mode='horizontal'] .roadmap-intro-description { max-width: 360px; font-size: 13px; }
  [data-roadmap-mode='horizontal'] .roadmap-scroll-hint { display: flex; align-items: center; gap: 40px; margin-top: 42px; color: var(--roadmap-muted); font: 12px/1.6 var(--font-sans); }
  .roadmap-scroll-hint > span { color: var(--roadmap-accent); font-family: var(--font-sans); font-size: 22px; }
  [data-roadmap-mode='horizontal'] .roadmap-spine { position: absolute; display: block; top: 50%; left: calc(var(--roadmap-gutter) + var(--roadmap-intro-width) + var(--roadmap-gap) - 48px); right: max(var(--roadmap-gutter), calc(50vw - var(--roadmap-column-width) / 2)); height: 1px; background: #4c5b3d; }
  .roadmap-spine > span { position: absolute; inset: 0; background: var(--roadmap-accent); transform: scaleX(var(--roadmap-draw, 0)); transform-origin: left; }
  [data-roadmap-mode='horizontal'] .roadmap-milestones { display: flex; gap: var(--roadmap-gap); height: 100%; }
  [data-roadmap-mode='horizontal'] .roadmap-milestone { flex: 0 0 var(--roadmap-column-width); width: var(--roadmap-column-width); height: 100%; padding: 0; border: 0; }
  [data-roadmap-mode='horizontal'] .milestone-stem { left: 0; top: 5%; width: 1px; height: 45%; border: 0; border-radius: 0; background: var(--roadmap-accent); transform: scaleY(var(--milestone-reveal, 1)); transform-origin: bottom; }
  [data-roadmap-mode='horizontal'] .milestone-stem > span { position: absolute; left: -3px; top: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--roadmap-accent); }
  [data-roadmap-mode='horizontal'] .roadmap-milestone:nth-child(even) .milestone-stem { top: 50%; height: 45%; transform-origin: top; }
  [data-roadmap-mode='horizontal'] .roadmap-milestone:nth-child(even) .milestone-stem > span { top: auto; bottom: -3px; }
  [data-roadmap-mode='horizontal'] .milestone-coordinate { position: absolute; display: block; left: 14px; top: calc(50% + 12px); color: #7b8a6d; font: 11px/1.5 var(--font-sans); }
  [data-roadmap-mode='horizontal'] .roadmap-milestone:nth-child(even) .milestone-coordinate { top: auto; bottom: calc(50% + 12px); }
  [data-roadmap-mode='horizontal'] .milestone-copy { position: absolute; left: 26px; right: 12px; top: 5%; max-width: none; transform: translateY(calc((1 - var(--milestone-reveal, 1)) * 18px)); clip-path: inset(0 0 calc((1 - var(--milestone-reveal, 1)) * 100%) 0); }
  [data-roadmap-mode='horizontal'] .roadmap-milestone:nth-child(even) .milestone-copy { top: calc(50% + 28px); }
  [data-roadmap-mode='horizontal'] h3 { font-size: 22px; }
  [data-roadmap-mode='horizontal'] .milestone-phase { margin-bottom: 10px; }
  [data-roadmap-mode='horizontal'] .roadmap-task-progress { margin-top: 12px; }
  [data-roadmap-mode='horizontal'] .roadmap-tasks { margin-top: 10px; }
  [data-roadmap-mode='horizontal'] .roadmap-task { padding-block: 8px; font-size: 12px; }
  [data-roadmap-mode='horizontal'] .roadmap-bottom { margin-top: 18px; padding-top: 14px; min-width: 0; }
  [data-roadmap-mode='horizontal'] .roadmap-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-right: auto; }
  .roadmap-controls button { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 10px; border: 0; background: transparent; color: #b1bba8; font: 12px/1.5 var(--font-sans); cursor: pointer; text-align: left; }
  .roadmap-control-index { color: #87947c; font-variant-numeric: tabular-nums; }
  .roadmap-controls [aria-current='step'], .roadmap-controls [aria-current='step'] .roadmap-control-index { color: var(--roadmap-accent); }
  @media (hover: hover) { .roadmap-controls button:hover { color: var(--roadmap-foreground); } .roadmap-discuss:hover svg { transform: translate(2px, -2px); } }
  @media (max-width: 767px) {
    .roadmap-story { --roadmap-gutter: 24px; padding-block: 32px 44px; }
    h2 { font-size: clamp(40px, 8.5vw, 62px); }
    .roadmap-intro { padding-bottom: 48px; }
    .roadmap-intro-description { font-size: 13px; margin-top: 22px; }
    .roadmap-milestone { padding-left: 26px; }
    .roadmap-bottom { margin-top: 34px; }
    .roadmap-discuss { justify-content: space-between; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .roadmap-discuss svg { transition: none; } }
</style>
