---
import { Picture } from 'astro:assets';
import sky from '../assets/clouds.png';
---

<div class="sky-background" aria-hidden="true">
  <Picture
    src={sky}
    alt=""
    formats={['avif', 'webp']}
    widths={[256, 400, 640, 800]}
    sizes="(max-width: 767px) 170px, (min-width: 1400px) 400px, 30vw"
    quality={72}
    loading="eager"
    fetchpriority="auto"
  />
</div>
