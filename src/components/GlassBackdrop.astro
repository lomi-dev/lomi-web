---
// Refracted glass over the brand Aurora (hero/glass.ts). Put it first inside a positioned,
// isolated section; the light follows the pointer anywhere in that section.
// `center`: the copy sits centred on top, so the light gathers low, behind the visual.
// `mirror`: the copy sits on the right, so the light moves to the left.
interface Props { center?: boolean; mirror?: boolean }
const { center = false, mirror = false } = Astro.props;
---
<div class="glass" aria-hidden="true"><canvas data-glass data-glass-center={center ? '' : undefined} data-glass-mirror={mirror ? '' : undefined}></canvas></div>

<script>
  import { mountGlass } from './hero/glass';
  document.querySelectorAll<HTMLCanvasElement>('[data-glass]').forEach((canvas) => mountGlass(canvas, canvas.closest('section') ?? canvas.parentElement!));
</script>

<style>
  /* The CSS picture shows until the shader draws (and without WebGL). */
  .glass { position: absolute; inset: 0; z-index: 0; pointer-events: none; background:
    repeating-linear-gradient(90deg, rgb(255 255 255 / .04) 0 1px, transparent 2px 52px, rgb(0 0 0 / .18) 54px 56px),
    radial-gradient(20% 24% at 92% 24%, rgb(185 245 0 / .4), transparent 70%),
    radial-gradient(42% 50% at 86% 100%, #723bfa, transparent 72%),
    radial-gradient(34% 40% at 58% 74%, rgb(76 27 191 / .85), transparent 70%),
    var(--color-night-950); }
  .glass canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 600ms ease-out; }
  .glass canvas[data-live] { opacity: 1; }
  /* fade into the page below */
  .glass::after { position: absolute; inset: auto 0 0; height: min(160px, 30%); background: linear-gradient(transparent, var(--color-night-950)); content: ''; }
</style>
