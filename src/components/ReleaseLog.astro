---
import releases from '../../content/releases.json';
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section id="releases" class="releases section" aria-labelledby="releases-title">
  <div class="shell">
    <h2 id="releases-title">Every release, in the open.</h2>
    <p class="section-description">What changed in each release.</p>
    <ol class="log" data-release-log>
      {releases.map((r, i) => (
        <li class="entry">
          <div class="meta">
            <span class="node" aria-hidden="true">{i === 0 ? <i class="sig sig-live"></i> : null}</span>
            <h3>{r.version}</h3>
            <time datetime={r.date}>{fmt.format(new Date(r.date))}</time>
            {i === 0 && <span class="eyebrow">Latest</span>}
          </div>
          <div class="body">
            <p class="summary">{r.summary}</p>
            {i < 3 && <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>}
            <a class="text-link" href={r.href} target="_blank" rel="noopener">Release notes on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .releases { padding-block: clamp(72px, 10vw, 128px); }
  .releases h2 { font-size: clamp(32px, 4vw, 56px); line-height: 1; }
  .releases .section-description { margin-top: 20px; }
  .log { position: relative; list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; }
  .log::before { position: absolute; top: 8px; bottom: 0; left: 4px; width: 1px; background: var(--line); content: ''; }
  .entry { position: relative; display: grid; grid-template-columns: minmax(180px, 1fr) minmax(0, 3fr); gap: 40px; padding: 0 0 48px 36px; margin-bottom: 48px; border-bottom: 1px solid var(--line); }
  .entry:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
  .node { position: absolute; top: 12px; left: -36px; width: 9px; height: 9px; display: grid; place-items: center; }
  .node:empty { border-radius: 3px; background: var(--color-night-600); }
  .node .sig { width: 9px; height: 9px; }
  .meta { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; align-self: start; }
  .meta h3 { font-size: 32px; line-height: 1.1; font-weight: 700; font-stretch: 125%; }
  .meta time { color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 13px; }
  .meta .eyebrow { color: var(--color-ink); }
  .body .text-link { margin-top: 8px; }
  .entry:nth-child(n+4) .meta h3 { font-size: 24px; }
  .summary { max-width: 62ch; color: var(--color-ink); font-size: 18px; line-height: 1.5; text-wrap: pretty; }
  .body ul { max-width: 68ch; margin: 20px 0 0; padding-left: 20px; color: var(--color-text-secondary); font-size: 15px; line-height: 1.6; }
  .body li + li { margin-top: 8px; }
  @media (min-width: 768px) { .meta { position: sticky; top: calc(var(--site-header-height) + 24px); } }
  @media (max-width: 767px) { .entry { grid-template-columns: minmax(0, 1fr); gap: 20px; } .meta h3 { font-size: 28px; } }
  .log.js .entry { opacity: 0; transform: translateY(12px); transition: opacity 360ms var(--ease-out), transform 360ms var(--ease-out); }
  .log.js .entry.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .log.js .entry { opacity: 1; transform: none; transition: none; } }
</style>

<script>
  const log = document.querySelector<HTMLElement>('[data-release-log]');
  if (log && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    log.classList.add('js');
    const io = new IntersectionObserver((rows) => rows.forEach((r) => { if (r.isIntersecting) { r.target.classList.add('in'); io.unobserve(r.target); } }), { rootMargin: '0px 0px -8% 0px' });
    log.querySelectorAll('.entry').forEach((e) => io.observe(e));
  }
</script>
