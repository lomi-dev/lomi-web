---
import GlassBackdrop from './GlassBackdrop.astro';
import type { Editable, MediaAsset } from '../../content/editor-schema';
import { pageDefaults } from '../../content/page-defaults';
import Icon from './Icon';
import { downloadPlatforms, packageUrl } from '../lib/downloads';
import releases from '../../content/releases.json';
import { Image } from 'astro:assets';
import dmgBackground from '../assets/install/dmg-background.png';

interface Props { content: Editable<typeof pageDefaults.download>; placeholderLogo?: MediaAsset | null }
const { content } = Astro.props;
const platforms = downloadPlatforms.map((platform) => ({ ...platform, ...content.platforms[platform.id] }));
const latest = releases[0];
const latestDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(latest.date));
// Plain file names for the full list of installers.
const fileType: Record<string, string> = { 'apple-silicon': '.dmg', intel: '.dmg', exe: '.exe', msi: '.msi', appimage: '.AppImage', deb: '.deb', rpm: '.rpm' };
---

<div class="download-page" data-download-page data-mode="manual" data-version={latest.version} data-download-copy={JSON.stringify(content)} data-scroll-surface data-release-state="loading">
  <script is:inline>
    // Before paint: a visitor who came from another page of this site gets the download started
    // for them; arrivals from search, other sites, typed URLs and phones see the button instead.
    (function (root) {
      try {
        var internal = document.referrer && new URL(document.referrer).origin === location.origin;
        var phone = /android|iphone|ipad|ipod|mobile/i.test(navigator.userAgent);
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var revisit = nav && (nav.type === 'reload' || nav.type === 'back_forward');
        if (internal && !phone && !location.hash && !revisit) root.dataset.mode = 'auto';
      } catch (error) { /* keep the button */ }
    })(document.currentScript.parentElement);
  </script>
  <section class="dl-hero" data-enter aria-labelledby="download-title">
    <GlassBackdrop center />
    <div class="dl-hero-inner shell">
      <img class="app-icon" src="/icons/lomi-app-icon.svg" width="96" height="96" alt="" />
      <h1 id="download-title"><span class="manual-only">{content.title}</span><span class="auto-only">Your download is starting.</span></h1>
      <p class="dl-description manual-only">{content.description.map((line, index) => <>{index > 0 && ' '}{line.text}</>)}</p>

      <div class="primary" id="install" aria-label={content.chooserLabel}>
        {platforms.map((platform) => <section class="platform-panel" id={platform.id} data-platform-panel={platform.id} hidden={platform.id !== "macos"} aria-label={content.downloadLabel.replaceAll("{platform}", platform.label)}>
          <fieldset data-package-options disabled class="visually-hidden">
            <legend>{platform.legend}</legend>
            {platform.packages.map((option, index) => <label><input type="radio" name={`package-${platform.id}`} value={option.id} checked={index === 0} tabindex="-1" />{content.packages[option.id].label}</label>)}
          </fieldset>
          <p class="auto-only auto-file">Lomi {latest.version} for {platform.label} <span aria-hidden="true">·</span> <span data-package-meta>{content.packages[platform.packages[0].id].statusLabel}</span></p>
          <p class="download-line"><span class="auto-only">Didn’t start? </span><a class="button button-primary package-download" href={packageUrl(platform.id, platform.packages[0].id, latest.version)} data-build-href={packageUrl(platform.id, platform.packages[0].id, latest.version)} data-download-action><Icon name="download" width={20} height={20} /><span data-action-label>{content.downloadLabel.replaceAll('{platform}', platform.label)}</span></a></p>
          <p class="manual-only primary-meta"><span data-package-meta>{content.packages[platform.packages[0].id].statusLabel}</span> <span aria-hidden="true">·</span> v{latest.version} <span aria-hidden="true">·</span> <a href="#all-downloads">Other platforms</a></p>
          <p class="package-status" data-package-status role="status" aria-live="polite"></p>
        </section>)}
        <noscript><p class="download-noscript">{content.noscript}</p></noscript>
        <div class="release-feedback"><p data-release-status role="status" aria-live="polite"></p><button type="button" data-release-retry hidden>{content.retryLabel}<Icon name="arrow" width={14} height={14} /></button></div>
      </div>
    </div>
  </section>

  <section class="install" id="how-to-install" aria-labelledby="install-title" data-install-os="macos">
    <div class="shell">
      <h2 id="install-title">How to install Lomi</h2>
      <div class="os-switch" role="tablist" aria-label="Operating system">
        {platforms.map((platform) => <button type="button" role="tab" data-install-tab={platform.id} aria-selected={platform.id === 'macos' ? 'true' : 'false'}><img src={`/icons/download-${platform.id}.svg`} width="16" height="16" alt="" />{platform.label}</button>)}
      </div>

      <ol class="steps" data-install-steps="macos">
        <li>
          <span class="num">1</span>
          <div class="art art-dock" aria-hidden="true"><div class="dock"><i></i><span class="dock-file"><b>Downloads</b><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m-4.5-4.5L12 15l4.5-4.5M5 19h14" /></svg></span><i></i></div></div>
          <p>Open the Lomi <strong>.dmg</strong> from your <strong>Downloads</strong> folder</p>
        </li>
        <li>
          <span class="num">2</span>
          {/* The real installer window: Lomi's DMG background, icons at the positions set in tauri.macos.conf.json. */}
          <div class="art art-dmg" aria-hidden="true">
            <Image src={dmgBackground} alt="" width={720} />
            <span class="dmg-item dmg-app"><img src="/icons/lomi-app-icon.svg" width="64" height="64" alt="" />Lomi</span>
            <span class="dmg-item dmg-folder"><svg viewBox="0 0 64 52" width="64" height="52"><path d="M4 8a4 4 0 0 1 4-4h16l6 6h26a4 4 0 0 1 4 4v30a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z" fill="#63b3f3" /><path d="M4 16h56v28a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z" fill="#8cccfb" /></svg>Applications</span>
          </div>
          <p>Drag <strong>Lomi</strong> into your <strong>Applications</strong> folder</p>
        </li>
        <li>
          <span class="num">3</span>
          <div class="art art-list" aria-hidden="true"><p class="list-title">Applications</p><span class="row"><i></i><s></s></span><span class="row row-on"><img src="/icons/lomi-app-icon.svg" width="28" height="28" alt="" />Lomi<svg class="cursor" viewBox="0 0 24 24" width="22" height="22"><path d="M5 3l14 8-6 1.5L10 19Z" fill="#fff" stroke="#0e0e11" stroke-width="1.2" stroke-linejoin="round" /></svg></span><span class="row"><i></i><s></s></span></div>
          <p>Open <strong>Lomi</strong> from your <strong>Applications</strong> folder</p>
        </li>
      </ol>

      <ol class="steps" data-install-steps="windows" hidden>
        <li>
          <span class="num">1</span>
          <div class="art art-file" aria-hidden="true"><span class="file-chip"><img src="/icons/lomi-app-icon.svg" width="40" height="40" alt="" /><span><b>Lomi_{latest.version}_x64-setup.exe</b><small>Downloads</small></span></span></div>
          <p>Run the <strong>setup .exe</strong> from your <strong>Downloads</strong> folder</p>
        </li>
        <li>
          <span class="num">2</span>
          <div class="art art-choice" aria-hidden="true"><span class="choice">More info</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-5-5 5 5-5 5" /></svg><span class="choice choice-on">Run anyway</span></div>
          <p>If SmartScreen appears, choose <strong>More info</strong>, then <strong>Run anyway</strong>. The installer isn’t Authenticode-signed yet</p>
        </li>
        <li>
          <span class="num">3</span>
          <div class="art art-search" aria-hidden="true"><span class="search"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg>lomi</span><span class="row row-on"><img src="/icons/lomi-app-icon.svg" width="28" height="28" alt="" />Lomi<small>App</small></span></div>
          <p>Open <strong>Lomi</strong> from the <strong>Start</strong> menu</p>
        </li>
      </ol>

      <ol class="steps steps-alt" data-install-steps="linux" hidden>
        <li>
          <div class="art art-term" aria-hidden="true"><code><span>$</span> chmod +x Lomi_{latest.version}_amd64.AppImage</code><code><span>$</span> ./Lomi_{latest.version}_amd64.AppImage</code></div>
          <p><strong>AppImage:</strong> make it executable, then run it</p>
        </li>
        <li>
          <div class="art art-term" aria-hidden="true"><code><span>$</span> sudo apt install ./Lomi_{latest.version}_amd64.deb</code></div>
          <p><strong>Debian or Ubuntu:</strong> install the .deb with apt</p>
        </li>
        <li>
          <div class="art art-term" aria-hidden="true"><code><span>$</span> sudo dnf install ./Lomi-{latest.version}-1.x86_64.rpm</code><code class="alt"><span>$</span> yay -S lomi-bin</code></div>
          <p><strong>Fedora:</strong> install the .rpm with dnf. <strong>Arch:</strong> use the AUR</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="all" id="all-downloads" aria-labelledby="all-title">
    <div class="shell">
      <div class="all-head">
        <h2 id="all-title">All downloads</h2>
        <p>Lomi {latest.version} <span aria-hidden="true">·</span> {latestDate} <span aria-hidden="true">·</span> <a href="/devlog/#releases">Release notes</a></p>
      </div>
      {/* One group per system: name and a note on the left, every installer on the right. */}
      <div class="dl-table">
        {platforms.map((platform) => <div class="group">
          <div class="group-label">
            <h3><img src={`/icons/download-${platform.id}.svg`} width="20" height="20" alt="" />{platform.label}</h3>
            <p>{platform.id === 'macos' ? 'Signed with Developer ID and notarized by Apple.' : platform.id === 'windows' ? 'For Windows x64. The installers are not Authenticode-signed yet.' : 'For x86_64 distributions.'}</p>
          </div>
          <ul class="files">
            {platform.packages.map((option) => <li><a class="file" href={packageUrl(platform.id, option.id, latest.version)} data-build-href={packageUrl(platform.id, option.id, latest.version)} data-package-link={`${platform.id}:${option.id}`}>
              <span class="file-name"><b>{content.packages[option.id].label}</b><small>{content.packages[option.id].detail}</small></span>
              <span class="file-meta"><span class="ext">{fileType[option.id]}</span><span class="size" data-size></span></span>
              <span class="file-get" aria-hidden="true"><Icon name="download" width={16} height={16} /></span>
            </a></li>)}
            {platform.id === 'linux' && content.showAur && <li class="aur" id="arch-linux">
              <span class="file-name"><b>Arch Linux</b><small>{content.aur.description}</small></span>
              <div class="aur-command"><code><span aria-hidden="true">$ </span><span id="aur-command">{content.aur.command}</span></code><button type="button" data-copy-aur hidden aria-label={content.aur.copyAriaLabel}><span data-copy-label>{content.aur.copyLabel}</span></button></div>
              <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
            </li>}
          </ul>
        </div>)}
      </div>
      {content.showHelp && <p class="download-help">{content.help.text} <a href={content.help.href}>{content.help.label}<Icon name="arrow" width={15} height={15} /></a></p>}
    </div>
  </section>
</div>

<script>
  import { initDownloadPage } from './download-page';
  document.querySelectorAll<HTMLElement>('[data-download-page]').forEach(initDownloadPage);

  // How to install: start on the detected system, then follow the visitor's choice.
  document.querySelectorAll<HTMLElement>('[data-install-os]').forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-install-tab]')];
    const show = (os: string) => {
      section.dataset.installOs = os;
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.installTab === os)));
      section.querySelectorAll<HTMLElement>('[data-install-steps]').forEach((list) => { list.hidden = list.dataset.installSteps !== os; });
    };
    const detected = section.closest<HTMLElement>('[data-download-page]')?.dataset.platform;
    if (detected) show(detected);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => show(tab.dataset.installTab ?? 'macos'));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        show(next.dataset.installTab ?? 'macos');
        next.focus();
      });
    });
  });
</script>

<style>
  .download-page { --scroll-surface-color: var(--color-chalk); background: var(--color-chalk); color: var(--color-ink); }

  /* First screen: the name, one button, and the real app rising from the bottom edge. */
  .dl-hero { position: relative; isolation: isolate; overflow: clip; display: flex; min-height: 100svh; }
  [data-mode='auto'] .manual-only, [data-mode='manual'] .auto-only { display: none; }
  .app-icon { width: clamp(80px, 10svh, 104px); height: auto; margin-bottom: clamp(20px, 3svh, 32px); border-radius: 23%; filter: drop-shadow(0 24px 48px rgb(0 0 0 / .6)) drop-shadow(0 0 60px rgb(114 59 250 / .45)); }
  .auto-file { margin-top: 18px; color: #c8c8d0; font-size: clamp(17px, 1.35vw, 19px); }
  .auto-file > span[aria-hidden] { margin-inline: 6px; color: var(--color-night-600); }
  .download-line { color: var(--color-text-secondary); font-size: 15px; }
  [data-mode='auto'] .download-line { margin-top: 10px; }
  /* in auto mode the action is a quiet "download again" link, not a button */
  [data-mode='auto'] .package-download { display: inline; min-height: 0; padding: 0; border: 0; background: none; box-shadow: none; color: #dcdce2; font-size: 15px; font-weight: 500; text-decoration: underline; text-decoration-color: var(--color-night-600); text-underline-offset: 4px; }
  [data-mode='auto'] .package-download :global(svg) { display: none; }
  [data-mode='auto'] .package-download:hover { transform: none; background: none; box-shadow: none; text-decoration-color: currentColor; }
  .dl-hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-block: calc(var(--site-header-height) + 40px) 72px; text-align: center; }
  .dl-hero h1 { font-size: clamp(52px, min(8vw, 13svh), 128px); line-height: .9; }
  .dl-description { margin-top: 18px; color: #c8c8d0; font-size: clamp(17px, 1.35vw, 19px); line-height: 1.5; }
  .primary { margin-top: clamp(28px, 4.5svh, 44px); }
  .platform-panel[hidden] { display: none; }
  .package-download { min-height: 60px; padding-inline: 32px; border-radius: 16px; font-size: 17px; gap: 12px; }
  .primary-meta { margin-top: 16px; color: var(--color-text-secondary); font-size: 14px; }
  .primary-meta span[aria-hidden] { margin-inline: 6px; color: var(--color-night-600); }
  .primary-meta a { color: #dcdce2; text-decoration: underline; text-decoration-color: var(--color-night-600); text-underline-offset: 4px; }
  .package-status { margin-top: 8px; color: var(--color-text-secondary); font-size: 13px; }
  .package-status:empty { display: none; }
  .release-feedback { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; color: var(--color-text-secondary); font-size: 13px; }
  .release-feedback > button { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0; border: 0; background: transparent; color: var(--color-violet-300); font: inherit; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .release-feedback > button[hidden] { display: none; }
  .download-noscript { margin-top: 12px; color: var(--color-text-secondary); font-size: 13px; }
  .visually-hidden, .platform-panel[data-package-available='true'] [data-package-status], [data-release-state='ready'] [data-release-status] { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }


  /* All downloads: one rounded table, a group per system. */
  .all { padding-block: 24px 112px; scroll-margin-top: 80px; }
  .all-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; }
  .all-head h2 { font-size: clamp(32px, 4vw, 56px); }
  .all-head p { color: var(--color-text-secondary); font-size: 14px; }
  .all-head p span { margin-inline: 4px; color: var(--color-night-600); }
  .all-head a, .download-help a { color: #dcdce2; text-decoration: underline; text-decoration-color: var(--color-night-600); text-underline-offset: 4px; }
  .dl-table { margin-top: 32px; overflow: hidden; border: 1px solid var(--line); border-radius: 24px; background: var(--color-paper); }
  .group { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(0, 2.4fr); }
  .group + .group { border-top: 1px solid var(--line); }
  .group-label { padding: 28px; }
  .group-label h3 { display: flex; align-items: center; gap: 12px; font-size: 20px; font-weight: 650; font-stretch: 112%; }
  .group-label h3 img { width: 20px; height: 20px; filter: brightness(0) invert(1); }
  .group-label p { max-width: 26ch; margin-top: 10px; color: var(--color-text-secondary); font-size: 13px; line-height: 1.55; }
  .files { margin: 0; padding: 12px; list-style: none; border-left: 1px solid var(--line); }
  .file { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 20px; min-height: 64px; padding: 10px 12px 10px 16px; border-radius: 14px; transition: background-color var(--dur-fast) ease-out; }
  .file-name { display: flex; flex-direction: column; gap: 2px; min-width: 0; text-align: left; }
  .file-name b { color: var(--color-ink); font-size: 15px; font-weight: 600; }
  .file-name small { color: var(--color-text-secondary); font-size: 13px; }
  .file-meta { display: flex; align-items: baseline; gap: 12px; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 12px; }
  .size:empty { display: none; }
  .file-get { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line-strong); border-radius: 12px; color: #dcdce2; transition: background-color var(--dur-fast) ease-out, border-color var(--dur-fast) ease-out, color var(--dur-fast) ease-out; }
  .file-get :global(svg) { transition: transform var(--dur) var(--ease-out); }
  .aur { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: center; gap: 8px 20px; margin-top: 4px; padding: 14px 12px 6px 16px; border-top: 1px solid var(--line); }
  .aur .copy-status { grid-column: 1 / -1; }
  .aur-command { display: flex; align-items: center; gap: 10px; padding: 4px 4px 4px 14px; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--color-night-950); }
  .aur-command code { flex: 1; min-width: 0; color: var(--color-ink); font: 13px/1.5 var(--font-mono); }
  .aur-command code > span:first-child { color: var(--color-signal); }
  .aur-command button { min-height: 38px; padding: 0 12px; border: 0; border-radius: 9px; background: rgb(247 247 249 / 7%); color: var(--color-ink); font: 600 13px/1 var(--font-sans); cursor: pointer; transition: background-color var(--dur-fast) ease-out, transform var(--dur) var(--ease-out); }
  .aur-command button[hidden] { display: none; }
  .aur-command button:active { transform: scale(.96); transition-duration: 60ms; }
  .copy-status { min-height: 0; color: var(--color-text-secondary); font-size: 12px; }
  .download-help { margin-top: 40px; color: var(--color-text-secondary); font-size: 14px; text-align: center; }
  .download-help a { display: inline-flex; align-items: center; gap: 8px; }

  @media (hover: hover) {
    .primary-meta a:hover, .all-head a:hover, .download-help a:hover { text-decoration-color: currentColor; }
    .file:hover { background: rgb(247 247 249 / 4%); }
    .file:hover .file-get { border-color: transparent; background: var(--color-lime); color: var(--on-accent); }
    .file:hover .file-get :global(svg) { transform: translateY(2px); }
    .aur-command button:hover { background: rgb(247 247 249 / 12%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dl-hero-inner > * { animation: hero-rise 800ms var(--ease-out) both; }
    .dl-hero-inner > :nth-child(2) { animation-delay: 70ms; }
    .dl-hero-inner > :nth-child(3) { animation-delay: 150ms; }
    .app-icon { animation: icon-in 1000ms var(--ease-out) both; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } }
  @keyframes icon-in { from { opacity: 0; transform: translateY(20px) scale(.88); filter: blur(8px); } }
  @media (max-width: 899px) { .group { grid-template-columns: minmax(0, 1fr); } .group-label { padding: 24px 24px 4px; } .files { border-left: 0; } .aur { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .file-name small { display: none; } .file { gap: 12px; } }
  @media (max-width: 767px) {
    .dl-hero-inner { padding-block: calc(var(--site-header-height) + 40px) 56px; }
    .dl-hero h1 { font-size: clamp(44px, 13vw, 60px); }
    .primary, .package-download { width: 100%; }
  }


  /* How to install: three numbered steps per system, the detected one first. */
  .install { padding-block: clamp(80px, 10vw, 128px) 48px; text-align: center; }
  .install h2 { font-size: clamp(32px, 4vw, 56px); }
  .os-switch { display: inline-flex; gap: 4px; margin-top: 28px; padding: 4px; border: 1px solid var(--line); border-radius: 14px; background: var(--color-paper); }
  .os-switch button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 0; border-radius: 10px; background: transparent; color: var(--color-text-secondary); font: 500 14px/1 var(--font-sans); cursor: pointer; transition: background-color var(--dur-fast) ease-out, color var(--dur-fast) ease-out, transform var(--dur) var(--ease-out); }
  .os-switch button img { width: 16px; height: 16px; opacity: .6; filter: brightness(0) invert(1); transition: opacity var(--dur-fast) ease-out; }
  .os-switch button[aria-selected='true'] { background: rgb(247 247 249 / 9%); color: var(--color-ink); }
  .os-switch button[aria-selected='true'] img { opacity: 1; }
  .os-switch button:active { transform: scale(.97); }
  @media (hover: hover) { .os-switch button[aria-selected='false']:hover { color: var(--color-ink); } }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; padding: 0; list-style: none; }
  .steps[hidden] { display: none; }
  .steps:not([hidden]) > li { animation: step-in 500ms var(--ease-out) both; }
  .steps > li:nth-child(2) { animation-delay: 60ms; }
  .steps > li:nth-child(3) { animation-delay: 120ms; }
