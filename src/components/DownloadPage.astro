---
import ContentMedia from './ContentMedia.astro';
import type { Editable, MediaAsset } from '../../content/editor-schema';
import { pageDefaults } from '../../content/page-defaults';
import Icon from './Icon';
import { downloadPlatforms, releaseFallback } from '../lib/downloads';

interface Props { content: Editable<typeof pageDefaults.download>; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
const platforms = downloadPlatforms.map((platform) => ({ ...platform, ...content.platforms[platform.id] }));
---

<div class="download-page" data-download-page data-download-copy={JSON.stringify(content)} data-scroll-surface data-release-state="loading">
  <div class="download-shell">
    <header class="download-opening">
      <h1>{content.title}</h1>
      <p>{content.description.map((line, index) => <>{index > 0 && <br />}{line.text}</>)}</p>
    </header>

    <div class="download-composition">
      <div class="download-options">
        <section class="download-chooser" id="install" aria-label={content.chooserLabel}>
          <div class="system-picker">
            <p class="control-label" id="system-label">{content.systemLabel}</p>
            <nav class="platform-tabs" data-platform-tabs aria-labelledby="system-label">
              {platforms.map((platform) => <a class="platform-tab" id={`tab-${platform.id}`} href={`#${platform.id}`} data-platform={platform.id}>
                <img src={`/icons/download-${platform.id}.svg`} width="22" height="22" alt="" aria-hidden="true" />
                <span>{platform.label}</span>
              </a>)}
            </nav>
          </div>
          <div class="platform-panels">
            {platforms.map((platform) => <section class="platform-panel" id={platform.id} data-platform-panel={platform.id} aria-label={content.downloadLabel.replaceAll('{platform}', platform.label)}>
              <fieldset data-package-options disabled>
                <legend class="control-label">{platform.legend}</legend>
                <div class:list={['package-options', { 'package-options-linux': platform.id === 'linux' }]}>
                  {platform.packages.map((option, index) => <label class="package-option" title={content.packages[option.id].detail}>
                    <input type="radio" name={`package-${platform.id}`} value={option.id} checked={index === 0} />
                    <span>{content.packages[option.id].label}</span>
                    <span class="visually-hidden">{content.packages[option.id].detail}</span>
                  </label>)}
                </div>
              </fieldset>
              <a class="button button-primary package-download" href={releaseFallback} data-download-action><Icon name="download" width={18} height={18} /><span data-action-label>{content.releasesLabel}</span></a>
              <p class="package-status" data-package-status role="status" aria-live="polite"></p>
              {platform.id === 'windows' && content.showWindowsHelp && <details class="package-help"><summary>{content.windowsHelp.title}<Icon name="plus" width={12} height={12} /></summary><p>{content.windowsHelp.description}</p></details>}
            </section>)}
          </div>
          <noscript><p class="download-noscript">{content.noscript}</p></noscript>
          <div class="release-feedback"><p data-release-status role="status" aria-live="polite"></p><button type="button" data-release-retry hidden>{content.retryLabel}<Icon name="arrow" width={14} height={14} /></button></div>
        </section>

        {content.showAur && <section class="aur-install" id="arch-linux" aria-labelledby="aur-title">
          <div class="aur-heading"><h2 id="aur-title">{content.aur.title}</h2><a href={content.aur.href}>{content.aur.linkLabel}<Icon name="diagonal" width={13} height={13} /></a></div>
          <p class="aur-description">{content.aur.description}</p>
          <div class="aur-command"><span aria-hidden="true">$</span><code id="aur-command">{content.aur.command}</code><button type="button" data-copy-aur hidden aria-label={content.aur.copyAriaLabel}><span data-copy-label>{content.aur.copyLabel}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg></button></div>
          <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        </section>}
      </div>

      {content.showScreenshot && <figure class="product-showcase">
        <div class="product-stage">
          <div class="preview-heading"><span>{content.screenshot.heading}</span><span class="preview-caption">{content.screenshot.caption}</span></div>
          <ContentMedia
            image={content.screenshot.image}
            placeholderLogo={placeholderLogo}
            placeholderVariant="download"
            alt={content.screenshot.alt}
            widths={[640, 960, 1440, 1920]}
            sizes="(min-width: 1280px) 720px, (min-width: 1000px) 54vw, (min-width: 768px) 620px, calc(100vw - 72px)"
            loading="eager"
            class="product-capture"
          />
        </div>
      </figure>}
    </div>
    {content.showHelp && <div class="download-help"><span>{content.help.text}</span><a href={content.help.href}>{content.help.label}<Icon name="arrow" width={16} height={16} /></a></div>}
  </div>
</div>

<script>
  import { initDownloadPage } from './download-page';
  document.querySelectorAll<HTMLElement>('[data-download-page]').forEach(initDownloadPage);
</script>

<style>
  .download-page { --scroll-surface-color: var(--color-paper); --download-muted: #5b6355; --download-line: #dfe4d8; background: var(--color-paper); color: var(--color-ink); padding: 132px 0 64px; }
  .download-shell { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .download-opening { max-width: 640px; margin: 0 auto 48px; text-align: center; }
  h1 { margin: 0; font-size: clamp(54px, 5vw, 72px); font-weight: 500; line-height: 1.06; letter-spacing: -.055em; text-wrap: balance; }
  .download-opening > p { margin-top: 20px; color: var(--download-muted); font-size: 17px; line-height: 1.65; }
  .download-composition { display: grid; grid-template-columns: 400px minmax(0, 1fr); align-items: start; gap: 28px 48px; }
  .download-options { display: flex; min-width: 0; flex-direction: column; gap: 28px; }
  .download-chooser { min-width: 0; padding: 24px; border: 1px solid var(--download-line); border-radius: 16px; background: var(--color-paper); }
  .control-label { display: block; color: #333e2b; font-size: 12px; font-weight: 500; line-height: 1.5; }
  .platform-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-top: 12px; padding: 4px; border-radius: 12px; background: #f0f3eb; box-shadow: inset 0 0 0 1px #e1e6d9; }
  .platform-tab { display: flex; align-items: center; justify-content: center; gap: 8px; min-width: 0; min-height: 48px; padding: 10px 4px; border-radius: var(--button-radius); color: #4c5843; font-size: 13px; font-weight: 500; line-height: 1.4; }
  .platform-tab img { display: block; flex-shrink: 0; width: 20px; height: 20px; opacity: .75; }
  .platform-tab[aria-selected='true'] { background: var(--color-ink); color: #fff; }
  .platform-tab[aria-selected='true'] img { opacity: 1; filter: brightness(0) invert(1); }
  .platform-tab:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; border-radius: var(--button-radius); }
  .platform-panels { padding-top: 24px; }
  .platform-panel { min-width: 0; scroll-margin-top: 96px; }
  .platform-panel[hidden] { display: none; }
  .platform-panel + .platform-panel { margin-top: 24px; }
  [data-download-ready] .platform-panel { margin-top: 0; }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  fieldset legend { margin-bottom: 12px; padding: 0; }
  .package-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 12px; background: #f0f3eb; box-shadow: inset 0 0 0 1px #e1e6d9; }
  .package-options-linux { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .package-option { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 44px; padding: 10px 8px; border-radius: var(--button-radius); color: #4c5843; font-size: 13px; font-weight: 500; line-height: 1.4; text-align: center; cursor: pointer; }
  .package-option input { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
  .package-option:has(input:checked) { background: var(--color-ink); color: #fff; }
  .package-option:has(input:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .package-option:has(input:disabled) { opacity: .55; cursor: not-allowed; }
  .package-download { width: 100%; min-height: 52px; margin-top: 20px; }
  .package-status { margin-top: 12px; color: var(--download-muted); font-size: 12px; line-height: 1.6; }
  .package-status:empty { display: none; }
  .package-help { margin-top: 4px; color: var(--download-muted); font-size: 11px; line-height: 1.7; }
  .package-help summary { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 36px; width: fit-content; margin-inline: auto; cursor: pointer; }
  .package-help summary :global(svg) { flex-shrink: 0; }
  .package-help[open] summary :global(svg) { transform: rotate(45deg); }
  .package-help > p { max-width: 48ch; padding-block: 4px 12px; }
  .release-feedback { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-top: 8px; color: var(--download-muted); font-size: 12px; line-height: 1.6; }
  .release-feedback > button { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0; border: 0; background: transparent; color: #345600; font: inherit; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .release-feedback > button[hidden] { display: none; }
  [data-release-state='loading'] .release-feedback, [data-release-state='ready'] .release-feedback { margin-top: 0; }
  .download-noscript { margin-top: 16px; color: var(--download-muted); font-size: 12px; line-height: 1.7; }
  .visually-hidden, .platform-panel[data-package-available='true'] [data-package-status], [data-release-state='ready'] [data-release-status] { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .aur-install { display: none; min-width: 0; padding-inline: 8px; scroll-margin-top: 96px; }
  [data-platform='linux'] .aur-install,
  .download-page:not([data-download-ready]):has(#linux:target, #arch-linux:target) .aur-install { display: block; }
  .aur-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .aur-heading h2 { font-size: 15px; font-weight: 500; line-height: 1.4; letter-spacing: -.02em; }
  .aur-heading > a { display: inline-flex; align-items: center; gap: 4px; min-height: 32px; color: #4c5942; font-size: 11px; }
  .aur-description { margin-top: 4px; color: var(--download-muted); font-size: 12px; line-height: 1.7; }
  .aur-command { display: flex; align-items: center; gap: 12px; min-height: 52px; margin-top: 12px; padding: 4px 8px 4px 16px; border: 1px solid var(--download-line); border-radius: 8px; background: #f7f8f3; }
  .aur-command > span { color: #778568; font: 13px/1.5 ui-monospace, 'SFMono-Regular', Consolas, monospace; }
  .aur-command code { min-width: 0; flex: 1; color: #273b16; font: 13px/1.5 ui-monospace, 'SFMono-Regular', Consolas, monospace; overflow-wrap: anywhere; }
  .aur-command button { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; padding: 0 8px; border: 0; border-radius: var(--button-radius); background: transparent; color: #526446; font: inherit; font-size: 11px; cursor: pointer; }
  .aur-command button[hidden] { display: none; }
  .copy-status { min-height: 18px; margin-top: 4px; color: var(--download-muted); font-size: 11px; line-height: 1.6; }
  .product-showcase { align-self: start; min-width: 0; margin: 0; }
  .product-stage { overflow: hidden; padding: 32px; border-radius: 16px; background: #edf1e7; }
  .preview-heading { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; }
  .preview-heading > span:first-child { color: #26371a; font-size: clamp(24px, 2.5vw, 34px); font-weight: 450; line-height: 1.2; letter-spacing: -.035em; }
  .preview-caption { color: #5a694e; font-size: 12px; line-height: 1.6; }
  .product-stage :global(picture) { display: block; width: 100%; border-radius: 8px; box-shadow: 0 20px 48px -16px #1d2c124d; }
  .product-stage :global(.product-capture) { display: block; width: 100%; height: auto; border-radius: 8px; }
  .product-stage :global([data-media-placeholder]) { display: grid; height: auto; border-radius: 16px; box-shadow: none; }
  .download-help { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 16px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--download-line); color: var(--download-muted); font-size: 12px; line-height: 1.7; }
  .download-help a { display: inline-flex; align-items: center; gap: 12px; min-height: 40px; color: #263b15; }
  .download-page :focus-visible { outline-color: var(--color-focus); }
  @media (hover: hover) and (pointer: fine) {
    .platform-tab:not([aria-selected='true']):hover { color: var(--color-ink); background: #e2e8d9; }
    .platform-tab:hover img { opacity: 1; }
    .package-option:not(:has(input:checked, input:disabled)):hover { color: var(--color-ink); background: #e2e8d9; }
    .package-help summary:hover, .aur-heading a:hover, .download-help a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
    .aur-command button:hover { background: #e9efdf; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .platform-tab, .package-option, .aur-command button { transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease, color 150ms ease; }
  }
  @media (forced-colors: active) {
    .platform-tab[aria-selected='true'] { outline: 2px solid Highlight; outline-offset: -2px; }
    .package-option:has(input:checked) { outline: 2px solid Highlight; outline-offset: -2px; }
  }
  @media (min-width: 1000px) and (max-width: 1199px) {
    .download-shell { width: calc(100% - 64px); }
    .download-composition { grid-template-columns: 360px minmax(0, 1fr); column-gap: 32px; }
    .download-chooser { padding: 20px; }
    .product-stage { padding: 24px; }
    .preview-heading { margin-bottom: 32px; }
  }
  @media (max-width: 999px) {
    .download-page { padding-top: 128px; }
    .download-shell { width: min(620px, calc(100% - 48px)); }
    .download-opening { margin-bottom: 32px; }
    .download-composition { grid-template-columns: minmax(0, 1fr); row-gap: 24px; }
    .download-options { gap: 24px; }
    .download-chooser { padding: 24px; }
    .product-showcase { margin-top: 12px; }
    .product-stage { padding: 24px; }
    .preview-heading { margin-bottom: 24px; }
  }
  @media (max-width: 767px) {
    .download-page { padding-block: 112px 36px; }
    .download-shell { width: calc(100% - 40px); }
    .download-opening { margin-bottom: 28px; }
    h1 { font-size: clamp(43px, 9vw, 60px); letter-spacing: -.05em; }
    .download-opening > p { margin-top: 16px; font-size: 15px; line-height: 1.65; }
    .download-chooser { padding: 20px; border-radius: 12px; }
    .platform-tab { gap: 6px; font-size: 12px; }
    .platform-tab img { width: 18px; height: 18px; }
    .platform-panels { padding-top: 20px; }
    .package-option { font-size: 12px; }
    .package-download { margin-top: 16px; }
    .aur-install { padding-inline: 4px; }
    .aur-command button [data-copy-label] { display: none; }
    .product-stage { padding: 16px; border-radius: 12px; }
    .preview-heading { gap: 6px; margin-bottom: 24px; }
    .preview-heading > span:first-child { font-size: 24px; }
    .preview-caption { font-size: 10px; }
    .download-help { flex-direction: column; gap: 0; margin-top: 28px; padding-top: 20px; }
  }
  @media (max-width: 359px) {
    .download-shell { width: calc(100% - 32px); }
    h1 { font-size: 39px; }
    .download-chooser { padding: 16px; }
    .platform-tab { flex-direction: column; gap: 6px; min-height: 60px; font-size: 11px; }
    .aur-description { font-size: 11px; }
    .aur-command { padding-left: 12px; gap: 8px; }
  }
</style>
