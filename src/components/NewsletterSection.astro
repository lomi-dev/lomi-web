---
import NewsletterSignup from './NewsletterSignup.astro';
import type { Landing } from '../../content/landing-schema';
interface Props { content: Landing['newsletter'] }
const { content } = Astro.props;
---

<section id="newsletter" class="release-newsletter" data-scroll-surface aria-labelledby="newsletter-title">
  <div class="release-shell">
    <div class="release-intro">
      <h2 id="newsletter-title">{content.title}</h2>
      <p class="release-description">{content.description}</p>
    </div>
    <div class="release-signup"><NewsletterSignup content={content.form} /></div>
  </div>
</section>

<style>
  .release-newsletter {
    --scroll-surface-color:var(--color-chalk);
    --nl-controls-columns:minmax(0,1fr) auto;
    --nl-control-gap:10px;
    --nl-field-bg:var(--color-paper,#fff);
    --nl-field-border:#bdc6b5;
    --nl-field-radius:999px;
    --nl-field-size:16px;
    --nl-button-bg:var(--color-lime);
    --nl-button-ink:#0b0e0b;
    --nl-button-hover:#dcff83;
    --nl-button-active:var(--color-lime-pressed);
    --nl-button-radius:999px;
    --nl-disabled-bg:var(--color-lime);
    --nl-disabled-ink:#0b0e0b;
    --nl-note-align:center;
    --nl-note-size:12px;
    padding:56px 0;
    color:var(--color-ink);
    background:var(--color-chalk);
    overflow-wrap:anywhere;
  }
  .release-shell { display:grid; grid-template-columns:minmax(0,1fr); justify-items:center; gap:24px; width:min(1320px,calc(100% - clamp(40px,8.4vw,144px))); margin-inline:auto; }
  .release-intro { text-align:center; }
  .release-intro h2 { margin-inline:auto; font-size:clamp(36px,3.8vw,52px); font-weight:500; line-height:1.02; letter-spacing:-.06em; text-wrap:balance; }
  .release-description { margin-top:16px; color:var(--color-text-secondary); font-size:16px; line-height:1.6; }
  .release-signup { width:100%; min-width:0; max-width:660px; justify-self:center; }
  .release-signup :global(.newsletter input) { min-height:56px; padding-inline:20px; }
  .release-signup :global(.newsletter button) { justify-content:space-between; min-height:56px; padding:8px 10px 8px 20px; gap:20px; }
  .release-signup :global(.newsletter-submit-icon) { display:grid; place-items:center; flex:0 0 32px; width:32px; height:32px; border:1px solid currentColor; border-radius:50%; }
  .release-signup :global(.newsletter-status) { min-height:1.5em; margin-top:10px; }
  .release-signup :global(.newsletter-note) { margin-top:6px; }
  @media(max-width:900px) {
    .release-newsletter { padding:48px 0; }
    .release-shell { grid-template-columns:minmax(0,1fr); gap:28px; }
    .release-intro h2 { max-width:18ch; font-size:clamp(36px,5.7vw,48px); }
    .release-description { margin-top:12px; }
  }
  @media(max-width:600px) {
    .release-newsletter { padding:40px 0 48px; }
    .release-shell { width:calc(100% - 40px); gap:24px; }
    .release-signup { --nl-controls-columns:minmax(0,1fr); }
  }
</style>
