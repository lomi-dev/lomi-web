---
import type { Landing } from '../../content/landing-schema';

import terminalGif from '../assets/product/features/terminal.gif';
import terminalPoster from '../assets/product/features/terminal-poster.webp';
import panelsGif from '../assets/product/features/panels.gif';
import panelsPoster from '../assets/product/features/panels-poster.webp';
import codeGif from '../assets/product/features/code.gif';
import codePoster from '../assets/product/features/code-poster.webp';
import expandGif from '../assets/product/features/expand.gif';
import expandPoster from '../assets/product/features/expand-poster.webp';
import gitGif from '../assets/product/features/git.gif';
import gitPoster from '../assets/product/features/git-poster.webp';
import sparkGif from '../assets/product/features/spark.gif';
import sparkPoster from '../assets/product/features/spark-poster.webp';

interface Props {
  kind: Landing['features']['items'][number]['icon'];
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { kind, alt, class: className, loading = 'lazy' } = Astro.props;
const media = {
  terminal: { gif: terminalGif, poster: terminalPoster },
  panels: { gif: panelsGif, poster: panelsPoster },
  code: { gif: codeGif, poster: codePoster },
  expand: { gif: expandGif, poster: expandPoster },
  git: { gif: gitGif, poster: gitPoster },
  spark: { gif: sparkGif, poster: sparkPoster },
}[kind];
---

<div class:list={['feature-capture', className]} data-feature-preview={kind} data-media-placeholder data-placeholder-variant="feature">
  <img class="feature-capture-poster" data-feature-poster src={media.poster.src} alt={alt}
    width={media.poster.width} height={media.poster.height} loading={loading} decoding="async" />
  <img class="feature-capture-loop" data-feature-gif data-feature-gif-src={media.gif.src} alt="" aria-hidden="true"
    width={media.poster.width} height={media.poster.height} decoding="async" />
</div>

<style>
  .feature-capture { position: relative; display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; aspect-ratio: 8 / 5; overflow: hidden; border: 1px solid color-mix(in srgb, var(--line) 70%, transparent); border-radius: 16px; background: color-mix(in srgb, var(--color-ink) 3%, var(--color-chalk)); }
  .feature-capture img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .feature-capture-loop { opacity: 0; }
  .feature-capture[data-preview-running][data-preview-ready] .feature-capture-loop { opacity: 1; }
  .feature-capture[data-preview-running][data-preview-ready] .feature-capture-poster { opacity: 0; }
</style>
