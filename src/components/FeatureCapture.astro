---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Landing } from '../../content/landing-schema';
import cues from '../../media/feature-demos/cues.json';
import wallpaper from '../assets/product/renders/tahoe-light.jpg';

interface Props {
  kind: Landing['features']['items'][number]['icon'];
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { kind, alt, class: className, loading = 'lazy' } = Astro.props;
const movies = import.meta.glob<string>('../assets/product/demos/*.mp4', { eager: true, query: '?url', import: 'default' });
const posters = import.meta.glob<ImageMetadata>('../assets/product/demos/*-poster.webp', { eager: true, import: 'default' });
const movie = movies[`../assets/product/demos/${kind}.mp4`];
const poster = posters[`../assets/product/demos/${kind}-poster.webp`];
if (!movie || !poster) throw new Error(`Missing native feature recording: ${kind}`);
const [desktop, capture] = await Promise.all([
  getImage({ src: wallpaper, width: 1600, format: 'webp', quality: 85 }),
  getImage({ src: poster, format: 'webp', quality: 94 }),
]);
const camera = JSON.stringify({ ...cues.defaults, ...cues.features[kind] });
---

<div class:list={['feature-capture', `feature-capture-${kind}`, className]} data-feature-preview={kind} data-feature-render data-feature-camera={camera} data-media-placeholder data-placeholder-variant="feature">
  <img class="feature-desktop" src={desktop.src} alt="" aria-hidden="true"
    width={desktop.attributes.width} height={desktop.attributes.height} loading={loading} decoding="async" />
  <div class="feature-window" data-render-window>
    <img class="feature-capture-poster" data-feature-poster src={capture.src} alt={alt}
      width={capture.attributes.width} height={capture.attributes.height} loading={loading} decoding="async" />
    <video class="feature-movie" data-feature-video data-feature-video-src={movie}
      width={capture.attributes.width} height={capture.attributes.height} preload="none"
      muted playsinline loop disablepictureinpicture disableRemotePlayback aria-hidden="true" tabindex="-1"></video>
  </div>
</div>

<style>
  .feature-capture {
    position: relative; display: block; container-type: size; isolation: isolate;
    width: 100%; height: 100%; min-width: 0; min-height: 0; aspect-ratio: 8 / 5;
    overflow: hidden; border: 0; border-radius: 16px; background: #76a8cc;
  }
  .feature-capture > .feature-desktop {
    position: absolute; inset: 0; display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center; pointer-events: none;
  }
  .feature-window {
    position: absolute; z-index: 1; top: 48%; left: 50%; width: min(80cqw, 128cqh);
    transform: translate(-50%, -50%); overflow: hidden;
    border: 0; border-radius: 1.15cqw;
    background: #181a1c;
    box-shadow: 0 .2cqw .5cqw rgb(9 30 60 / 22%), 0 2cqw 4cqw -.8cqw rgb(9 30 60 / 35%), 0 5cqw 8cqw -3cqw rgb(9 30 60 / 32%);
  }
  .feature-window > .feature-capture-poster { display: block; width: 100%; height: auto; object-fit: contain; }
  .feature-window > .feature-movie { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; opacity: 0; pointer-events: none; }
  [data-video-ready] .feature-movie { opacity: 1; }
  [data-video-ready] .feature-capture-poster { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .feature-window { transform: translate(-50%, -50%) !important; }
  }
</style>
