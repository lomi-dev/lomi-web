---
import ContentMedia from './ContentMedia.astro';
import type { Editable, MediaAsset } from '../../content/editor-schema';
import { pageDefaults } from '../../content/page-defaults';
import Icon from './Icon';
import { remoteInstallPlatforms } from '../data/remote';
interface Props { content: Editable<typeof pageDefaults.remote>; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
const platforms = remoteInstallPlatforms.map((platform) => ({ ...platform, ...content.platforms[platform.id] }));
---

<section class="remote-page" data-remote-page data-scroll-surface aria-labelledby="remote-title">
  <div class="remote-shell">
    <header class="remote-opening">
      <h1 id="remote-title">{content.title}</h1>
      <p>{content.description.map((line, index) => <>{index > 0 && <br />}{line.text}</>)}</p>
    </header>

    <div class="remote-installer" data-remote-installer data-remote-copy={JSON.stringify(content.feedback)}>
      <div class="command-box">
        <div class="command-toolbar">
          <h2 class="command-title">{content.installerTitle}</h2>
          <fieldset class="remote-system-picker">
            <legend class="visually-hidden">{content.systemLabel}</legend>
            <div class="remote-system-options">
              {platforms.map((platform, index) => <label class="remote-system-option">
                <input type="radio" name="remote-system" value={platform.id} checked={index === 0} />
                <span class="system-icons" aria-hidden="true">{platform.icons.map((icon) => <img src={`/icons/download-${icon}.svg`} width="16" height="16" alt="" />)}</span>
                <span>{platform.label}</span>
              </label>)}
            </div>
          </fieldset>
        </div>
        <div class="command-panels">
          {platforms.map((platform) => <div class={`command-panel command-${platform.id}`} data-remote-platform={platform.id} data-platform-label={platform.label}>
            <div class="command-bar">
              <span class="command-prompt" aria-hidden="true">{platform.id === 'windows' ? 'PS' : '$'}</span>
              <div class="command-scroll" tabindex="0" role="region" aria-label={content.commandAriaLabel.replaceAll('{platform}', platform.label)}>
                <code data-remote-command>{platform.command}</code>
              </div>
              <button class="copy-command" type="button" data-copy-remote disabled aria-label={content.copyAriaLabel.replaceAll('{platform}', platform.label)} title={content.copyAriaLabel.replaceAll('{platform}', platform.label)}>
                <span data-copy-icon><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4V3h13v13h-1" /><rect x="4" y="7" width="13" height="14" rx="1" /></svg></span>
                <span data-copied-icon hidden><Icon name="check" width={20} height={20} /></span>
              </button>
            </div>
          </div>)}
        </div>
      </div>

      <p class="copy-feedback" data-remote-copy-status role="status" aria-live="polite" aria-atomic="true"></p>
      <noscript><p class="manual-copy-note">{content.manualCopy}</p></noscript>
    </div>

    {content.showScreenshot && <figure class="remote-showcase">
      <div class="remote-preview-stage">
        <ContentMedia
          image={content.screenshot.image}
          placeholderLogo={placeholderLogo}
          alt={content.screenshot.alt}
          widths={[640, 960, 1440, 1920, 2400]}
          sizes="(min-width: 1280px) 1104px, (min-width: 1000px) calc(100vw - 160px), (min-width: 768px) calc(100vw - 112px), calc(100vw - 72px)"
          loading="lazy"
          class="remote-capture"
        />
      </div>
    </figure>}
  </div>
</section>

<script>
  import { initRemoteInstaller } from './remote-installer';
  document.querySelectorAll<HTMLElement>('[data-remote-installer]').forEach(initRemoteInstaller);
</script>

<style>
  .remote-page { --scroll-surface-color: var(--color-paper); --remote-muted: #5b6355; --remote-line: #dfe4d8; min-height: min(800px, 100svh); padding: 132px 0 80px; background: var(--color-paper); color: var(--color-ink); }
  .remote-shell { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .remote-opening { max-width: 640px; margin: 0 auto 48px; text-align: center; }
  h1 { margin: 0; font-size: clamp(54px, 5vw, 72px); font-weight: 500; line-height: 1.06; letter-spacing: -.055em; text-wrap: balance; }
  .remote-opening > p { margin-top: 20px; color: var(--remote-muted); font-size: 17px; line-height: 1.65; }
  .remote-installer { max-width: 960px; margin-inline: auto; text-align: center; }
  .command-box { min-width: 0; border: 1px solid var(--remote-line); border-radius: 12px; background: var(--color-paper); }
  .command-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding: 12px 24px; border-bottom: 1px solid #edf0e9; }
  .command-title { margin: 0; color: #35412c; font-size: 13px; font-weight: 500; line-height: 1.5; letter-spacing: -.01em; text-align: left; }
  .command-panel { display: none; min-width: 0; }
  .remote-installer:has(input[value='unix']:checked) .command-unix,
  .remote-installer:has(input[value='windows']:checked) .command-windows { display: block; }
  .command-bar { display: flex; align-items: center; gap: 16px; min-width: 0; min-height: 76px; padding: 12px 16px 12px 24px; text-align: left; }
  .command-prompt { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; min-width: 24px; min-height: 44px; color: #5b6355; font: 16px/1.7 ui-monospace, 'SFMono-Regular', Consolas, monospace; }
  .command-scroll { flex: 1; min-width: 0; overflow-x: auto; padding-block: 10px; scrollbar-width: thin; scrollbar-color: #b9c5ad transparent; }
  .command-scroll code { display: block; width: max-content; min-width: 100%; color: #35412c; font: 16px/1.5 ui-monospace, 'SFMono-Regular', Consolas, monospace; white-space: nowrap; user-select: text; }
  .command-scroll:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; border-radius: 2px; }
  .copy-command { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: #5b6355; cursor: pointer; }
  .copy-command > span { display: flex; align-items: center; justify-content: center; }
  .copy-command > span[hidden] { display: none; }
  .copy-command:disabled { opacity: .45; cursor: default; }
  .copy-command[aria-disabled='true'] { cursor: default; }
  .copy-command[aria-disabled='true'] > span { opacity: .45; }
  .copy-command[data-copied] { color: #345600; }
  .remote-system-picker { min-width: 0; max-width: 100%; margin: 0 0 0 auto; padding: 0; border: 0; }
  .remote-system-options { display: flex; align-items: center; gap: 20px; }
  .remote-system-option { display: flex; position: relative; align-items: center; justify-content: center; gap: 8px; min-width: 0; min-height: 44px; padding: 10px 0; border-bottom: 2px solid transparent; color: #5b6355; font-size: 12px; font-weight: 500; line-height: 1.5; white-space: nowrap; cursor: pointer; }
  .remote-system-option input { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .system-icons { display: flex; flex-shrink: 0; align-items: center; gap: 4px; }
  .remote-system-option img { flex-shrink: 0; width: 14px; height: 14px; opacity: .6; }
  .remote-system-option:has(input:checked) { border-bottom-color: var(--color-ink); color: var(--color-ink); }
  .remote-system-option:has(input:checked) img { opacity: 1; }
  .remote-system-option:has(input:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .copy-feedback { min-height: 20px; margin-top: 8px; color: #465a35; font-size: 12px; line-height: 1.7; text-wrap: pretty; }
  .manual-copy-note { margin: 0 0 12px; color: var(--remote-muted); font-size: 12px; line-height: 1.7; }
  .remote-showcase { margin-top: 48px; }
  .remote-preview-stage { padding: 48px; border-radius: 16px; background: #edf1e7; }
  .remote-preview-stage :global(picture) { display: block; border-radius: 8px; box-shadow: 0 20px 48px -16px #1d2c124d; }
  .remote-preview-stage :global(.remote-capture) { display: block; width: 100%; height: auto; border-radius: 8px; }
  .remote-preview-stage:has([data-media-placeholder]) { padding: 0; background: transparent; }
  .remote-preview-stage :global([data-media-placeholder]) { display: grid; height: auto; border-radius: 16px; box-shadow: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (hover: hover) and (pointer: fine) {
    .copy-command:not(:disabled, [aria-disabled='true']):hover { background: #edf2e6; color: var(--color-ink); }
    .remote-system-option:hover { color: var(--color-ink); }
    .remote-system-option:not(:has(input:checked)):hover { border-bottom-color: #b9c5ad; }
    .remote-system-option:hover img { opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .copy-command, .remote-system-option { transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease; }
    .remote-system-option img { transition: opacity 150ms ease; }
  }
  @media (forced-colors: active) {
    .remote-system-option:has(input:checked) { outline: 2px solid Highlight; outline-offset: -3px; }
    .remote-system-option:has(input:focus-visible) { outline-offset: 1px; }
  }
  @media (min-width: 1000px) and (max-width: 1199px) { .remote-shell { width: calc(100% - 64px); } }
  @media (max-width: 999px) {
    .remote-page { padding-top: 128px; }
    .remote-shell { width: calc(100% - 48px); }
    .remote-opening { margin-bottom: 40px; }
    .command-bar { gap: 12px; padding-left: 20px; }
    .command-scroll code { font-size: 14px; }
    .remote-preview-stage { padding: 32px; }
  }
  @media (max-width: 767px) {
    .remote-page { min-height: min(680px, 100svh); padding: 112px 0 56px; }
    .remote-shell { width: calc(100% - 40px); }
    h1 { font-size: clamp(43px, 9vw, 60px); letter-spacing: -.05em; }
    .remote-opening { margin-bottom: 32px; }
    .remote-opening > p { margin-top: 16px; font-size: 15px; }
    .command-box { border-radius: 10px; }
    .command-toolbar { padding: 12px 16px; }
    .command-bar { gap: 8px; min-height: 72px; padding: 10px 8px 10px 12px; }
    .command-prompt { min-width: 20px; font-size: 13px; }
    .copy-feedback { min-height: 40px; }
    .remote-showcase { margin-top: 32px; }
    .remote-preview-stage { padding: 16px; border-radius: 12px; }
  }
  @media (max-width: 359px) {
    .remote-shell { width: calc(100% - 32px); }
    h1 { font-size: 39px; }
    .remote-system-option { gap: 6px; }
  }
</style>
