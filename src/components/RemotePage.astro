---
import { Picture } from 'astro:assets';
import browser from '../assets/product/browser.png';
import phone from '../assets/product/mobile-app/workspace-home-dark.png';
import ContentMedia from './ContentMedia.astro';
import GlassBackdrop from './GlassBackdrop.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import type { Editable, MediaAsset } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';
import { pageDefaults } from '../../content/page-defaults';
import { remoteLaunch, remoteInstall } from '../data/remote';

interface Props {
  content: Editable<typeof pageDefaults.remote>;
  placeholderLogo?: MediaAsset | null;
  newsletterForm?: Landing['newsletter']['form'];
}

const { content, placeholderLogo, newsletterForm } = Astro.props;
const installers = [remoteInstall.unix, remoteInstall.windows];
const facts = [
  { label: 'Encrypted', title: 'End-to-end encrypted channels', text: 'Live terminal channels use end-to-end encryption.' },
  { label: 'Pause and resume', title: 'Sessions that wait for you', text: 'Sharing pauses after an hour without terminal or window activity and resumes without restarting your terminals.' },
  { label: 'Updates', title: 'Signed updates', text: 'lomiremote update checks signed release metadata and keeps your existing service and profile.' },
];
---

<div data-remote-page data-scroll-surface>
  <section class="hero" data-enter aria-labelledby="remote-title">
    <GlassBackdrop center />
    <div class="hero-inner shell">
      <h1 id="remote-title">{content.title}</h1>
      <p class="hero-description">{content.description.map((line, index) => <>{index > 0 && <br />}{line.text}</>)}</p>

      {/* The install command is the hero: real installers from lomi-remote, one tab per system. */}
      <div class="install" data-install>
        <div class="install-tabs" role="tablist" aria-label="Operating system">
          {installers.map((item, index) => <button class="install-tab" type="button" role="tab" id={`install-tab-${item.id}`} aria-controls={`install-panel-${item.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{item.label}</button>)}
        </div>
        {installers.map((item, index) => <div class="install-panel" role="tabpanel" id={`install-panel-${item.id}`} aria-labelledby={`install-tab-${item.id}`} hidden={index !== 0} data-live={item.live ? '' : undefined}>
          <div class="command">
            {item.live
              ? <code><span class="prompt" aria-hidden="true">$</span>{item.command}</code>
              : <p class="soon"><i class="sig" aria-hidden="true"></i>Coming soon</p>}
            {item.live && <button class="copy" type="button" data-copy={item.command} aria-label={`Copy the ${item.label} install command`}><svg class="copy-idle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="3" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg><svg class="copy-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span class="copy-label"><span class="copy-idle-text">Copy</span><span class="copy-done-text" aria-hidden="true">Copied</span></span></button>}
          </div>
          {item.live
            ? <p class="install-next">Then run <code>lomiremote</code> to start your host.</p>
            : <p class="install-next">Windows packages are on the way. <a class="text-link" href="#remote-newsletter">Get release news</a></p>}
        </div>)}
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </section>

  {content.showScreenshot && <section class="section screens" aria-labelledby="remote-screens-title">
    <div class="shell screens-layout">
      <div class="screens-copy">
        <p class="eyebrow">One workspace, two screens</p>
        <h2 id="remote-screens-title">Pick up where your terminal is.</h2>
        <p class="section-description">Open your workspaces from another computer or from Lomi Mobile.</p>
      </div>
      {/* Real captures of Lomi on the desktop and of Lomi Mobile. */}
      <div class="stage">
        <figure class="desk">
          {content.screenshot.image
            ? <ContentMedia image={content.screenshot.image} placeholderLogo={placeholderLogo} alt={content.screenshot.alt} widths={[960, 1440, 1920]} sizes="(max-width: 1023px) 92vw, 780px" loading="lazy" />
            : <Picture src={browser} formats={['avif', 'webp']} widths={[800, 1200, 1600, 2160]} sizes="(max-width: 1023px) 92vw, 780px" alt="The Lomi desktop app with a Workspaces sidebar listing Development, Review and Website, a terminal and a browser preview." loading="lazy" />}
        </figure>
        <figure class="phone"><Picture src={phone} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 767px) 40vw, 280px" alt="Lomi Mobile listing shared workspaces and their terminal sessions." loading="lazy" /></figure>
      </div>
    </div>
  </section>}

  <section class="section facts" aria-labelledby="remote-facts-title">
    <div class="shell">
      <p class="eyebrow">How sharing works</p>
      <h2 id="remote-facts-title">Built for long sessions.</h2>
      <div class="fact-grid">
        {facts.map((fact) => <article class="fact">
          <p class="fact-label">{fact.label}</p>
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </article>)}
      </div>
    </div>
  </section>

  {newsletterForm && <section class="section notify" id="remote-newsletter" tabindex="-1" aria-labelledby="remote-newsletter-title">
    <div class="shell notify-inner">
      <h2 id="remote-newsletter-title">{remoteLaunch.newsletter.title}</h2>
      <p class="section-description">{remoteLaunch.newsletter.description}</p>
      <NewsletterSignup content={newsletterForm} showNote={false} />
    </div>
  </section>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-install]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    const select = (tab: HTMLButtonElement) => tabs.forEach((other) => {
      const on = other === tab;
      other.setAttribute('aria-selected', String(on));
      other.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        select(next); next.focus();
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      const command = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(command);
        button.dataset.copied = '';
        if (status) status.textContent = 'Install command copied.';
        setTimeout(() => delete button.dataset.copied, 1800);
      } catch {
        // no clipboard access: select the command so it can be copied by hand
        const code = button.parentElement?.querySelector('code');
        if (code) getSelection()?.selectAllChildren(code);
        if (status) status.textContent = 'Select the command and copy it manually.';
      }
    }));
  });
</script>

<style>
  /* Command-centred hero: the name, one line, and the install command on glass. */
  .hero { position: relative; isolation: isolate; overflow: clip; display: flex; min-height: 100svh; background: var(--color-night-950); color: var(--color-ink); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-block: calc(var(--site-header-height) + 48px) 88px; text-align: center; }
  .hero h1 { font-size: clamp(52px, min(8.4vw, 14svh), 132px); line-height: .9; }
  .hero-description { max-width: 46ch; margin-top: 24px; color: #c8c8d0; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; text-wrap: balance; }
  .install { width: min(760px, 100%); margin-top: clamp(36px, 5svh, 56px); text-align: left; }
  .install-tabs { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid rgb(247 247 249 / 10%); border-radius: 12px; background: rgb(14 14 17 / 55%); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .install-tab { min-height: 36px; padding: 0 14px; border: 0; border-radius: 9px; background: transparent; color: var(--color-text-secondary); font: 500 14px/1 var(--font-sans); cursor: pointer; transition: background-color var(--dur-fast) ease-out, color var(--dur-fast) ease-out, transform var(--dur) var(--ease-out); }
  @media (hover: hover) { .install-tab[aria-selected='false']:hover { background: rgb(247 247 249 / 5%); color: #dcdce2; } }
  .install-tab:active { transform: scale(.97); }
  .install-tab[aria-selected='true'] { background: rgb(247 247 249 / 10%); color: var(--color-ink); box-shadow: inset 0 1px 0 rgb(255 255 255 / 6%); }
  .install-panel { margin-top: 12px; }
  .install-panel:not([hidden]) { animation: panel-in var(--dur) var(--ease-out); }
  .command { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 22px; border: 1px solid rgb(247 247 249 / 14%); border-radius: 18px; background: rgb(14 14 17 / 62%); -webkit-backdrop-filter: blur(22px) saturate(160%); backdrop-filter: blur(22px) saturate(160%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 7%), 0 30px 80px -30px rgb(0 0 0 / 90%), 0 0 100px -30px rgb(114 59 250 / 55%); }
  .command code { flex: 1; min-width: 0; overflow-x: auto; padding-block: 12px; color: var(--color-ink); font-size: clamp(14px, 1.25vw, 17px); line-height: 1.4; white-space: nowrap; scrollbar-width: none; }
  .command code::-webkit-scrollbar { display: none; }
  .prompt { margin-right: 14px; color: var(--color-signal); user-select: none; }
  .soon { display: flex; align-items: center; gap: 12px; flex: 1; min-height: 44px; padding-block: 12px; color: var(--color-ink); font-size: clamp(15px, 1.25vw, 17px); font-weight: 600; }
  .soon .sig { width: 9px; height: 9px; border-radius: 3px; }
  .copy { position: relative; display: inline-flex; flex: none; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 0; border-radius: 12px; background: var(--color-lime); color: var(--on-accent); font: 600 14px/1 var(--font-sans); cursor: pointer; box-shadow: inset 0 1px 0 rgb(255 255 255 / 35%); transition: background-color var(--dur-fast) ease-out, transform var(--dur) var(--ease-out), box-shadow var(--dur) ease-out; }
  .copy :global(svg) { transition: opacity var(--dur-fast) ease-out, transform var(--dur) var(--ease-out); }
  .copy :global(.copy-done) { position: absolute; left: 16px; opacity: 0; transform: scale(.6); }
  .copy[data-copied] :global(.copy-idle) { opacity: 0; transform: scale(.6); }
  .copy[data-copied] :global(.copy-done) { opacity: 1; transform: none; }
  .copy-label { display: grid; }
  .copy-label > span { grid-area: 1 / 1; transition: opacity var(--dur-fast) ease-out; }
  .copy-done-text, .copy[data-copied] .copy-idle-text { opacity: 0; }
  .copy[data-copied] .copy-done-text { opacity: 1; }
  .copy:active { transform: scale(.97); transition-duration: 60ms; }
  @media (hover: hover) { .copy:hover { background: var(--color-lime-hover); transform: translateY(-1px); box-shadow: inset 0 1px 0 rgb(255 255 255 / 40%), 0 10px 28px -10px rgb(185 245 0 / 55%); } }
  .install-next { margin-top: 18px; color: var(--color-text-secondary); font-size: 14px; line-height: 2; text-align: center; }
  .install-next code { margin-inline: 4px; padding: 3px 8px; border: 1px solid rgb(247 247 249 / 10%); border-radius: 7px; background: rgb(247 247 249 / 6%); color: var(--color-ink); font-size: 13px; white-space: nowrap; }
  .install-next .text-link { min-height: 0; font-size: 14px; background-position: 0 100%; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-inner > * { animation: hero-rise 800ms var(--ease-out) both; }
    .hero-inner > :nth-child(2) { animation-delay: 80ms; }
    .hero-inner > :nth-child(3) { animation-delay: 180ms; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } }
  @keyframes panel-in { from { opacity: 0; transform: translateY(4px); } }

  /* One workspace, two screens: the desktop and the phone standing in front of it. */
  .screens { border-top: 1px solid var(--line); overflow: clip; }
  .screens-layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: center; gap: clamp(40px, 5vw, 80px); }
  .screens h2 { margin-top: 20px; max-width: 12ch; }
  .screens .section-description { margin-top: 24px; }
  .stage { position: relative; height: min(600px, 46vw); }
  .desk { position: absolute; top: 50%; left: 0; width: 80%; margin: 0; border-radius: 11px; transform: translateY(-56%); box-shadow: 0 0 0 1px rgb(247 247 249 / .14), 0 0 0 9px rgb(247 247 249 / .035), 0 50px 140px -30px rgb(0 0 0 / .9), 0 0 120px -20px rgb(114 59 250 / .35); }
  .desk :global(img), .desk :global(video) { display: block; width: 100%; height: auto; border-radius: 11px; }
  .phone { position: absolute; top: 50%; right: 0; width: min(230px, 28%); margin: 0; padding: 8px; border-radius: 42px; background: #1f1f24; transform: translateY(-46%); box-shadow: inset 0 0 0 1px rgb(247 247 249 / .1), 0 0 0 1px rgb(247 247 249 / .16), -30px 50px 120px -30px rgb(0 0 0 / .95), 0 0 120px -20px rgb(114 59 250 / .5); }
  .phone :global(img) { display: block; width: 100%; height: auto; border-radius: 34px; }

  .facts { border-top: 1px solid var(--line); }
  .facts h2 { margin-top: 20px; max-width: 14ch; }
  .fact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 56px; }
  .fact { padding: 32px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--color-paper); }
  .fact-label { color: var(--color-violet-300); font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .fact h3 { margin-top: 20px; font-size: 20px; font-weight: 600; }
  .fact p:last-child { margin-top: 10px; color: var(--color-text-secondary); font-size: 15px; line-height: 1.6; }

  .notify { border-top: 1px solid var(--line); text-align: center; scroll-margin-top: 80px; }
  .notify-inner { width: min(620px, calc(100% - 40px)); }
  .notify .section-description { margin: 20px auto 32px; }
  .notify :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr) auto; }
  .notify :global(.newsletter button) { width: auto; white-space: nowrap; }
  .notify :global(.newsletter-submit-icon) { display: none; }

  @media (max-width: 1023px) {
    .screens-layout { grid-template-columns: minmax(0, 1fr); }
    .stage { height: clamp(320px, 66vw, 560px); }
    .fact-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .hero h1 { font-size: clamp(48px, 14vw, 64px); }
    .hero-inner { padding-block: calc(var(--site-header-height) + 48px) 72px; }
    .command { padding: 8px 8px 8px 16px; border-radius: 14px; }
    .copy-label { display: none; }
    .copy { padding: 0 14px; }
    .copy :global(.copy-done) { left: 14px; }
    .command code { -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent); mask-image: linear-gradient(90deg, #000 82%, transparent); }
    .install-tabs { width: 100%; }
    .install-tab { flex: 1; min-height: 44px; }
    .stage { height: clamp(300px, 90vw, 420px); }
    .desk { left: -2%; width: 92%; }
    .phone { width: 40%; padding: 5px; border-radius: 30px; }
    .phone :global(img) { border-radius: 25px; }
    .fact { padding: 28px; }
    .notify :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr); }
  }
  @media (forced-colors: active) {
    .command, .install-tabs { border-color: CanvasText; }
  }
</style>
