---
import ContentMedia from './ContentMedia.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import RemoteCliPreview from './RemoteCliPreview.astro';
import type { Editable, MediaAsset } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';
import { pageDefaults } from '../../content/page-defaults';
import { remoteLaunch } from '../data/remote';
import { loadServerRelease } from '../lib/server-release';

interface Props {
  content: Editable<typeof pageDefaults.remote>;
  placeholderLogo?: MediaAsset | null;
  newsletterForm?: Landing['newsletter']['form'];
}

const { content, placeholderLogo, newsletterForm } = Astro.props;
const release = loadServerRelease(process.env.LOMI_REMOTE_INSTALLATION_CATALOG_JSON, process.env.LOMI_REMOTE_INSTALLATION_CATALOG_SHA256);
const platforms = [
  { id: 'macos', label: 'macOS' },
  { id: 'windows', label: 'Windows' },
  { id: 'linux', label: 'Linux' },
] as const;
---

<section class="remote-page" data-remote-page data-scroll-surface aria-labelledby="remote-title">
  <div class="remote-shell">
    <header class="remote-opening">
      <h1 id="remote-title">{content.title}</h1>
      <p>{content.description.map((line, index) => <>{index > 0 && <br />}{line.text}</>)}</p>
      <div class="remote-platforms" aria-label="Target platforms">
        {platforms.map((platform) => <div class="remote-platform-wrap">
          {release ? <a class="remote-platform remote-platform-link" href="/server/#install-heading" aria-label={`Install the ${platform.label} host`}>
            <img src={`/icons/download-${platform.id}.svg`} width="16" height="16" alt="" />
            <span>{platform.label}</span>
          </a> : <button class="remote-platform" type="button" disabled aria-label={`${platform.label}, coming soon`}>
            <img src={`/icons/download-${platform.id}.svg`} width="16" height="16" alt="" />
            <span>{platform.label}</span>
          </button>}
          <span class="remote-platform-soon">{release ? `Version ${release.version}` : 'Coming soon'}</span>
        </div>)}
      </div>
      <p><a class="remote-setup-guide" href="/server/">Installation and system requirements</a></p>
    </header>

    {content.showScreenshot && <section class="remote-showcase" aria-label="Lomi Remote CLI preview">
      {content.screenshot.image
        ? <figure class="remote-preview remote-uploaded-preview">
            <ContentMedia
              image={content.screenshot.image}
              placeholderLogo={placeholderLogo}
              alt={content.screenshot.alt}
              widths={[640, 960, 1280, 1600, 1920]}
              sizes="(min-width: 1100px) 1000px, calc(100vw - 80px)"
              loading="lazy"
              class="remote-uploaded-capture"
            />
          </figure>
        : <RemoteCliPreview />}
    </section>}

    {newsletterForm && <section class="remote-launch-signup" id="remote-newsletter" tabindex="-1" aria-labelledby="remote-newsletter-title">
      <h2 id="remote-newsletter-title">{remoteLaunch.newsletter.title}</h2>
      <p class="remote-newsletter-description">{remoteLaunch.newsletter.description}</p>
      <NewsletterSignup content={newsletterForm} showNote={false} />
    </section>}
  </div>
</section>

<style>
  .remote-page { --scroll-surface-color: var(--color-paper); --remote-muted: #5b6355; --remote-line: #dfe4d8; min-height: min(800px, 100svh); padding: 132px 0 80px; background: var(--color-paper); color: var(--color-ink); }
  .remote-shell { width: min(1120px, calc(100% - 80px)); margin-inline: auto; }
  .remote-opening { max-width: 700px; margin: 0 auto; text-align: center; }
  .remote-opening h1 { margin: 0; font-size: clamp(54px, 5vw, 72px); font-weight: 500; line-height: 1.06; letter-spacing: -.055em; text-wrap: balance; }
  .remote-opening > p { max-width: 590px; margin: 20px auto 0; color: var(--remote-muted); font-size: 17px; line-height: 1.65; text-wrap: balance; }
  .remote-platforms { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 26px auto 0; }
  .remote-platform-wrap { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
  .remote-platform { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 118px; min-height: 48px; padding: 9px 14px; border: 1px solid #c9cec7; border-radius: var(--button-radius); background: #e5e8e2; color: #424944; font: inherit; font-size: 13px; font-weight: var(--button-font-weight); line-height: 1.4; opacity: 1; }
  .remote-platform:disabled { opacity: 1; }
  .remote-platform { cursor: not-allowed; }
  .remote-platform-link { cursor: pointer; text-decoration: none; }
  .remote-platform-link:hover { background: #d9ded5; }
  .remote-platform-link:focus-visible, .remote-setup-guide:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .remote-setup-guide { text-decoration: underline; text-underline-offset: .2em; font-size: 14px; }
  .remote-platform img { flex: 0 0 16px; width: 16px; height: 16px; opacity: .65; }
  .remote-platform-soon { color: #60695f; font-size: 10px; line-height: 1.4; }
  .remote-showcase { width: min(100%, 1000px); min-width: 0; margin: 48px auto 0; }
  .remote-preview { min-width: 0; margin: 0; }
  .remote-uploaded-preview :global(picture), .remote-uploaded-preview :global(video) { display: block; overflow: hidden; border: 1px solid #d8dfd0; border-radius: 12px; background: #f8f9f5; box-shadow: 0 20px 42px -24px rgb(28 39 18 / 32%); }
  .remote-uploaded-preview :global(.remote-uploaded-capture) { display: block; width: 100%; height: auto; }
  .remote-launch-signup { width: min(100%, 620px); margin: 64px auto 0; padding-top: 32px; border-top: 1px solid var(--remote-line); text-align: center; scroll-margin-top: 112px; }
  .remote-launch-signup > h2 { margin: 0; font-size: 24px; font-weight: 500; line-height: 1.3; letter-spacing: -.035em; }
  .remote-newsletter-description { max-width: 52ch; margin: 10px auto 24px; color: var(--remote-muted); font-size: 14px; line-height: 1.65; }
  #remote-newsletter :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr) auto; }
  #remote-newsletter :global(.newsletter input) { min-height: 52px; padding-inline: 12px; background: var(--color-paper); }
  #remote-newsletter :global(.newsletter button) { width: auto; padding-inline: 16px; white-space: nowrap; }
  #remote-newsletter :global(.newsletter-submit-icon) { display: none; }
  #remote-newsletter :global(.newsletter-status) { min-height: 1.5em; margin-top: 8px; }
  @media (max-width: 999px) {
    .remote-page { padding-top: 128px; }
    .remote-shell { width: calc(100% - 48px); }
  }
  @media (max-width: 767px) {
    .remote-page { min-height: min(680px, 100svh); padding: 112px 0 56px; }
    .remote-shell { width: calc(100% - 40px); }
    .remote-opening h1 { font-size: clamp(43px, 9vw, 60px); letter-spacing: -.05em; }
    .remote-opening > p { margin-top: 16px; font-size: 15px; }
    .remote-platforms { gap: 8px; margin-top: 22px; }
    .remote-platform { min-width: 94px; min-height: 46px; padding-inline: 10px; }
    .remote-showcase { margin-top: 40px; }
    .remote-launch-signup { margin-top: 44px; padding-top: 28px; scroll-margin-top: 96px; }
    #remote-newsletter :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 359px) {
    .remote-shell { width: calc(100% - 32px); }
    .remote-platforms { gap: 6px; }
    .remote-platform { min-width: 0; gap: 6px; padding-inline: 8px; font-size: 12px; }
  }
  @media (forced-colors: active) {
    .remote-platform { border-color: ButtonText; background: ButtonFace; color: ButtonText; }
    .remote-platform-soon { color: CanvasText; }
  }
</style>
