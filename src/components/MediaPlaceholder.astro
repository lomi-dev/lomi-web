---
import type { MediaAsset } from '../../content/editor-schema';
import { resolveMedia } from '../../content/editor-schema';

interface Props { logo?: MediaAsset | null; aspect?: string; class?: string; loading?: 'eager' | 'lazy'; variant?: 'brand' | 'hero' | 'download' }
const { logo, aspect = '8 / 5', class: className, loading = 'lazy', variant = 'brand' } = Astro.props;
// Hero and download variants render the product capture in ContentMedia instead.
const brand = variant === 'brand' ? resolveMedia(logo, import.meta.env.CMS_URL) : null;
---

<picture class="media-placeholder" data-media-placeholder data-placeholder-variant={variant} style={{ '--placeholder-aspect': aspect }} aria-hidden="true">
  <img class={className} src={brand?.url ?? '/placeholders/lomi-mark.svg'} alt="" width="1775" height="788" loading={loading} decoding="async"
    style={{ width: 'clamp(120px, 14vw, 200px)', maxWidth: '45%', height: 'auto', maxHeight: '45%', aspectRatio: '1775 / 788', objectFit: 'contain', ...(brand ? { opacity: '.18', filter: 'grayscale(1)' } : {}) }} />
</picture>

<style>
  .media-placeholder[data-media-placeholder] { display: grid; place-items: center; width: 100%; height: 100%; min-width: 0; aspect-ratio: var(--placeholder-aspect); overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--color-paper); }
</style>
