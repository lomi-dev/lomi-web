---
import ContentMedia from './ContentMedia.astro';
import Icon from './Icon';
import { resolveMedia, youtubeVideoId, type MediaAsset } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['hero']; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
const clip = content.mediaMode === 'video' ? resolveMedia(content.video, import.meta.env.CMS_URL) : null;
const image = resolveMedia(content.poster, import.meta.env.CMS_URL);
const videoId = youtubeVideoId(content.videoUrl)!;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const copy = content.player;
---

<div class="hero-video" data-hero-video data-placeholder-poster={!image || undefined} data-video-provider={clip ? 'video' : 'youtube'} data-video-status="poster" data-video-id={videoId} data-video-copy={JSON.stringify(copy)}>
  <div class="video-player" data-video-player role="group" aria-label={copy.videoTitle} aria-busy="false" data-scroll-surface>
    <div class="video-viewport" data-video-viewport>
      <div class="video-mount" data-video-mount>
        {clip && <video data-native-video controls muted playsinline preload="metadata" poster={image?.url ?? '/placeholders/hero-workspace.svg'} aria-label={copy.videoTitle}>
          <source src={clip.url} type={clip.mimeType} />{content.previewAlt}
        </video>}
      </div>
      <button class="video-gestures" data-player-surface-toggle type="button" tabindex="-1" aria-label={copy.playLabel}></button>
      <a class="video-poster" data-video-poster href={clip?.url ?? watchUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.watchLabel}>
        <ContentMedia image={content.poster} alt={content.previewAlt} placeholderLogo={placeholderLogo} placeholderVariant="hero" loading="eager" />
        <span class="video-poster-play" aria-hidden="true"><Icon name="play" width={24} height={24} /></span>
        <span class="video-loading" aria-hidden="true"></span>
      </a>
    </div>
    <div class="player-controls" data-player-controls role="group" aria-label={copy.controlsLabel}>
      <button class="player-toggle" type="button" data-player-toggle data-state="play" aria-label={copy.playLabel} title={copy.playLabel}>
        <span data-icon="play"><Icon name="play" width={19} height={19} /></span><span data-icon="pause"><Icon name="pause" width={17} height={17} /></span><span data-icon="replay"><Icon name="replay" width={19} height={19} /></span>
      </button>
      <span class="player-time" aria-hidden="true"><span data-player-current>00:00</span><span class="player-time-divider">/</span><span data-player-duration>00:00</span></span>
      <input class="player-seek player-range" data-player-seek type="range" min="0" max="1" step="0.1" value="0" aria-label={copy.seekLabel} disabled />
      <div class="player-audio">
        <button class="player-icon-button" type="button" data-player-mute data-muted="true" aria-label={copy.unmuteLabel} title={copy.unmuteLabel} disabled>
          <span data-icon="volume"><Icon name="volume" width={19} height={19} /></span><span data-icon="muted"><Icon name="muted" width={19} height={19} /></span>
        </button>
        <input class="player-volume player-range" data-player-volume type="range" min="0" max="100" step="1" value="0" aria-label={copy.volumeLabel} disabled />
      </div>
      <button class="player-icon-button player-fullscreen" type="button" data-player-fullscreen data-active="false" aria-label={copy.fullscreenLabel} title={copy.fullscreenLabel} disabled>
        <span data-icon="expand"><Icon name="expand" width={18} height={18} /></span><span data-icon="minimize"><Icon name="minimize" width={18} height={18} /></span>
      </button>
      <button class="player-retry" type="button" data-player-retry hidden>{copy.retryLabel}</button>
    </div>
  </div>
  <span class="video-status" role="status" data-video-announcement></span>
</div>

<script>
  import { initHeroVideo } from './hero-video';
  document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach(initHeroVideo);
</script>

<style>
  .hero-video { min-width: 0; }
  .video-player { --scroll-surface-color: #080a08; position: relative; isolation: isolate; width: 100%; min-height: 240px; aspect-ratio: 8 / 5; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: #080a08; }
  [data-placeholder-poster]:not([data-video-frame]) .video-player { --scroll-surface-color: color-mix(in srgb, var(--color-ink) 3%, var(--color-chalk)); }
  [data-placeholder-poster]:not([data-video-frame]) .video-player::after { display: none; }
  [data-placeholder-poster]:not([data-video-frame]) .player-controls { --player-foreground: var(--color-ink); }
  .video-poster :global([data-media-placeholder]) { border: 0; border-radius: 0; }
  .video-viewport { position: absolute; inset: 0; overflow: hidden; }
  .video-player::after { content: ''; position: absolute; z-index: 2; inset: auto 0 0; height: min(130px, 40%); background: linear-gradient(transparent, rgb(0 0 0 / 75%) 40%, rgb(0 0 0 / 88%)); pointer-events: none; }
  .video-gestures { display: none; position: absolute; z-index: 1; inset: 48px 0 64px; width: 100%; border: 0; padding: 0; background: transparent; cursor: pointer; }
  [data-player-ready][data-video-frame] .video-gestures { display: block; }
  [data-video-provider='video'] .video-gestures { inset: 0; height: 100%; }
  .video-gestures:focus-visible { outline: 2px solid var(--color-lime); outline-offset: -4px; }
  .video-poster, .video-mount { position: absolute; inset: 0; }
  .video-poster { z-index: 1; }
  .video-poster :global(picture), .video-poster :global(img) { display: block; width: 100%; height: 100%; }
  .video-poster :global(img), .video-mount :global(video) { object-fit: contain; }
  .video-mount { display: none; }
  [data-video-mounted] .video-mount, [data-video-provider='video'] .video-mount { display: block; }
  [data-video-frame] .video-poster { visibility: hidden; }
  .video-mount :global(iframe), .video-mount :global(video) { display: block; width: 100%; height: 100%; border: 0; }
  .video-poster-play { display: none; position: absolute; inset: 0; width: 48px; height: 48px; margin: auto; align-items: center; justify-content: center; border: 0; border-radius: 50%; background: var(--color-lime); color: var(--color-ink); }
  [data-player-ready] .video-poster-play { display: flex; }
  .video-poster-play :global(svg) { transform: translateX(-1px); }
  .video-loading { display: none; position: absolute; top: 50%; left: 50%; width: 30px; height: 30px; margin: -15px; border: 2px solid #ffffff40; border-top-color: var(--color-lime); border-radius: 50%; }
  [data-video-status='loading'] .video-loading { display: block; }
  [data-video-status='loading'] .video-poster-play { visibility: hidden; }
  .player-controls { --player-foreground: var(--color-dark-text); --player-track: color-mix(in srgb, var(--player-foreground) 30%, transparent); display: none; position: absolute; z-index: 3; inset-inline: 16px; bottom: max(12px, env(safe-area-inset-bottom, 0px)); align-items: center; gap: 10px; min-height: 44px; padding: 4px 0; border: 0; color: var(--player-foreground); background: transparent; }
  [data-player-ready] .player-controls { display: flex; }
  [data-controls-visible='false'] .player-controls { opacity: 0; pointer-events: none; }
  [data-controls-visible='false'] .video-player::after { opacity: 0; }
  .player-controls [hidden] { display: none !important; }
  .player-controls button { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; padding: 0; border: 0; border-radius: 6px; color: inherit; cursor: pointer; }
  .player-controls button:disabled { opacity: .35; cursor: default; }
  .player-controls .player-toggle { background: transparent; color: inherit; }
  .player-icon-button { background: transparent; }
  .player-toggle [data-icon='pause'], .player-toggle [data-icon='replay'], [data-player-mute][data-muted='true'] [data-icon='volume'], [data-player-mute][data-muted='false'] [data-icon='muted'], [data-player-fullscreen][data-active='false'] [data-icon='minimize'], [data-player-fullscreen][data-active='true'] [data-icon='expand'] { display: none; }
  .player-toggle[data-state='pause'] [data-icon='play'], .player-toggle[data-state='replay'] [data-icon='play'] { display: none; }
  .player-toggle[data-state='pause'] [data-icon='pause'], .player-toggle[data-state='replay'] [data-icon='replay'] { display: inline-flex; }
  .player-time { display: inline-flex; align-items: center; gap: 5px; flex: 0 0 auto; font-size: 11px; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .player-time-divider, [data-player-duration] { color: color-mix(in srgb, var(--player-foreground) 68%, transparent); }
  .player-range { --progress: 0%; appearance: none; display: block; min-width: 0; height: 36px; margin: 0; border: 0; border-radius: 0; background: transparent; cursor: pointer; }
  .player-range:disabled { opacity: .35; cursor: default; }
  .player-seek { flex: 1; }
  .player-audio { display: flex; flex: 0 0 auto; align-items: center; gap: 1px; }
  .player-volume { width: 58px; }
  .player-range::-webkit-slider-runnable-track { height: 3px; border-radius: 999px; background: linear-gradient(to right, var(--color-lime) var(--progress), var(--player-track) var(--progress)); }
  .player-range::-moz-range-track { height: 3px; border-radius: 999px; background: var(--player-track); }
  .player-range::-moz-range-progress { height: 3px; border-radius: 999px; background: var(--color-lime); }
  .player-range::-webkit-slider-thumb { appearance: none; width: 9px; height: 9px; margin-top: -3px; border: 0; border-radius: 50%; background: var(--player-foreground); }
  .player-range::-moz-range-thumb { width: 9px; height: 9px; border: 0; border-radius: 50%; background: var(--player-foreground); }
  .player-controls .player-retry { padding-inline: 12px; border-radius: 999px; background: var(--color-lime); color: var(--color-ink); font: 500 12px/1.2 var(--font-sans); }
  [data-video-status='error'] .player-seek { visibility: hidden; }
  .video-poster:focus-visible { outline: 2px solid var(--color-lime); outline-offset: -5px; border-radius: inherit; }
  .player-controls :focus-visible { outline: 2px solid var(--color-lime); outline-offset: 3px; }
  .video-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .video-player:fullscreen { width: 100%; height: 100%; max-height: none; min-height: 0; aspect-ratio: auto; border: 0; border-radius: 0; }
  [data-video-provider='video']:not([data-player-ready]) .video-poster { display: none; }
  @media (hover: hover) { .player-icon-button:not(:disabled):hover, .player-controls .player-toggle:not(:disabled):hover { background: color-mix(in srgb, var(--color-dark-text) 12%, transparent); } .player-controls .player-retry:hover { background: var(--color-lime-hover); } }
  @media (hover: hover) and (pointer: fine) { [data-controls-visible='false'] .video-gestures { cursor: none; } }
  @media (prefers-reduced-motion: no-preference) { .video-loading { animation: video-loading-spin 900ms linear infinite; } .player-controls, .video-player::after { transition: opacity 180ms ease; } .player-controls button { transition: background-color 150ms ease, scale 150ms ease; } .player-controls button:not(:disabled):active { scale: .96; } }
  @media (max-width: 600px) { .player-controls { inset-inline: 10px; bottom: max(8px, env(safe-area-inset-bottom, 0px)); gap: 6px; min-height: 48px; padding: 2px 0; } .player-time { gap: 4px; } .player-volume { width: 48px; } .player-controls button { min-width: 40px; min-height: 44px; } .video-poster-play { width: 44px; height: 44px; } }
  @media (max-width: 420px) { .player-controls { inset-inline: 10px; column-gap: 4px; row-gap: 0; flex-wrap: wrap; } .player-controls .player-icon-button { min-width: 36px; } .player-seek { flex-basis: 100%; height: 24px; order: -1; } .player-audio { margin-left: auto; } .player-volume { width: 44px; } }
  @media (forced-colors: active) { .player-controls button { border: 1px solid ButtonText; } .player-range { appearance: auto; forced-color-adjust: auto; } .player-range::-webkit-slider-thumb { appearance: auto; } }
  @keyframes video-loading-spin { to { transform: rotate(360deg); } }
</style>
