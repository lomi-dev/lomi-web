---
import ContentMedia from './ContentMedia.astro';
import { youtubeVideoId } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';
import workspacePlaceholder from '../assets/placeholders/workspace.png';

interface Props { content: Landing['hero'] }
const { content } = Astro.props;
const videoId = youtubeVideoId(content.videoUrl)!;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
---

<div class="hero-video" data-hero-video data-video-status="poster" data-video-id={videoId} data-video-copy={JSON.stringify(content.player)}>
  <div class="video-player" data-video-player role="group" aria-label={content.player.videoTitle} aria-busy="false" data-scroll-surface>
    <a class="video-poster" data-video-poster href={watchUrl} target="_blank" rel="noopener noreferrer" aria-label={content.player.watchLabel}>
      <ContentMedia image={content.poster} fallback={workspacePlaceholder} alt={content.previewAlt}
        widths={[480, 800, 1200, 1600]} sizes="(min-width: 1608px) 1440px, (min-width: 385px) 89.6vw, calc(100vw - 40px)"
        loading="eager" />
      <span class="video-loading" aria-hidden="true"></span>
    </a>
    <div class="video-mount" data-video-mount></div>
  </div>
  <span class="video-status" role="status" data-video-announcement></span>
</div>

<script>
  import { hasMediaConsent, onConsentChange, requestConsentSettings } from '../lib/consent';

  type Player = { mute: () => void; playVideo: () => void; pauseVideo: () => void; destroy: () => void };
  type PlayerEvent = { target: Player; data?: number };
  type API = { Player: new (iframe: HTMLIFrameElement, options: { events: {
    onReady: (event: PlayerEvent) => void;
    onStateChange: (event: PlayerEvent) => void;
    onAutoplayBlocked: () => void;
    onError: () => void;
  } }) => Player };

  const root = document.querySelector<HTMLElement>('[data-hero-video]');
  const copy = JSON.parse(root?.dataset.videoCopy ?? '{}') as import('../../content/landing-schema').Landing['hero']['player'];
  const videoId = root?.dataset.videoId ?? '';
  const surface = root?.querySelector<HTMLElement>('[data-video-player]');
  const mount = root?.querySelector<HTMLElement>('[data-video-mount]');
  const poster = root?.querySelector<HTMLAnchorElement>('[data-video-poster]');
  const announcement = root?.querySelector<HTMLElement>('[data-video-announcement]');
  const youtube = window as Window & { YT?: API; onYouTubeIframeAPIReady?: () => void };
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let active: Player | null = null;
  let version = 0;
  let pending = false;
  let ready = false;
  let visible = false;
  let inView = false;
  let autoStarted = false;
  let timeout = 0;
  let apiScript: HTMLScriptElement | null = null;
  let cancelAPI: (() => void) | null = null;

  function status(value: string, text = '') {
    if (root) root.dataset.videoStatus = value;
    surface?.setAttribute('aria-busy', String(value === 'loading'));
    if (announcement) announcement.textContent = text;
  }

  const current = (session: number) => session === version && hasMediaConsent();

  function clearPlayer() {
    version++;
    pending = ready = autoStarted = false;
    cancelAPI?.();
    clearTimeout(timeout);
    const previous = active;
    active = null;
    try { previous?.destroy(); } catch { /* Removing the iframe also stops it. */ }
    mount?.replaceChildren();
    root?.removeAttribute('data-video-mounted');
  }

  function showConsent() {
    const hadFocus = !!mount?.contains(document.activeElement);
    clearPlayer();
    apiScript?.remove();
    apiScript = null;
    status('consent');
    poster?.setAttribute('aria-label', copy.privacyLabel);
    if (hadFocus) poster?.focus({ preventScroll: true });
  }

  function loadAPI(session: number): Promise<API> {
    if (youtube.YT?.Player) return Promise.resolve(youtube.YT);
    return new Promise((resolve, reject) => {
      const previousReady = youtube.onYouTubeIframeAPIReady;
      const script = document.createElement('script');
      apiScript = script;
      let apiTimeout = 0;
      const cleanup = () => {
        clearTimeout(apiTimeout);
        script.onerror = null;
        cancelAPI = null;
        if (youtube.onYouTubeIframeAPIReady === onReady) youtube.onYouTubeIframeAPIReady = previousReady;
      };
      const fail = () => {
        cleanup();
        script.remove();
        reject(new Error('YouTube API unavailable'));
      };
      const onReady = () => {
        if (!current(session) || !youtube.YT?.Player) { fail(); return; }
        cleanup();
        resolve(youtube.YT);
        previousReady?.();
      };
      cancelAPI = fail;
      youtube.onYouTubeIframeAPIReady = onReady;
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      script.onerror = fail;
      apiTimeout = window.setTimeout(fail, 12000);
      document.head.append(script);
    });
  }

  function autoplay() {
    if (!ready || !active || !visible || autoStarted || document.hidden || reducedMotion.matches || !hasMediaConsent()) return;
    autoStarted = true;
    active.playVideo();
  }

  function fallback(session: number, error = false) {
    if (!current(session)) return;
    clearTimeout(timeout);
    status(error ? 'error' : 'ready', error ? copy.errorLabel : copy.readyLabel);
  }

  function start() {
    if (!root || !mount || pending || mount.childElementCount) return;
    if (!hasMediaConsent()) { showConsent(); return; }
    clearPlayer();
    const session = version;
    pending = true;
    status('loading', copy.loadingLabel);
    poster?.setAttribute('aria-label', copy.watchLabel);
    void loadAPI(session).then((api) => {
      if (!current(session)) return;
      const iframe = document.createElement('iframe');
      const source = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);
      source.search = new URLSearchParams({ autoplay: '0', controls: '1', playsinline: '1', enablejsapi: '1', origin: location.origin }).toString();
      iframe.src = source.href;
      iframe.title = copy.videoTitle;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      mount.replaceChildren(iframe);
      // Native controls stay visible from the moment the embed is mounted.
      // The local poster never covers an active YouTube player.
      const hadPosterFocus = document.activeElement === poster;
      root.dataset.videoMounted = 'true';
      if (hadPosterFocus) iframe.focus({ preventScroll: true });
      timeout = window.setTimeout(() => fallback(session, true), 15000);
      active = new api.Player(iframe, { events: {
        onReady: ({ target }) => {
          if (!current(session)) return;
          clearTimeout(timeout);
          pending = false;
          target.mute();
          ready = true;
          status('ready', copy.readyLabel);
          autoplay();
        },
        onStateChange: ({ data, target }) => {
          if (!current(session)) return;
          if (data === 1) {
            autoStarted = true;
            if (!inView || document.hidden) { target.pauseVideo(); status('paused'); }
            else status('playing');
          }
          else if (data === 2) status('paused');
          else if (data === 0) status('ended');
        },
        onAutoplayBlocked: () => fallback(session),
        onError: () => fallback(session, true),
      } });
    }).catch(() => { if (current(session)) { pending = false; fallback(session, true); } });
  }

  poster?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || hasMediaConsent()) return;
    event.preventDefault();
    requestConsentSettings(poster);
  });
  onConsentChange((choice) => { if (choice?.externalMedia) start(); else showConsent(); });

  if (surface && typeof IntersectionObserver !== 'undefined') {
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting && entry.intersectionRatio > 0;
      visible = entry.isIntersecting && entry.intersectionRatio >= .5;
      if (visible) autoplay();
      else if (!inView && ready) active?.pauseVideo();
    }, { threshold: [0, .5] }).observe(surface);
  }
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && ready) active?.pauseVideo();
    else autoplay();
  });
  window.addEventListener('pagehide', clearPlayer);
  window.addEventListener('pageshow', () => { if (hasMediaConsent()) start(); });
  if (hasMediaConsent()) start();
  else showConsent();
</script>

<style>
  .hero-video { min-width: 0; }
  .video-player { --scroll-surface-color: #080a08; position: relative; width: 100%; min-height: 200px; aspect-ratio: 8 / 5; overflow: hidden; border: 1px solid rgb(0 0 0 / 12%); border-radius: 16px; background: #080a08; }
  .video-poster, .video-mount { position: absolute; inset: 0; }
  .video-poster :global(picture), .video-poster :global(img) { display: block; width: 100%; height: 100%; }
  .video-poster :global(img) { object-fit: contain; }
  .video-mount { display: none; }
  [data-video-mounted] .video-mount { display: block; }
  [data-video-mounted] .video-poster { visibility: hidden; }
  .video-mount :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .video-loading { display: none; position: absolute; top: 50%; left: 50%; width: 30px; height: 30px; margin: -15px; border: 2px solid #ffffff40; border-top-color: var(--color-lime); border-radius: 50%; animation: video-loading-spin 900ms linear infinite; }
  [data-video-status='loading']:not([data-video-mounted]) .video-loading { display: block; }
  .video-poster:focus-visible { outline: 2px solid var(--color-lime); outline-offset: -5px; border-radius: inherit; }
  .video-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes video-loading-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .video-loading { animation: none; } }
</style>
