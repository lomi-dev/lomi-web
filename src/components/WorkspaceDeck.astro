---
import { Picture } from 'astro:assets';
import workbench from '../assets/product/workbench.png';
import browser from '../assets/product/browser.png';
import sourceControl from '../assets/product/source-control.png';

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;
const views = [
  { label: 'Build', image: workbench, alt, caption },
  {
    label: 'Preview',
    image: browser,
    alt: 'Lomi workspace with a development terminal beside an integrated browser showing the Lomi website.',
    caption: 'Run your development server and preview the result beside it.',
  },
  {
    label: 'Review',
    image: sourceControl,
    alt: 'Lomi source control showing commit history, changed files, and a code diff.',
    caption: 'Follow the commit history and inspect changes in the same workspace.',
  },
];
---

<lomi-workspace-deck class="deck-root">
  <figure class="deck-figure">
    <div class="deck-frame">
      <div class="deck-chrome">
        <span class="deck-label"><span class="deck-mark" aria-hidden="true"></span>lomi / workspace preview</span>
        <span class="deck-platform">desktop</span>
      </div>
      <div class="deck-rail">
        <div class="deck-controls" role="group" aria-label="Choose a workspace view" hidden>
          {views.map((view, index) => (
            <button class="deck-button" type="button" data-deck-view={index} aria-pressed={index === 0}>
              <span class="deck-button-index" aria-hidden="true">0{index + 1}</span>{view.label}
            </button>
          ))}
        </div>
        <span class="deck-kind">Product screenshots</span>
      </div>
      <div class="deck-stage">
        {views.map((view, index) => (
          <div class="deck-panel" data-deck-panel data-caption={view.caption} hidden={index !== 0}>
            <Picture
              src={view.image}
              alt={view.alt}
              formats={['avif', 'webp']}
              widths={[640, 960, 1440, 1920]}
              sizes="(min-width: 1336px) 1240px, (min-width: 1191px) calc(100vw - 96px), (min-width: 768px) calc(100vw - 64px), calc(100vw - 40px)"
              loading="lazy"
              decoding="async"
              class="deck-image"
            />
          </div>
        ))}
      </div>
    </div>
    <figcaption class="deck-caption" aria-live="polite" aria-atomic="true">{caption}</figcaption>
  </figure>
</lomi-workspace-deck>

<script>
  class LomiWorkspaceDeck extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      const panels = Array.from(this.querySelectorAll<HTMLElement>('[data-deck-panel]'));
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-deck-view]'));
      const controls = this.querySelector<HTMLElement>('.deck-controls');
      const caption = this.querySelector<HTMLElement>('.deck-caption');
      if (!controls || !caption || panels.length !== buttons.length || panels.length === 0) return;

      buttons.forEach((button, selectedIndex) => {
        button.addEventListener('click', () => {
          panels.forEach((panel, index) => { panel.hidden = index !== selectedIndex; });
          buttons.forEach((control, index) => {
            control.setAttribute('aria-pressed', String(index === selectedIndex));
          });
          caption.textContent = panels[selectedIndex]?.dataset.caption ?? '';
        });
      });
      this.dataset.initialized = 'true';
      controls.hidden = false;
    }
  }

  if (!customElements.get('lomi-workspace-deck')) {
    customElements.define('lomi-workspace-deck', LomiWorkspaceDeck);
  }
</script>

<style>
  .deck-root { display: block; width: 100%; min-width: 0; }
  .deck-figure { min-width: 0; margin: 0; }
  .deck-frame {
    overflow: hidden;
    border: 1px solid #45484b;
    border-radius: 4px;
    background: #171a1e;
    color: #e9eae5;
    box-shadow: 0 20px 50px -28px rgb(12 15 14 / 45%);
  }
  .deck-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 8px 14px;
    border-bottom: 1px solid #363b40;
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    line-height: 1.5;
  }
  .deck-label { display: flex; align-items: center; gap: 9px; }
  .deck-mark { width: 6px; height: 6px; border: 1px solid #c8f575; transform: rotate(45deg); }
  .deck-platform { color: #a6afb5; }
  .deck-stage { aspect-ratio: 8 / 5; background: #101214; }
  .deck-panel { width: 100%; height: 100%; }
  .deck-panel[hidden], .deck-controls[hidden] { display: none; }
  .deck-panel :global(picture) { display: block; width: 100%; height: 100%; }
  .deck-panel :global(.deck-image) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .deck-rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 54px;
    padding: 6px 12px;
    border-bottom: 1px solid #363b40;
  }
  .deck-controls { display: flex; flex-wrap: wrap; gap: 4px; }
  .deck-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    color: #bac1c6;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    line-height: 1.4;
    cursor: pointer;
  }
  .deck-button-index { color: #8b959c; font-size: 9px; }
  .deck-button[aria-pressed='true'] { border-color: #525c4b; background: #252d21; color: #dafbaf; }
  .deck-button[aria-pressed='true'] .deck-button-index { color: #b0ce8b; }
  .deck-button:focus-visible { outline: 2px solid #d5f8a8; outline-offset: 2px; }
  .deck-kind {
    color: #a6afb5;
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    line-height: 1.5;
  }
  .deck-caption { margin-top: 13px; color: var(--color-text-secondary, #626b65); font-size: 12px; line-height: 1.6; }
  @media (hover: hover) {
    .deck-button:hover { border-color: #626d74; color: #fff; }
  }
  @media (max-width: 440px) {
    .deck-chrome { gap: 8px; padding-inline: 10px; font-size: 9px; }
    .deck-rail { padding-inline: 7px; gap: 5px; }
    .deck-button { min-height: 44px; padding-inline: 8px; }
    .deck-kind { width: 100%; padding: 0 8px 5px; }
  }
</style>
