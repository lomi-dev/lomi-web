---
// Temporarily disabled until the hero video is ready.
// import HeroVideo from './HeroVideo.astro';
import ContentMedia from './ContentMedia.astro';
import type { Landing } from '../../content/landing-schema';
import type { MediaAsset } from '../../content/editor-schema';

interface Props { content: Landing['hero']; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
---

<figure class="workspace-showcase" id="workspace" aria-label={content.previewAlt}>
  {/* Restore this media switch and the HeroVideo import when the video is ready.
    {content.mediaMode === 'youtube' || content.mediaMode === 'video' && content.video ? <HeroVideo content={content} placeholderLogo={placeholderLogo} /> : <div class="workspace-capture" data-scroll-surface data-product-capture={!content.poster || undefined} style={!content.poster ? '--scroll-surface-color: color-mix(in srgb, var(--color-ink) 3%, var(--color-chalk))' : undefined}>
      <ContentMedia image={content.poster} video={content.mediaMode === 'video' ? content.video : null} alt={content.previewAlt} placeholderLogo={placeholderLogo} placeholderVariant="hero" loading="eager" />
    </div>}
  */}
  <div class="workspace-capture" data-scroll-surface data-product-capture={!content.poster || undefined} style={!content.poster ? '--scroll-surface-color: color-mix(in srgb, var(--color-ink) 3%, var(--color-chalk))' : undefined}>
    <ContentMedia image={content.poster} alt={content.previewAlt} placeholderLogo={placeholderLogo} placeholderVariant="hero" loading="eager" />
  </div>
</figure>

<style>
  .workspace-showcase {
    margin: 0;
    min-width: 0;
  }
  .workspace-capture { --scroll-surface-color: #080a08; width: 100%; min-height: 200px; aspect-ratio: 8 / 5; overflow: hidden; border: 1px solid rgb(0 0 0 / 12%); border-radius: 16px; background: #080a08; }
  .workspace-capture[data-product-capture] :global(img) { object-fit: cover; }
  .workspace-capture :global([data-media-placeholder]) { border: 0; border-radius: 0; }
</style>
