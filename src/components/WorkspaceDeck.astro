---
import HeroVideo from './HeroVideo.astro';

interface Props { alt: string }
const { alt } = Astro.props;
---

<figure class="workspace-showcase" id="workspace" aria-label="Lomi product walkthrough">
  <HeroVideo alt={alt} />
</figure>

<style>
  .workspace-showcase {
    margin: 0;
    min-width: 0;
  }
</style>
