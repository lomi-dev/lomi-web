---
import { getImage, Picture } from 'astro:assets';
import laptop from '../assets/hero/laptop-concrete.png';
import workbench from '../assets/product/workbench.png';
import { resolveMedia } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';
import { buildScreenMesh, screenOutline } from '../lib/laptop-screen';

interface Props { content: Landing['hero'] }
const { content } = Astro.props;
const poster = resolveMedia(content.poster, import.meta.env.CMS_URL);
const screen = poster ? poster.url : (await getImage({ src: workbench, width: 1920, format: 'webp', quality: 90 })).src;
const mesh = buildScreenMesh();
---

<figure class="workspace-showcase" id="workspace" role="img" aria-label={content.previewAlt}>
  <Picture src={laptop} alt="" aria-hidden="true" class="laptop-render" widths={[768, 1200, 1536]}
    sizes="(min-width: 900px) and (min-aspect-ratio: 4/3) min(82vw, calc((100vh - 88px) * 1.5), 1920px), (min-width: 560px) and (max-height: 600px) and (orientation: landscape) min(82vw, calc((100vh - 80px) * 1.5)), 100vw"
    formats={['webp']} quality={88} loading="eager" fetchpriority="high" />
  {/* Build-time affine tiles keep perspective identical across browsers. The
      single source image is shared by every tile and downloaded only once. */}
  <svg class="laptop-display" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs>
      <image id="lomi-screen-capture" data-screen-source href={screen} width="900" height="562" preserveAspectRatio="xMidYMid slice" />
      <clipPath id="lomi-screen-bezel"><polygon points={screenOutline} /></clipPath>
      {mesh.map((tile, index) => <clipPath id={`lomi-screen-tile-${index}`}><polygon points={tile.points} /></clipPath>)}
      <linearGradient id="lomi-screen-glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="white" stop-opacity=".035" />
        <stop offset=".5" stop-color="white" stop-opacity="0" />
        <stop offset="1" stop-color="black" stop-opacity=".1" />
      </linearGradient>
    </defs>
    <g data-laptop-screen clip-path="url(#lomi-screen-bezel)">
      {mesh.map((tile, index) => <g clip-path={`url(#lomi-screen-tile-${index})`}><use href="#lomi-screen-capture" transform={tile.transform} /></g>)}
      <polygon points={screenOutline} fill="url(#lomi-screen-glass)" />
    </g>
    <polygon data-screen-boundary points={screenOutline} fill="none" />
  </svg>
</figure>

<style>
  .workspace-showcase { position: relative; width: 100%; aspect-ratio: 3 / 2; margin: 0; isolation: isolate; }
  .workspace-showcase > :global(picture) { display: block; width: 100%; height: 100%; }
  .workspace-showcase :global(.laptop-render) { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .laptop-display { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; }
</style>
