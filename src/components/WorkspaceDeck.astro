---
import { Picture } from 'astro:assets';
import workbench from '../assets/product/workbench.png';
import sourceControl from '../assets/product/source-control.png';

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;
---

<div class="deck-root">
  <figure class="deck-figure" id="workspace">
    <div class="deck-composition">
      <a class="deck-frame" href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" data-video-open aria-label="Watch the Lomi video" aria-haspopup="dialog" aria-controls="video-dialog">
        <Picture
          src={workbench}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 1965px) 1514px, (min-width: 768px) 77vw, calc(100vw - 40px)"
          loading="eager"
          decoding="async"
          class="deck-image"
        />
        <span class="deck-overlay" data-video-overlay aria-hidden="true"></span>
        <span class="deck-play" data-video-play aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M6 3.5a.7.7 0 0 1 1.06-.6l9 6.5a.74.74 0 0 1 0 1.2l-9 6.5A.7.7 0 0 1 6 16.5Z" /></svg>
        </span>
      </a>
      <div class="deck-detail" data-workspace-detail>
        <Picture
          src={sourceControl}
          alt="Lomi source-control detail showing a commit and its code changes."
          formats={['avif', 'webp']}
          widths={[360, 520, 720, 960]}
          sizes="(min-width: 1278px) 460px, (min-width: 768px) 33vw, (min-width: 573px) 330px, calc(62vw - 24.8px)"
          loading="eager"
          decoding="async"
          class="deck-detail-image"
        />
      </div>
    </div>
    <figcaption class="deck-caption">{caption}</figcaption>
  </figure>
</div>

<style>
  .deck-root { display: block; width: 100%; min-width: 0; }
  .deck-figure { min-width: 0; margin: 0; }
  .deck-composition { display: grid; grid-template-areas: 'capture'; min-width: 0; }
  .deck-frame, .deck-detail { grid-area: capture; align-self: start; min-width: 0; overflow: hidden; border: 1px solid #d5dccd; border-radius: 16px; background: #fff; box-shadow: 0 24px 70px -32px rgb(30 45 19 / 25%); }
  .deck-frame { position: relative; display: block; width: 86%; aspect-ratio: 8 / 5; }
  .deck-detail { position: relative; z-index: 1; justify-self: end; width: 36%; max-width: 460px; aspect-ratio: 1.1; margin-top: 104px; transform: translateX(40px); }
  .deck-frame :global(picture), .deck-detail :global(picture) { display: block; width: 100%; height: 100%; }
  .deck-frame :global(.deck-image), .deck-detail :global(.deck-detail-image) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .deck-detail :global(.deck-detail-image) { object-position: right top; }
  .deck-overlay { position: absolute; inset: 0; background: #050a07; opacity: 0; transition: opacity 180ms ease; }
  .deck-play { position: absolute; left: 50%; top: 50%; display: grid; width: 64px; height: 64px; place-items: center; transform: translate(-50%, -50%) scale(.92); border: 1px solid #e6ffb3; border-radius: 50%; background: linear-gradient(180deg, #dcff91, #bce950); color: #16200e; box-shadow: 0 0 0 10px #c8ff3d12, 0 8px 30px #0005; opacity: 0; transition: opacity 180ms ease, transform 220ms var(--ease-out); }
  .deck-play::before { content: ''; position: absolute; inset: -10px; border: 1px solid #dfff9e30; border-radius: inherit; }
  .deck-play svg { margin-left: 2px; }
  .deck-frame:focus-visible .deck-overlay { opacity: .22; }
  .deck-frame:focus-visible .deck-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .deck-frame:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 5px; }
  .deck-caption { margin-top: 13px; color: var(--color-text-secondary, #87917f); font-size: 12px; line-height: 1.6; }
  @media (hover: hover) {
    .deck-frame:hover .deck-overlay { opacity: .22; }
    .deck-frame:hover .deck-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  @media (hover: none) {
    .deck-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    .deck-overlay { opacity: .08; }
  }
  @media (max-width: 767px) {
    .deck-frame { width: 100%; aspect-ratio: 8 / 7; }
    .deck-frame :global(.deck-image) { object-position: left top; }
    .deck-detail { width: 62%; max-width: 330px; margin-top: 56vw; transform: translateX(12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .deck-overlay, .deck-play { transition: none; }
    .deck-play { transform: translate(-50%, -50%); }
  }
</style>
