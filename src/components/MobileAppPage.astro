---
import GlassBackdrop from './GlassBackdrop.astro';
import MobilePhonePreview from './MobilePhonePreview.astro';
import MobileStoreBadges from './MobileStoreBadges.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import type { Landing } from '../../content/landing-schema';

interface Props {
  newsletterForm?: Landing['newsletter']['form'];
  content: {
    title: string;
    description: string;
    showcase: {
      eyebrow: string;
      title: string;
      description: string;
      capabilities: readonly { title: string; description: string }[];
      imageAlt: string;
    };
    newsletter: { title: string; description: string };
  };
}

const { content, newsletterForm } = Astro.props;
---

<div data-mobile-app-page data-scroll-surface>
  <section class="hero" data-enter aria-labelledby="mobile-app-title">
    <GlassBackdrop />
    <div class="hero-inner shell">
      <div class="hero-copy">
        <h1 id="mobile-app-title">{content.title}</h1>
        <p class="hero-description">{content.description}</p>
        <MobileStoreBadges />
      </div>
      <MobilePhonePreview alt={content.showcase.imageAlt} />
    </div>
  </section>

  <section class="section showcase" aria-labelledby="mobile-showcase-title">
    <div class="shell showcase-layout">
      <div>
        <p class="eyebrow">{content.showcase.eyebrow}</p>
        <h2 id="mobile-showcase-title">{content.showcase.title}</h2>
        {content.showcase.description && <p class="section-description">{content.showcase.description}</p>}
      </div>
      <ol class="capabilities">
        {content.showcase.capabilities.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}
      </ol>
    </div>
  </section>

  {newsletterForm && <section class="section notify" id="mobile-newsletter" tabindex="-1" aria-labelledby="mobile-newsletter-title">
    <div class="shell notify-inner">
      <h2 id="mobile-newsletter-title">{content.newsletter.title}</h2>
      <p class="section-description">{content.newsletter.description}</p>
      <NewsletterSignup content={newsletterForm} />
    </div>
  </section>}
</div>

<style>
  .hero { position: relative; isolation: isolate; overflow: clip; height: 100svh; min-height: 720px; max-height: 1000px; background: var(--color-night-950); color: var(--color-ink); }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; gap: clamp(40px, 5vw, 72px); height: 100%; padding-top: var(--site-header-height); }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .hero h1 { font-size: clamp(48px, min(7vw, 13svh), 116px); line-height: .92; }
  .hero-description { max-width: 34ch; margin-top: 28px; color: #c8c8d0; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; text-wrap: pretty; }
  .hero-copy :global(.mobile-store-badges) { margin-top: 40px; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: hero-rise 800ms var(--ease-out) both; }
    .hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .hero-copy > :nth-child(3) { animation-delay: 160ms; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } }
  @media (max-width: 1023px) {
    .hero { height: auto; min-height: 0; max-height: none; }
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 56px; padding-top: calc(var(--site-header-height) + 56px); }
  }
  @media (max-width: 767px) {
    .hero-inner { gap: 44px; padding-top: calc(var(--site-header-height) + 40px); }
    .hero h1 { font-size: clamp(44px, 13vw, 60px); }
    .hero-description { margin-top: 20px; }
    .hero-copy :global(.mobile-store-badges) { width: 100%; margin-top: 28px; }
  }

  .showcase { border-top: 1px solid var(--line); }
  .showcase-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(48px, 7vw, 112px); align-items: center; }
  .showcase h2 { margin-top: 20px; max-width: 12ch; }
  .showcase .section-description { margin-top: 24px; }
  .capabilities { margin: 0; padding: 0; list-style: none; }
  .capabilities li { display: grid; grid-template-columns: 48px 1fr; gap: 8px; padding-block: 28px; border-top: 1px solid var(--line); }
  .capabilities li:last-child { border-bottom: 1px solid var(--line); }
  .capabilities li > span { padding-top: 6px; color: var(--color-violet-300); font-family: var(--font-mono); font-size: 12px; font-weight: 500; }
  .capabilities h3 { font-size: 20px; font-weight: 600; }
  .capabilities p { margin-top: 8px; max-width: 46ch; color: var(--color-text-secondary); font-size: 15px; line-height: 1.6; }

  .notify { border-top: 1px solid var(--line); text-align: center; scroll-margin-top: 80px; }
  .notify-inner { width: min(620px, calc(100% - 40px)); }
  .notify .section-description { margin: 20px auto 32px; }
  .notify :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr) auto; }
  .notify :global(.newsletter button) { width: auto; white-space: nowrap; }
  .notify :global(.newsletter-submit-icon) { display: none; }

  @media (max-width: 1023px) {
    .hero { height: auto; min-height: 0; max-height: none; }
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 56px; padding-top: calc(var(--site-header-height) + 64px); padding-bottom: 72px; }
    .showcase-layout { grid-template-columns: minmax(0, 1fr); gap: 48px; }
  }
  @media (max-width: 767px) {
    .hero-inner { gap: 48px; padding-top: calc(var(--site-header-height) + 40px); padding-bottom: 56px; }
    .hero h1 { font-size: clamp(44px, 13vw, 60px); }
    .hero-description { margin-top: 20px; }
    .hero-copy { width: 100%; }
    .notify :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
