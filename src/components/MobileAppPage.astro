---
import Icon from './Icon';
import MobilePhonePreview from './MobilePhonePreview.astro';
import MobileStoreBadges from './MobileStoreBadges.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import type { Landing } from '../../content/landing-schema';

interface Capability {
  title: string;
  description: string;
}

interface Props {
  newsletterForm?: Landing['newsletter']['form'];
  content: {
    title: string;
    description: string;
    showcase: {
      eyebrow: string;
      title: string;
      description: string;
      capabilities: readonly Capability[];
      imageAlt: string;
      imageCaption: string;
    };
    newsletter: { title: string; description: string };
  };
}

const { content, newsletterForm } = Astro.props;
---

<section class="mobile-app-page" data-mobile-app-page data-scroll-surface aria-labelledby="mobile-app-title">
  <div class="mobile-app-shell">
    <header class="mobile-app-opening">
      <h1 id="mobile-app-title">{content.title}</h1>
      <p class="mobile-app-intro">{content.description}</p>

      <MobileStoreBadges />
    </header>

    <section class="mobile-app-showcase" aria-labelledby="mobile-showcase-title">
      <MobilePhonePreview alt={content.showcase.imageAlt} caption={content.showcase.imageCaption} />

      <div class="mobile-showcase-copy">
        <p class="mobile-showcase-eyebrow">{content.showcase.eyebrow}</p>
        <h2 id="mobile-showcase-title">{content.showcase.title}</h2>
        <p class="mobile-showcase-description">{content.showcase.description}</p>
        {newsletterForm && <section class="mobile-launch-signup" id="mobile-newsletter" tabindex="-1" aria-labelledby="mobile-newsletter-title">
          <h3 id="mobile-newsletter-title">{content.newsletter.title}</h3>
          <p class="mobile-newsletter-description">{content.newsletter.description}</p>
          <NewsletterSignup content={newsletterForm} />
        </section>}
      </div>
    </section>

    <ul class="mobile-capabilities">
      {content.showcase.capabilities.map((capability) => <li>
        <span class="mobile-capability-mark" aria-hidden="true"><Icon name="arrow" width={15} height={15} /></span>
        <div><h3>{capability.title}</h3><p>{capability.description}</p></div>
      </li>)}
    </ul>
  </div>
</section>

<style>
  .mobile-app-page { --scroll-surface-color: var(--color-paper); --mobile-muted: #5b6355; --mobile-line: #dfe4d8; min-height: min(800px, 100svh); padding: 132px 0 80px; background: var(--color-paper); color: var(--color-ink); }
  .mobile-app-shell { width: min(1120px, calc(100% - 80px)); margin-inline: auto; }
  .mobile-app-opening { max-width: 700px; margin: 0 auto; text-align: center; }
  .mobile-app-opening h1 { margin: 0; font-size: clamp(54px, 6vw, 76px); font-weight: 500; line-height: 1.03; letter-spacing: -.06em; text-wrap: balance; }
  .mobile-app-intro { max-width: 590px; margin: 20px auto 0; color: var(--mobile-muted); font-size: 17px; line-height: 1.65; text-wrap: balance; }
  .mobile-app-opening :global(.mobile-store-badges) { margin-top: 26px; }
  .mobile-app-showcase { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); align-items: center; gap: clamp(28px, 4vw, 56px); margin-top: 48px; padding: 40px; border-radius: 16px; background: #edf1e7; }
  .mobile-showcase-copy { min-width: 0; max-width: 510px; padding-block: 10px; }
  .mobile-showcase-eyebrow { margin: 0 0 16px; color: #596b48; font-size: 12px; font-weight: 500; line-height: 1.5; }
  .mobile-showcase-copy h2 { margin: 0; font-size: clamp(34px, 4vw, 48px); font-weight: 500; line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
  .mobile-showcase-description { margin: 18px 0 0; color: var(--mobile-muted); font-size: 15px; line-height: 1.7; }
  .mobile-launch-signup { margin-top: 28px; padding-top: 24px; border-top: 1px solid #d8dfd0; scroll-margin-top: 112px; }
  .mobile-launch-signup > h3 { margin: 0; font-size: 21px; font-weight: 500; line-height: 1.3; letter-spacing: -.025em; }
  .mobile-newsletter-description { margin: 8px 0 20px; color: var(--mobile-muted); font-size: 13px; line-height: 1.65; }
  #mobile-newsletter :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr) auto; }
  #mobile-newsletter :global(.newsletter input) { min-height: 52px; padding-inline: 12px; background: var(--color-paper); }
  #mobile-newsletter :global(.newsletter button) { width: auto; padding-inline: 16px; white-space: nowrap; }
  #mobile-newsletter :global(.newsletter-submit-icon) { display: none; }
  #mobile-newsletter :global(.newsletter-status) { min-height: 1.5em; margin-top: 8px; }
  #mobile-newsletter :global(.newsletter-note) { margin-top: 8px; text-align: left; }
  .mobile-capabilities { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 32px 0 0; padding: 0; list-style: none; }
  .mobile-capabilities li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; padding: 20px 0; border-top: 1px solid #d8dfd0; }
  .mobile-capability-mark { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid #d2dac9; border-radius: 50%; color: #536344; }
  .mobile-capabilities h3 { margin: 0; font-size: 14px; font-weight: 550; line-height: 1.5; }
  .mobile-capabilities p { margin: 3px 0 0; color: var(--mobile-muted); font-size: 13px; line-height: 1.55; }
  @media (forced-colors: active) {
    .mobile-capability-mark { border-color: CanvasText; }
  }
  @media (min-width: 1000px) and (max-width: 1199px) { .mobile-app-shell { width: calc(100% - 64px); } }
  @media (max-width: 999px) {
    .mobile-app-page { padding-top: 128px; }
    .mobile-app-shell { width: calc(100% - 48px); }
    .mobile-app-showcase { grid-template-columns: minmax(0, 1fr); gap: 36px; padding: 36px; }
    .mobile-showcase-copy { max-width: 560px; margin-inline: auto; }
    #mobile-newsletter :global(.newsletter-controls) { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .mobile-app-page { min-height: min(680px, 100svh); padding: 112px 0 56px; }
    .mobile-app-shell { width: calc(100% - 40px); }
    .mobile-app-opening h1 { font-size: clamp(43px, 9vw, 60px); letter-spacing: -.05em; }
    .mobile-app-intro { margin-top: 16px; font-size: 15px; }
    .mobile-app-showcase { grid-template-columns: minmax(0, 1fr); gap: 34px; margin-top: 40px; padding: 24px; border-radius: 12px; }
    .mobile-showcase-copy { max-width: none; padding: 0; }
    .mobile-showcase-copy h2 { font-size: clamp(32px, 7vw, 42px); }
    .mobile-capabilities { grid-template-columns: minmax(0, 1fr); gap: 0; margin-top: 24px; }
    .mobile-launch-signup { scroll-margin-top: 96px; }
  }
  @media (max-width: 359px) {
    .mobile-app-shell { width: calc(100% - 32px); }
    .mobile-app-showcase { padding: 16px; }
  }
</style>
