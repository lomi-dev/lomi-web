---
import ContentMedia from './ContentMedia.astro';
import Icon from './Icon';
import type { MediaAsset } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['features']; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
const mediaAlt = (item: Landing['features']['items'][number]) => item.alt || item.image?.alt || item.video?.alt || item.title;
---

{/* One stage, one feature at a time: a vertical list of features on the left (the active one shows its
    description) and its real recording on the right. On wide, tall screens the section pins and the
    page's scroll moves through the features (the client's choice); elsewhere tabs are chosen by click. */}
<section id="features" class="features" data-features data-scroll-surface aria-labelledby="features-title">
  <div class="shell">
    <header class="features-head">
      <h2 id="features-title">{content.title}<span>{content.accent}</span></h2>
      {content.description && <p class="section-description">{content.description}</p>}
    </header>
  </div>
  <div class="track" data-features-track style={`--count: ${content.items.length}`}>
  <div class="pin">
  <div class="shell">
    <div class="features-body">
      <div class="feature-tabs" role="tablist" aria-label={content.controls.chooseLabel} aria-orientation="vertical">
        {content.items.map((item, index) => <button class="feature-tab" type="button" role="tab" id={`feature-tab-${index}`} aria-controls={`feature-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-feature-tab={index}>
          <span class="tab-icon" aria-hidden="true"><Icon name={item.icon} width={18} height={18} /></span>
          <span class="tab-text">
            <span class="tab-title">{item.title}</span>
            <span class="tab-desc"><span>{item.description}</span></span>
          </span>
        </button>)}
      </div>

      <div class="feature-stage">
        {content.items.map((item, index) => <div class="feature-panel" role="tabpanel" id={`feature-panel-${index}`} aria-labelledby={`feature-tab-${index}`} hidden={index !== 0} data-feature-panel={index}>
          <div class="panel-media">
            <ContentMedia image={item.image} video={item.video} placeholderLogo={placeholderLogo} placeholderFeature={item.icon} alt={mediaAlt(item)} controls={false} widths={[960, 1440, 1920]} sizes="(min-width: 1200px) 820px, (min-width: 900px) 64vw, calc(100vw - 40px)" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
          <p class="panel-desc">{item.description}</p>
        </div>)}
      </div>
    </div>
  </div>
  </div>
  </div>
</section>

<script>
  import { initFeatureVideos } from './feature-videos';
  document.querySelectorAll<HTMLElement>('[data-features]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-feature-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-feature-panel]')];
    const track = root.querySelector<HTMLElement>('[data-features-track]');
    const pinned = matchMedia('(min-width: 900px) and (min-height: 700px), (max-width: 899px) and (min-height: 560px)');
    const tabRow = root.querySelector<HTMLElement>('.feature-tabs');
    let current = 0;
    const select = (index: number, focus = false) => {
      if (index === current && !focus) return;
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        const on = i === index;
        if (on) {
          if (panel.hidden) {
            // each feature's recording starts from its beginning when it is chosen
            const video = panel.querySelector('video');
            if (video) video.currentTime = 0;
          }
          delete panel.dataset.leaving;
          panel.hidden = false;
        } else if (!panel.hidden && panel.dataset.leaving === undefined) {
          // the outgoing recording fades under the incoming one instead of vanishing
          panel.dataset.leaving = '';
          setTimeout(() => { if (panel.dataset.leaving !== undefined) { panel.hidden = true; delete panel.dataset.leaving; } }, 320);
        }
      });
      if (focus) tabs[index]?.focus({ preventScroll: pinned.matches });
      // keep the chosen tab in view in the phone's horizontal row, without moving the page
      if (tabRow && tabRow.scrollWidth > tabRow.clientWidth) tabRow.scrollTo({ left: tabs[index].offsetLeft - tabRow.offsetLeft - 20, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };

    // Pinned mode: progress through the tall track picks the feature and fills the progress line.
    const range = () => {
      if (!track) return null;
      const top = track.getBoundingClientRect().top + scrollY;
      const span = track.offsetHeight - innerHeight;
      return span > 0 ? { top, span } : null;
    };
    let frame = 0;
    let settle: ReturnType<typeof setTimeout> | undefined;
    let pending = -1;
    const onScroll = () => {
      frame = 0;
      const r = pinned.matches ? range() : null;
      if (!r) return;
      const progress = Math.min(1, Math.max(0, (scrollY - r.top) / r.span));
      root.style.setProperty('--progress', progress.toFixed(4));
      // Hysteresis: leave the current feature only once the scroll is a little past its edge.
      const exact = progress * tabs.length;
      const margin = .12;
      let target = current;
      if (exact < current - margin || exact > current + 1 + margin) target = Math.min(tabs.length - 1, Math.floor(exact));
      // Settle: the line follows the scroll at once, but the feature (and its recording) changes
      // only after the scroll has calmed, so a fast flick swaps the stage once, not six times.
      // The timer restarts only when the target changes, so a steady scroll still switches promptly.
      if (target === pending) return;
      clearTimeout(settle);
      pending = target;
      if (target !== current) settle = setTimeout(() => { pending = -1; select(target); }, 150);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(onScroll); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    // Pinned on phones: the heading moves into the pin, so title, tabs and recording fill the screen together.
    const head = root.querySelector<HTMLElement>('.features-head');
    const headHome = head?.parentElement;
    const pinShell = root.querySelector<HTMLElement>('.pin > .shell');
    const narrowPinned = matchMedia('(max-width: 899px) and (min-height: 560px)');
    const placeHead = () => { if (head && headHome && pinShell) (narrowPinned.matches ? pinShell.prepend(head) : headHome.append(head)); };
    pinned.addEventListener('change', () => { root.toggleAttribute('data-pinned', pinned.matches); placeHead(); schedule(); });
    root.toggleAttribute('data-pinned', pinned.matches);
    placeHead();
    schedule();
    // In pinned mode a choice scrolls the page to that feature's stretch of the track.
    const go = (index: number, focus = false) => {
      clearTimeout(settle);
      pending = -1;
      const r = pinned.matches ? range() : null;
      if (!r) { select(index, focus); return; }
      select(index, focus);
      scrollTo({ top: r.top + ((index + .5) / tabs.length) * r.span, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => go(index));
      tab.addEventListener('keydown', (event) => {
        const step = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(event.key) ? -1 : 0;
        if (event.key === 'Home' || event.key === 'End') { event.preventDefault(); go(event.key === 'Home' ? 0 : tabs.length - 1, true); return; }
        if (!step) return;
        event.preventDefault();
        go((index + step + tabs.length) % tabs.length, true);
      });
    });
    initFeatureVideos(root);
  });
</script>

<style>
  .features { --scroll-surface-color: var(--color-chalk); padding-block: clamp(80px, 9vw, 128px); background: var(--color-chalk); color: var(--color-ink); }
  .features-head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; gap: 24px 64px; }
  .features-head h2 > span { display: block; }
  .features-head .section-description { justify-self: end; }
  /* Pinned: the track is one screen plus ~65% of a screen per feature; the pin sticks below the header. */
  /* The heading scrolls in above; the pin holds only the list and the stage, each centred on its own,
     so the recording sits in the vertical middle of the screen whatever the list's height. */
  [data-pinned] { padding-bottom: 0; }
  [data-pinned] .track { height: calc(100svh + var(--count) * 65svh); }
  [data-pinned] .pin { position: sticky; top: 0; height: 100svh; padding-block: var(--site-header-height); }
  [data-pinned] .pin > .shell { height: 100%; }
  [data-pinned] .features-body { height: 100%; margin-top: 0; }
  .features-body { display: grid; grid-template-columns: minmax(280px, 4fr) minmax(0, 8fr); gap: clamp(28px, 4vw, 64px); align-items: center; margin-top: clamp(40px, 5vw, 72px); }

  /* The list: icon, title, and for the active one its description opening below. */
  .feature-tabs { position: relative; display: flex; flex-direction: column; gap: 4px; }
  /* progress along the list while the page scrolls through the features */
  [data-pinned] .feature-tabs { padding-left: 20px; }
  [data-pinned] .feature-tabs::before, [data-pinned] .feature-tabs::after { position: absolute; top: 8px; bottom: 8px; left: 0; width: 2px; border-radius: 1px; background: var(--line-strong); content: ''; }
  [data-pinned] .feature-tabs::after { bottom: auto; height: calc((100% - 16px) * var(--progress, 0)); background: var(--color-lime); box-shadow: 0 0 12px rgb(185 245 0 / .6); }
  .feature-tab { position: relative; display: flex; align-items: flex-start; gap: 16px; width: 100%; padding: 16px 18px; border: 1px solid transparent; border-radius: 16px; background: transparent; color: var(--color-text-secondary); font: inherit; text-align: left; cursor: pointer; transition: background-color var(--dur) ease-out, border-color var(--dur) ease-out, color var(--dur) ease-out; }
  .tab-icon { display: grid; flex: none; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line-strong); border-radius: 10px; color: var(--color-text-secondary); transition: background-color var(--dur) ease-out, border-color var(--dur) ease-out, color var(--dur) ease-out; }
  .tab-text { display: flex; flex-direction: column; min-width: 0; padding-top: 6px; }
  .tab-title { font-size: 17px; font-weight: 600; line-height: 1.3; }
  .tab-desc { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows var(--dur-slow) var(--ease-out), opacity var(--dur) ease-out; }
  .tab-desc > span { overflow: hidden; padding-top: 0; color: var(--color-text-secondary); font-size: 15px; line-height: 1.55; }
  .feature-tab[aria-selected='true'] { border-color: var(--line); background: var(--color-paper); color: var(--color-ink); }
  .feature-tab[aria-selected='true'] .tab-icon { border-color: transparent; background: var(--color-lime); color: var(--on-accent); }
  .feature-tab[aria-selected='true'] .tab-desc { grid-template-rows: 1fr; opacity: 1; }
  .feature-tab[aria-selected='true'] .tab-desc > span { padding-top: 8px; }
  .feature-tab:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }

  /* The stage: the recording on the brand's lit ground, crossfading between features. */
  .feature-stage { position: relative; display: grid; min-width: 0; }
  .feature-panel { position: relative; z-index: 1; grid-area: 1 / 1; min-width: 0; }
  .feature-panel[data-leaving] { z-index: 0; }
  .feature-panel[hidden] { display: none; }
  .panel-media { overflow: hidden; border: 1px solid var(--line); border-radius: 24px; background: var(--color-night-850); box-shadow: 0 50px 120px -40px rgb(0 0 0 / .9); }
  .panel-media :global(.feature-capture) { border-radius: 0; }
  /* the recording fills more of the stage than in a small card, so its interface stays readable */
  .panel-media :global(.feature-window) { width: min(90cqw, 140cqh); border-radius: .9cqw; }
  .panel-media :global(picture), .panel-media :global(img) { display: block; width: 100%; height: auto; }
  .panel-desc { display: none; margin-top: 16px; color: var(--color-text-secondary); font-size: 15px; line-height: 1.55; }

  @media (hover: hover) {
    .feature-tab[aria-selected='false']:hover { color: var(--color-ink); background: rgb(247 247 249 / 3%); }
    .feature-tab[aria-selected='false']:hover .tab-icon { border-color: var(--color-night-600); color: var(--color-ink); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature-panel:not([hidden]):not([data-leaving]) { animation: panel-in 360ms var(--ease-out); }
    .feature-panel[data-leaving] { animation: panel-out 300ms ease-out forwards; }
    .feature-tab:active { transform: scale(.985); transition: transform 60ms var(--ease-press); }
  }
  @keyframes panel-in { from { opacity: 0; transform: scale(.985); } }
  @keyframes panel-out { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .tab-desc { transition: none; } }

  /* Narrow screens: tabs become one horizontal row above the stage; the description moves under it. */
  @media (max-width: 899px) {
    .features-head { grid-template-columns: minmax(0, 1fr); }
    .features-head .section-description { justify-self: start; }
    .features-body { grid-template-columns: minmax(0, 1fr); }
    .feature-tabs { flex-direction: row; gap: 6px; margin-inline: -20px; padding: 2px 20px 6px; overflow-x: auto; scroll-snap-type: x proximity; scroll-padding-inline: 20px; scrollbar-width: none; }
    .feature-tabs::-webkit-scrollbar { display: none; }
    .feature-tab { flex: none; align-items: center; gap: 10px; width: auto; padding: 8px 14px 8px 8px; scroll-snap-align: start; }
    .tab-icon { width: 30px; height: 30px; border-radius: 8px; }
    .tab-text { padding-top: 0; }
    .tab-title { font-size: 15px; white-space: nowrap; }
    .tab-desc { display: none; }
    .panel-media { border-radius: 18px; }
    .panel-desc { display: block; }
    /* Pinned on phones: tabs row and stage centred in the screen; progress runs as a bar over the stage. */
    [data-pinned] .track { height: calc(100svh + var(--count) * 45svh); }
    [data-pinned] .pin > .shell { display: flex; flex-direction: column; justify-content: center; gap: 28px; }
    [data-pinned] .features-body { height: auto; align-content: center; gap: 28px; }
    [data-pinned] .features-head .section-description { font-size: 16px; }
    /* descriptions run one to three lines; reserving three keeps the centred stack from jumping between features */
    [data-pinned] .panel-desc { min-height: calc(3 * 1.55em); }
    [data-pinned] .feature-tabs { padding-left: 20px; }
    [data-pinned] .feature-tabs::before, [data-pinned] .feature-tabs::after { display: none; }
    [data-pinned] .feature-stage::before, [data-pinned] .feature-stage::after { position: absolute; top: -14px; left: 0; width: 100%; height: 2px; border-radius: 1px; background: var(--line-strong); content: ''; }
    [data-pinned] .feature-stage::after { width: calc(100% * var(--progress, 0)); background: var(--color-lime); box-shadow: 0 0 12px rgb(185 245 0 / .6); }
  }
</style>
