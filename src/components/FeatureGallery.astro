---
import ContentMedia from './ContentMedia.astro';
import Icon from './Icon';
import type { MediaAsset } from '../../content/editor-schema';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['features']; placeholderLogo?: MediaAsset | null }
const { content, placeholderLogo } = Astro.props;
const mediaAlt = (item: Landing['features']['items'][number]) => item.alt || item.image?.alt || item.video?.alt || item.title;
const count = content.items.length;
// Explicit tabindex keeps native buttons in WebKit's sequential keyboard order.
---

<section id="features" class="feature-gallery" data-feature-gallery data-scroll-surface aria-labelledby="features-title">
  <div class="gallery-shell">
    <div class="gallery-heading">
      <h2 id="features-title">{content.title}<span>{content.accent}</span></h2>
      <div class="gallery-intro"><p>{content.description}</p></div>
    </div>

    <div class="gallery-grid" data-feature-grid data-layout={count >= 3 ? 'editorial' : 'compact'}>
      {content.items.map((item, index) => <article class="gallery-tile" data-feature-card>
        <a class="gallery-preview" href={`#feature-description-${index}`} data-feature-open={index} aria-labelledby={`feature-title-${index} feature-detail-${index}`}>
          <div class="gallery-media" data-feature-card-media>
            <ContentMedia image={item.image} video={item.video} placeholderLogo={placeholderLogo} placeholderFeature={item.icon} alt={mediaAlt(item)} controls={false} widths={[640, 960, 1440, 1920]} sizes={index === 0 ? '(min-width: 1600px) 960px, (min-width: 900px) 62vw, calc(100vw - 40px)' : '(min-width: 1600px) 470px, (min-width: 900px) 31vw, (min-width: 600px) 46vw, calc(100vw - 40px)'} loading="lazy" />
            <span class="gallery-open" aria-hidden="true"><Icon name="expand" width={19} height={19} /></span>
          </div>
          <div class="gallery-caption"><h3 id={`feature-title-${index}`}>{item.title}</h3><span id={`feature-detail-${index}`}>{item.detail}</span></div>
        </a>
        <p class="gallery-fallback-description" id={`feature-description-${index}`} tabindex="-1">{item.description}</p>
      </article>)}
    </div>
  </div>

  <dialog id="feature-dialog" class="feature-dialog" aria-labelledby="feature-dialog-title-0" aria-describedby="feature-dialog-description-0" tabindex="-1">
    <div class="feature-dialog-chrome">
      <button class="feature-modal-close" type="button" tabindex="0" data-feature-close aria-label={content.controls.closeLabel}><Icon name="close" width={20} height={20} /></button>
    </div>
    <div class="feature-modal-panel" data-feature-panel>
      <div class="feature-slides" data-feature-pages>
        {content.items.map((item, index) => <article class="feature-slide" data-feature-slide id={`feature-slide-${index}`} hidden={index !== 0}>
          <div class="feature-modal-media" data-feature-modal-media>
            <ContentMedia image={item.image} video={item.video} placeholderLogo={placeholderLogo} placeholderFeature={item.icon} alt={mediaAlt(item)} widths={[640, 960, 1440, 1920]} sizes="(min-width: 1600px) 960px, (min-width: 900px) 65vw, 92vw" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="feature-modal-copy" data-feature-copy tabindex="0" role="region" aria-labelledby={`feature-dialog-title-${index}`}>
            <p class="feature-modal-detail">{item.detail}</p>
            <h3 id={`feature-dialog-title-${index}`}>{item.title}</h3>
            <p class="feature-modal-description" id={`feature-dialog-description-${index}`}>{item.description}</p>
          </div>
          {index === 0 && <div class="feature-modal-navigation" data-feature-navigation>
            <div class="feature-modal-paging"><span class="feature-modal-count" data-feature-count>01 / {String(count).padStart(2, '0')}</span><div class="feature-modal-arrows"><button class="feature-modal-previous" type="button" tabindex="0" data-feature-prev aria-label={content.controls.previousLabel}><Icon name="arrow" width={19} height={19} /></button><button type="button" tabindex="0" data-feature-next aria-label={content.controls.nextLabel}><Icon name="arrow" width={19} height={19} /></button></div></div>
            <div class="feature-modal-dots" aria-label={content.controls.chooseLabel} role="group">{content.items.map((item, dotIndex) => <button type="button" tabindex="0" data-feature-dot={dotIndex} aria-label={content.controls.showLabel.replaceAll('{title}', item.title)} aria-current={dotIndex === 0 ? 'true' : undefined}><span></span></button>)}</div>
          </div>}
        </article>)}
      </div>
    </div>
  </dialog>
</section>

<script>
  import { initFeatureGallery } from './feature-gallery';
  import { initFeaturePreviews } from './feature-previews';
  document.querySelectorAll<HTMLElement>('[data-feature-gallery]').forEach((gallery) => {
    initFeatureGallery(gallery);
    initFeaturePreviews(gallery);
  });
</script>

<style>
  .feature-gallery { --scroll-surface-color: var(--color-chalk); padding: 64px 0 112px; background: var(--color-chalk); color: var(--color-ink); overflow-wrap: anywhere; }
  .gallery-shell { width: min(1440px, calc(100% - clamp(40px, 10.4vw, 192px))); margin-inline: auto; }
  .gallery-heading { display: grid; grid-template-columns: 1.4fr 1fr; align-items: end; gap: 64px; margin-bottom: 60px; }
  .gallery-heading h2 { font-size: clamp(42px, 5.1vw, 72px); font-weight: 500; line-height: 1.04; letter-spacing: -.055em; }
  .gallery-heading h2 > span { display: block; color: #616e54; }
  .gallery-intro { max-width: 350px; margin-bottom: 5px; }
  .gallery-intro > p { color: var(--color-text-secondary); font-size: 15px; line-height: 1.8; }
  .gallery-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px 24px; align-items: stretch; }
  .gallery-tile { grid-column: span 4; min-width: 0; }
  .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child { grid-column: span 8; grid-row: span 2; display: flex; flex-direction: column; }
  .gallery-grid[data-layout='compact'] > .gallery-tile { grid-column: span 6; }
  .gallery-grid[data-layout='compact'] > .gallery-tile:only-child { grid-column: span 12; }
  .gallery-preview { display: flex; flex-direction: column; border-radius: 16px 16px 4px 4px; }
  [data-feature-ready='true'] .gallery-preview { height: 100%; }
  .gallery-media { position: relative; isolation: isolate; flex-shrink: 0; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 16px; background: #080a08; }
  .gallery-media::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; border: 1px solid rgb(0 0 0 / 12%); border-radius: inherit; }
  .gallery-media :global(picture), .gallery-media :global(video) { position: absolute; display: block; inset: 0; }
  .gallery-media :global([data-feature-preview]) { position: absolute; inset: 0; }
  .gallery-media:has([data-media-placeholder]) { background: transparent; }
  .gallery-media:has([data-media-placeholder])::after { display: none; }
  .gallery-media :global([data-media-placeholder]) { display: grid; }
  .gallery-media :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child .gallery-preview { flex: 1; }
  .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child .gallery-media { flex: 1; min-height: 240px; aspect-ratio: auto; }
  .gallery-open { position: absolute; z-index: 2; bottom: 18px; right: 18px; display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgb(255 255 255 / 25%); border-radius: 50%; background: #151a13; color: #f3f6ed; transition: background-color 150ms ease, color 150ms ease; }
  .gallery-caption { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; padding: 20px 2px 8px; }
  .gallery-caption h3 { font-size: clamp(18px, 1.6vw, 23px); font-weight: 500; letter-spacing: -.03em; line-height: 1.25; }
  .gallery-caption > span { color: #60695b; font-size: 13px; line-height: 1.5; }
  .gallery-fallback-description { color: var(--color-text-secondary); font-size: 14px; line-height: 1.75; padding: 12px 2px 0; }
  [data-feature-ready='true'] .gallery-fallback-description { display: none; }
  .gallery-preview:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 6px; }
  .gallery-preview:focus-visible .gallery-open { color: var(--color-ink); background: var(--color-lime); border-color: var(--color-lime); }

  .feature-dialog { width: min(1360px, calc(100vw - 64px)); max-width: none; max-height: calc(100dvh - 48px); margin: auto; padding: 0; overflow: auto; overscroll-behavior: contain; border: 1px solid #dce3d4; border-radius: 22px; color: var(--color-ink); background: var(--color-paper); box-shadow: 0 24px 80px rgb(24 35 15 / 16%); }
  .feature-dialog:not([open]) { display: none; }
  .feature-dialog::backdrop { background: rgb(31 40 24 / 26%); backdrop-filter: blur(12px); }
  .feature-dialog-chrome { position: sticky; z-index: 5; top: 0; height: 0; }
  .feature-modal-close { position: absolute; top: 18px; right: 18px; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid #ccd5c1; border-radius: 50%; color: #37422e; background: var(--color-paper); cursor: pointer; }
  .feature-modal-panel { position: relative; display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr); grid-template-rows: minmax(0, 1fr) auto; height: min(78dvh, calc(100dvh - 50px), 760px); }
  .feature-slides { position: relative; z-index: 0; isolation: isolate; display: grid; grid-area: 1 / 1 / -1 / -1; grid-template-columns: subgrid; grid-template-rows: subgrid; min-width: 0; min-height: 0; overflow: clip; }
  .feature-slide { display: grid; grid-area: 1 / 1 / -1 / -1; grid-template-columns: subgrid; grid-template-rows: subgrid; min-width: 0; min-height: 0; background: var(--color-paper); }
  .feature-slide[hidden] { display: none; }
  .feature-modal-media { position: relative; display: grid; align-items: center; grid-column: 1; grid-row: 1 / span 2; min-width: 0; min-height: 0; overflow: hidden; background: #000; border-right: 1px solid #e2e8da; }
  .feature-modal-media :global(picture), .feature-modal-media :global(video), .feature-modal-media :global([data-feature-preview]) { display: block; width: 100%; height: 100%; min-height: 0; }
  .feature-modal-media:has([data-media-placeholder]) { background: transparent; }
  .feature-modal-media :global([data-media-placeholder]) { display: grid; }
  .feature-modal-media :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .feature-modal-copy { position: relative; grid-column: 2; grid-row: 1; padding: 72px 36px 24px; min-width: 0; min-height: 0; overflow: hidden auto; overscroll-behavior: contain; }
  .feature-modal-detail { margin-bottom: 24px; max-width: calc(100% - 8px); color: #616e54; font-size: 12px; line-height: 1.6; }
  .feature-modal-copy h3 { font-size: clamp(26px, 2.6vw, 38px); line-height: 1.08; letter-spacing: -.045em; font-weight: 500; }
  .feature-modal-description { margin-top: 24px; color: #535c4d; font-size: 15px; line-height: 1.75; white-space: pre-line; }
  .feature-modal-navigation { position: relative; z-index: 1; grid-column: 2; grid-row: 2; min-width: 0; padding: 20px 36px 26px; border-top: 1px solid transparent; background: var(--color-paper); }
  .feature-modal-navigation::before { content: ''; position: absolute; top: -1px; left: 36px; right: 36px; height: 1px; background: #e1e7d8; }
  .feature-modal-paging { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .feature-modal-count { color: #59654e; font-size: 12px; font-variant-numeric: tabular-nums; }
  .feature-modal-arrows { display: flex; gap: 8px; }
  .feature-modal-arrows button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid #ccd5c1; border-radius: 50%; color: #37422e; background: var(--color-paper); cursor: pointer; }
  .feature-modal-previous svg { transform: rotate(180deg); }
  .feature-modal-dots { display: flex; flex-wrap: wrap; align-items: center; margin-top: 10px; gap: 0; }
  .feature-modal-dots button { display: grid; place-items: center; width: 26px; min-width: 26px; height: 28px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .feature-modal-dots span { display: block; width: 17px; height: 5px; transform: scaleX(.3); border-radius: 99px; background: #718164; }
  .feature-modal-dots [aria-current='true'] span { transform: scaleX(1); background: var(--color-lime); box-shadow: 0 0 0 1px #6a823e; }
  .feature-dialog :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  .feature-modal-close:disabled, .feature-modal-arrows button:disabled { opacity: .4; cursor: default; }

  @media (hover: hover) {
    .gallery-preview:hover .gallery-open { color: var(--color-ink); background: var(--color-lime); border-color: var(--color-lime); }
    .feature-modal-close:hover, .feature-modal-arrows button:not(:disabled):hover { color: #26301f; background: #edf3e2; border-color: #8b9f71; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature-modal-dots span { transition: transform 180ms var(--ease-out), background-color 180ms ease; }
    .gallery-media :global(img) { transition: transform 300ms var(--ease-out); }
    .gallery-preview:active .gallery-open { transform: scale(.96); transition: transform 150ms ease-out; }
    @media (hover: hover) { .gallery-preview:hover .gallery-media :global(img) { transform: scale(1.015); } }
  }
  @media (max-width: 1050px) { .gallery-heading { gap: 40px; } .feature-modal-copy { padding-inline: 26px; } .feature-modal-navigation { padding-inline: 26px; } .feature-modal-navigation::before { left: 26px; right: 26px; } }
  @media (max-width: 899px) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gallery-tile, .gallery-grid[data-layout='compact'] > .gallery-tile { grid-column: span 1; }
    .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child { grid-column: span 2; grid-row: auto; }
    .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child .gallery-media { aspect-ratio: 16 / 10; flex: auto; }
    .gallery-grid[data-layout='compact'] > .gallery-tile:only-child { grid-column: span 2; }
    .feature-dialog { width: min(660px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); border-radius: 18px; }
    .feature-modal-panel { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, .85fr) minmax(0, 1fr) auto; height: min(88dvh, calc(100dvh - 34px), 820px); }
    .feature-modal-media { grid-column: 1; grid-row: 1; border: 0; border-bottom: 1px solid #e2e8da; }
    .feature-modal-copy { grid-column: 1; grid-row: 2; padding: 28px 26px 24px; }
    .feature-modal-detail { margin-bottom: 16px; }
    .feature-modal-description { margin-top: 18px; font-size: 14px; }
    .feature-modal-navigation { grid-column: 1; grid-row: 3; padding: 18px 26px 22px; }
    .feature-modal-dots { margin-top: 8px; }
  }
  @media (max-width: 599px) {
    .feature-gallery { padding-block: 40px 64px; }
    .gallery-heading { grid-template-columns: minmax(0, 1fr); gap: 22px; margin-bottom: 34px; }
    .gallery-heading h2 { font-size: clamp(40px, 9vw, 58px); }
    .gallery-intro { margin: 0; max-width: 360px; }
    .gallery-intro > p { font-size: 14px; }
    .gallery-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .gallery-tile, .gallery-grid[data-layout='compact'] > .gallery-tile, .gallery-grid[data-layout='editorial'] > .gallery-tile:first-child, .gallery-grid[data-layout='compact'] > .gallery-tile:only-child { grid-column: span 1; }
    .gallery-caption { padding-top: 16px; }
    .gallery-caption h3 { font-size: 21px; }
    .gallery-open { right: 14px; bottom: 14px; }
    .feature-modal-close { top: 12px; right: 12px; }
    .feature-modal-copy { padding-inline: 22px; }
    .feature-modal-navigation { padding-inline: 22px; }
    .feature-modal-navigation::before { left: 22px; right: 22px; }
  }
</style>
