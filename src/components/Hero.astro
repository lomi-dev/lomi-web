---
import AgentConstellation from './AgentConstellation';
import ShapeWavesBackground from './ShapeWavesBackground.astro';
import WorkspaceDeck from './WorkspaceDeck.astro';
import Icon from './Icon';
import { site } from '../data/site';
import { agents } from '../data/agents';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['hero'] }
const { content } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"><ShapeWavesBackground /></div>
  <div class="hero-opening">
    <AgentConstellation client:load />
    <div class="hero-content shell">
      <p class="hero-eyebrow"><span aria-hidden="true">[</span>{content.eyebrow}<span aria-hidden="true">]</span></p>
      <h1 id="hero-title">{content.title}<span>{content.accent}</span></h1>
      <p class="hero-description">{content.description}</p>
      <div class="hero-actions">
        <a class="hero-download" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog"><Icon name="download" width={18} height={18} />{content.primaryLabel}<span aria-hidden="true">↗</span></a>
        <a class="hero-explore" href="#workspace">{content.secondaryLabel}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note">{content.note}</p>
    </div>
    <div class="hero-bottom">
      <p class="hero-agent-caption">Bring your CLI. <span>Keep your setup.</span></p>
      <ul class="hero-agent-names" aria-label="Supported CLI agents">{agents.map((agent) => <li>{agent.name}</li>)}</ul>
      <button class="hero-motion" type="button" data-motion-toggle aria-pressed="false" hidden><span class="motion-symbol" aria-hidden="true"></span><span data-motion-label>Pause motion</span></button>
    </div>
  </div>
  <div class="hero-product shell">
    <WorkspaceDeck caption={content.previewCaption} alt={content.previewAlt} />
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const button = hero?.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && button) {
    let paused = false;
    const sync = () => {
      hero.dataset.motion = preference.matches ? 'reduced' : paused ? 'paused' : 'running';
      button.hidden = preference.matches;
      button.setAttribute('aria-pressed', String(paused));
      const label = button.querySelector('[data-motion-label]');
      if (label) label.textContent = paused ? 'Resume motion' : 'Pause motion';
      document.dispatchEvent(new CustomEvent('lomi:hero-motion'));
    };
    button.addEventListener('click', () => { paused = !paused; sync(); });
    preference.addEventListener('change', sync);
    document.addEventListener('visibilitychange', () => { hero.dataset.documentHidden = String(document.hidden); });
    new IntersectionObserver(([entry]) => { hero.dataset.visible = String(entry.isIntersecting); }).observe(hero);
    sync();
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: 100svh; padding-bottom: 64px; background: #0b0e0b; color: #f6f7f1; }
  /* Thirty percent of the 8:5 screenshot is 18.75% of its rendered width. */
  .hero-opening { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - min(221.25px, calc(18.75vw - 18px))); padding: 140px 0 26px; }
  .hero-atmosphere { position: absolute; z-index: -1; inset: 0 0 auto; height: 950px; overflow: hidden; pointer-events: none; --shape-waves-color: #557336; }
  .hero-atmosphere :global(lomi-shape-waves) { opacity: .6; }
  .hero-atmosphere::after { content: ''; position: absolute; z-index: 2; inset: 0; background: radial-gradient(ellipse 40% 41% at 50% 49%, #0b0e0bf5 0%, #0b0e0bba 55%, #0b0e0b00 100%), linear-gradient(0deg, #0b0e0b 0%, #0b0e0b00 22%, #0b0e0b00 83%, #0b0e0b85 100%); }
  .hero-content { position: relative; z-index: 2; width: min(760px, calc(100% - 48px)); text-align: center; pointer-events: none; }
  .hero-content a { pointer-events: auto; }
  .hero-eyebrow { display: flex; justify-content: center; align-items: center; gap: 15px; margin: 0 0 22px; color: #adb6a5; font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; line-height: 1.8; text-transform: uppercase; }
  .hero-eyebrow > span { color: #73934b; font-size: 17px; }
  h1 { margin: 0; font-size: clamp(68px, 7vw, 100px); font-weight: 500; letter-spacing: -.067em; line-height: 1.02; text-wrap: balance; overflow-wrap: anywhere; }
  h1 > span { display: block; color: var(--color-lime); }
  .hero-description { max-width: 470px; margin: 22px auto 0; color: #aab3a4; font-size: 16px; line-height: 1.7; text-wrap: pretty; }
  .hero-actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 26px; }
  .hero-download { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; padding: 0 22px; border: 1px solid #dcff71; border-radius: 9px; color: #0b0d0c; background: var(--color-lime); font-size: 13px; font-weight: 600; box-shadow: inset 0 1px 0 #ecffa7; transition: background-color 150ms ease, transform 150ms var(--ease-out); }
  .hero-download > span { margin-left: 12px; font-size: 18px; font-weight: 400; }
  .hero-download:hover { background: #dbff7d; }
  .hero-download:active { transform: scale(.98); }
  .hero-explore { display: inline-flex; align-items: center; gap: 16px; min-height: 48px; color: #e7ecdf; font-size: 13px; text-underline-offset: 5px; }
  .hero-explore:hover { text-decoration: underline; }
  .hero-explore > span { color: #a4b297; font-size: 19px; }
  .hero-note { margin-top: 16px; color: #87917f; font-family: var(--font-mono); font-size: 9px; line-height: 1.8; }
  .hero-bottom { position: relative; width: min(1180px, calc(100% - 96px)); margin: 26px auto 0; text-align: center; }
  .hero-agent-caption { color: #c6cfbd; font-size: 12px; }
  .hero-agent-caption > span { color: #7f8c75; }
  .hero-agent-names { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px 20px; list-style: none; margin: 10px 0 0; padding: 0; color: #91a083; font-family: var(--font-mono); font-size: 9px; line-height: 1.8; }
  .hero-motion { position: absolute; right: 0; bottom: 0; display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 6px; border: 0; background: none; color: #a3b196; cursor: pointer; font-family: var(--font-mono); font-size: 9px; }
  .hero-motion[hidden] { display: none; }
  .hero-product { position: relative; z-index: 2; max-width: 1180px; --color-text-secondary: #9da995; }
  .motion-symbol { display: block; width: 8px; height: 10px; border-inline: 2px solid currentColor; }
  .hero-motion[aria-pressed='true'] .motion-symbol { width: 0; height: 0; border-top: 5px solid transparent; border-bottom: 5px solid transparent; border-left: 7px solid currentColor; border-right: 0; }
  .hero :focus-visible { outline-color: #c8ff3d; }
  @media (max-width: 1190px) and (min-width: 768px) { .hero-opening { min-height: calc(100svh - (18.75vw - 12px)); } }
  @media (max-width: 1100px) and (min-width: 768px) { .hero-content { max-width: 650px; } h1 { font-size: 84px; } .hero-description { max-width: 400px; font-size: 14px; } .hero-bottom { margin-top: 24px; } }
  @media (max-width: 767px) {
    .hero { padding-bottom: 38px; }
    .hero-opening { min-height: calc(100svh - (18.75vw - 7.5px)); padding: 235px 0 24px; }
    .hero-content { width: calc(100% - 40px); }
    .hero-eyebrow { font-size: 8px; gap: 10px; margin-bottom: 18px; }
    h1 { font-size: clamp(47px, 11.8vw, 78px); letter-spacing: -.065em; line-height: 1.04; }
    .hero-description { font-size: 14px; max-width: 410px; margin-top: 20px; line-height: 1.7; }
    .hero-actions { gap: 8px 16px; margin-top: 22px; }
    .hero-download { min-height: 52px; padding-inline: 14px; gap: 9px; font-size: 12px; }
    .hero-download > span { margin-left: 4px; }
    .hero-explore { gap: 9px; font-size: 11px; }
    .hero-note { max-width: 290px; margin: 15px auto 0; font-size: 8px; }
    .hero-bottom { width: calc(100% - 40px); min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 18px; text-align: left; }
    .hero-agent-caption { font-size: 10px; }
    .hero-agent-names { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .hero-motion { position: relative; font-size: 8px; flex-shrink: 0; }
    .hero-atmosphere::after { background: linear-gradient(0deg, #0b0e0b 0%, #0b0e0bd9 40%, #0b0e0b55 70%, #0b0e0b22 100%); }
  }
  @media (max-width: 359px) { .hero-agent-caption { max-width: 120px; line-height: 1.7; } }
  @media (prefers-reduced-motion: reduce) { .hero-download { transition: background-color 150ms ease; } .hero-download:active { transform: none; } }
</style>
