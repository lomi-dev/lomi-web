---
import AgentConstellation from './AgentConstellation';
import Icon from './Icon';
import { site } from '../data/site';
import { agents } from '../data/agents';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['hero'] }
const { content } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"><div class="hero-horizon"></div><span class="hero-orbit-line orbit-one"></span><span class="hero-orbit-line orbit-two"></span></div>
  <AgentConstellation client:load />
  <div class="hero-content shell">
    <p class="hero-eyebrow"><span aria-hidden="true">[</span>{content.eyebrow}<span aria-hidden="true">]</span></p>
    <h1 id="hero-title">{content.title}<span>{content.accent}</span></h1>
    <p class="hero-description">{content.description}</p>
    <div class="hero-actions">
      <a class="hero-download" href={site.releases} data-download-open aria-haspopup="dialog" aria-controls="download-dialog"><Icon name="download" width={18} height={18} />{content.primaryLabel}<span aria-hidden="true">↗</span></a>
      <a class="hero-explore" href="#workspace">{content.secondaryLabel}<span aria-hidden="true">↓</span></a>
    </div>
    <p class="hero-note">{content.note}</p>
  </div>
  <div class="hero-bottom">
    <p class="hero-agent-caption">Bring your CLI. <span>Keep your setup.</span></p>
    <ul class="hero-agent-names" aria-label="Supported CLI agents">{agents.map((agent) => <li>{agent.name}</li>)}</ul>
    <button class="hero-motion" type="button" data-motion-toggle aria-pressed="false" hidden><span class="motion-symbol" aria-hidden="true"></span><span data-motion-label>Pause motion</span></button>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const button = hero?.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && button) {
    let paused = false;
    const sync = () => {
      hero.dataset.motion = preference.matches ? 'reduced' : paused ? 'paused' : 'running';
      button.hidden = preference.matches;
      button.setAttribute('aria-pressed', String(paused));
      const label = button.querySelector('[data-motion-label]');
      if (label) label.textContent = paused ? 'Resume motion' : 'Pause motion';
      document.dispatchEvent(new CustomEvent('lomi:hero-motion'));
    };
    button.addEventListener('click', () => { paused = !paused; sync(); });
    preference.addEventListener('change', sync);
    document.addEventListener('visibilitychange', () => { hero.dataset.documentHidden = String(document.hidden); });
    new IntersectionObserver(([entry]) => { hero.dataset.visible = String(entry.isIntersecting); }).observe(hero);
    sync();
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: 920px; min-height: max(920px, 100svh); padding: 280px 0 205px; background: #0b0e0b; color: #f6f7f1; }
  .hero-atmosphere { position: absolute; z-index: -1; inset: 0; overflow: hidden; pointer-events: none; background: radial-gradient(ellipse at 50% 8%, #28302145, transparent 54%); }
  .hero-horizon { position: absolute; width: 150%; height: 75%; left: -25%; top: 78%; border: 1px solid #c8ff3d28; border-radius: 50%; background: radial-gradient(ellipse at 50% 0%, #b0e64a0d, transparent 58%); box-shadow: 0 -20px 110px #a4e44f08; }
  .hero-orbit-line { position: absolute; width: 1080px; height: 710px; border: 1px solid #d8f0c708; border-radius: 50%; left: 50%; top: 110px; transform: translateX(-50%) rotate(-18deg); }
  .orbit-two { width: 1460px; height: 650px; top: 130px; transform: translateX(-50%) rotate(17deg); border-color: #d8f0c706; }
  .hero-content { position: relative; z-index: 2; width: min(760px, calc(100% - 48px)); text-align: center; pointer-events: none; }
  .hero-content a { pointer-events: auto; }
  .hero-eyebrow { display: flex; justify-content: center; align-items: center; gap: 15px; margin: 0 0 29px; color: #adb6a5; font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; line-height: 1.8; text-transform: uppercase; }
  .hero-eyebrow > span { color: #73934b; font-size: 17px; }
  h1 { margin: 0; font-size: clamp(68px, 7.5vw, 108px); font-weight: 500; letter-spacing: -.067em; line-height: 1.02; text-wrap: balance; overflow-wrap: anywhere; }
  h1 > span { display: block; color: var(--color-lime); }
  .hero-description { max-width: 470px; margin: 27px auto 0; color: #aab3a4; font-size: 16px; line-height: 1.75; text-wrap: pretty; }
  .hero-actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 32px; }
  .hero-download { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; padding: 0 22px; border: 1px solid #dcff71; border-radius: 9px; color: #0b0d0c; background: var(--color-lime); font-size: 13px; font-weight: 600; box-shadow: inset 0 1px 0 #ecffa7; transition: background-color 150ms ease, transform 150ms var(--ease-out); }
  .hero-download > span { margin-left: 12px; font-size: 18px; font-weight: 400; }
  .hero-download:hover { background: #dbff7d; }
  .hero-download:active { transform: scale(.98); }
  .hero-explore { display: inline-flex; align-items: center; gap: 16px; min-height: 48px; color: #e7ecdf; font-size: 13px; text-underline-offset: 5px; }
  .hero-explore:hover { text-decoration: underline; }
  .hero-explore > span { color: #a4b297; font-size: 19px; }
  .hero-note { margin-top: 21px; color: #87917f; font-family: var(--font-mono); font-size: 9px; line-height: 1.8; }
  .hero-bottom { position: absolute; inset-inline: 40px; bottom: 32px; text-align: center; }
  .hero-agent-caption { color: #c6cfbd; font-size: 12px; }
  .hero-agent-caption > span { color: #7f8c75; }
  .hero-agent-names { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px 20px; list-style: none; margin: 15px 0 0; padding: 0; color: #91a083; font-family: var(--font-mono); font-size: 9px; line-height: 1.8; }
  .hero-motion { position: absolute; right: 0; bottom: 0; display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 6px; border: 0; background: none; color: #a3b196; cursor: pointer; font-family: var(--font-mono); font-size: 9px; }
  .hero-motion[hidden] { display: none; }
  .motion-symbol { display: block; width: 8px; height: 10px; border-inline: 2px solid currentColor; }
  .hero-motion[aria-pressed='true'] .motion-symbol { width: 0; height: 0; border-top: 5px solid transparent; border-bottom: 5px solid transparent; border-left: 7px solid currentColor; border-right: 0; }
  .hero :focus-visible { outline-color: #c8ff3d; }
  @media (max-width: 1100px) and (min-width: 768px) { .hero { min-height: 880px; padding-top: 270px; } .hero-content { max-width: 650px; } h1 { font-size: 84px; } .hero-description { max-width: 400px; font-size: 14px; } .hero-motion { position: relative; margin-top: 14px; } .hero-bottom { bottom: 20px; } }
  @media (max-width: 767px) {
    .hero { min-height: 980px; padding: 390px 0 155px; }
    .hero-content { width: calc(100% - 40px); }
    .hero-eyebrow { font-size: 8px; gap: 10px; margin-bottom: 22px; }
    h1 { font-size: clamp(47px, 11.8vw, 78px); letter-spacing: -.065em; line-height: 1.04; }
    .hero-description { font-size: 14px; max-width: 410px; margin-top: 22px; line-height: 1.8; }
    .hero-actions { flex-direction: column; gap: 8px; margin-top: 26px; }
    .hero-download { min-height: 52px; min-width: 220px; font-size: 13px; }
    .hero-explore { font-size: 12px; }
    .hero-note { max-width: 290px; margin: 15px auto 0; font-size: 8px; }
    .hero-bottom { position: relative; inset: auto; margin: 55px 20px -108px; }
    .hero-agent-caption { font-size: 11px; }
    .hero-agent-names { font-size: 8px; gap: 5px 15px; margin-top: 13px; }
    .hero-motion { position: relative; margin-top: 13px; font-size: 8px; }
    .hero-horizon { top: 88%; height: 40%; width: 250%; left: -75%; }
    .hero-orbit-line { width: 590px; height: 265px; top: 105px; }
    .orbit-two { width: 540px; height: 260px; top: 110px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-download { transition: background-color 150ms ease; } .hero-download:active { transform: none; } }
</style>
