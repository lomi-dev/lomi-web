---
import ShapeWavesBackground from './ShapeWavesBackground.astro';
import WorkspaceDeck from './WorkspaceDeck.astro';
import Icon from './Icon';
import { site } from '../data/site';
import type { Landing } from '../../content/landing-schema';

interface Props { content: Landing['hero'] }
const { content } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title" data-scroll-surface>
  <div class="hero-atmosphere" aria-hidden="true"><ShapeWavesBackground /></div>
  <div class="hero-opening hero-shell">
    <div class="hero-content">
      <h1 id="hero-title">{content.title}<span>{content.accent}</span></h1>
      <p class="hero-description">{content.description}</p>
      <div class="hero-actions">
        <a class="hero-download" href={site.download}><Icon name="download" width={18} height={18} />{content.primaryLabel}</a>
        <a class="hero-explore" href="#workspace">{content.secondaryLabel}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
  <div class="hero-product hero-shell">
    <WorkspaceDeck alt={content.previewAlt} />
  </div>
</section>

<style>
  .hero { --scroll-surface-color: #ffffff; --hero-gutter: clamp(24px, 5.2vw, 112px); position: relative; isolation: isolate; overflow: hidden; min-height: 100svh; padding-bottom: 64px; background: linear-gradient(180deg, #ffffff 0%, #ffffff 65%, var(--color-chalk) 100%); color: var(--color-ink); }
  .hero-shell { width: min(1760px, calc(100% - var(--hero-gutter) * 2)); margin-inline: auto; }
  .hero-opening { position: relative; padding: clamp(160px, 16svh, 194px) 0 112px; }
  .hero-atmosphere { position: absolute; z-index: -1; inset: 0 0 auto; height: 950px; overflow: hidden; pointer-events: none; --shape-waves-background: #ffffff; --shape-waves-color: #9baa8b; --shape-waves-interaction-color: #6b922c; }
  .hero-atmosphere :global(lomi-shape-waves) { opacity: .95; }
  .hero-atmosphere::after { content: ''; position: absolute; z-index: 2; inset: 0; background: radial-gradient(ellipse 44% 46% at 50% 38%, #ffffffd9 0%, #ffffff9c 48%, #ffffff0d 100%), linear-gradient(0deg, #ffffff 0%, #ffffff00 24%, #ffffff00 88%, #ffffff66 100%); }
  .hero-content { position: relative; z-index: 2; max-width: 820px; margin-inline: auto; text-align: center; }
  h1 { margin: 0; font-size: clamp(54px, 4.8vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1.06; text-wrap: balance; overflow-wrap: anywhere; }
  h1 > span { display: block; }
  .hero-description { max-width: 530px; margin: 24px auto 0; color: #56614e; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.65; text-wrap: pretty; }
  .hero-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-download { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 23px; border: 1px solid #b6e43b; border-radius: 999px; color: var(--color-ink); background: var(--color-lime); font-size: 14px; font-weight: 550; box-shadow: inset 0 1px 0 #ecffa7; transition: background-color 150ms ease, transform 150ms var(--ease-out); }
  .hero-download:active { transform: scale(.98); }
  .hero-explore { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 52px; padding: 0 23px; border: 1px solid #d5dccd; border-radius: 999px; background: rgb(255 255 255 / 80%); color: #293423; font-size: 14px; transition: background-color 150ms ease, border-color 150ms ease; }
  .hero-explore > span { color: #5b6d4b; font-size: 18px; }
  .hero-product { position: relative; z-index: 2; --color-text-secondary: #5f6b55; }
  .hero :focus-visible { outline-color: var(--color-focus); }
  @media (hover: hover) {
    .hero-download:hover { background: #dbff7d; }
    .hero-explore:hover { background: #f0f4e9; border-color: #b7c5a8; }
  }
  @media (max-width: 767px) {
    .hero { --hero-gutter: 20px; padding-bottom: 38px; }
    .hero-opening { padding: 132px 0 90px; }
    h1 { font-size: clamp(44px, 8.8vw, 62px); letter-spacing: -.06em; line-height: 1.06; }
    .hero-description { max-width: 450px; margin-top: 20px; font-size: 15px; line-height: 1.7; }
    .hero-actions { gap: 10px; margin-top: 24px; }
    .hero-download { min-height: 48px; padding-inline: 16px; gap: 9px; font-size: 12px; }
    .hero-explore { min-height: 48px; padding-inline: 14px; gap: 8px; font-size: 12px; }
    .hero-explore > span { font-size: 16px; }
    .hero-atmosphere::after { background: radial-gradient(ellipse 52% 28% at 50% 25%, #ffffffb3 0%, #ffffff00 100%), linear-gradient(0deg, #ffffff 0%, #ffffffe6 26%, #ffffff66 66%, #ffffff26 100%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-download { transition: background-color 150ms ease; } .hero-download:active { transform: none; } }
</style>
