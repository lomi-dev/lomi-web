---
import ShapeWavesBackground from './ShapeWavesBackground.astro';
import WorkspaceDeck from './WorkspaceDeck.astro';
import Icon from './Icon';
import { activeLandingLinks } from '../data/navigation';
import type { Landing } from '../../content/landing-schema';
import type { MediaAsset } from '../../content/editor-schema';

interface Props { content: Landing['hero']; layout?: Landing['layout']; placeholderLogo?: MediaAsset | null }
const { content, layout, placeholderLogo } = Astro.props;
const primary = activeLandingLinks([{label: content.primaryLabel, href: content.primaryHref}], layout)[0];
const secondary = activeLandingLinks([{label: content.secondaryLabel, href: content.secondaryHref}], layout)[0];
---

<section class="hero" aria-labelledby="hero-title" data-scroll-surface>
  <div class="hero-atmosphere" aria-hidden="true"><ShapeWavesBackground /></div>
  <div class="hero-opening hero-shell">
    <div class="hero-content">
      <h1 id="hero-title">{content.title}<span>{content.accent}</span></h1>
      <p class="hero-description">{content.description}</p>
      <div class="hero-actions">
        {primary && <a class="hero-download" href={primary.href}><Icon name="download" width={18} height={18} />{primary.label}</a>}
        {secondary && <a class="hero-explore" href={secondary.href}>{secondary.label}<span aria-hidden="true">↓</span></a>}
      </div>
    </div>
  </div>
  <div class="hero-product">
    <WorkspaceDeck content={content} placeholderLogo={placeholderLogo} />
  </div>
</section>

<style>
  .hero { --scroll-surface-color: var(--color-paper); --hero-gutter: clamp(24px, 5.2vw, 112px); position: relative; isolation: isolate; overflow: hidden; padding-bottom: 64px; background: linear-gradient(180deg, var(--color-paper) 0%, var(--color-paper) 65%, var(--color-chalk) 100%); color: var(--color-ink); }
  /* Reserve stays constant: pulling reveals the same live canvas above the hero. */
  .hero[data-hero-pull-ready] .hero-atmosphere { top: -144px; height: 1094px; }
  .hero[data-hero-pull-active] { overflow: visible; clip-path: inset(-144px 0 0); }
  .hero-shell { width: min(1760px, calc(100% - var(--hero-gutter) * 2)); margin-inline: auto; }
  .hero-opening { position: relative; padding: clamp(160px, 16svh, 194px) 0 64px; }
  .hero-atmosphere { position: absolute; z-index: -1; inset: 0 0 auto; height: 950px; overflow: hidden; pointer-events: none; --shape-waves-background: var(--color-paper); --shape-waves-color: #9baa8b; --shape-waves-interaction-color: color-mix(in srgb, var(--color-lime) 35%, #345600); }
  .hero-atmosphere :global(lomi-shape-waves) { opacity: .95; }
  .hero-atmosphere::after { content: ''; position: absolute; z-index: 2; inset: 0; background: radial-gradient(ellipse 44% 46% at 50% 38%, color-mix(in srgb, var(--color-paper) 85%, transparent) 0%, color-mix(in srgb, var(--color-paper) 61%, transparent) 48%, color-mix(in srgb, var(--color-paper) 5%, transparent) 100%), linear-gradient(0deg, var(--color-paper) 0%, transparent 24%, transparent 88%, color-mix(in srgb, var(--color-paper) 40%, transparent) 100%); }
  .hero-content { position: relative; z-index: 2; max-width: 820px; margin-inline: auto; text-align: center; }
  h1 { margin: 0; font-size: clamp(54px, 4.8vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1.06; text-wrap: balance; overflow-wrap: anywhere; }
  h1 > span { display: block; }
  .hero-description { max-width: 530px; margin: 24px auto 0; color: var(--color-text-secondary); font-size: clamp(16px, 1.2vw, 18px); line-height: 1.65; text-wrap: pretty; }
  .hero-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-download { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 23px; border: 1px solid var(--color-lime-hover); border-radius: 999px; color: var(--color-ink); background: var(--color-lime); font-size: 14px; font-weight: 550; box-shadow: inset 0 1px 0 #ecffa7; transition: background-color 150ms ease, transform 150ms var(--ease-out); }
  .hero-download:active { background: var(--color-lime-pressed); transform: scale(.98); }
  .hero-explore { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 52px; padding: 0 23px; border: 1px solid var(--line); border-radius: 999px; background: rgb(255 255 255 / 80%); color: #293423; font-size: 14px; transition: background-color 150ms ease, border-color 150ms ease; }
  .hero-explore > span { color: #5b6d4b; font-size: 18px; }
  .hero-product { position: relative; z-index: 2; width: min(1440px, calc(100% - clamp(40px, 10.4vw, 192px))); margin-inline: auto; }
  .hero :focus-visible { outline-color: var(--color-focus); }
  @media (hover: hover) {
    .hero-download:hover { background: var(--color-lime-hover); }
    .hero-explore:hover { background: #f0f4e9; border-color: #b7c5a8; }
  }
  @media (max-width: 767px) {
    .hero { --hero-gutter: 20px; padding-bottom: 40px; }
    .hero-opening { padding: 132px 0 40px; }
    h1 { font-size: clamp(44px, 8.8vw, 62px); letter-spacing: -.06em; line-height: 1.06; }
    .hero-description { max-width: 450px; margin-top: 20px; font-size: 15px; line-height: 1.7; }
    .hero-actions { gap: 10px; margin-top: 24px; }
    .hero-download { min-height: 48px; padding-inline: 16px; gap: 9px; font-size: 12px; }
    .hero-explore { min-height: 48px; padding-inline: 14px; gap: 8px; font-size: 12px; }
    .hero-explore > span { font-size: 16px; }
    .hero-atmosphere::after { background: radial-gradient(ellipse 52% 28% at 50% 25%, color-mix(in srgb, var(--color-paper) 70%, transparent) 0%, transparent 100%), linear-gradient(0deg, var(--color-paper) 0%, color-mix(in srgb, var(--color-paper) 90%, transparent) 26%, color-mix(in srgb, var(--color-paper) 40%, transparent) 66%, color-mix(in srgb, var(--color-paper) 15%, transparent) 100%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-download { transition: background-color 150ms ease; } .hero-download:active { transform: none; } }
</style>
