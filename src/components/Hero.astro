---
import { Picture } from 'astro:assets';
import clouds from '../assets/clouds.png';
import type { HeroProps } from './hero/types';
import HeroActions from './hero/Actions.astro';
import WorkspaceDeck from './WorkspaceDeck.astro';

interface Props extends HeroProps {}
const { content, layout } = Astro.props;
---

<section class="hero desktop-hero" data-scroll-surface aria-labelledby="hero-title">
  <div class="hero-wallpaper" aria-hidden="true">
    <Picture src={clouds} alt="" widths={[768, 1280, 1536]} sizes="100vw" formats={['webp']} quality={78} loading="eager" fetchpriority="low" />
  </div>

  <div class="hero-layout">
    <div class="hero-copy">
      <h1 id="hero-title"><span>{content.title}</span><span>{content.accent}</span></h1>
      <p>{content.description}</p>
      <HeroActions content={content} layout={layout} class="desktop-actions" />
    </div>
  </div>
  <div class="hero-desktop"><WorkspaceDeck content={content} /></div>
</section>

<style>
  .desktop-hero {
    --scroll-surface-color: #f6f8f4;
    --hero-button-radius: 4px;
    --hero-button-fill: #c8ff3d;
    --hero-button-ink: #101410;
    --hero-button-line: #cbd2c6;
    position: relative;
    min-height: 960px;
    overflow: clip;
    isolation: isolate;
    background: #f6f8f4;
    color: #101410;
  }
  .hero-wallpaper { position: absolute; z-index: -1; inset: 0; overflow: hidden; background: #f6f8f4; }
  .hero-wallpaper::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgb(248 250 246 / .88) 0%, rgb(248 250 246 / .72) 40%, rgb(248 250 246 / .52) 100%);
    content: '';
  }
  :global(.hero-wallpaper picture),
  :global(.hero-wallpaper img) { display: block; width: 100%; height: 100%; }
  :global(.hero-wallpaper img) { object-fit: cover; object-position: center 46%; filter: saturate(.55); }
  .hero-layout {
    box-sizing: border-box;
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, .72fr) minmax(620px, 1.28fr);
    align-items: start;
    column-gap: clamp(42px, 6vw, 88px);
    width: min(1312px, calc(100% - 96px));
    min-height: 960px;
    margin-inline: auto;
    padding: 166px 0 82px;
  }
  .hero-copy {
    grid-column: 1;
    position: relative;
    z-index: 2;
    max-width: 420px;
    padding-top: 22px;
  }
  .desktop-hero h1 {
    margin: 0;
    font-size: clamp(52px, 5.8vw, 78px);
    font-weight: 520;
    letter-spacing: -.076em;
    line-height: .98;
    text-wrap: balance;
  }
  .desktop-hero h1 span { display: block; }
  .desktop-hero h1 span + span { margin-top: .11em; }
  .hero-copy > p {
    max-width: 385px;
    margin: 23px 0 0;
    color: #505a51;
    font-size: 15px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .desktop-actions { margin-top: 26px; }
  .hero-desktop {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    width: min(1320px, 82vw);
  }
  .desktop-hero :focus-visible { outline: 2px solid #345600; outline-offset: 4px; }
  @media (max-width: 1199px) {
    .desktop-hero { min-height: 0; }
    .hero-layout {
      grid-template-columns: minmax(0, 1fr);
      width: min(100% - 56px, 780px);
      min-height: 0;
      padding: 150px 0 0;
    }
    .hero-copy { grid-column: 1; max-width: 580px; padding-top: 0; }
    .desktop-hero h1 { font-size: clamp(52px, 8vw, 72px); }
    .hero-desktop { position: relative; right: auto; bottom: auto; width: min(100%, 900px); margin: 12px auto 0; }
  }
  @media (max-width: 620px) {
    .hero-layout { width: calc(100% - 40px); padding: 142px 0 0; }
    .desktop-hero h1 { font-size: clamp(48px, 13vw, 62px); }
    .hero-copy > p { margin-top: 17px; font-size: 15px; }
    .desktop-actions { margin-top: 20px; }
  }
</style>
