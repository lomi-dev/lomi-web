---
import { Picture } from 'astro:assets';
import workbench from '../assets/product/workbench.png';
import type { HeroProps } from './hero/types';
import HeroActions from './hero/Actions.astro';
import GlassBackdrop from './GlassBackdrop.astro';
import releases from '../../content/releases.json';

interface Props extends HeroProps {}
const { content, layout } = Astro.props;
---

<section class="hero" data-enter aria-labelledby="hero-title">
  <GlassBackdrop />
  <div class="hero-inner shell">
    <div class="hero-copy">
      <h1 id="hero-title">{content.title}</h1>
      <p class="hero-description">{content.description}</p>
      <HeroActions content={content} layout={layout} class="hero-cta" />
      <p class="hero-meta">Free and open source <span aria-hidden="true">·</span> <a href="/devlog/#releases">v{releases[0].version}</a></p>
    </div>

    <figure class="shot">
      {/* A real capture of Lomi 0.6 (2880x1800), never a drawing of it. */}
      <Picture src={workbench} formats={['avif', 'webp']} widths={[960, 1440, 2160, 2880]} sizes="(max-width: 1023px) 100vw, 1180px" alt={content.previewAlt} loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; isolation: isolate; height: 100svh; min-height: 720px; max-height: 1000px; background: var(--color-night-950); color: var(--color-ink); }


  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(40px, 5vw, 72px); height: 100%; padding-top: var(--site-header-height); }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .hero h1 { font-size: clamp(48px, min(6.4vw, 12.5svh), 104px); line-height: .94; text-wrap: balance; }
  .hero-description { max-width: 36ch; margin-top: 28px; color: #c8c8d0; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; text-wrap: pretty; }
  .hero :global(.hero-cta) { margin-top: 36px; }
  .hero-meta { margin-top: 24px; color: var(--color-text-secondary); font-size: 14px; }
  .hero-meta span { margin-inline: 6px; color: var(--color-night-600); }
  .hero-meta a { color: #dcdce2; text-decoration: underline; text-decoration-color: var(--color-night-600); text-underline-offset: 4px; transition: text-decoration-color 120ms ease-out; }
  .hero-meta a:hover { text-decoration-color: currentColor; }

  /* The real app, bleeding off the right edge. */
  .shot { position: relative; width: 1180px; margin: 0; border-radius: 11px; box-shadow: 0 0 0 1px rgb(247 247 249 / .14), 0 0 0 9px rgb(247 247 249 / .035), 0 50px 140px -30px rgb(0 0 0 / .9), 0 0 120px -20px rgb(114 59 250 / .45); }
  .shot :global(img) { border-radius: 11px; }
  /* one pass of light across the window glass on arrival */
  .shot::after { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / .09) 48%, rgb(255 255 255 / .02) 54%, transparent 62%) -120% 0 / 220% 100% no-repeat; pointer-events: none; content: ''; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: hero-rise 800ms var(--ease-out) both; }
    .hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .hero-copy > :nth-child(3) { animation-delay: 160ms; }
    .hero-copy > :nth-child(4) { animation-delay: 240ms; }
    .shot { animation: hero-shot 1300ms var(--ease-out) 250ms both; }
    .shot::after { animation: hero-sheen 1600ms var(--ease-out) 1100ms both; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); filter: blur(6px); } }
  @keyframes hero-shot { from { opacity: 0; transform: translate(80px, 24px) scale(.97); } }
  @keyframes hero-sheen { from { background-position: 120% 0; } to { background-position: -120% 0; } }

  @media (max-width: 1023px) {
    .hero { height: auto; min-height: 0; max-height: none; }
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 56px; padding-top: calc(var(--site-header-height) + 64px); padding-bottom: 0; }
    .shot { width: 135%; border-radius: 11px 11px 0 0; }
  }
  @media (max-width: 767px) {
    .hero-inner { gap: 40px; padding-top: calc(var(--site-header-height) + 40px); }
      .hero h1 { font-size: clamp(44px, 13vw, 60px); }
    .hero-description { margin-top: 20px; }
    .hero :global(.hero-cta) { width: 100%; margin-top: 28px; }
    .hero :global(.hero-cta .button) { flex: 1 1 100%; }
    .shot { width: 190%; }
  }
</style>
