---
import { resolveMedia, type MediaAsset } from '../../content/editor-schema';
import { Picture } from 'astro:assets';
import workbench from '../assets/product/hero-workbench.png';
import MediaPlaceholder from './MediaPlaceholder.astro';
import FeatureCapture from './FeatureCapture.astro';
import type { Landing } from '../../content/landing-schema';

interface Props {
  image?: MediaAsset | null;
  video?: MediaAsset | null;
  alt: string;
  placeholderLogo?: MediaAsset | null;
  placeholderAspect?: string;
  placeholderVariant?: 'brand' | 'hero' | 'download';
  placeholderFeature?: Landing['features']['items'][number]['icon'];
  class?: string;
  loading?: 'eager' | 'lazy';
  controls?: boolean;
  widths?: number[];
  sizes?: string;
}
const { image, video, alt, placeholderLogo, placeholderAspect, placeholderVariant, placeholderFeature, class: className, loading = 'lazy', controls = true, widths, sizes } = Astro.props;
const picture = resolveMedia(image, import.meta.env.CMS_URL);
const clip = resolveMedia(video, import.meta.env.CMS_URL);
const description = alt || picture?.alt || clip?.alt || '';
const useProductCapture = placeholderVariant === 'hero' || placeholderVariant === 'download';
const fetchPriority = placeholderVariant === 'hero' && loading === 'eager' ? 'high' : undefined;
---

{clip ? <video class={className} data-cms-video controls={controls} muted playsinline loop preload="metadata"
  poster={picture?.url ?? '/placeholders/lomi-poster.svg'} width={clip.width ?? 1600} height={clip.height ?? 1000} aria-label={description}>
  <source src={clip.url} type={clip.mimeType} />
  {description}
</video> : picture ? <picture><img class={className} src={picture.url} alt={description}
  width={picture.width ?? 1600} height={picture.height ?? 1000} loading={loading} fetchpriority={fetchPriority} decoding="async" /></picture>
  : useProductCapture ? <Picture src={workbench} alt={description} class={className} widths={widths ?? [640, 960, 1280, 1600, 1920, 2560, 2880]} sizes={sizes ?? '(min-width: 1600px) 1440px, calc(100vw - 40px)'} formats={['avif', 'webp']} loading={loading} fetchpriority={fetchPriority} decoding={loading === 'eager' ? 'sync' : 'async'} />
  : placeholderFeature ? <FeatureCapture kind={placeholderFeature} alt={description} class={className} loading={loading} />
  : <MediaPlaceholder logo={placeholderLogo} aspect={placeholderAspect} variant={placeholderVariant} class={className} loading={loading} />}

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-cms-video]')];
  const started = new WeakSet<HTMLVideoElement>();
  const pauseAll = () => videos.forEach((video) => video.pause());
  const available = (video: HTMLVideoElement) => {
    const modal = document.querySelector('dialog[open]');
    const bounds = video.getBoundingClientRect();
    return !document.hidden && !video.closest('[hidden], [inert], dialog[data-state="closing"]')
      && (!modal || modal.contains(video)) && bounds.width > 0 && bounds.height > 0
      && bounds.bottom > 0 && bounds.top < innerHeight;
  };
  videos.forEach((video) => video.addEventListener('playing', () => {
    if (!available(video)) video.pause();
  }));
  if (typeof IntersectionObserver !== 'undefined') {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (!entry.isIntersecting || !available(video)) video.pause();
      else if (entry.intersectionRatio >= .5 && !started.has(video) && !reduced.matches) {
        started.add(video);
        void video.play().catch(() => { /* Native controls remain available. */ });
      }
    }), { threshold: [0, .5] });
    videos.forEach((video) => observer.observe(video));
  }
  reduced.addEventListener('change', () => { if (reduced.matches) pauseAll(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pauseAll(); });
  window.addEventListener('pagehide', pauseAll);
</script>

<style>
  picture, video { display: block; width: 100%; height: 100%; }
  picture :global(img), video { width: 100%; height: 100%; object-fit: contain; }
</style>
