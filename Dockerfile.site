# Run Astro on the supported Node.js LTS line while pinning Bun for installs.
FROM oven/bun:1.4.4 AS bun
FROM node:22-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

COPY package.json bun.lock ./
# Bookworm uses glibc. Keep Sharp's native optional dependencies enabled and
# copy package files instead of hardlinking them from Bun's cache.
RUN bun install --frozen-lockfile --libc=glibc --backend=copyfile

COPY . .
ARG CMS_URL
ARG SITE_URL
ARG PUBLIC_NEWSLETTER_ENDPOINT
ARG LOMI_REMOTE_INSTALLATION_CATALOG_JSON
ARG LOMI_REMOTE_INSTALLATION_CATALOG_SHA256
ENV CMS_URL=${CMS_URL}
ENV SITE_URL=${SITE_URL}
ENV PUBLIC_NEWSLETTER_ENDPOINT=${PUBLIC_NEWSLETTER_ENDPOINT}
ENV LOMI_REMOTE_INSTALLATION_CATALOG_JSON=${LOMI_REMOTE_INSTALLATION_CATALOG_JSON}
ENV LOMI_REMOTE_INSTALLATION_CATALOG_SHA256=${LOMI_REMOTE_INSTALLATION_CATALOG_SHA256}
RUN bun run build

FROM nginx:1.30-alpine
COPY deploy/nginx-site.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -T 2 -O /dev/null http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
