# Keep Astro and Payload on the Node.js 22 LTS line required by package.json.
FROM oven/bun:1.3.14 AS bun
FROM node:22-bookworm-slim AS dependencies
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY cms/package.json cms/bun.lock ./cms/
RUN cd cms && bun install --frozen-lockfile
# Shared ../content modules resolve packages from their parent directory.
RUN ln -s /app/cms/node_modules /app/node_modules

FROM dependencies AS build
COPY cms ./cms
COPY content ./content
WORKDIR /app/cms
ARG NEXT_PUBLIC_SERVER_URL=https://cms.lomi.dev
ENV NEXT_PUBLIC_SERVER_URL=${NEXT_PUBLIC_SERVER_URL}
ENV PAYLOAD_SECRET=build-only-dummy-secret-not-for-runtime
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM node:22-bookworm-slim AS runtime
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
COPY --from=dependencies /app/cms/node_modules ./cms/node_modules
COPY --from=build /app/cms ./cms
COPY --from=build /app/content ./content
RUN ln -s /app/cms/node_modules /app/node_modules
WORKDIR /app/cms
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3001/api/globals/landing?depth=0&draft=false').then((response) => { if (!response.ok) process.exitCode = 1 }).catch(() => { process.exitCode = 1 })"
CMD ["sh", "-c", "node node_modules/payload/bin.js migrate && bun run bootstrap:admin && bun run seed && bun run recover:rebuilds && exec node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3001"]
