# Optional; unavailable by default. Configure the subscribe endpoint after
# completing auth-app/NEWSLETTER.md. Never put a provider API key here.
# The backend permits only explicitly configured site origins.
# PUBLIC_NEWSLETTER_ENDPOINT=https://auth.example.com/v1/newsletter/subscribe

# Optional. Omit to use content/landing.json while designing the page.
# When set, build reads published Payload content and fails on CMS errors.
# Publishing in Payload requires rebuilding the static site to go live.
# CMS_URL=http://localhost:3001
# SITE_URL=https://lomi.dev
