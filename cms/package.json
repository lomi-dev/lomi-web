{
  "name": "lomi-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "check": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx scripts/test.ts && tsx scripts/test-editor.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "graphql": "16.14.2",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
