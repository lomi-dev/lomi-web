# Generate a long random value, for example: openssl rand -hex 32
PAYLOAD_SECRET=
# Local SQLite requires a persistent, writable disk. Run commands from cms/.
DATABASE_URL=file:./data/payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Persistent writable directory for original media uploads (up to 50 MiB each).
MEDIA_UPLOAD_DIR=./data/media

# Required for the Docker container's first start, before it serves the admin.
# Use an address you control and a unique random password of at least 16 chars.
# Existing administrators are never changed; remove these after initialization.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Optional automatic Astro rebuild after publishing or changing public media.
# Runtime only. Use the site's Coolify deploy API URL and a deploy-capable token.
# Never enable either value for the Docker build or expose them to the browser.
# SITE_REBUILD_URL=https://coolify.example.com/api/v1/deploy?uuid=SITE_UUID&force=true
# SITE_REBUILD_TOKEN=
